<%- include('partials/head') %>
<% var locked = ims && ims.locked; %>

<section class="py-10 md:py-14">
  <div class="max-w-6xl mx-auto px-4">

    <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-accent mb-1">Panel edycji - poufne</p>
        <h1 class="text-2xl md:text-3xl font-bold text-gray-900">Edycja oferty <%= ims ? ims.client : 'IMS' %></h1>
      </div>
      <a href="/oferta-ims/" target="_blank" rel="noopener" class="text-accent-dark hover:text-accent font-medium text-sm">Podgląd jak widzi Klient &rarr;</a>
    </div>

    <% if (saved) { %>
      <div class="bg-green-50 border border-green-200 text-green-800 rounded-xl px-4 py-3 mb-5 text-sm">Zapisano.</div>
    <% } %>
    <% if (err) { %>
      <div class="bg-red-50 border border-red-200 text-red-800 rounded-xl px-4 py-3 mb-5 text-sm">Błąd: <%= err %></div>
    <% } %>

    <% if (!ims) { %>
      <p class="text-gray-600">Brak danych oferty (data/ims-offer.json).</p>
    <% } else { %>

    <% if (locked) { %>
      <div class="bg-amber-50 border border-amber-300 text-amber-900 rounded-xl px-5 py-4 mb-6">
        <p class="font-semibold mb-1">Oferta ZABLOKOWANA</p>
        <p class="text-sm mb-3">Edycja jest wstrzymana. Klient widzi finalną wersję oferty pod adresem <code>/oferta-ims/</code>.</p>
        <form method="post" action="/oferta-ims/lock/">
          <button type="submit" class="bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-4 py-2 rounded-lg transition-colors">Odblokuj ofertę (wróć do edycji)</button>
        </form>
      </div>
    <% } else { %>
      <div class="flex flex-wrap items-center gap-3 mb-6">
        <button type="submit" form="imsTextForm" class="bg-accent hover:bg-accent-light text-white text-sm font-semibold px-5 py-2.5 rounded-lg transition-colors">Zapisz zmiany (stawki i notatki)</button>
        <form method="post" action="/oferta-ims/lock/" onsubmit="return confirm('Zablokować ofertę? Klient zobaczy aktualną wersję, edycja zostanie wstrzymana (można odblokować).');">
          <button type="submit" class="border border-amber-400 text-amber-800 hover:bg-amber-50 text-sm font-semibold px-4 py-2.5 rounded-lg transition-colors">Zablokuj ofertę (pokaż Klientowi finalną)</button>
        </form>
        <span class="text-xs text-gray-500">Pliki demo wgrywa się osobno przy każdym lektorze (zapisują się od razu).</span>
      </div>
      <form id="imsTextForm" method="post" action="/oferta-ims/zapisz/"></form>
    <% } %>

    <div class="mb-6 flex flex-wrap items-center gap-3">
      <label for="imsLangFilter" class="text-sm font-medium text-gray-700">Filtr języka:</label>
      <select id="imsLangFilter" class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-accent">
        <option value="">Wszystkie języki</option>
        <% ims.languages.forEach(function(group){ %><option value="<%= group.lang %>"><%= group.lang %></option><% }); %>
      </select>
      <% if (!locked) { %><span class="text-xs text-gray-500">Wskazówka: zapisz zmiany tekstowe przed dodaniem/usunięciem pozycji (te akcje przeładowują stronę).</span><% } %>
    </div>

    <% ims.languages.forEach(function(group, li){ %>
    <div class="ims-lang mb-8" data-lang="<%= group.lang %>">
      <h2 class="text-lg md:text-xl font-bold text-gray-900 mb-2"><%= group.lang %></h2>
      <div class="hidden md:grid grid-cols-12 gap-2 px-3 pb-1 text-[10px] uppercase tracking-wider text-gray-400">
        <div class="col-span-3">Lektor</div><div class="col-span-2">Radio - krajowe</div><div class="col-span-2">Galeria</div><div class="col-span-2">Notatka</div><div class="col-span-3">Demo mp3</div>
      </div>
      <div class="border border-gray-200 rounded-xl overflow-hidden bg-white">
        <% group.lektorzy.forEach(function(v, vi){ %>
        <div class="grid grid-cols-1 md:grid-cols-12 gap-1.5 md:gap-2 md:items-center px-3 py-2 <%= vi ? 'border-t border-gray-100' : '' %>">
          <div class="md:col-span-3 min-w-0">
            <span class="font-semibold text-gray-900 text-sm"><%= v.name %></span>
            <% if (!locked) { %>
            <form method="post" action="/oferta-ims/usun/" class="inline ml-2" onsubmit="return confirm('Usunąć tę pozycję lektora?');">
              <input type="hidden" name="li" value="<%= li %>"><input type="hidden" name="vi" value="<%= vi %>">
              <button type="submit" class="text-[11px] text-red-600 hover:text-red-700 hover:underline">usuń</button>
            </form>
            <% } %>
          </div>
          <div class="md:col-span-2">
            <% if (locked) { %><span class="text-sm font-semibold text-gray-900"><%= v.radio %></span><% } else { %><input form="imsTextForm" type="text" name="radio_<%= li %>_<%= vi %>" value="<%= v.radio %>" class="w-full border border-gray-300 rounded px-2 py-1 text-xs focus:outline-none focus:border-accent"><% } %>
          </div>
          <div class="md:col-span-2">
            <% if (locked) { %><span class="text-sm font-semibold text-gray-900"><%= v.gallery %></span><% } else { %><input form="imsTextForm" type="text" name="gallery_<%= li %>_<%= vi %>" value="<%= v.gallery %>" class="w-full border border-gray-300 rounded px-2 py-1 text-xs focus:outline-none focus:border-accent"><% } %>
          </div>
          <div class="md:col-span-2">
            <% if (locked) { %><span class="text-xs text-gray-500"><%= v.note %></span><% } else { %><input form="imsTextForm" type="text" name="note_<%= li %>_<%= vi %>" value="<%= v.note %>" placeholder="notatka" class="w-full border border-gray-300 rounded px-2 py-1 text-xs focus:outline-none focus:border-accent"><% } %>
          </div>
          <div class="md:col-span-3 space-y-1">
            <% var demos = Array.isArray(v.demos) ? v.demos : []; for (var s = 0; s < 2; s++) { %>
            <div class="flex items-center gap-1.5">
              <% if (demos[s]) { %><audio controls preload="none" class="min-w-0 flex-1" style="height:28px"><source src="<%= demos[s] %>" type="audio/mpeg"></audio><% } else { %><span class="text-[10px] text-gray-300 flex-1">demo <%= s + 1 %>: brak</span><% } %>
              <% if (!locked) { %>
              <form method="post" action="/oferta-ims/demo/" enctype="multipart/form-data" class="flex items-center gap-1">
                <input type="hidden" name="li" value="<%= li %>"><input type="hidden" name="vi" value="<%= vi %>"><input type="hidden" name="slot" value="<%= s %>">
                <input type="file" name="demo" accept="audio/mpeg,.mp3" required class="text-[10px] w-24">
                <button type="submit" title="Wgraj/Zmień" class="bg-gray-900 hover:bg-gray-700 text-white text-[10px] font-semibold px-2 py-1 rounded">↑</button>
              </form>
              <% } %>
            </div>
            <% } %>
          </div>
        </div>
        <% }); %>
      </div>
      <% if (!locked) { %>
      <form method="post" action="/oferta-ims/dodaj/" class="mt-3">
        <input type="hidden" name="li" value="<%= li %>">
        <button type="submit" class="text-sm font-semibold text-accent-dark hover:text-accent border border-dashed border-gray-300 hover:border-accent rounded-lg px-4 py-2 transition-colors">+ Dodaj lektora (<%= group.lang %>)</button>
      </form>
      <% } %>
    </div>
    <% }); %>

    <% if (!locked) { %>
      <div class="sticky bottom-4 mt-8">
        <button type="submit" form="imsTextForm" class="bg-accent hover:bg-accent-light text-white text-sm font-semibold px-6 py-3 rounded-lg shadow-lg transition-colors">Zapisz zmiany (stawki i notatki)</button>
      </div>
    <% } %>

    <p class="text-xs text-gray-400 mt-10 border-t border-gray-200 pt-6">Panel operatora. Dane: data/ims-offer.json (źródło prawdy, edytowane tutaj). Strona nieindeksowana.</p>

    <script>(function(){var s=document.getElementById('imsLangFilter');if(!s)return;var gs=document.querySelectorAll('.ims-lang');s.addEventListener('change',function(){var v=s.value;gs.forEach(function(g){g.style.display=(!v||g.getAttribute('data-lang')===v)?'':'none';});});})();</script>

    <% } %>
  </div>
</section>

<%- include('partials/foot') %>
