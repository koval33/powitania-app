<%- include('partials/head') %>
<% var locked = ims && ims.locked; %>

<section class="py-10 md:py-14">
  <div class="max-w-6xl mx-auto px-4">

    <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
      <div>
        <p class="text-xs font-semibold uppercase tracking-widest text-accent mb-1">Panel edycji - poufne</p>
        <h1 class="text-2xl md:text-3xl font-bold text-gray-900">Edycja oferty <%= ims ? ims.client : 'IMS' %></h1>
      </div>
      <a href="/oferta-ims/" target="_blank" rel="noopener" class="text-accent-dark hover:text-accent font-medium text-sm">Podgląd jak widzi Klient &rarr;</a>
    </div>

    <% if (saved) { %>
      <div class="bg-green-50 border border-green-200 text-green-800 rounded-xl px-4 py-3 mb-5 text-sm">Zapisano.</div>
    <% } %>
    <% if (err) { %>
      <div class="bg-red-50 border border-red-200 text-red-800 rounded-xl px-4 py-3 mb-5 text-sm">Błąd: <%= err %></div>
    <% } %>

    <% if (!ims) { %>
      <p class="text-gray-600">Brak danych oferty (data/ims-offer.json).</p>
    <% } else { %>

    <% if (locked) { %>
      <div class="bg-amber-50 border border-amber-300 text-amber-900 rounded-xl px-5 py-4 mb-6">
        <p class="font-semibold mb-1">Oferta ZABLOKOWANA</p>
        <p class="text-sm mb-3">Edycja jest wstrzymana. Klient widzi finalną wersję oferty pod adresem <code>/oferta-ims/</code>.</p>
        <form method="post" action="/oferta-ims/lock/">
          <button type="submit" class="bg-amber-600 hover:bg-amber-700 text-white text-sm font-semibold px-4 py-2 rounded-lg transition-colors">Odblokuj ofertę (wróć do edycji)</button>
        </form>
      </div>
    <% } else { %>
      <div class="flex flex-wrap items-center gap-3 mb-6">
        <button type="submit" form="imsTextForm" class="bg-accent hover:bg-accent-light text-white text-sm font-semibold px-5 py-2.5 rounded-lg transition-colors">Zapisz zmiany (stawki i notatki)</button>
        <form method="post" action="/oferta-ims/lock/" onsubmit="return confirm('Zablokować ofertę? Klient zobaczy aktualną wersję, edycja zostanie wstrzymana (można odblokować).');">
          <button type="submit" class="border border-amber-400 text-amber-800 hover:bg-amber-50 text-sm font-semibold px-4 py-2.5 rounded-lg transition-colors">Zablokuj ofertę (pokaż Klientowi finalną)</button>
        </form>
        <span class="text-xs text-gray-500">Pliki demo wgrywa się osobno przy każdym lektorze (zapisują się od razu).</span>
      </div>
      <form id="imsTextForm" method="post" action="/oferta-ims/zapisz/"></form>
    <% } %>

    <% ims.languages.forEach(function(group, li){ %>
    <div class="mb-8">
      <h2 class="text-lg md:text-xl font-bold text-gray-900 mb-3 pb-2 border-b border-gray-200"><%= group.lang %></h2>
      <div class="space-y-4">
        <% group.lektorzy.forEach(function(v, vi){ %>
        <div class="bg-white border border-gray-200 rounded-xl p-5 shadow-sm">
          <div class="grid md:grid-cols-12 gap-4 md:gap-5 items-start">

            <div class="md:col-span-3">
              <p class="font-bold text-gray-900"><%= v.name %></p>
            </div>

            <div class="md:col-span-3">
              <label class="block text-[11px] uppercase tracking-wider text-gray-400 mb-1">Radio - zasięg krajowy</label>
              <% if (locked) { %>
                <p class="text-base font-semibold text-gray-900"><%= v.radio %></p>
              <% } else { %>
                <input form="imsTextForm" type="text" name="radio_<%= li %>_<%= vi %>" value="<%= v.radio %>" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-accent">
              <% } %>
            </div>

            <div class="md:col-span-3">
              <label class="block text-[11px] uppercase tracking-wider text-gray-400 mb-1">Galeria handlowa</label>
              <% if (locked) { %>
                <p class="text-base font-semibold text-gray-900"><%= v.gallery %></p>
              <% } else { %>
                <input form="imsTextForm" type="text" name="gallery_<%= li %>_<%= vi %>" value="<%= v.gallery %>" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-accent">
              <% } %>
            </div>

            <div class="md:col-span-3">
              <label class="block text-[11px] uppercase tracking-wider text-gray-400 mb-1">Notatka (opcjonalnie)</label>
              <% if (locked) { %>
                <p class="text-xs text-gray-500 leading-relaxed"><%= v.note %></p>
              <% } else { %>
                <textarea form="imsTextForm" name="note_<%= li %>_<%= vi %>" rows="2" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-xs focus:outline-none focus:border-accent"><%= v.note %></textarea>
              <% } %>
            </div>

          </div>

          <div class="mt-4 pt-4 border-t border-gray-100 grid sm:grid-cols-2 gap-4">
            <% var demos = Array.isArray(v.demos) ? v.demos : []; for (var s = 0; s < 2; s++) { %>
            <div>
              <p class="text-[11px] uppercase tracking-wider text-gray-400 mb-1">Demo <%= s + 1 %></p>
              <% if (demos[s]) { %>
                <audio controls preload="none" class="w-full mb-2" style="height:36px"><source src="<%= demos[s] %>" type="audio/mpeg"></audio>
              <% } else { %>
                <p class="text-xs text-gray-400 mb-2">Brak pliku</p>
              <% } %>
              <% if (!locked) { %>
              <form method="post" action="/oferta-ims/demo/" enctype="multipart/form-data" class="flex items-center gap-2">
                <input type="hidden" name="li" value="<%= li %>">
                <input type="hidden" name="vi" value="<%= vi %>">
                <input type="hidden" name="slot" value="<%= s %>">
                <input type="file" name="demo" accept="audio/mpeg,.mp3" required class="text-xs">
                <button type="submit" class="bg-gray-900 hover:bg-gray-700 text-white text-xs font-semibold px-3 py-1.5 rounded-lg transition-colors whitespace-nowrap"><%= demos[s] ? 'Zmień' : 'Wgraj' %></button>
              </form>
              <% } %>
            </div>
            <% } %>
          </div>

        </div>
        <% }); %>
      </div>
    </div>
    <% }); %>

    <% if (!locked) { %>
      <div class="sticky bottom-4 mt-8">
        <button type="submit" form="imsTextForm" class="bg-accent hover:bg-accent-light text-white text-sm font-semibold px-6 py-3 rounded-lg shadow-lg transition-colors">Zapisz zmiany (stawki i notatki)</button>
      </div>
    <% } %>

    <p class="text-xs text-gray-400 mt-10 border-t border-gray-200 pt-6">Logowanie: ims. Dane: data/ims-offer.json (źródło prawdy, edytowane tutaj). Strona nieindeksowana.</p>

    <% } %>
  </div>
</section>

<%- include('partials/foot') %>
