<%- include('partials/head') %>

<%- include('partials/page-hero', {
  heroH1: 'Pakiety nagrań lektorskich z&nbsp;cenami',
  heroSub: 'Gotowe pakiety w&nbsp;stałych cenach: zapowiedzi telefoniczne, spoty radiowe i&nbsp;internetowe, narracje do&nbsp;filmów. Głosy z&nbsp;grupy standardowej, zamówienie i&nbsp;płatność online, faktura&nbsp;VAT.',
  heroCta: 'none'
}) %>

<%
  var groups = [
    { id: 'zapowiedzi', title: 'Zapowiedzi telefoniczne (IVR)', desc: 'Komunikaty na centralę telefoniczną: powitania, menu, wiadomości poza godzinami. Cztery rozmiary - od startowego po dwujęzyczny komplet.', cat: 'ivr', cols: 'lg:grid-cols-4' },
    { id: 'spoty', title: 'Spoty reklamowe', desc: 'Nagrania lektorskie spotów z licencją emisyjną na 12 miesięcy: radio lokalne, ogólnopolskie i kampanie internetowe.', cat: 'spot', cols: 'lg:grid-cols-3' },
    { id: 'narracje', title: 'Narracje do filmów i prezentacji', desc: 'Głos do filmu korporacyjnego, prezentacji lub e-learningu, rozliczany za stronę znormalizowaną tekstu.', cat: 'narracja', cols: 'lg:grid-cols-3' }
  ];
%>

<!-- Intro + kafle kategorii -->
<section class="py-12 md:py-16 border-b border-gray-200 bg-stone-50">
  <div class="max-w-6xl mx-auto px-4">
    <div class="max-w-3xl">
      <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-3">Jak działa sklep?</h2>
      <p class="text-gray-600 leading-relaxed">Sprzedajemy ustandaryzowane pakiety nagrań lektorskich w stałych cenach. Zamawiasz w trzech krokach: wybierasz typ nagrania i rozmiar pakietu, odsłuchujesz próbki i wskazujesz lektora, a po płatności online realizujemy nagranie w terminie pakietu. Bez wycen i maili - od wyboru do zamówienia w kilka minut.</p>
    </div>
    <%
      var catTiles = [
        { anchor: '#zapowiedzi', title: 'Zapowiedzi telefoniczne', img: 'zapowiedzi-telefoniczne-start-foto', cat: 'ivr' },
        { anchor: '#spoty', title: 'Spoty reklamowe', img: 'spot-radiowy-30s-stacja-lokalna-foto', cat: 'spot' },
        { anchor: '#narracje', title: 'Narracje do filmów', img: 'narracja-do-filmu-1-strona-foto', cat: 'narracja' }
      ];
    %>
    <div class="grid sm:grid-cols-3 gap-5 mt-8">
      <% catTiles.forEach(function(t) {
        var items = pakiety.filter(function(p){ return p.category === t.cat; });
        var odCeny = Math.min.apply(null, items.map(function(p){ return p.netto; }));
      %>
      <a href="<%= t.anchor %>" class="group bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:border-accent/40 hover:shadow-md transition-all hover:-translate-y-0.5">
        <img src="/img/pakiety/<%= t.img %>.webp" alt="<%= t.title %> - pakiety nagrań" width="800" height="800" class="w-full h-40 object-cover" loading="lazy">
        <div class="p-5">
          <h3 class="font-bold text-gray-900 group-hover:text-accent transition-colors"><%= t.title %></h3>
          <p class="text-sm text-gray-500 mt-1"><%= items.length %> <%= items.length === 1 ? 'pakiet' : (items.length < 5 ? 'pakiety' : 'pakietów') %> · od <%= odCeny %> zł netto</p>
          <span class="mt-3 inline-flex items-center gap-1.5 text-accent font-semibold text-sm">Przejdź do pakietów
            <svg class="w-4 h-4 group-hover:translate-y-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5L12 21m0 0l-7.5-7.5M12 21V3"/></svg>
          </span>
        </div>
      </a>
      <% }); %>
    </div>
  </div>
</section>

<section class="py-12 md:py-16">
  <div class="max-w-6xl mx-auto px-4">
    <% groups.forEach(function(g) { var items = pakiety.filter(function(p){ return p.category === g.cat; }); if (!items.length) return; %>
    <div id="<%= g.id %>" class="mb-14 scroll-mt-28">
      <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-2"><%= g.title %></h2>
      <p class="text-gray-600 mb-6 max-w-3xl"><%= g.desc %></p>
      <div class="grid sm:grid-cols-2 <%= g.cols %> gap-5">
        <% items.forEach(function(p) { %>
        <a href="/pakiety/<%= p.id %>/" class="group bg-white border border-gray-200 rounded-2xl p-6 shadow-sm hover:border-accent/40 hover:shadow-md transition-all hover:-translate-y-0.5 flex flex-col">
          <img src="/img/pakiety/<%= p.id %>-foto.webp" alt="<%= p.name %>" width="800" height="800" class="w-full aspect-square object-cover rounded-xl mb-4" loading="lazy">
          <h3 class="font-bold text-gray-900 leading-snug mb-2 group-hover:text-accent transition-colors"><%= p.name %></h3>
          <p class="text-sm text-gray-600 leading-relaxed mb-4 flex-1"><%= p.short %></p>
          <div>
            <span class="text-2xl font-bold text-gray-900"><%= p.netto %> zł</span>
            <span class="text-gray-500 text-sm"> netto</span>
            <p class="text-xs text-gray-500"><%= p.brutto.replace('.', ',') %> zł brutto</p>
          </div>
          <span class="mt-4 inline-flex items-center gap-1.5 text-accent font-semibold text-sm">Zobacz pakiet
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12l-7.5 7.5M21 12H3"/></svg>
          </span>
        </a>
        <% }); %>
      </div>
    </div>
    <% }); %>

    <div class="bg-stone-50 border border-gray-200 rounded-2xl p-6 md:p-8 text-center">
      <h2 class="text-xl md:text-2xl font-bold text-gray-900 mb-2">Projekt nie mieści się w pakiecie?</h2>
      <p class="text-gray-600 max-w-2xl mx-auto mb-5">Głosy premium i znane z nazwiska, kampanie wielospotowe, audiobooki, dłuższe teksty i nietypowe licencje wyceniamy indywidualnie. Odpowiadamy w ciągu 2 godzin w dni robocze.</p>
      <a href="/kontakt/#formularz" class="inline-block bg-accent hover:bg-accent-light text-white px-7 py-3 rounded-lg font-semibold transition-colors">Wypełnij formularz wyceny</a>
    </div>
  </div>
</section>

<%- include('partials/foot') %>
