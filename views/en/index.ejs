<!-- POPULAR VOICE ACTORS -->
<section class="py-20" style="background-color:#e7ded3">
  <div class="max-w-6xl mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Popular Voice Actors</h2>
      <p class="text-gray-500">Listen to samples and find the ideal voice for your project</p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-6">
      <% var popularIds = ['jacek-brzostynski', 'malgorzata', 'janusz', 'anita', 'maciej-jablonski']; %>
      <% var allVoices = typeof voices !== 'undefined' ? voices : []; %>
      <% popularIds.forEach(function(pid) { %>
        <% var v = allVoices.find(function(x) { return x.id === pid; }); %>
        <% if (v) { %>
        <div class="text-center group">
          <div class="relative mb-3">
            <img
              src="<%= v.photo %>"
              alt="<%= v.name %>"
              class="w-28 h-28 md:w-32 md:h-32 rounded-full mx-auto object-cover border-2 border-gray-200 group-hover:border-accent transition-all"
              loading="lazy"
            >
            <% if (v.audio) { %>
            <button
              onclick="playPopular(this, '<%= v.audio %>')"
              class="absolute bottom-0 right-1/2 translate-x-1/2 translate-y-1/3 w-10 h-10 bg-accent hover:bg-accent-light text-white rounded-full flex items-center justify-center shadow-lg transition-all hover:scale-110"
              title="Listen to sample"
            >
              <svg class="w-4 h-4 ml-0.5 play-icon" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              <svg class="w-4 h-4 pause-icon hidden" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
            </button>
            <% } %>
          </div>
          <a href="/en/voice-actors/<%= v.id %>/" class="text-gray-900 font-semibold text-sm hover:text-accent transition-colors"><%= v.name %></a>
          <div class="text-xs text-gray-500 mt-0.5"><%= v.gender === 'm' ? 'Voice Actor' : 'Voice Actress' %></div>
        </div>
        <% } %>
      <% }); %>
    </div>

    <div class="text-center mt-10">
      <a href="/en/voice-bank/" class="text-accent hover:text-accent-light font-medium text-sm">See all voice actors (230+) &rarr;</a>
    </div>
  </div>
</section>

