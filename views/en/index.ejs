<%- include('../partials/head-en') %>

<!-- HERO + KREATOR -->
<section class="relative overflow-hidden hero-dotgrid">

  <div class="relative max-w-4xl mx-auto px-4 pt-10 pb-4 md:pt-14 md:pb-6 text-center">
    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-3 leading-tight" style="font-family: 'Poppins', sans-serif;">
      Professional Voiceover Productions
    </h1>
    <p class="text-lg text-gray-600 max-w-2xl mx-auto">
      Prepare your script, choose a voice artist, order your recording. Over 230 professional voices in 30+ languages.
    </p>
  </div>

  <!-- KREATOR wewnątrz sekcji z kropkami -->
  <div id="kreator" class="relative pb-10 pt-2 scroll-mt-[8rem]">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center mb-5">
        <h2 class="text-2xl font-bold text-gray-900" style="font-family: 'Poppins', sans-serif;">Voiceover Script Creator</h2>
      </div>
      <%- include('../partials/kreator-en') %>
    </div>
  </div>
</section>

<!-- JAK TO DZIAŁA -->
<section class="py-16" style="background-color:#efe8df">
  <div class="max-w-6xl mx-auto px-4">
    <h2 class="text-3xl font-bold text-center text-gray-900 mb-12">How It Works</h2>
    <div class="grid md:grid-cols-3 gap-10">
      <!-- Step 1: Prepare Your Script -->
      <div class="text-center group">
        <div class="w-full mb-5 aspect-[3/2] rounded-xl overflow-hidden shadow-sm">
          <img src="/img/sections/przygotuj-tekst.webp" alt="Prepare Your Script — text editor" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" fetchpriority="high" width="670" height="449">
        </div>
        <h3 class="font-bold text-lg mb-2 text-gray-900">Prepare Your Script</h3>
        <p class="text-gray-500 text-sm">Use our creator or paste your own text for optimization.</p>
      </div>
      <!-- Step 2: Choose a Voice -->
      <div class="text-center group">
        <div class="w-full mb-5 aspect-[3/2] rounded-xl overflow-hidden shadow-sm">
          <img src="/img/sections/wybierz-lektora.webp" alt="Choose a Voice — recording studio" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" width="670" height="445">
        </div>
        <h3 class="font-bold text-lg mb-2 text-gray-900">Choose a Voice</h3>
        <p class="text-gray-500 text-sm">Listen to samples and choose the voice perfect for your project.</p>
      </div>
      <!-- Step 3: Order Recording -->
      <div class="text-center group">
        <div class="w-full mb-5 aspect-[3/2] rounded-xl overflow-hidden shadow-sm">
          <img src="/img/sections/zamow-nagranie.webp" alt="Order Recording — online ordering" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" width="670" height="353">
        </div>
        <h3 class="font-bold text-lg mb-2 text-gray-900">Order Recording</h3>
        <p class="text-gray-500 text-sm">Professional recording ready in 24-48 hours.</p>
      </div>
    </div>
  </div>
</section>

<!-- NEWS -->
<% if (typeof posts !== 'undefined' && posts.length > 0) { %>
<section class="py-16">
  <div class="max-w-6xl mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">News</h2>
      <p class="text-gray-500">Updates from the voiceover studio, tips and industry articles</p>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      <% posts.forEach(function(post) { %>
      <a href="/aktualnosci-pl/<%= post.slug %>/" class="group bg-white rounded-xl border border-gray-200 hover:border-accent overflow-hidden shadow-sm hover:shadow-md transition-all duration-300">
        <div class="p-6">
          <div class="text-xs text-gray-500 mb-3"><%= post.date %></div>
          <h3 class="font-semibold mb-2 text-gray-900 group-hover:text-accent transition-colors line-clamp-2"><%= post.title %></h3>
          <p class="text-gray-500 text-sm leading-relaxed line-clamp-3"><%= post.excerpt %></p>
          <span class="inline-flex items-center gap-1 text-accent text-sm font-medium mt-4">
            Read more
            <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          </span>
        </div>
      </a>
      <% }); %>
    </div>

    <div class="text-center mt-10">
      <a href="/aktualnosci-pl/" class="text-accent hover:text-accent-light font-medium text-sm">All news &rarr;</a>
    </div>
  </div>
</section>
<% } %>

