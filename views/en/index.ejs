  form.addEventListener('submit', function(e) {
    e.preventDefault();
    if (!document.getElementById('hc-rodo').checked) {
      msg.className = 'text-center text-sm py-3 rounded-lg bg-red-500/10 border border-red-500/30 text-red-400';
      msg.textContent = 'You must accept the privacy policy';
      return;
    }
    btn.disabled = true;
    btn.textContent = 'Sending...';
    msg.textContent = '';

    var data = {
      name: document.getElementById('hc-name').value,
      email: document.getElementById('hc-email').value,
      message: document.getElementById('hc-message').value,
      source: 'homepage'
    };

    fetch('/api/contact', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    })
    .then(function(r) { return r.json(); })
    .then(function(res) {
      if (res.ok) {
        if (window.trackEvent) trackEvent('form_submit_contact', { source: 'homepage' });
        msg.className = 'text-center text-sm py-3 rounded-lg bg-accent/10 border border-accent/30 text-accent';
        msg.textContent = 'Thank you! We\'ll respond as soon as possible.';
        form.reset();
      } else {
        msg.className = 'text-center text-sm py-3 rounded-lg bg-red-500/10 border border-red-500/30 text-red-400';
        msg.textContent = res.error || 'An error occurred. Please try again.';
      }
    })
    .catch(function() {
      msg.className = 'text-center text-sm py-3 rounded-lg bg-red-500/10 border border-red-500/30 text-red-400';
      msg.textContent = 'Connection error. Please try again.';
    })
    .finally(function() {
      btn.disabled = false;
      btn.textContent = 'Send Message';
    });
  });
})();

// Newsletter form (UI - shows confirmation, actual endpoint TBD)
(function() {
  var form = document.getElementById('newsletter-form');
  if (!form) return;
  var msg = document.getElementById('nl-msg');

  form.addEventListener('submit', function(e) {
    e.preventDefault();
    var email = document.getElementById('nl-email').value.trim();
    if (!email) return;
    msg.className = 'text-center text-sm py-2 mt-2 rounded-lg bg-accent/10 border border-accent/30 text-accent';
    msg.textContent = 'Thank you for subscribing! Confirmation will be sent to ' + email;
    form.reset();
  });
})();
</script>

