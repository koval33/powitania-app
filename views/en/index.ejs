<%- include('../partials/head-en') %>

<!-- HERO - mirror PL: image bg + title block + widget -->
<section class="hero relative overflow-hidden min-h-[600px] md:min-h-0">

  <%# Mobile: object-cover wypelnia container (absolute, sekcja ma min-h-[600px]) %>
  <img src="/img/studio-bg-960.bw-backup.webp"
       alt="Powitania.pl voiceover studio - artist at microphone"
       class="md:hidden absolute inset-0 w-full h-full object-cover object-top"
       width="960" height="490"
       loading="eager"
       fetchpriority="high">
  <%# Desktop: obraz W NORMALNYM FLOW - definiuje wysokosc sekcji (bez zoomu, bez pustego pasa) %>
  <img src="/img/studio-bg-1920.bw-backup.webp"
       alt=""
       class="hidden md:block w-full h-auto max-w-none"
       width="1920" height="980"
       loading="eager"
       fetchpriority="high">

  <%# Overlay - pokrywa dokladnie obraz (na desktop sekcja == wysokosc obrazu) %>
  <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-black/10 to-black/30"></div>

  <%# Content - nalozony absolutnie na obraz %>
  <div class="absolute inset-0 z-10 w-full max-w-7xl mx-auto px-4 md:px-6 lg:px-8 pt-[140px] md:pt-[160px] pb-8">

    <%# Title block %>
    <div class="flex justify-center mb-10 md:mb-14">
      <div class="inline-block bg-black/35 px-6 md:px-10 py-6 md:py-8 text-center">
        <h1 class="text-white font-extralight text-3xl sm:text-4xl md:text-5xl lg:text-[56px] tracking-tight leading-[1.1]" style="font-family: 'Dosis', sans-serif;">
          Voiceover Studio &amp;&nbsp;Services
        </h1>
        <p class="mt-3 md:mt-4 text-white/95 font-extralight text-2xl sm:text-3xl md:text-[32px] tracking-wide leading-snug" style="font-family: 'Dosis', sans-serif;">
          Browse our voice bank
        </p>
      </div>
    </div>

    <%# Widget: find your voice (gender + language + button) %>
    <form action="/en/voice-bank/" method="get" class="max-w-3xl mx-auto bg-black/35 border border-white/45 rounded-md p-5 md:p-7">
      <h2 class="text-white text-center text-lg md:text-xl font-normal mb-5 md:mb-6 leading-snug tracking-wide" style="font-family: 'Dosis', sans-serif;">
        Find your voice in&nbsp;two simple steps or&nbsp;call us <a href="tel:+48605491069" class="font-semibold hover:underline whitespace-nowrap">+48&nbsp;605&nbsp;491&nbsp;069</a>!
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-[1fr_1fr_auto] gap-3 md:gap-4 items-end">
        <label class="block">
          <span class="block text-white text-xs font-medium mb-1.5">Voice gender</span>
          <select name="gender" class="field-select w-full bg-white text-gray-900 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-accent/60">
            <option value="all">All</option>
            <option value="m">Male</option>
            <option value="f">Female</option>
          </select>
        </label>

        <label class="block">
          <span class="block text-white text-xs font-medium mb-1.5">Language</span>
          <select name="lang" class="field-select w-full bg-white text-gray-900 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-accent/60">
            <option value="all">All languages</option>
            <%
              // Dynamic language list from voices.json (English first, rest alphabetical)
              var allLangs = new Set();
              (voices || []).forEach(function(v) { (v.languages || []).forEach(function(l) { allLangs.add(l); }); });
              var langs = Array.from(allLangs).sort(function(a, b) {
                if (a === 'angielski') return -1;
                if (b === 'angielski') return 1;
                return a.localeCompare(b, 'en');
              });
            %>
            <% langs.forEach(function(lang) { %>
              <option value="<%= lang %>"<% if (lang === 'angielski') { %> selected<% } %>><%= lang %></option>
            <% }); %>
          </select>
        </label>

        <button type="submit" class="w-full md:w-auto bg-accent hover:bg-accent-light transition-colors duration-200 text-white uppercase tracking-wider font-semibold text-xs md:text-sm px-5 md:px-6 py-2.5 rounded-md focus:outline-none focus:ring-2 focus:ring-white/70 focus:ring-offset-2 focus:ring-offset-transparent whitespace-nowrap">
          Find a voice
        </button>
      </div>
    </form>

  </div>
</section>

<!-- ATOMIC FACTS - for LLM/GEO -->
<section class="py-12 border-t border-gray-200">
  <div class="max-w-4xl mx-auto px-4 text-center">
    <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4" style="font-family: 'Dosis', sans-serif;">
      Powitania.pl voiceover studio - since 2001
    </h2>
    <p class="text-base md:text-lg text-gray-700 leading-relaxed">
      <strong>Powitania.pl</strong> is a professional voiceover studio founded in 2001 in Lublin, Poland. We are one of the longest-running Polish companies providing voice-over services. Our voice bank includes <strong><%= voiceCount %> voice artists in 30+ languages</strong>. We have delivered over <strong>11,000 recordings</strong> for <strong>2,800+ clients</strong> - including Hyundai, Orange, Play, Asseco, Allegro, DHL, TVN, Volvo, MSWiA, MEN. Rating <strong>5/5</strong> (149 reviews). Turnaround <strong>24-48h</strong>, prices <strong>from 70 EUR</strong>.
    </p>
  </div>
</section>

<!-- NEWS - carousel -->
<% if (typeof posts !== 'undefined' && posts.length > 0) { %>
<section class="py-16 border-t border-gray-200">
  <div class="max-w-6xl mx-auto px-4">

    <div class="flex items-end justify-between gap-6 mb-8">
      <div>
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-2">News</h2>
        <p class="text-gray-600">Updates from our voice-over studio, tips and&nbsp;industry articles</p>
      </div>
      <div class="hidden md:flex items-center gap-3 shrink-0">
        <a href="/en/news/" class="text-accent-dark hover:text-accent font-medium text-sm whitespace-nowrap">All &rarr;</a>
        <button type="button" data-news-prev aria-label="Previous" class="w-9 h-9 rounded-full border border-gray-300 text-gray-600 hover:border-accent hover:text-accent flex items-center justify-center transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
        </button>
        <button type="button" data-news-next aria-label="Next" class="w-9 h-9 rounded-full border border-gray-300 text-gray-600 hover:border-accent hover:text-accent flex items-center justify-center transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>
    </div>

    <div class="news-scroll flex gap-5 overflow-x-auto snap-x snap-mandatory scroll-smooth -mx-4 px-4 pb-2">
      <% posts.forEach(function(post) { %>
      <a href="/en/news/<%= post.slugEn || post.slug %>/" class="news-card snap-start shrink-0 w-[290px] md:w-[330px] group bg-white rounded-xl border border-gray-200 hover:border-accent shadow-sm hover:shadow-md transition-all duration-300 flex flex-col">
        <div class="h-1 rounded-t-xl bg-accent/70 group-hover:bg-accent transition-colors"></div>
        <div class="p-6 flex flex-col flex-1">
          <div class="text-xs text-gray-600 mb-3 tracking-wide"><%= post.date.split('-').reverse().join('.') %></div>
          <h3 class="font-bold text-lg text-gray-900 group-hover:text-accent transition-colors line-clamp-3 mb-3 leading-snug"><%= post.titleEn || post.title %></h3>
          <p class="text-gray-600 text-sm leading-relaxed line-clamp-3 mb-5"><%= post.excerptEn || post.excerpt %></p>
          <span class="mt-auto inline-flex items-center gap-1 text-accent-dark text-sm font-medium">
            Read more
            <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          </span>
        </div>
      </a>
      <% }); %>
    </div>

    <div class="text-center mt-8 md:hidden">
      <a href="/en/news/" class="text-accent-dark hover:text-accent font-medium text-sm">All news &rarr;</a>
    </div>
  </div>
</section>
<script>
(function(){
  var sc = document.querySelector('.news-scroll');
  if (!sc) return;
  function step(){ var c = sc.querySelector('.news-card'); return c ? c.offsetWidth + 20 : 320; }
  var p = document.querySelector('[data-news-prev]'), n = document.querySelector('[data-news-next]');
  if (p) p.addEventListener('click', function(){ sc.scrollBy({ left: -step(), behavior: 'smooth' }); });
  if (n) n.addEventListener('click', function(){ sc.scrollBy({ left: step(), behavior: 'smooth' }); });
})();
</script>
<% } %>

