<!-- Audio player for popular lectors + Reviews carousel -->
<script>
var popularAudio = null;
var popularBtn = null;

function playPopular(btn, src) {
  if (popularBtn && popularBtn !== btn) {
    popularBtn.querySelector('.play-icon').classList.remove('hidden');
    popularBtn.querySelector('.pause-icon').classList.add('hidden');
  }
  if (popularAudio && popularAudio.src.includes(src) && !popularAudio.paused) {
    popularAudio.pause();
    btn.querySelector('.play-icon').classList.remove('hidden');
    btn.querySelector('.pause-icon').classList.add('hidden');
    return;
  }
  if (!popularAudio) popularAudio = new Audio();
  popularAudio.src = src;
  popularAudio.play();
  btn.querySelector('.play-icon').classList.add('hidden');
  btn.querySelector('.pause-icon').classList.remove('hidden');
  popularAudio.onended = function() {
    btn.querySelector('.play-icon').classList.remove('hidden');
    btn.querySelector('.pause-icon').classList.add('hidden');
  };
}

// Reviews carousel
var currentSlide = 0;
var totalSlides = 3;

function slideReviews(dir) {
  currentSlide = (currentSlide + dir + totalSlides) % totalSlides;
  updateSlider();
}

function goToSlide(n) {
  currentSlide = n;
  updateSlider();
}

function updateSlider() {
  var slider = document.getElementById('reviews-slider');
  if (slider) slider.style.transform = 'translateX(-' + (currentSlide * 100) + '%)';
  var dots = document.querySelectorAll('.review-dot');
  dots.forEach(function(dot, i) {
    dot.className = 'review-dot w-2.5 h-2.5 rounded-full transition-colors ' + (i === currentSlide ? 'bg-accent' : 'bg-gray-600');
  });
}

// Auto-play carousel
setInterval(function() { slideReviews(1); }, 8000);

// Dynamic YouTube carousel — checks video availability, builds slides
(function() {
  var allVideos = [
    { id: '9lWm6XAbaDg', title: 'Instructional Film Narration', narrator: 'Voice Actor Patryk' },
    { id: 'mZ8mMfeD870', title: 'English Language Narration', narrator: 'Voice Actress Alison' },
    { id: 'cfZ27giVqh8', title: 'Wiktor Encourages Site Monitoring', narrator: 'Voice Actor Wiktor' },
    { id: '6gnEr5UzW2Q', title: 'Narration for "Earthmen Attack" Project', narrator: 'Voice Actor David' },
    { id: 'XQV-8dbWgII', title: 'Industrial Company Presentation', narrator: 'Voice Actress Beata' },
    { id: 'YLdaojG1tQw', title: 'Askberry Service Film Narration', narrator: 'Voice Actor Michał' }
  ];

  var track = document.getElementById('yt-track');
  var prevBtn = document.getElementById('yt-prev');
  var nextBtn = document.getElementById('yt-next');
  var dotsWrap = document.getElementById('yt-dots');
  if (!track) return;

  var activeVideos = [];
  var currentIndex = 0;

  function buildCarousel() {
    if (activeVideos.length === 0) return;

    track.innerHTML = '';
    activeVideos.forEach(function(video) {
      var item = document.createElement('div');
      item.className = 'w-full md:w-1/2 lg:w-1/3 flex-shrink-0 px-3';
      item.innerHTML = '<div style="aspect-ratio:16/9" class="bg-gray-200 rounded-xl overflow-hidden"><iframe width="100%" height="100%" src="https://www.youtube.com/embed/' + video.id + '?rel=0" frameborder="0" allowfullscreen></iframe></div><h3 class="text-sm font-semibold text-gray-900 mt-3">' + video.title + '</h3><p class="text-xs text-gray-500">' + video.narrator + '</p>';
      track.appendChild(item);
    });

    dotsWrap.innerHTML = '';
    var dotCount = Math.ceil(activeVideos.length / 3);
    for (var i = 0; i < dotCount; i++) {
      var dot = document.createElement('button');
      dot.className = 'w-2.5 h-2.5 rounded-full ' + (i === 0 ? 'bg-accent' : 'bg-gray-300') + ' transition-colors';
      dot.onclick = function(idx) { return function() { currentIndex = idx; updateCarousel(); }; }(i);
      dotsWrap.appendChild(dot);
    }
    updateCarousel();
  }

  function updateCarousel() {
    if (track && activeVideos.length > 0) {
      track.style.transform = 'translateX(-' + (currentIndex * 100) + '%)';
      var dots = document.querySelectorAll('#yt-dots button');
      dots.forEach(function(d, i) { d.className = 'w-2.5 h-2.5 rounded-full ' + (i === currentIndex ? 'bg-accent' : 'bg-gray-300') + ' transition-colors'; });
      prevBtn.style.display = currentIndex > 0 ? 'flex' : 'none';
      nextBtn.style.display = currentIndex < Math.ceil(activeVideos.length / 3) - 1 ? 'flex' : 'none';
    }
  }

  if (prevBtn) prevBtn.onclick = function() { if (currentIndex > 0) currentIndex--; updateCarousel(); };
  if (nextBtn) nextBtn.onclick = function() { if (currentIndex < Math.ceil(activeVideos.length / 3) - 1) currentIndex++; updateCarousel(); };

  activeVideos = allVideos;
  buildCarousel();
})();

// Contact form
(function() {
  var form = document.getElementById('homepage-contact-form');
  if (!form) return;
  var btn = document.getElementById('hc-submit');
  var msg = document.getElementById('hc-msg');
  msg.classList.remove('hidden');

  form.addEventListener('submit', function(e) {
    e.preventDefault();
    if (!document.getElementById('hc-rodo').checked) {
      msg.className = 'text-center text-sm py-3 rounded-lg bg-red-500/10 border border-red-500/30 text-red-400';
      msg.textContent = 'You must accept the privacy policy';
      return;
    }
    btn.disabled = true;
    btn.textContent = 'Sending...';
    msg.textContent = '';

    var data = {
      name: document.getElementById('hc-name').value,
      email: document.getElementById('hc-email').value,
      message: document.getElementById('hc-message').value,
      source: 'homepage'
    };

    if (window.trackEvent) trackEvent('form_submit_contact', { source: 'homepage' });

    fetch('/api/contact', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    })
    .then(function(r) { return r.json(); })
    .then(function(res) {
      if (res.ok) {
        msg.className = 'text-center text-sm py-3 rounded-lg bg-accent/10 border border-accent/30 text-accent';
        msg.textContent = 'Thank you! We\'ll respond as soon as possible.';
        form.reset();
      } else {
        msg.className = 'text-center text-sm py-3 rounded-lg bg-red-500/10 border border-red-500/30 text-red-400';
        msg.textContent = res.error || 'An error occurred. Please try again.';
      }
    })
    .catch(function() {
      msg.className = 'text-center text-sm py-3 rounded-lg bg-red-500/10 border border-red-500/30 text-red-400';
      msg.textContent = 'Connection error. Please try again.';
    })
    .finally(function() {
      btn.disabled = false;
      btn.textContent = 'Send Message';
    });
  });
})();

// Newsletter form (UI - shows confirmation, actual endpoint TBD)
(function() {
  var form = document.getElementById('newsletter-form');
  if (!form) return;
  var msg = document.getElementById('nl-msg');

  form.addEventListener('submit', function(e) {
    e.preventDefault();
    var email = document.getElementById('nl-email').value.trim();
    if (!email) return;
    msg.className = 'text-center text-sm py-2 mt-2 rounded-lg bg-accent/10 border border-accent/30 text-accent';
    msg.textContent = 'Thank you for subscribing! Confirmation will be sent to ' + email;
    form.reset();
  });
})();
</script>

