<%- include('../partials/head-en') %>

<section class="py-16 md:py-24">
  <div class="max-w-4xl mx-auto px-4">

    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4 text-center">News</h1>
    <p class="text-gray-500 text-center mb-12">Studio updates, new voice artists, tips and industry articles</p>

    <!-- Post list -->
    <div class="space-y-6">
      <% posts.forEach(function(post) { %>
      <a href="/en/news/<%= post.slugEn || post.slug %>/" class="block group bg-white shadow-sm border border-gray-200 rounded-xl p-6 hover:border-accent/30 transition-all">
        <div class="flex items-start gap-4">
          <% if (post.image) { %>
          <img src="<%= post.image %>" alt="<%= post.titleEn || post.title %>" class="w-20 h-20 rounded-full object-cover border border-gray-200 flex-shrink-0" loading="lazy">
          <% } %>
          <div class="flex-1 min-w-0">
            <div class="flex items-start justify-between gap-4">
              <h2 class="text-lg font-bold text-gray-900 group-hover:text-accent transition-colors mb-2"><%= post.titleEn || post.title %></h2>
              <time class="text-xs text-gray-600 flex-shrink-0" datetime="<%= post.date %>">
                <%= new Date(post.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) %>
              </time>
            </div>
            <p class="text-gray-500 text-sm leading-relaxed"><%= post.excerptEn || post.excerpt %></p>
          </div>
        </div>
      </a>
      <% }); %>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
    <div class="flex items-center justify-center gap-2 mt-12">
      <% if (currentPage > 1) { %>
        <a href="/en/news/<%= currentPage === 2 ? '' : 'page/' + (currentPage - 1) + '/' %>" class="px-4 py-2 bg-white hover:bg-gray-100 text-gray-500 rounded-lg border border-gray-200 text-sm transition-colors">&larr; Newer</a>
      <% } %>

      <% for (var p = 1; p <= totalPages; p++) { %>
        <% if (p === currentPage) { %>
          <span class="px-3 py-2 bg-accent text-white rounded-lg text-sm font-semibold"><%= p %></span>
        <% } else { %>
          <a href="/en/news/<%= p === 1 ? '' : 'page/' + p + '/' %>" class="px-3 py-2 bg-white hover:bg-gray-100 text-gray-500 rounded-lg border border-gray-200 text-sm transition-colors"><%= p %></a>
        <% } %>
      <% } %>

      <% if (currentPage < totalPages) { %>
        <a href="/en/news/page/<%= currentPage + 1 %>/" class="px-4 py-2 bg-white hover:bg-gray-100 text-gray-500 rounded-lg border border-gray-200 text-sm transition-colors">Older &rarr;</a>
      <% } %>
    </div>
    <% } %>

  </div>
</section>

<%- include('../partials/foot-en') %>
