    { "@type": "Question", "name": "How does the Powitania.pl voice bank work?", "acceptedAnswer": { "@type": "Answer", "text": "Our voice bank is a searchable database of <%= voiceCount %> professional voice actors. You can filter by language (30+), gender, age, voice character, and project type. Each voice actor has their own profile with a description of experience, scope of services, and an individual price calculator." } },
    { "@type": "Question", "name": "Can I listen to audio samples before choosing a voice actor?", "acceptedAnswer": { "@type": "Answer", "text": "Yes, every voice actor in the bank has 2-4 voiceover samples available to play instantly. Samples cover different styles: commercial, narration, IVR, audiobook. No login, no registration." } },
    { "@type": "Question", "name": "What is the difference between Polish voice actors and native speakers?", "acceptedAnswer": { "@type": "Answer", "text": "The bank includes over 150 native Polish voice actors: actors, presenters, and dubbing artists. Foreign-language native speakers cover export and multilingual projects. Native rates are usually about 2x higher than Polish ones." } },
    { "@type": "Question", "name": "Is every voice actor available immediately?", "acceptedAnswer": { "@type": "Answer", "text": "Most are. Standard voiceover delivery is 24-48h after script approval and voice selection. A few of the most in-demand voices may have a 2-5 business day queue." } },
    { "@type": "Question", "name": "Can I order a casting demo with my own text?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. If you want certainty before a full order, we can record a demo dedicated to your project: a fragment of your specific text performed by the chosen voice actor. Contact us with your project description and we will quote it individually." } },
    { "@type": "Question", "name": "Can I download a voice actor's sample to send to my client?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Every voiceover sample in our bank is available as an MP3 download. Pick 1-3 options, download the samples, and forward them to the end client for approval." } }
  ]
}
</script>

