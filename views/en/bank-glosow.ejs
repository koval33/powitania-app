    <!-- Language -->
    <div>
      <div class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Language</div>
      <select id="filter-lang" class="bank-filter-select w-full">
        <option value="all">All</option>
        <option value="polski">Polish</option>
        <option value="angielski">English</option>
        <option value="niemiecki">German</option>
        <option value="rosyjski">Russian</option>
        <option value="hiszpański">Spanish</option>
        <option value="francuski">French</option>
        <option value="ukraiński">Ukrainian</option>
        <option value="włoski">Italian</option>
        <option value="portugalski">Portuguese</option>
        <option value="czeski">Czech</option>
        <option value="słowacki">Slovak</option>
        <option value="węgierski">Hungarian</option>
        <option value="holenderski">Dutch</option>
        <option value="rumuński">Romanian</option>
        <option value="turecki">Turkish</option>
        <option value="grecki">Greek</option>
        <option value="chorwacki">Croatian</option>
        <option value="serbski">Serbian</option>
        <option value="bułgarski">Bulgarian</option>
        <option value="litewski">Lithuanian</option>
        <option value="łotewski">Latvian</option>
        <option value="szwedzki">Swedish</option>
        <option value="norweski">Norwegian</option>
        <option value="duński">Danish</option>
        <option value="fiński">Finnish</option>
        <option value="hebrajski">Hebrew</option>
        <option value="arabski">Arabic</option>
        <option value="chiński">Chinese</option>
        <option value="japoński">Japanese</option>
        <option value="koreański">Korean</option>
        <option value="hindi">Hindi</option>
      </select>
    </div>

    <!-- Age -->
    <div>
      <div class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Age</div>
      <select id="filter-age" class="bank-filter-select w-full">
        <option value="all">Any</option>
        <option value="20-30">20-30 years</option>
        <option value="30-50">30-50 years</option>
        <option value="50+">50+ years</option>
      </select>
    </div>

    <!-- Hidden checkboxes -->
    <input type="checkbox" id="filter-famous" class="hidden">
    <input type="checkbox" id="filter-native" class="hidden">

    <!-- Toggle buttons -->
    <div class="flex flex-col gap-2">
      <button type="button" id="filter-famous-btn" class="bank-filter-toggle" onclick="toggleFilterPill(this, 'filter-famous')">Famous</button>
      <button type="button" id="filter-native-btn" class="bank-filter-toggle" onclick="toggleFilterPill(this, 'filter-native')">Native Speakers</button>
    </div>

    <!-- Reset -->
    <button onclick="resetFilters()" class="text-xs text-gray-400 hover:text-accent transition-colors text-left">↺ Reset filters</button>

    <!-- Contact - inside filter card, border-t separator -->
    <div class="border-t border-gray-100 pt-4 -mt-1 text-gray-700">
      <p class="text-sm font-semibold mb-3 leading-snug text-gray-900">Not sure where to start?<br>Call or write us.</p>
      <div class="space-y-2.5 text-sm">
        <a href="tel:+48605491069" class="flex items-center gap-2.5 hover:text-accent transition-colors">
          <svg class="w-5 h-5 flex-shrink-0 text-gray-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3"/></svg>
          <span>+48 605 491 069</span>
        </a>
        <a href="mailto:biuro@powitania.pl" class="flex items-center gap-2.5 hover:text-accent transition-colors">
          <svg class="w-5 h-5 flex-shrink-0 text-gray-500" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
          <span class="break-all">biuro@powitania.pl</span>
        </a>
      </div>
    </div>

    </div>
    <!-- /Filter card -->

  </aside>

  <!-- PRAWA TREŚĆ -->
  <div class="flex-1 min-w-0">

    <!-- Kreator context banner -->
    <div id="kreator-context-banner" class="mb-4 hidden">
      <div class="bg-green-50 border-2 border-green-300 rounded-xl p-5 flex items-start gap-4">
        <svg class="w-6 h-6 text-green-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
        <div class="flex-1">
          <h3 class="text-gray-900 font-bold mb-1">Your text is ready</h3>
          <p class="text-sm text-gray-600 mb-3">Select a voice actor below to see pricing for this text</p>
          <div class="bg-stone-100/80 rounded-lg p-3">
            <div class="text-xs text-gray-500 mb-1">Text preview:</div>
            <div id="context-text-preview" class="text-sm text-gray-600 line-clamp-3"></div>
          </div>
        </div>
        <button onclick="clearKreatorContext()" class="text-gray-500 hover:text-gray-900 transition-colors flex-shrink-0" title="Close">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
    </div>

    <!-- Counter -->
    <p class="text-sm text-gray-500 mb-4">Found: <span id="voice-count" class="text-gray-900 font-semibold"><%= voices.length %></span> voice actors</p>

    <!-- SIATKA LEKTORÓW -->
    <style>
      /* Desktop: player wrap is display:contents - player and buttons are direct flex children */
      .vc-player-wrap { display: contents; }
      /* Desktop: grid 3-col 2-row [photo | content (player on top, meta below) | CTA] */
      /* Photo flush with card (no padding/border-radius), other zones have own padding */
      .vc-inner {
        display: grid !important;
        grid-template-columns: 140px 1fr 150px !important;
        grid-template-rows: auto auto !important;
        column-gap: 20px !important;
        row-gap: 6px !important;
        padding: 0 16px 0 0 !important;
        align-items: stretch !important;
      }
      .vc-photo {
        grid-column: 1; grid-row: 1 / -1;
        width: 140px !important;
        height: 140px !important;
        align-self: start !important;
        border-radius: 0 !important;
      }
      .vc-photo img { width: 100% !important; height: 100% !important; }
      .vc-player-wrap { display: contents; }
      .vc-player-row { grid-column: 2; grid-row: 1; display: flex; align-items: center; gap: 10px; min-width: 0; padding-top: 16px; }
      .vc-info { grid-column: 2; grid-row: 2; min-width: 0; align-self: end; padding-bottom: 16px; }
      .vc-cta { grid-column: 3; grid-row: 1 / -1; align-self: center; padding: 16px 0; }
      /* Mobile-only elements - hidden on desktop */
      .vc-badge-mobile { display: none; }
      /* Mobile: 3-zone layout - (1) photo+info, (2) full-width player, (3) CTA+more */
      @media (max-width: 767px) {
        .vc-inner {
          display: grid !important;
          grid-template-columns: 72px 1fr !important;
          column-gap: 12px !important;
          row-gap: 8px !important;
          align-items: start !important;
          padding: 10px !important;
          gap: unset;
        }
        /* ZONE 1 - photo 72px in left column */
        .vc-photo {
          grid-column: 1; grid-row: 1;
          width: 72px !important; height: 72px !important;
          flex-shrink: 0;
        }
        /* ZONE 1 - info: name+badge row 1, meta below */
        .vc-info {
          grid-column: 2; grid-row: 1;
          display: grid !important;
          grid-template-columns: minmax(0, 1fr) auto;
          column-gap: 8px;
          row-gap: 2px;
          align-content: center;
          align-self: center;
          flex: initial !important;
          width: auto !important;
          min-width: 0;
        }
        .vc-info > h3 { grid-column: 1; grid-row: 1; min-width: 0; }
        /* Badge inline next to name (instead of under meta) */
        .vc-info > .vc-badge-inline {
          grid-column: 2; grid-row: 1;
          margin: 0 !important;
          align-self: center;
          display: block !important;
        }
        /* Meta (age/lang/turnaround/price) - full info width, no top margin */
        .vc-info > div:not(.vc-badge-inline) {
          grid-column: 1 / -1;
          margin-top: 0 !important;
        }
        /* Separate .vc-badge-mobile not needed - badge sits next to name */
        .vc-badge-mobile { display: none !important; }

        /* ZONE 2 - full-width player */
        .vc-player-wrap { display: contents !important; }
        .player-box {
          grid-column: 1 / -1; grid-row: 2;
          flex: initial !important;
          padding: 10px 12px !important;
        }
        /* Bigger Play button - 40x40 tap-target */
        .player-box .play-btn { width: 40px !important; height: 40px !important; }

        /* ZONE 3 - actions: single CTA full-width */
        .vc-cta {
          width: auto !important;
          grid-column: 1 / -1; grid-row: 3;
          align-self: center;
        }
        .vc-cta > a, .vc-cta > button { width: 100%; min-height: 44px; }

        /* Mobile - rounded photo (avatar-style on small card) */
        .vc-photo { border-radius: 0.5rem !important; }

        /* Mobile - hide time counter to give waveform more room */
        .player-box .audio-time-wrap { display: none !important; }
      }
    </style>
    <div id="voices-grid" class="grid grid-cols-1 gap-3">
      <% voices.forEach(function(v, idx) { %>
      <%
        var sampleToPlay = (v.samples && v.samples.length > 0)
          ? v.samples.filter(function(s) { return s.url && !s.url.includes('youtu'); })[0]
          : null;
        if (!sampleToPlay) sampleToPlay = { name: 'Sample', url: '' };
        var profileUrl = v.profileUrl ? v.profileUrl.replace('/lektorzy/', '/en/voice-artists/') : '';
      %>
      <div class="voice-card bg-white rounded-xl border border-gray-200 overflow-hidden hover:border-accent/30 shadow-sm hover:shadow-md transition-shadow<%= idx >= 20 ? ' hidden' : '' %>"
           data-url="<%= profileUrl %>"
           data-gender="<%= v.gender %>"
           data-age="<%= v.age %>"
           data-languages="<%= v.languages.join(',') %>"
           data-famous="<%= v.famous %>"
           data-native="<%= v.native %>"
           data-price="<%= v.priceGroup || '' %>"
           data-hideprice="<%= v.hidePrice ? 'true' : 'false' %>"
           data-nativelanguage="<%= v.nativeLanguage || '' %>"
           data-name="<%= v.name.toLowerCase() %>">

        <div class="vc-inner flex items-center gap-4 px-5 py-4">

          <!-- Photo (link to profile) -->
          <a href="<%= profileUrl %>" class="vc-photo flex-shrink-0 w-20 h-20 overflow-hidden bg-gray-100 block hover:opacity-90 transition-opacity">
            <% if (v.photo) { %>
              <img src="<%= v.photo %>" alt="<%= v.name %>" class="w-full h-full object-cover" loading="lazy">
            <% } else { %>
              <div class="w-full h-full flex items-center justify-center text-gray-400">
                <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
              </div>
            <% } %>
          </a>

          <!-- Name + meta (link to profile) - row 2 grid, below player -->
          <a href="<%= profileUrl %>" class="vc-info min-w-0 block hover:text-accent transition-colors">
            <div class="flex items-baseline gap-2.5 flex-wrap">
              <h3 class="font-light text-gray-900 tracking-tight leading-tight text-2xl"><%= v.name %></h3>
              <% if (v.age) { %><span class="text-sm text-gray-500"><%= v.age %></span><% } %>
            </div>
            <div class="mt-1.5 flex items-center justify-between gap-3 flex-wrap">
              <div class="text-sm text-gray-500">
                Languages: <span class="text-accent font-medium uppercase tracking-wide"><%= v.languages.slice(0,3).join(', ') %></span>
              </div>
              <div class="text-sm text-accent font-medium flex items-center gap-2 whitespace-nowrap">
                <% if (!v.hidePrice && v.prices && v.prices.ivr_100) { %>
                  <span>from <%= v.prices.ivr_100 %>&nbsp;EUR</span>
                  <% if (v.turnaround) { %>
                    <span class="text-gray-300">|</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 7v5l3 2"/></svg>
                    <span><%= v.turnaround %></span>
                  <% } %>
                <% } else if (v.hidePrice) { %>
                  <span class="text-yellow-600">custom pricing</span>
                <% } %>
              </div>
            </div>
          </a>


          <!-- Player + CTA - desktop: display:contents (grid placement via CSS) -->
          <div class="vc-player-wrap">
            <div class="player-box vc-player-row cursor-pointer">
              <%# Play - czarne outline 24x24 (mniejszy ok 25%) z umiarkowanym trojkatem 12px %>
              <button class="play-btn w-6 h-6 flex-shrink-0 rounded-full border-2 border-gray-900 bg-white flex items-center justify-center transition-colors" data-audio="<%= sampleToPlay.url %>" title="Play">
                <svg class="play-icon w-3.5 h-3.5 text-gray-900 ml-px" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                <svg class="pause-icon w-3.5 h-3.5 text-gray-900 hidden" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
              </button>
              <%# Stop - bialy 24x24 z accent obreczy + accent kwadratem 12px %>
              <button type="button" class="stop-btn w-6 h-6 flex-shrink-0 rounded-full border-2 border-accent bg-white hover:bg-accent/5 flex items-center justify-center transition-colors" title="Stop">
                <svg class="w-3 h-3 text-accent" fill="currentColor" viewBox="0 0 24 24"><rect x="6" y="6" width="12" height="12"/></svg>
              </button>
              <%# Time display (hidden on mobile - gives waveform more room) %>
              <div class="audio-time-wrap text-xs text-gray-600 font-mono tabular-nums whitespace-nowrap flex-shrink-0">
                <span class="audio-time">00:00</span>
                <span class="audio-duration text-gray-400 ml-1">--:--</span>
              </div>
              <%# Waveform - continuous path (spektrum) %>
              <%
                var _hashStr = function(s){var h=0;for(var i=0;i<s.length;i++)h=((h<<5)-h+s.charCodeAt(i))|0;return Math.abs(h);};
                var _seedRnd = function(seed, i){var x=Math.sin(seed*9999+i*1.37)*10000;return x-Math.floor(x);};
                var _seed = _hashStr(v.id || v.name);
                var _waveBars = 80;
                var _midY = 18;
                var _topPts = [];
                var _botPts = [];
                for(var _i=0; _i<_waveBars; _i++) {
                  var _h = 4 + Math.round(_seedRnd(_seed, _i) * 26);
                  var _x = (_i * 100 / (_waveBars - 1)).toFixed(2);
                  _topPts.push(_x + ',' + (_midY - _h/2).toFixed(2));
                  _botPts.push(_x + ',' + (_midY + _h/2).toFixed(2));
                }
                var _pathD = 'M ' + _topPts[0] + ' L ' + _topPts.join(' L ') + ' L ' + _botPts.reverse().join(' L ') + ' Z';
              %>
              <div class="audio-progress relative flex-1 min-w-0 h-9 cursor-pointer">
                <svg class="absolute inset-0 w-full h-full text-gray-300" viewBox="0 0 100 36" preserveAspectRatio="none" aria-hidden="true">
                  <path d="<%= _pathD %>" fill="currentColor"/>
                </svg>
                <div class="audio-bar absolute top-0 h-full pointer-events-none" style="left: 0%; width: 1px; background-color: rgba(107,114,128,0.8); transform: translateX(-0.5px); transition: left 100ms linear;"></div>
              </div>
              <%# Download MP3 - stara ikonka (strzalka w dol, gray) %>
              <a href="<%= sampleToPlay.url %>" download onclick="event.stopPropagation()" title="Download MP3 sample" class="w-7 h-7 flex-shrink-0 flex items-center justify-center rounded-full text-gray-400 hover:text-gray-700 hover:bg-gray-200 transition-colors">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
              </a>
            </div>

            <!-- CTA: premium (hidePrice) → inquiry form on profile; others → Get quote (calculator) -->
            <div class="vc-cta flex-shrink-0 flex items-center justify-center">
              <% if (v.hidePrice) { %>
                <a href="<%= profileUrl %>#zapytanie" onclick="event.stopPropagation()" class="cta-inquiry inline-flex items-center justify-center bg-accent hover:bg-accent-light text-white text-sm font-medium px-4 py-2.5 rounded-lg transition-colors whitespace-nowrap">
                  Request a quote
                </a>
              <% } else { %>
                <a href="<%= profileUrl %>#wycena" onclick="event.stopPropagation()" class="cta-pricing inline-flex items-center justify-center bg-accent hover:bg-accent-light text-white text-sm font-medium px-4 py-2.5 rounded-lg transition-colors whitespace-nowrap">
                  Price recording
                </a>
              <% } %>
            </div>
          </div>

        </div>
      </div>
      <% }); %>
    </div>

    <!-- Załaduj więcej -->
    <div id="load-more-wrap" class="text-center mt-10">
      <button id="load-more-btn" class="bg-white hover:bg-gray-100 border border-gray-300 text-gray-700 px-8 py-3 rounded-lg font-medium transition-colors">
        Load more voice actors
      </button>
      <p id="load-more-info" class="text-sm text-gray-500 mt-3">Showing <span id="shown-count">20</span> of <span id="total-filtered">0</span></p>
    </div>

    <!-- Pusty stan -->
    <div id="no-results" class="hidden text-center py-16">
      <svg class="w-16 h-16 text-gray-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/></svg>
      <p class="text-gray-500 text-lg">No voice actors found matching your criteria</p>
      <button onclick="resetFilters()" class="mt-4 text-accent hover:text-accent-light text-sm font-medium">Clear filters</button>
    </div>

  </div><!-- /.flex-1 prawa treść -->

</div><!-- /.max-w-7xl layout -->

<script>
  (function() {
    var header = document.querySelector('header');
    var sidebar = document.getElementById('filters-sidebar');
    if (!sidebar) return;
    // Filter+contact card can be taller than the viewport. We want it to
    // scroll with the list, then freeze once its BOTTOM (contact CTA) is
    // ~24px above the screen bottom. position:sticky + dynamic top:
    //  - card fits in viewport -> top = headerH+12 (pin under header)
    //  - card taller than vh   -> negative top = vh - cardH - 24
    function setSidebarTop() {
      if (!window.matchMedia('(min-width: 768px)').matches) { sidebar.style.top = ''; return; }
      var headerH = header ? header.offsetHeight : 0;
      var topFits = headerH + 12;
      var topTall = window.innerHeight - sidebar.offsetHeight - 24;
      sidebar.style.top = Math.min(topFits, topTall) + 'px';
    }
    setSidebarTop();
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setSidebarTop);
    }
    window.addEventListener('load', setSidebarTop);
    window.addEventListener('resize', setSidebarTop);
  })();
</script>

