<%- include('../partials/head-en') %>

<!-- HERO -->
<section class="bg-gradient-to-br from-stone-100 via-white to-stone-100">
  <div class="py-5 md:py-7 max-w-5xl mx-auto px-4 text-center">
    <h1 class="text-2xl md:text-4xl font-bold text-gray-900 mb-4 leading-tight">Voice Bank</h1>
    <p class="text-lg text-gray-500 max-w-2xl mx-auto leading-relaxed"><%= voiceCount %> professional voice actors in 30+ languages - experienced voice actors, radio presenters, and voices of renowned TV stations. Use the filters, listen to samples, and find the perfect voice for your project.</p>
  </div>
</section>

<!-- MOBILE FILTERS BAR (hidden on desktop) -->
<div id="filters-bar" class="py-3 pb-4 sticky top-0 z-40 bg-white shadow-md md:hidden">
  <div class="max-w-7xl mx-auto px-4">
    <style>.filters-ready{opacity:1!important}</style>
    <div class="flex flex-wrap items-center gap-2" style="opacity:0;transition:opacity .1s" id="filters-wrap">
      <div class="flex rounded-lg overflow-hidden border border-gray-200">
        <button data-filter="gender" data-value="all" class="filter-btn active">All</button>
        <button data-filter="gender" data-value="m" class="filter-btn border-l border-gray-200">Male</button>
        <button data-filter="gender" data-value="f" class="filter-btn border-l border-gray-200">Female</button>
      </div>
      <select id="filter-lang-mobile" class="bank-filter-select" onchange="document.getElementById('filter-lang').value=this.value;applyFiltersGlobal()">
        <option value="all">Language</option>
        <option value="polski">Polish</option>
        <option value="angielski">English</option>
        <option value="niemiecki">German</option>
        <option value="rosyjski">Russian</option>
        <option value="hiszpański">Spanish</option>
        <option value="francuski">French</option>
        <option value="ukraiński">Ukrainian</option>
        <option value="włoski">Italian</option>
        <option value="portugalski">Portuguese</option>
        <option value="czeski">Czech</option>
        <option value="słowacki">Slovak</option>
        <option value="węgierski">Hungarian</option>
        <option value="holenderski">Dutch</option>
        <option value="rumuński">Romanian</option>
        <option value="turecki">Turkish</option>
        <option value="grecki">Greek</option>
        <option value="chorwacki">Croatian</option>
        <option value="serbski">Serbian</option>
        <option value="bułgarski">Bulgarian</option>
        <option value="litewski">Lithuanian</option>
        <option value="łotewski">Latvian</option>
        <option value="szwedzki">Swedish</option>
        <option value="norweski">Norwegian</option>
        <option value="duński">Danish</option>
        <option value="fiński">Finnish</option>
        <option value="hebrajski">Hebrew</option>
        <option value="arabski">Arabic</option>
        <option value="chiński">Chinese</option>
        <option value="japoński">Japanese</option>
        <option value="koreański">Korean</option>
        <option value="hindi">Hindi</option>
      </select>
      <button type="button" id="more-filters-btn" class="bank-filter-toggle" onclick="toggleMoreFilters()">
        More filters
        <svg id="more-filters-arrow" class="inline w-3 h-3 ml-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/></svg>
      </button>
    </div>
    <!-- Mobile: rozwijane dodatkowe filtry -->
    <div id="more-filters-panel" class="hidden mt-2 flex flex-wrap items-center gap-2">
      <select id="filter-age-mobile" class="bank-filter-select" onchange="document.getElementById('filter-age').value=this.value;applyFiltersGlobal()">
        <option value="all">Age</option>
        <option value="20-30">20-30 years</option>
        <option value="30-50">30-50 years</option>
        <option value="50+">50+ years</option>
      </select>
      <select id="filter-price-mobile" class="bank-filter-select" onchange="document.getElementById('filter-price').value=this.value;applyFiltersGlobal()">
        <option value="all">Price group</option>
        <option value="Niższa grupa cenowa">Lower</option>
        <option value="Wyższa grupa cenowa">Higher</option>
      </select>
      <button type="button" id="filter-famous-btn-mobile" class="bank-filter-toggle" onclick="toggleFilterPill(document.getElementById('filter-famous-btn'), 'filter-famous');this.classList.toggle('active')">Famous</button>
      <button type="button" id="filter-native-btn-mobile" class="bank-filter-toggle" onclick="toggleFilterPill(document.getElementById('filter-native-btn'), 'filter-native');this.classList.toggle('active')">Native Speakers</button>
      <div class="relative w-full mt-1">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/></svg>
        <input type="text" id="filter-search-mobile" placeholder="Search voice actor..." class="bg-white border border-gray-200 text-gray-700 text-sm rounded-lg pl-9 pr-3 w-full focus:outline-none placeholder-gray-400" style="height:38px" oninput="document.getElementById('filter-search').value=this.value;applyFiltersGlobal()">
      </div>
    </div>
  </div>
  <script>
    document.getElementById('filters-wrap').classList.add('filters-ready');
    (function() {
      var header = document.querySelector('header');
      var bar = document.getElementById('filters-bar');
      function setTops() {
        var h = header ? header.offsetHeight : 0;
        if (bar) bar.style.top = h + 'px';
      }
      // Run immediately for the bar, and after DOM is ready for the sidebar
      setTops();
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setTops);
      } else {
        setTops();
      }
      window.addEventListener('resize', setTops);
    })();
  </script>
</div>

<!-- GŁÓWNY LAYOUT: sidebar + treść -->
<div class="max-w-7xl mx-auto px-4 mt-6 pb-16 flex gap-6 items-start">

  <!-- LEWY PANEL FILTRÓW (desktop) -->
  <aside class="hidden md:flex flex-col gap-5 w-52 flex-shrink-0 md:self-stretch">

    <!-- Filter card (sticky) -->
    <div id="filters-sidebar" class="bg-white rounded-xl border border-gray-100 shadow-sm p-4 flex flex-col gap-5 sticky">

    <!-- Search -->
    <div class="relative">
      <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400 pointer-events-none" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/></svg>
