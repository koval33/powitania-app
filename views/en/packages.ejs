<%- include('../partials/head-en') %>

<%- include('../partials/page-hero', {
  heroH1: 'Voice-over packages with&nbsp;prices',
  heroSub: 'Fixed-price recording packages: phone announcements, radio and&nbsp;online spots, film narration. Online ordering and&nbsp;payment, VAT&nbsp;invoice.',
  heroCta: 'none'
}) %>

<%
  var groups = [
    { id: 'phone', title: 'Phone announcements (IVR)', desc: 'PBX messages: greetings, menus, after-hours announcements. Four sizes - from starter to a bilingual full set.', cat: 'ivr', cols: 'lg:grid-cols-4' },
    { id: 'spots', title: 'Advertising spots', desc: 'Voice-over spot recordings with a 12-month broadcast licence: local radio, nationwide radio and online campaigns.', cat: 'spot', cols: 'lg:grid-cols-3' },
    { id: 'narration', title: 'Film and presentation narration', desc: 'Voice for corporate films, presentations and e-learning, billed per standard page of script.', cat: 'narracja', cols: 'lg:grid-cols-3' }
  ];
%>

<!-- Intro + category tiles -->
<section class="py-12 md:py-16 border-b border-gray-200 bg-stone-50">
  <div class="max-w-6xl mx-auto px-4">
    <div class="max-w-3xl">
      <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-3">How the shop works</h2>
      <p class="text-gray-600 leading-relaxed">This is where you buy standardised voice-over packages at fixed prices. You order in three steps: pick the recording type and package size, listen to samples and choose your voice talent, then pay online - we deliver within 2 business days. No quotes, no email ping-pong - from browsing to ordering in minutes.</p>
    </div>
    <%
      var catTiles = [
        { anchor: '#phone', title: 'Phone announcements', img: 'zapowiedzi-telefoniczne-start-foto', cat: 'ivr' },
        { anchor: '#spots', title: 'Advertising spots', img: 'spot-radiowy-30s-stacja-lokalna-foto', cat: 'spot' },
        { anchor: '#narration', title: 'Film narration', img: 'narracja-do-filmu-1-strona-foto', cat: 'narracja' }
      ];
    %>
    <div class="grid sm:grid-cols-3 gap-5 mt-8">
      <% catTiles.forEach(function(t) {
        var items = pakiety.filter(function(p){ return p.category === t.cat; });
        var fromPrice = Math.min.apply(null, items.map(function(p){ return p.eur; }));
      %>
      <a href="<%= t.anchor %>" class="group bg-white border border-gray-200 rounded-2xl overflow-hidden shadow-sm hover:border-accent/40 hover:shadow-md transition-all hover:-translate-y-0.5">
        <img src="/img/pakiety/<%= t.img %>.webp" alt="<%= t.title %> - voice-over packages" width="800" height="800" class="w-full aspect-square object-cover" loading="lazy">
        <div class="p-5">
          <h3 class="font-bold text-gray-900 group-hover:text-accent transition-colors"><%= t.title %></h3>
          <p class="text-sm text-gray-500 mt-1"><%= items.length %> <%= items.length === 1 ? 'package' : 'packages' %> · from EUR <%= fromPrice %> net</p>
          <span class="mt-3 inline-block text-accent font-semibold text-sm">Browse</span>
        </div>
      </a>
      <% }); %>
    </div>
  </div>
</section>

<section class="py-12 md:py-16">
  <div class="max-w-6xl mx-auto px-4">
    <% groups.forEach(function(g) { var items = pakiety.filter(function(p){ return p.category === g.cat; }); if (!items.length) return; %>
    <div id="<%= g.id %>" class="mb-14 scroll-mt-28">
      <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-2"><%= g.title %></h2>
      <p class="text-gray-600 mb-6 max-w-3xl"><%= g.desc %></p>
      <div class="grid sm:grid-cols-2 <%= g.cols %> gap-5">
        <% items.forEach(function(p) { %>
        <a href="/en/packages/<%= p.slugEn %>/" class="group bg-white border border-gray-200 rounded-2xl p-6 shadow-sm hover:border-accent/40 hover:shadow-md transition-all hover:-translate-y-0.5 flex flex-col">
          <img src="/img/pakiety/<%= p.id %>-foto.webp" alt="<%= p.nameEn %>" width="800" height="800" class="w-full aspect-square object-cover rounded-xl mb-4" loading="lazy">
          <h3 class="font-bold text-gray-900 leading-snug mb-2 group-hover:text-accent transition-colors"><%= p.nameEn %></h3>
          <p class="text-sm text-gray-600 leading-relaxed mb-4 flex-1"><%= p.shortEn %></p>
          <div>
            <span class="text-2xl font-bold text-gray-900">EUR <%= p.eur %></span>
            <span class="text-gray-500 text-sm"> net</span>
            <p class="text-xs text-gray-500">Payment in PLN: <%= p.brutto %> PLN gross (incl. 23% VAT)</p>
          </div>
          <span class="mt-4 inline-flex items-center gap-1.5 text-accent font-semibold text-sm">View package
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12l-7.5 7.5M21 12H3"/></svg>
          </span>
        </a>
        <% }); %>
      </div>
    </div>
    <% }); %>

    <div class="bg-stone-50 border border-gray-200 rounded-2xl p-6 md:p-8 text-center">
      <h2 class="text-xl md:text-2xl font-bold text-gray-900 mb-2">Project outside the packages?</h2>
      <p class="text-gray-600 max-w-2xl mx-auto mb-5">Premium and celebrity voices, multi-spot campaigns, audiobooks, longer scripts and non-standard licences are quoted individually. We reply within 2 business hours.</p>
      <a href="/en/contact/#contact-form" class="inline-block bg-accent hover:bg-accent-light text-white px-7 py-3 rounded-lg font-semibold transition-colors">Request a quote</a>
    </div>
  </div>
</section>

<%- include('../partials/foot-en') %>
