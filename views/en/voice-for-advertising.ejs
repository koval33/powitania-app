<%- include('../partials/head-en') %>

<!-- Hero -->
<section class="py-10 md:py-14 bg-gradient-to-br from-stone-100 via-white to-stone-100 border-b border-gray-200">
  <div class="max-w-4xl mx-auto px-4 text-center">
    <h1 class="text-2xl md:text-4xl font-bold text-gray-900 mb-4 leading-tight">Voice for Advertising</h1>
    <p class="text-lg text-gray-500 max-w-2xl mx-auto leading-relaxed">
      Hire the most recognisable voice artists and create an advertising spot that captures your audience's attention. A professional voice and a distinctive performance mean a higher-quality commercial.
    </p>
  </div>
</section>

<!-- Most popular voice artists for advertising (PL flagship) -->
<section class="py-16 border-b border-gray-200">
  <div class="max-w-5xl mx-auto px-4">
    <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4 text-center">Most popular voice artists for advertising</h2>
    <p class="text-gray-600 text-center max-w-3xl mx-auto leading-relaxed mb-10">In our <a href="/en/voice-bank/" class="text-accent hover:underline">voice bank</a> you'll find the most recognisable voice talents in Polish advertising - voices known from hundreds of TV, radio and cinema spots. Their authority and distinctive timbre build trust from the first seconds of your commercial. The choice for brands that want immediate association with quality and prestige.</p>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% var flagPL = [
        {id: 'andrzej-ferenc', desc: 'Deep, recognisable male voice known from hundreds of Polish TV and radio commercials.', sampleUrl: '/audio/samples/Ferenc_1.mp3'},
        {id: 'jacek-brzostynski', desc: 'Charismatic, authoritative male voice - perfect for premium spots and corporate campaigns.', sampleUrl: '/audio/samples/Jacek-Brzosty%C5%84ski_spot-Nest-Bank.mp3'},
        {id: 'lukasz-nowicki', desc: 'Versatile male voice known from Polish media. Works equally well for spots and narration.', sampleUrl: '/audio/samples/Lukasz_Nowicki.mp3'},
        {id: 'przemyslaw-skowron', desc: 'Deep, dynamic male voice - frequent choice for automotive ads and emotionally driven campaigns.', sampleUrl: '/audio/samples/Skowron_1.mp3'},
        {id: 'stanislaw-olejniczak', desc: 'Legendary voice of Polish television and cinema, iconic to multiple generations of viewers.', sampleUrl: '/audio/samples/StanislawOlejniczak_21.mp3'},
        {id: 'janusz', desc: 'Experienced advertising voice talent, proven in hundreds of radio and TV spots.', sampleUrl: '/audio/samples/Janusz_demo2.mp3'}
      ]; %>
      <% flagPL.forEach(function(item) { var v = voices.find(function(x) { return x.id === item.id; }); if (v) { %>
        <div class="bg-white shadow-sm border border-gray-200 rounded-xl p-5 hover:border-accent/40 transition-all">
          <div class="flex items-center gap-4 mb-3">
            <a href="/lektorzy/<%= v.id %>/" class="group flex items-center gap-4 flex-1 min-w-0">
              <img src="<%= v.photo %>" alt="<%= v.name %>" class="w-16 h-16 rounded-full object-cover border-2 border-gray-200 flex-shrink-0" loading="lazy">
              <div class="min-w-0">
                <p class="font-bold text-gray-900 group-hover:text-accent transition-colors truncate"><%= v.name %></p>
                <p class="text-xs text-gray-500">Advertising voice</p>
              </div>
            </a>
            <% if (item.sampleUrl) { %>
            <button type="button" onclick="playSample(this, '<%= item.sampleUrl %>')" title="Listen to sample" aria-label="Listen to sample - <%= v.name %>" class="play-btn w-9 h-9 flex-shrink-0 rounded-full border-2 border-gray-900 bg-white hover:bg-gray-50 flex items-center justify-center transition-colors">
              <svg class="play-icon w-4 h-4 text-gray-900 ml-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              <svg class="pause-icon w-4 h-4 text-gray-900 hidden" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
            </button>
            <% } %>
          </div>
          <p class="text-sm text-gray-600 leading-relaxed"><%= item.desc %></p>
        </div>
      <% } }); %>
    </div>
  </div>
</section>

<!-- Native voice artists for foreign-language ads -->
<section class="py-16 bg-stone-100/60 border-b border-gray-200">
  <div class="max-w-5xl mx-auto px-4">
    <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4 text-center">Native voice artists for foreign-language ads</h2>
    <p class="text-gray-600 text-center max-w-3xl mx-auto leading-relaxed mb-10">We also produce advertising spots in foreign languages with native voice talent. The right choice for international brands, export campaigns and retail chains with multilingual messaging. Native rates are typically about 2× higher than Polish voices.</p>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% var flagNative = [
        {id: 'bill', desc: 'English (US / British) - professional native speaker for export-ready spots.', sampleUrl: '/audio/samples/BillRatner_CommercialVO.mp3'},
        {id: 'roy-2', desc: 'English - distinctive male voice. Profile includes video reels from advertising campaigns.', sampleUrl: '/audio/samples/Roy_2_commercials.mp3'},
        {id: 'jon', desc: 'English - versatile male voice, great for corporate spots and e-learning.', sampleUrl: '/audio/samples/Jon-Carter-TV-Promo-Demo.mp3'},
        {id: 'konstancja', desc: 'Native voice talent - language and tone confirmed on profile.', sampleUrl: '/audio/samples/spot_Konstancja.mp3'},
        {id: 'julien', desc: 'French - native voice for the francophone market.', sampleUrl: '/audio/samples/Julien_demo1.mp3'},
        {id: 'carla', desc: 'Native voice talent - female voice for multilingual spots, see profile.', sampleUrl: '/audio/samples/Carla_commercial.mp3'}
      ]; %>
      <% flagNative.forEach(function(item) { var v = voices.find(function(x) { return x.id === item.id; }); if (v) { %>
        <div class="bg-white shadow-sm border border-gray-200 rounded-xl p-5 hover:border-accent/40 transition-all">
          <div class="flex items-center gap-4 mb-3">
            <a href="/lektorzy/<%= v.id %>/" class="group flex items-center gap-4 flex-1 min-w-0">
              <img src="<%= v.photo %>" alt="<%= v.name %>" class="w-16 h-16 rounded-full object-cover border-2 border-gray-200 flex-shrink-0" loading="lazy">
              <div class="min-w-0">
                <p class="font-bold text-gray-900 group-hover:text-accent transition-colors truncate"><%= v.name %></p>
                <p class="text-xs text-gray-500">Native voice</p>
              </div>
            </a>
            <% if (item.sampleUrl) { %>
            <button type="button" onclick="playSample(this, '<%= item.sampleUrl %>')" title="Listen to sample" aria-label="Listen to sample - <%= v.name %>" class="play-btn w-9 h-9 flex-shrink-0 rounded-full border-2 border-gray-900 bg-white hover:bg-gray-50 flex items-center justify-center transition-colors">
              <svg class="play-icon w-4 h-4 text-gray-900 ml-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              <svg class="pause-icon w-4 h-4 text-gray-900 hidden" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
            </button>
            <% } %>
          </div>
          <p class="text-sm text-gray-600 leading-relaxed"><%= item.desc %></p>
        </div>
      <% } }); %>
    </div>

    <div class="text-center mt-8">
      <a href="/en/voice-bank/?native=1" class="text-accent hover:text-accent-light font-medium text-sm">Browse all native voice artists &rarr;</a>
    </div>
  </div>
</section>

