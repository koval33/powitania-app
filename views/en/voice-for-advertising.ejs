<%- include('../partials/head-en') %>

<!-- Hero -->
<section class="py-10 md:py-14 bg-gradient-to-br from-stone-100 via-white to-stone-100 border-b border-gray-200">
  <div class="max-w-4xl mx-auto px-4 text-center">
    <div class="inline-flex items-center gap-2 bg-red-500/10 text-red-500 px-4 py-1.5 rounded-full text-sm font-medium mb-4">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.114 5.636a9 9 0 010 12.728M16.463 8.288a5.25 5.25 0 010 7.424M6.75 8.25l4.72-4.72a.75.75 0 011.28.53v15.88a.75.75 0 01-1.28.53l-4.72-4.72H4.51c-.88 0-1.704-.507-1.938-1.354A9.01 9.01 0 012.25 12c0-.83.112-1.633.322-2.396C2.806 8.756 3.63 8.25 4.51 8.25H6.75z"/></svg>
      Voiceover Services
    </div>
    <h1 class="text-3xl md:text-5xl font-bold text-gray-900 mb-4 leading-tight">Voice for Advertising</h1>
    <p class="text-lg text-gray-500 max-w-2xl mx-auto leading-relaxed">
      Hire the most recognisable voice artists and create an advertising spot that captures your audience's attention. A professional voice artist and a distinctive voice mean a higher-quality commercial.
    </p>
  </div>
</section>

