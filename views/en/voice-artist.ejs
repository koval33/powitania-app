<%- include('../partials/head-en') %>

<section class="py-10 md:py-16 bg-stone-100/80">
  <div class="max-w-5xl mx-auto px-4">

    <!-- Breadcrumb -->
    <nav class="text-sm mb-8">
      <a href="/en/" class="text-gray-500 hover:text-gray-900 transition-colors">Home</a>
      <span class="text-gray-400 mx-2">/</span>
      <a href="/en/voice-bank/" class="text-gray-500 hover:text-gray-900 transition-colors">Voice Bank</a>
      <span class="text-gray-400 mx-2">/</span>
      <span class="text-gray-600"><%= lektor.name %></span>
    </nav>

    <!-- Profil: zdjęcie + info -->
    <div class="flex flex-col md:flex-row gap-8 md:gap-12">

      <!-- Lewa kolumna: zdjęcie + tagi -->
      <div class="flex-shrink-0">
        <div class="w-48 h-48 md:w-56 md:h-56 rounded-2xl overflow-hidden border-2 border-gray-200 mx-auto md:mx-0">
          <img src="<%= lektor.photo %>" alt="<%= lektor.name %>" class="w-full h-full object-cover">
        </div>
        <div class="flex flex-wrap gap-2 mt-4 justify-center md:justify-start">
          <% if (lektor.famous) { %>
            <span class="bg-yellow-50 text-yellow-700 text-xs font-semibold px-3 py-1 rounded-full border border-yellow-300">Celebrity</span>
          <% } %>
          <% if (lektor.native) { %>
            <span class="bg-blue-50 text-blue-700 text-xs font-semibold px-3 py-1 rounded-full border border-blue-300">Native speaker</span>
          <% } %>
          <span class="bg-gray-50 text-gray-500 text-xs font-medium px-3 py-1 rounded-full border border-gray-200">
            <%= lektor.gender === 'm' ? 'Male' : 'Female' %>
          </span>
          <span class="bg-gray-50 text-gray-500 text-xs font-medium px-3 py-1 rounded-full border border-gray-200">
            <%= lektor.age %>
          </span>
        </div>

        <% if (!lektor.hidePrice && lektor.prices) { %>
        <div class="mt-5 space-y-1.5 text-xs text-gray-500">
          <%# UWAGA: lektor.prices przychodza JUZ przekonwertowane na EUR przez convertPricesToEur() w server.js. Nie konwertuj ponownie! %>
          <% if (lektor.prices.ivr_100) { %>
          <div class="flex justify-between"><span>Phone Announcement</span><span class="font-semibold text-gray-800">from <%= lektor.prices.ivr_100 %> EUR</span></div>
          <% } %>
          <% if (lektor.prices.spot_social_1min) { %>
          <div class="flex justify-between"><span>Social Media</span><span class="font-semibold text-gray-800">from <%= lektor.prices.spot_social_1min %> EUR</span></div>
          <% } %>
          <% if (lektor.prices.spot_radio_local) { %>
          <div class="flex justify-between"><span>Ad Spot</span><span class="font-semibold text-gray-800">from <%= lektor.prices.spot_radio_local %> EUR</span></div>
          <% } %>
          <% if (lektor.prices.narration_1page) { %>
          <div class="flex justify-between"><span>Narration / film</span><span class="font-semibold text-gray-800">from <%= lektor.prices.narration_1page %> EUR</span></div>
          <% } %>
        </div>
        <% } %>
      </div>

      <!-- Prawa kolumna: dane -->
      <div class="flex-1 min-w-0">
        <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-3"><%= lektor.name %></h1>

        <% if (lektor.descriptionEn || lektor.description) { %>
          <p class="text-gray-500 leading-relaxed mb-4"><%= lektor.descriptionEn || lektor.description %></p>
        <% } %>

        <!-- Meta info - kompaktowo -->
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1.5 text-sm text-gray-500 mb-4">
          <span><%= lektor.languages.join(', ') %></span>
          <span class="text-gray-400">·</span>
          <span>Turnaround: <span class="text-gray-900"><%= lektor.turnaround || '24-48h' %></span></span>
          <% if (lektor.applications && lektor.applications.length > 0) { %>
          <span class="text-gray-400">·</span>
          <% lektor.applications.forEach(function(app) { %>
            <span class="text-xs bg-accent/10 text-accent px-2 py-0.5 rounded-full"><%= app %></span>
          <% }); %>
          <% } %>
        </div>

        <!-- AUDIO SAMPLES - order from admin panel (after ↑↓ reorder). -->
        <%
          var allAudio = [];
          var videoSamples = [];
          (lektor.samples || []).forEach(function(s) {
            if (!s.url) return;
            var isVideo = s.url.includes('youtu') || s.url.includes('vimeo');
            if (isVideo) videoSamples.push(s);
            else allAudio.push(s);
          });
        %>

        <% if (allAudio.length > 0) { %>
        <div class="space-y-2 mb-5">
          <% allAudio.forEach(function(sample, idx) { %>
          <div class="sample-row bg-white shadow-sm rounded-lg border border-gray-200 overflow-hidden">
            <div class="flex items-center gap-3 p-3">
              <button class="sample-play-btn w-9 h-9 flex-shrink-0 rounded-full border-2 border-gray-900 bg-white hover:bg-gray-50 flex items-center justify-center transition-colors" data-audio="<%= sample.url %>">
                <svg class="play-icon w-4 h-4 text-gray-900 ml-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                <svg class="pause-icon w-4 h-4 text-gray-900 hidden" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
              </button>
              <div class="flex-1 min-w-0">
                <div class="text-sm text-gray-900 font-medium truncate mb-1"><%= sample.name || ('Sample ' + (idx + 1)) %></div>
                <div class="audio-progress w-full h-1.5 bg-gray-100 rounded-full overflow-hidden cursor-pointer">
                  <div class="audio-bar h-full bg-accent rounded-full transition-all" style="width: 0%"></div>
                </div>
                <div class="flex justify-between mt-0.5">
                  <span class="audio-time text-xs text-gray-500">0:00</span>
                  <span class="audio-duration text-xs text-gray-500">--:--</span>
                </div>
              </div>
              <a href="<%= sample.url %>" download title="Download MP3" class="w-8 h-8 flex-shrink-0 flex items-center justify-center rounded-full text-gray-500 hover:text-gray-900 hover:bg-gray-100 transition-colors">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
              </a>
            </div>
          </div>
          <% }); %>
        </div>
        <% } %>

        <!-- Banner ekspresowy -->
        <% if (typeof isExpress !== 'undefined' && isExpress) { %>
        <div class="bg-yellow-50 border border-yellow-400/30 rounded-xl px-4 py-3 mb-3 flex items-center gap-2 text-sm">
          <svg class="w-4 h-4 text-yellow-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.381z" clip-rule="evenodd"/></svg>
          <span class="text-yellow-800"><strong>Express recording</strong> - rates include priority delivery</span>
        </div>
        <% } %>

        <!-- CTA (only for hidePrice - links to inquiry form) -->
        <% if (lektor.hidePrice) { %>
        <div id="lektor-cta-section" class="flex flex-col gap-3">
          <a href="#zapytanie" class="bg-accent hover:bg-accent-light text-white px-6 py-3 rounded-lg font-semibold text-center transition-colors inline-flex items-center justify-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
            Request a quote
          </a>
        </div>
        <% } %>

        <!-- INTELIGENTNY WIZARD WYCENY (widoczny gdy kontekst z kreatora) -->
        <div id="pricing-wizard" class="mt-6 hidden">
          <div class="bg-white shadow-sm rounded-2xl border-2 border-accent/30 p-6">
            <div class="flex items-center justify-between mb-4">
              <div class="flex items-center gap-2.5 flex-wrap">
                <svg class="w-6 h-6 text-accent flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                <h3 class="text-lg font-bold text-gray-900">Recording Quote</h3>
                <span id="wizard-subtitle" class="text-sm text-gray-500 hidden"></span>
              </div>
              <button onclick="clearPricingContext()" class="text-gray-500 hover:text-gray-900 transition-colors" title="Close">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
              </button>
            </div>
            <!-- Podgląd tekstu -->
            <div class="bg-gray-50 rounded-lg p-3 mb-4">
              <div class="flex items-center justify-between mb-1">
                <span class="text-xs text-gray-500">Your script:</span>
                <span id="wizard-word-count" class="text-xs text-accent font-medium"></span>
              </div>
              <div id="wizard-text-preview" class="text-gray-600 text-sm leading-relaxed max-h-24 overflow-y-auto"></div>
            </div>
            <!-- Typ nagrania (jeśli nie przyszedł z kreatora) -->
            <div id="wizard-service-type" class="hidden mb-4">
              <label class="block text-gray-900 font-semibold mb-2 text-sm">Recording Type</label>
              <select id="wizard-service-select" onchange="updateWizardPricing()" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-3 text-gray-900 focus:border-accent focus:outline-none">
                <option value="">- select recording type -</option>
                <option value="ivr">Phone Announcements (IVR)</option>
                <option value="radio">Radio Commercial</option>
                <option value="tv">TV Commercial</option>
                <option value="social">Social Media Campaign</option>
                <option value="elearning">E-learning / Training</option>
                <option value="film">Film Narration</option>
                <option value="audiobook">Audiobook</option>
                <option value="podcast">Podcast (intro/outro)</option>
              </select>
            </div>
            <!-- Dynamiczne pytania per serviceType -->
            <div id="wizard-questions"></div>
            <!-- Wycena -->
            <div id="wizard-pricing" class="hidden"></div>
            <!-- CTA + formularz zamówienia - pojawi się dopiero po wycenie -->
            <div id="wizard-cta" class="hidden mt-5">

              <!-- Formularz PEŁNY (zamówienie - widoczny gdy jest cena) -->
              <div id="wizard-order-form" class="border-t border-gray-200 pt-4">
                <h4 class="text-gray-900 font-bold mb-4 flex items-center gap-2">
                  <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/></svg>
                  Order details
                </h4>
                <div class="space-y-3">
                  <div class="grid sm:grid-cols-2 gap-3">
                    <div>
                      <label class="block text-gray-900 text-sm font-medium mb-1">Company Name *</label>
                      <input type="text" id="wiz-firmName" required class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none text-sm" placeholder="Company Ltd.">
                    </div>
                    <div>
                      <label class="block text-gray-900 text-sm font-medium mb-1">Tax ID</label>
                      <input type="text" id="wiz-nip" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none text-sm" placeholder="Tax ID number">
                    </div>
                  </div>
                  <div class="order-fields-3col">
                    <div>
                      <label class="block text-gray-900 text-sm font-medium mb-1">Full Name *</label>
                      <input type="text" id="wiz-name" required class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none text-sm" placeholder="John Smith">
                    </div>
                    <div>
                      <label class="block text-gray-900 text-sm font-medium mb-1">Email *</label>
                      <input type="email" id="wiz-email" required class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none text-sm" placeholder="john@company.com">
                    </div>
                    <div>
                      <label class="block text-gray-900 text-sm font-medium mb-1">Phone</label>
                      <input type="tel" id="wiz-phone" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none text-sm" placeholder="+48 600 000 000">
                    </div>
                  </div>
                </div>
                <button id="wiz-submit-btn" onclick="submitWizardOrder()" class="bg-accent hover:bg-accent-light text-white px-6 py-3 rounded-lg font-semibold w-full transition-colors mt-4">
                  Order Recording
                </button>
                <div id="wizard-order-msg" class="hidden text-center text-sm mt-2"></div>
                <button onclick="showWizardInquiry()" class="w-full mt-2 px-6 py-2.5 rounded-lg border border-gray-300 hover:border-accent text-gray-600 hover:text-accent text-sm font-medium transition-colors text-center">
                  Ask for details
                </button>
              </div>

              <!-- Formularz PROSTY (kontakt - widoczny przy wycenie indywidualnej) -->
              <div id="wizard-inquiry-form" class="border-t border-gray-200 pt-4 hidden">
                <h4 class="text-gray-900 font-bold mb-4 flex items-center gap-2">
                  <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
                  Request a quote
                </h4>
                <div class="space-y-3">
                  <div>
                    <label class="block text-gray-900 text-sm font-medium mb-1">Email *</label>
                    <input type="email" id="wiz-inq-email" required class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none text-sm" placeholder="john@company.com">
                  </div>
                  <div>
                    <label class="block text-gray-900 text-sm font-medium mb-1">Full Name</label>
                    <input type="text" id="wiz-inq-name" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none text-sm" placeholder="John Smith">
                  </div>
                  <div>
                    <label class="block text-gray-900 text-sm font-medium mb-1">Message</label>
                    <textarea id="wiz-inq-message" rows="3" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none text-sm resize-y" placeholder="Additional information, questions..."></textarea>
                  </div>
                </div>
                <button id="wiz-inq-submit-btn" onclick="submitWizardInquiry()" class="bg-accent hover:bg-accent-light text-white px-6 py-3 rounded-lg font-semibold w-full transition-colors mt-4">
                  Send Inquiry
                </button>
                <div id="wizard-inquiry-msg" class="hidden text-center text-sm mt-2"></div>
              </div>

            </div>
          </div>
        </div>

        <!-- INLINE: Quote for recording -->
        <% if (!lektor.hidePrice) { %>
        <div id="wycena" class="mt-6 scroll-mt-[10rem]">
          <div class="bg-white shadow-sm rounded-2xl border-2 border-accent/20 p-6">
            <h2 class="text-2xl font-bold text-gray-900 mb-1">
              Get a quote - <%= lektor.name %>
            </h2>
            <p class="text-base text-gray-900 mb-4"><strong class="font-semibold">Click the recording type</strong> <span class="text-accent font-semibold text-lg align-middle" aria-hidden="true">↓</span> the price will be calculated instantly.</p>

            <!-- Hidden service select -->
            <select id="modal-service-select" class="hidden">
              <option value="">- select recording type -</option>
              <option value="ivr">Phone Announcement (IVR)</option>
              <option value="social">Social Media</option>
              <option value="radio">Ad Spot</option>
              <option value="film">Narration</option>
            </select>

            <!-- 4 tile buttons -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
              <button type="button" class="svc-btn relative border-2 border-gray-200 rounded-xl px-4 py-4 text-left transition-all hover:border-accent hover:bg-accent/5 hover:-translate-y-0.5 hover:shadow-md" data-select="modal-service-select" data-value="ivr" onclick="pickService(this)">
                <span class="block text-sm font-semibold text-gray-800 leading-tight">Phone Ann.</span>
                <span class="block text-xs text-gray-400 mt-1">IVR / phone system</span>
              </button>
              <button type="button" class="svc-btn relative border-2 border-gray-200 rounded-xl px-4 py-4 text-left transition-all hover:border-accent hover:bg-accent/5 hover:-translate-y-0.5 hover:shadow-md" data-select="modal-service-select" data-value="social" onclick="pickService(this)">
                <span class="block text-sm font-semibold text-gray-800 leading-tight">Social Media</span>
                <span class="block text-xs text-gray-400 mt-1">online / digital</span>
              </button>
              <button type="button" class="svc-btn relative border-2 border-gray-200 rounded-xl px-4 py-4 text-left transition-all hover:border-accent hover:bg-accent/5 hover:-translate-y-0.5 hover:shadow-md" data-select="modal-service-select" data-value="radio" onclick="pickService(this)">
                <span class="block text-sm font-semibold text-gray-800 leading-tight">Ad Spot</span>
                <span class="block text-xs text-gray-400 mt-1">radio / TV</span>
              </button>
              <button type="button" class="svc-btn relative border-2 border-gray-200 rounded-xl px-4 py-4 text-left transition-all hover:border-accent hover:bg-accent/5 hover:-translate-y-0.5 hover:shadow-md" data-select="modal-service-select" data-value="film" onclick="pickService(this)">
                <span class="block text-sm font-semibold text-gray-800 leading-tight">Narration</span>
                <span class="block text-xs text-gray-400 mt-1">film / e-learning</span>
              </button>
            </div>

            <div>
              <div id="modal-step-text">
                <textarea id="modal-text-input" rows="5" placeholder="Paste your recording script here..." class="w-full bg-white border border-gray-300 rounded-lg px-4 py-3 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none resize-y mb-1"></textarea>
                <div class="flex items-center justify-between mb-3">
                  <button onclick="goToKreatorWithLektor()" class="text-accent hover:text-accent-light font-medium hover:underline inline-flex items-center gap-1 text-sm">
                    I need a script - generate with AI Creator
                  </button>
                  <p id="modal-word-count" class="text-xs text-gray-400"></p>
                </div>

                <!-- Dynamic questions per serviceType -->
                <div id="modal-questions"></div>

                <!-- Inline pricing -->
                <div id="modal-pricing" class="hidden"></div>

                <!-- Order form after pricing -->
                <div id="modal-order-cta" class="hidden mt-4">
                  <div class="border-t border-gray-200 pt-4">
                    <h4 class="text-gray-900 font-bold mb-4 flex items-center gap-2">
                      <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/></svg>
                      Order Details
                    </h4>
                    <div class="space-y-3">
                      <div class="grid sm:grid-cols-2 gap-3">
                        <div>
                          <label class="block text-gray-900 text-sm font-medium mb-1">Company Name *</label>
                          <input type="text" id="mod-firmName" required class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none text-sm" placeholder="Company Ltd.">
                        </div>
                        <div>
                          <label class="block text-gray-900 text-sm font-medium mb-1">Tax ID</label>
                          <input type="text" id="mod-nip" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none text-sm" placeholder="Tax ID number">
                        </div>
                      </div>
                      <div class="order-fields-3col">
                        <div>
                          <label class="block text-gray-900 text-sm font-medium mb-1">Full Name *</label>
                          <input type="text" id="mod-name" required class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none text-sm" placeholder="John Smith">
                        </div>
                        <div>
                          <label class="block text-gray-900 text-sm font-medium mb-1">Email *</label>
                          <input type="email" id="mod-email" required class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none text-sm" placeholder="john@company.com">
                        </div>
                        <div>
                          <label class="block text-gray-900 text-sm font-medium mb-1">Phone</label>
                          <input type="tel" id="mod-phone" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none text-sm" placeholder="+48 600 000 000">
                        </div>
                      </div>
                    </div>
                    <button id="mod-submit-btn" onclick="submitModalOrder()" class="bg-accent hover:bg-accent-light text-white px-6 py-3 rounded-lg font-semibold w-full transition-colors mt-4">
                      Order Recording
                    </button>
                    <div id="modal-order-msg" class="hidden text-center text-sm mt-2"></div>
                    <p class="text-center text-sm text-gray-500 mt-3">Have questions? <button type="button" onclick="showModalInquiry()" class="text-accent hover:text-accent-light font-medium">Ask for details</button></p>
                  </div>
                </div>

                <!-- Inquiry form inside #wycena -->
                <div id="modal-inquiry-form" class="hidden mt-4">
                  <div class="border-t border-gray-200 pt-4">
                    <h4 class="text-gray-900 font-bold mb-4 flex items-center gap-2">
                      <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
                      Ask for details
                    </h4>
                    <div class="space-y-3">
                      <div>
                        <label class="block text-gray-900 text-sm font-medium mb-1">Email *</label>
                        <input type="email" id="mod-inq-email" required class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none text-sm" placeholder="john@company.com">
                      </div>
                      <div>
                        <label class="block text-gray-900 text-sm font-medium mb-1">Full Name</label>
                        <input type="text" id="mod-inq-name" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none text-sm" placeholder="John Smith">
                      </div>
                      <div>
                        <label class="block text-gray-900 text-sm font-medium mb-1">Message</label>
                        <textarea id="mod-inq-message" rows="3" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none text-sm resize-y" placeholder="Additional information, questions..."></textarea>
                      </div>
                    </div>
                    <button id="mod-inq-submit-btn" onclick="submitModalInquiry()" class="bg-accent hover:bg-accent-light text-white px-6 py-3 rounded-lg font-semibold w-full transition-colors mt-4">
                      Send Inquiry
                    </button>
                    <div id="modal-inquiry-msg" class="hidden text-center text-sm mt-2"></div>
                    <p class="text-center text-sm text-gray-500 mt-3"><button type="button" onclick="showModalOrder()" class="text-accent hover:text-accent-light font-medium">← Back to order</button></p>
                  </div>
                </div>

              </div>
            </div>
          </div>
        </div><!-- /#wycena -->
        <% } %>

      </div>
    </div>

    <!-- VIDEO (pełna szerokość, pod profilem) -->
    <%
      var videoSamples = (lektor.samples || []).filter(function(s) {
        return s.url && (s.url.includes('youtu') || s.url.includes('vimeo'));
      });
    %>

    <% if (videoSamples.length > 0) { %>
    <div class="mt-10">
      <h3 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
        <svg class="w-5 h-5 text-red-500" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814z"/><path fill="#fff" d="M9.545 15.568V8.432L15.818 12z"/></svg>
        Video Productions
      </h3>
      <div class="grid sm:grid-cols-2 gap-4">
        <% videoSamples.forEach(function(video) {
          var ytId = '';
          var url = video.url || '';
          if (url.includes('youtu.be/')) {
            ytId = url.split('youtu.be/')[1].split(/[?&#]/)[0];
          } else if (url.includes('youtube.com/watch')) {
            var match = url.match(/[?&]v=([^&#]+)/);
            if (match) ytId = match[1];
          } else if (url.includes('youtube.com/shorts/')) {
            ytId = url.split('shorts/')[1].split(/[?&#]/)[0];
          }
        %>
        <div class="bg-white shadow-sm rounded-xl border border-gray-200 overflow-hidden group">
          <% if (ytId) { %>
          <div style="position:relative;padding-bottom:56.25%;height:0;overflow:hidden" class="cursor-pointer bg-black" data-vid="<%= ytId %>" onclick="loadYT(this)">
            <img src="https://img.youtube.com/vi/<%= ytId %>/mqdefault.jpg" alt="<%= video.name %>" style="position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover">
            <div style="position:absolute;top:0;left:0;width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.4)">
              <div style="width:56px;height:56px;background:#dc2626;border-radius:50%;display:flex;align-items:center;justify-content:center">
                <svg style="width:24px;height:24px;color:#fff;margin-left:3px" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              </div>
            </div>
          </div>
          <% } else { %>
          <div style="position:relative;padding-bottom:56.25%;height:0;overflow:hidden;background:#f9fafb">
            <a href="<%= video.url %>" target="_blank" rel="noopener" style="position:absolute;top:0;left:0;width:100%;height:100%;display:flex;align-items:center;justify-content:center" class="text-accent hover:text-accent-light">
              <svg style="width:48px;height:48px" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/></svg>
            </a>
          </div>
          <% } %>
          <div class="p-3">
            <div class="text-sm text-gray-900 font-medium"><%= video.name %></div>
          </div>
        </div>
        <% }); %>
      </div>
    </div>
    <% } %>

    <!-- FORMULARZ ZAPYTANIA (dla lektorów z hidePrice) -->
    <% if (lektor.hidePrice) { %>
    <div class="mt-12 scroll-mt-[8rem]" id="zapytanie">
      <div class="max-w-2xl mx-auto bg-white shadow-sm rounded-2xl border border-gray-200 p-8">
        <div class="flex items-center gap-4 mb-6">
          <% if (lektor.photo) { %>
            <img src="<%= lektor.photo %>" alt="<%= lektor.name %>" class="w-14 h-14 rounded-full object-cover border-2 border-gray-200 flex-shrink-0">
          <% } %>
          <div class="min-w-0">
            <div class="text-xs text-gray-500 uppercase tracking-wider font-medium mb-0.5">Inquiry about production</div>
            <h2 class="text-xl md:text-2xl font-bold text-gray-900 truncate"><%= lektor.name %></h2>
          </div>
        </div>
        <p class="text-gray-600 leading-relaxed mb-8">
          The artist's participation in the project is confirmed individually. Please provide as much detail as possible about the project (recording type, usage rights, license duration) and we will get back to you with availability and pricing.
        </p>
        <hr class="border-gray-200 mb-8">

        <form id="inquiry-form" enctype="multipart/form-data">
          <input type="hidden" name="lektorName" value="<%= lektor.name %>">
          <input type="hidden" name="lektorId" value="<%= lektor.id %>">

          <div class="mb-6">
            <label class="block text-gray-900 font-semibold mb-2">Project Description</label>
            <textarea name="description" rows="5" required
              class="w-full bg-white border border-gray-300 rounded-xl px-4 py-3 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none resize-y transition-colors"
              placeholder="Project details: recording type, usage rights, license duration..."></textarea>
          </div>

          <div class="mb-6">
            <label class="block text-gray-900 font-semibold mb-2">Email:</label>
            <input type="email" name="email" required
              class="w-full bg-white border border-gray-300 rounded-xl px-4 py-3 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none transition-colors"
              placeholder="your@email.com">
          </div>

          <div class="mb-6">
            <label class="block text-gray-500 text-sm mb-2">Attachment <span class="text-gray-400">(optional)</span></label>
            <label class="flex items-center gap-3 cursor-pointer border border-dashed border-gray-300 rounded-xl px-4 py-3 hover:border-gray-400 hover:bg-gray-50 transition-colors">
              <svg class="w-5 h-5 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"/></svg>
              <span class="text-gray-400 text-sm truncate file-label">Attach file (PDF, DOC, MP3, WAV, ZIP)</span>
              <input type="file" name="attachment" class="hidden" accept=".pdf,.doc,.docx,.txt,.rtf,.odt,.mp3,.wav,.zip" onchange="updateFileLabel(this)">
            </label>
          </div>

          <div class="flex justify-end">
            <button type="submit" id="inquiry-submit"
              class="bg-accent hover:bg-accent-light text-white px-8 py-3 rounded-lg font-bold text-sm uppercase tracking-wider transition-colors">
              Send Inquiry
            </button>
          </div>

          <div id="inquiry-msg" class="mt-4 text-center hidden"></div>
        </form>
      </div>
    </div>
    <% } %>

    <!-- FAQ -->
    <div class="mt-16">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">Frequently Asked Questions</h2>
      <div class="space-y-3 max-w-3xl">

        <%
          var displayNameEn = lektor.name.replace(/\s+\d+$/, '').trim();
          var _faqTurnaroundEn = lektor.turnaround || (lektor.hidePrice ? '4 business days' : null);
          // PL → EN maps for languages and applications (shared with schema below)
          var _faqLangMap = {
            'polski': 'Polish', 'angielski': 'English', 'niemiecki': 'German', 'hiszpański': 'Spanish',
            'francuski': 'French', 'włoski': 'Italian', 'rosyjski': 'Russian', 'ukraiński': 'Ukrainian',
            'czeski': 'Czech', 'słowacki': 'Slovak', 'portugalski': 'Portuguese', 'arabski': 'Arabic',
            'chiński': 'Chinese', 'japoński': 'Japanese', 'koreański': 'Korean', 'hindi': 'Hindi',
            'turecki': 'Turkish', 'fiński': 'Finnish', 'norweski': 'Norwegian', 'duński': 'Danish',
            'szwedzki': 'Swedish', 'islandzki': 'Icelandic', 'estoński': 'Estonian', 'litewski': 'Lithuanian',
            'łotewski': 'Latvian', 'węgierski': 'Hungarian', 'bułgarski': 'Bulgarian', 'słoweński': 'Slovenian',
            'holenderski': 'Dutch', 'flamandzki': 'Flemish', 'tajski': 'Thai', 'hebrajski': 'Hebrew',
            'rumuński': 'Romanian', 'grecki': 'Greek', 'wietnamski': 'Vietnamese'
          };
          var _faqAppMap = {
            'Reklama': 'commercials', 'Narracja do filmu': 'film narration', 'Audiobook': 'audiobooks',
            'Dubbing': 'dubbing', 'Powitanie tel.': 'phone announcements / IVR', 'Dokument': 'documentaries',
            'Bajka': 'children\u2019s stories', 'E-learning': 'e-learning', 'Podcast': 'podcasts',
            'Komentarz': 'voice-over commentary', 'Animacja': 'animation', 'Gra komputerowa': 'video games'
          };
          function _faqTranslateLangs(arr) {
            return (arr || []).map(function(l) { return _faqLangMap[l] || l; }).join(', ');
          }
          function _faqTranslateApps(arr) {
            return (arr || []).map(function(a) { return _faqAppMap[a] || a.toLowerCase(); }).join(', ');
          }
          var _faqNativeLang = lektor.native
            ? (lektor.nativeLanguage ? (_faqLangMap[lektor.nativeLanguage.toLowerCase()] || lektor.nativeLanguage) : _faqTranslateLangs((lektor.languages || []).slice(0, 1)))
            : 'Polish';
        %>

        <% if (_faqTurnaroundEn) { %>
        <details class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
          <summary class="flex items-center justify-between px-6 py-4 cursor-pointer font-semibold text-gray-900 select-none" style="list-style:none">
            <span>How quickly will <%= displayNameEn %> deliver the recording?</span>
            <svg class="w-5 h-5 flex-shrink-0 ml-3 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/></svg>
          </summary>
          <div class="px-6 pb-5 text-gray-600 leading-relaxed">Standard turnaround is <strong><%= _faqTurnaroundEn %></strong>. Short advertising formats (up to 30 seconds) are often ready the same day. Longer projects are quoted individually with a timeline agreed with the client.</div>
        </details>
        <% } %>

        <% if (!lektor.hidePrice) { %>
        <details class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
          <summary class="flex items-center justify-between px-6 py-4 cursor-pointer font-semibold text-gray-900 select-none" style="list-style:none">
            <span>How do I order a voice-over recording?</span>
            <svg class="w-5 h-5 flex-shrink-0 ml-3 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/></svg>
          </summary>
          <div class="px-6 pb-5 text-gray-600 leading-relaxed">You can get an instant quote and place an order using the form above. If you have any questions, email us at <a href="mailto:biuro@powitania.pl" class="text-accent hover:underline">biuro@powitania.pl</a> or call <a href="tel:+48605491069" class="text-accent hover:underline">+48 605 491 069</a>.</div>
        </details>

        <details class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
          <summary class="flex items-center justify-between px-6 py-4 cursor-pointer font-semibold text-gray-900 select-none" style="list-style:none">
            <span>Is a free sample available?</span>
            <svg class="w-5 h-5 flex-shrink-0 ml-3 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/></svg>
          </summary>
          <div class="px-6 pb-5 text-gray-600 leading-relaxed">On request we deliver a free, dedicated voice sample based on your script. Ready-made audio samples are also available on this profile for you to listen to right away.</div>
        </details>
        <% } %>

        <% if (lektor.languages && lektor.languages.length > 0) { %>
        <details class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
          <summary class="flex items-center justify-between px-6 py-4 cursor-pointer font-semibold text-gray-900 select-none" style="list-style:none">
            <span>Which languages does <%= displayNameEn %> record in?</span>
            <svg class="w-5 h-5 flex-shrink-0 ml-3 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/></svg>
          </summary>
          <div class="px-6 pb-5 text-gray-600 leading-relaxed"><strong><%= displayNameEn %></strong> records in <strong><%= _faqTranslateLangs(lektor.languages) %></strong>. Native language: <strong><%= _faqNativeLang %></strong>.</div>
        </details>
        <% } %>

        <% if (lektor.applications && lektor.applications.length > 0) { %>
        <details class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
          <summary class="flex items-center justify-between px-6 py-4 cursor-pointer font-semibold text-gray-900 select-none" style="list-style:none">
            <span>What does <%= displayNameEn %> specialise in?</span>
            <svg class="w-5 h-5 flex-shrink-0 ml-3 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/></svg>
          </summary>
          <div class="px-6 pb-5 text-gray-600 leading-relaxed"><strong><%= displayNameEn %></strong> specialises in: <strong><%= _faqTranslateApps(lektor.applications) %></strong>. Details and audio samples are available above.</div>
        </details>
        <% } %>

      </div>
    </div>

    <!-- CENNIK usunięty - ceny pod zdjęciem i w formularzu wyceny -->
    <% if (false && !lektor.hidePrice && lektor.prices) { %>
    <div class="mt-12" id="lektor-cennik-section">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">Pricing</h2>

      <div class="grid md:grid-cols-3 gap-6">

        <!-- Powitanie / IVR -->
        <% if (lektor.prices.ivr_100) { %>
        <div class="bg-white rounded-xl border border-gray-200 shadow-md p-6">
          <div class="flex items-center gap-2 mb-4">
            <div class="w-8 h-8 bg-emerald-600/10 rounded-lg flex items-center justify-center">
              <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg>
            </div>
            <h3 class="text-gray-900 font-bold">Phone Greeting / IVR</h3>
          </div>
          <table class="w-full text-sm">
            <tbody class="divide-y divide-gray-200">
              <tr>
                <td class="py-2 text-gray-500">up to 100 words</td>
                <td class="py-2 text-right text-gray-900 font-semibold"><%= lektor.prices.ivr_100 %> EUR net</td>
              </tr>
              <% if (lektor.prices.ivr_200) { %>
              <tr>
                <td class="py-2 text-gray-500">101-200 words</td>
                <td class="py-2 text-right text-gray-900 font-semibold"><%= lektor.prices.ivr_200 %> EUR net</td>
              </tr>
              <% } %>
              <% if (lektor.prices.ivr_200plus && lektor.prices.ivr_200plus !== 'wycena') { %>
              <tr>
                <td class="py-2 text-gray-500">over 200 words</td>
                <td class="py-2 text-right text-gray-900 font-semibold"><%= lektor.prices.ivr_200plus %> EUR net</td>
              </tr>
              <% } else { %>
              <tr>
                <td class="py-2 text-gray-500">over 200 words</td>
                <td class="py-2 text-right text-accent text-xs font-medium">custom quote</td>
              </tr>
              <% } %>
              <% if (lektor.prices.ivr_guarantee_100) { %>
              <tr>
                <td class="py-2 text-gray-500 text-xs">Modification guarantee up to 100 words</td>
                <td class="py-2 text-right text-gray-600 text-xs"><%= lektor.prices.ivr_guarantee_100 %> EUR net</td>
              </tr>
              <% } %>
              <% if (lektor.prices.ivr_guarantee_100plus) { %>
              <tr>
                <td class="py-2 text-gray-500 text-xs">Modification guarantee over 100 words</td>
                <td class="py-2 text-right text-gray-600 text-xs"><%= lektor.prices.ivr_guarantee_100plus %> EUR net</td>
              </tr>
              <% } %>
              <% if (lektor.prices.ivr_melody) { %>
              <tr>
                <td class="py-2 text-gray-500 text-xs">Background music</td>
                <td class="py-2 text-right text-gray-600 text-xs"><%= lektor.prices.ivr_melody %> EUR net</td>
              </tr>
              <% } %>
              <% if (lektor.prices.ivr_bilingual) { %>
              <tr>
                <td class="py-2 text-gray-500 text-xs">Bilingual package</td>
                <td class="py-2 text-right text-gray-600 text-xs"><%= lektor.prices.ivr_bilingual %> EUR net</td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
        <% } %>

        <!-- Spot reklamowy -->
        <% if (lektor.prices.spot_radio_local) { %>
        <div class="bg-white rounded-xl border border-gray-200 shadow-md p-6">
          <div class="flex items-center gap-2 mb-4">
            <div class="w-8 h-8 bg-red-500/10 rounded-lg flex items-center justify-center">
              <svg class="w-4 h-4 text-red-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.114 5.636a9 9 0 010 12.728M16.463 8.288a5.25 5.25 0 010 7.424M6.75 8.25l4.72-4.72a.75.75 0 011.28.53v15.88a.75.75 0 01-1.28.53l-4.72-4.72H4.51c-.88 0-1.704-.507-1.938-1.354A9.01 9.01 0 012.25 12c0-.83.112-1.633.322-2.396C2.806 8.756 3.63 8.25 4.51 8.25H6.75z"/></svg>
            </div>
            <h3 class="text-gray-900 font-bold">Advertising Spot</h3>
          </div>
          <table class="w-full text-sm">
            <tbody class="divide-y divide-gray-200">
              <tr>
                <td class="py-2 text-gray-500">Radio - local</td>
                <td class="py-2 text-right text-gray-900 font-semibold"><%= lektor.prices.spot_radio_local %> EUR net</td>
              </tr>
              <% if (lektor.prices.spot_radio_national) { %>
              <tr>
                <td class="py-2 text-gray-500">Radio - national</td>
                <td class="py-2 text-right text-gray-900 font-semibold"><%= lektor.prices.spot_radio_national %> EUR net</td>
              </tr>
              <% } %>
              <% if (lektor.prices.spot_tv_local) { %>
              <tr>
                <td class="py-2 text-gray-500">TV - local</td>
                <td class="py-2 text-right text-gray-900 font-semibold"><%= lektor.prices.spot_tv_local %> EUR net</td>
              </tr>
              <% } %>
              <% if (lektor.prices.spot_tv_national) { %>
              <tr>
                <td class="py-2 text-gray-500">TV - national</td>
                <td class="py-2 text-right text-gray-900 font-semibold"><%= lektor.prices.spot_tv_national %> EUR net</td>
              </tr>
              <% } %>
