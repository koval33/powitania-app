// --- Walidacja pól formularza ---
var NIP_WEIGHTS = [6, 5, 7, 2, 3, 4, 5, 6, 7];

function validateNIP(val) {
  if (!val) return { ok: true };
  var clean = val.replace(/[\s\-]/g, '');
  // Zagraniczny NIP: 2 litery + min 5 cyfr
  if (/^[A-Z]{2}/i.test(clean)) {
    var digits = clean.slice(2);
    if (digits.length < 5 || !/^\d+$/.test(digits)) return { ok: false, msg: 'Invalid Tax ID format' };
    return { ok: true };
  }
  // Polski NIP: 10 cyfr + suma kontrolna
  if (!/^\d{10}$/.test(clean)) return { ok: false, msg: 'Tax ID should contain 10 digits' };
  var d = clean.split('').map(Number);
  var sum = 0;
  for (var i = 0; i < 9; i++) sum += NIP_WEIGHTS[i] * d[i];
  if (sum % 11 !== d[9]) return { ok: false, msg: 'Invalid Tax ID number' };
  return { ok: true };
}

function validateZipCode(val) {
  if (!val) return { ok: true };
  if (val.trim().length < 3) return { ok: false, msg: 'Enter a valid zip/postal code' };
  return { ok: true };
}

function validatePhone(val) {
  if (!val) return { ok: true };
  var clean = val.replace(/[\s\-()]/g, '');
  if (!/^\+?\d{7,15}$/.test(clean)) return { ok: false, msg: 'Min. 7 digits' };
  return { ok: true };
}

function showFieldError(el, msg) {
  el.classList.add('border-red-400');
  el.classList.remove('border-gray-300');
  var errEl = el.parentNode.querySelector('.field-error');
  if (!errEl) {
    errEl = document.createElement('div');
    errEl.className = 'field-error text-red-500 text-xs mt-1';
    el.parentNode.appendChild(errEl);
  }
  errEl.textContent = msg;
}

function clearFieldError(el) {
  el.classList.remove('border-red-400');
  el.classList.add('border-gray-300');
  var errEl = el.parentNode.querySelector('.field-error');
  if (errEl) errEl.remove();
}

function validateOrderFields(prefix, msgElId) {
  var fields = [
    { id: prefix + '-firmName', label: 'Company name' },
    { id: prefix + '-name', label: 'Full name' },
    { id: prefix + '-email', label: 'Email' }
  ];
  var ok = true;
  fields.forEach(function(f) {
    var el = document.getElementById(f.id);
    if (!el) return;
    var val = el.value.trim();
    var invalid = !val || (f.id.indexOf('email') !== -1 && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val));
    if (invalid) { showFieldError(el, 'Required field'); ok = false; }
    else { clearFieldError(el); }
  });

  // Walidacja formatu NIP (opcjonalne, ale jeśli podane - walidowane)
  var nipEl = document.getElementById(prefix + '-nip');
  if (nipEl && nipEl.value.trim()) {
    var nipCheck = validateNIP(nipEl.value.trim());
    if (!nipCheck.ok) { showFieldError(nipEl, nipCheck.msg); ok = false; }
    else { clearFieldError(nipEl); }
  } else if (nipEl) { clearFieldError(nipEl); }

  // Walidacja formatu telefonu (opcjonalne, ale jeśli podane - walidowane)
  var phoneEl = document.getElementById(prefix + '-phone');
  if (phoneEl && phoneEl.value.trim()) {
    var phoneCheck = validatePhone(phoneEl.value.trim());
    if (!phoneCheck.ok) { showFieldError(phoneEl, phoneCheck.msg); ok = false; }
    else { clearFieldError(phoneEl); }
  } else if (phoneEl) { clearFieldError(phoneEl); }

  if (!ok) {
    var msgEl = document.getElementById(msgElId);
    if (msgEl) {
      msgEl.classList.remove('hidden');
      msgEl.className = 'text-center text-sm mt-2 text-red-400';
      msgEl.textContent = 'Please fill in the highlighted fields correctly.';
    }
  }
  return ok;
}

