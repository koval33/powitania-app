      msgEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
      try { sessionStorage.removeItem('kreatorContext'); } catch(e) {}
    } else {
      msgEl.className = 'text-center text-sm mt-2 text-red-500';
      msgEl.textContent = res.error || 'An error occurred. Please try again.';
      btn.disabled = false;
