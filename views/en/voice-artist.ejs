    method: 'choice',
    options: [
      { field: 'spot_radio_local', label: 'Local ad' },
      { field: 'spot_radio_national', label: 'National ad' }
    ],
    addons: [
      { field: 'addon_av_montage', label: 'Audio-video editing', price: 200, tooltip: 'Editing of recorded audio track with video material. Ready file in MP4 format.' },
      { field: 'addon_remote_session', label: 'Remote session participation', price: 150, tooltip: 'Participate in an online recording session - hear the voice artist in real-time and provide feedback.', hideOnHidePrice: true },
      { field: 'addon_archiving', label: 'Recording archiving for 2 years', price: 50, tooltip: 'We store source recording files for 2 years - for modifications or re-downloads.' }
    ],
