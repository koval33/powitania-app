function renderPricing(result, wordCount, targetEl) {
  if (!result) { targetEl.innerHTML = ''; targetEl.classList.add('hidden'); return; }

  var html = '<div class="bg-green-50/50 border border-green-200 rounded-xl p-4 mt-4">';

  if (result.needsCustomQuote) {
    html += '<div class="text-center">' +
      '<p class="text-yellow-400 text-sm font-medium">Custom quote</p>' +
      '<p class="text-gray-500 text-xs mt-1">Contact us for an exact quote.</p>' +
    '</div>';
  } else if (result.basePrice) {
    var totalBase = result.basePrice;

    html += '<div class="flex items-center justify-between mb-2">' +
      '<span class="text-gray-500 text-sm">' + result.label + '</span>' +
      '<span class="text-gray-900 font-bold">' + result.basePrice + ' EUR net</span>' +
    '</div>';

    // Nagranie dwujezyczne — automatycznie doliczane
    if (result.bilingualPrice) {
      totalBase += result.bilingualPrice;
      html += '<div class="flex items-center justify-between mb-2">' +
        '<span class="text-gray-500 text-sm">Bilingual recording</span>' +
        '<span class="text-gray-900 font-bold">+' + result.bilingualPrice + ' EUR net</span>' +
      '</div>';
    }

    // Addony (checkboxy IVR)
    if (result.addons && result.addons.length > 0) {
      html += '<div class="border-t border-gray-200 pt-3 mt-2 space-y-2">';
      html += '<p class="text-xs text-gray-500 mb-1">Additional services:</p>';
      result.addons.forEach(function(addon, idx) {
        var melodyCheckId = addon.hasMelodySelector ? 'melody-addon-check' : '';
        html += '<label class="flex items-center justify-between gap-3 cursor-pointer">' +
          '<span class="flex items-center gap-2">' +
            '<input type="checkbox" class="addon-checkbox accent-emerald-600" data-price="' + addon.price + '" data-label="' + addon.label + '"' +
            (melodyCheckId ? ' id="' + melodyCheckId + '"' : '') +
            ' onchange="recalcTotal();' + (addon.hasMelodySelector ? 'toggleMelodySelector(this)' : '') + '">' +
            '<span class="text-gray-600 text-sm">' + addon.label + '</span>' +
            (addon.tooltip ? '<span class="addon-tooltip-trigger text-gray-500 hover:text-gray-700 cursor-help" data-tooltip-idx="' + idx + '" onclick="toggleAddonTooltip(event, ' + idx + ')">&#10067;</span>' : '') +
          '</span>' +
          '<span class="text-gray-500 text-sm">+' + addon.price + ' EUR net</span>' +
        '</label>';
        if (addon.tooltip) {
          html += '<div id="addon-tooltip-' + idx + '" class="hidden bg-gray-100 rounded-lg p-3 ml-6 text-xs text-gray-500 border border-gray-200">' +
            '<span class="text-gray-500 mr-1">&#9432;</span>' + addon.tooltip +
          '</div>';
        }
