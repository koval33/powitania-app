// Mapowanie kreator serviceType → PRICING_MAP key
var SERVICE_TYPE_MAP = {
  'ivr': 'ivr',
  'powitania': 'ivr',
  'spot': 'radio',
  'radio': 'radio',
  'tv': 'tv',
  'social': 'social',
  'elearning': 'elearning',
  'film': 'film',
  'audiobook': 'audiobook',
  'podcast': 'podcast'
};

// Quote subtitle labels - reminds user what they're pricing
var WIZARD_SUBTITLE_LABELS = {
  'ivr':       'phone IVR message',
  'powitania': 'phone greeting',
  'radio':     'radio ad spot',
  'tv':        'TV ad spot',
  'spot':      'ad spot',
  'social':    'social media content',
  'elearning': 'e-learning content',
  'audiobook': 'audiobook',
  'film':      'film narration',
  'podcast':   'podcast intro/outro'
};
function setWizardSubtitle(serviceType) {
  var el = document.getElementById('wizard-subtitle');
  if (!el) return;
  var label = serviceType && WIZARD_SUBTITLE_LABELS[serviceType];
  if (label) {
    el.textContent = '· ' + label;
    el.classList.remove('hidden');
  } else {
    el.textContent = '';
    el.classList.add('hidden');
  }
}

// --- Helpers ---
function countWords(text) {
  // Usun oznaczenia sekcji w ** ** (np. **Powitanie:**) - to nie tekst do nagrania
  var cleaned = text.replace(/\*\*[^*]*\*\*/g, '');
  return cleaned.trim().split(/\s+/).filter(function(w) { return w.length > 0; }).length;
}

function wordsToPages(words) {
  return Math.ceil(words / 250 * 10) / 10; // ~250 slow = 1 strona A4, zaokr. do 0.1
}

// --- Inteligentna wycena ---
function calculatePrice(serviceType, wordCount, options) {
  var cfg = PRICING_MAP[serviceType];
  if (!cfg) return null;

  var result = { basePrice: null, label: '', addons: [], note: cfg.note || null, needsCustomQuote: false };

  if (cfg.method === 'wordcount') {
    // IVR - cena z tieru wg liczby slow
    for (var i = 0; i < cfg.tiers.length; i++) {
      var tier = cfg.tiers[i];
      if (wordCount <= tier.max) {
        var price = LEKTOR_PRICES[tier.field];
        if (price && price !== 'wycena') {
          result.basePrice = parseInt(price);
          result.label = tier.label;
        } else {
          result.needsCustomQuote = true;
          result.label = tier.label;
        }
        break;
      }
    }
    // Pakiet dwujezyczny - automatycznie gdy 2 jezyki
    if (options && options.bilingual) {
      var bilingualPrice = LEKTOR_PRICES['ivr_bilingual'];
      if (bilingualPrice) {
        result.bilingualPrice = parseInt(bilingualPrice);
      }
    }
  } else if (cfg.method === 'choice') {
    // Radio/TV/Social - klient wybiera opcje
    if (options && options.choiceField) {
      var choicePrice = LEKTOR_PRICES[options.choiceField];
      if (choicePrice) {
        result.basePrice = parseInt(choicePrice);
        var chosenOpt = cfg.options.find(function(o) { return o.field === options.choiceField; });
        result.label = chosenOpt ? chosenOpt.label : '';
      } else {
        result.needsCustomQuote = true;
      }
    }
  } else if (cfg.method === 'pages') {
    // Narracja - cena per strona A4
    var pages = wordsToPages(wordCount);
    for (var j = 0; j < cfg.tiers.length; j++) {
      var pageTier = cfg.tiers[j];
      if (pages <= pageTier.max) {
        var pagePrice = LEKTOR_PRICES[pageTier.field];
        if (pagePrice && pagePrice !== 'wycena') {
          result.basePrice = parseInt(pagePrice);
          result.label = pageTier.label + ' (~' + pages.toFixed(1) + ' p.)';
        } else {
          result.needsCustomQuote = true;
          result.label = pageTier.label;
        }
        break;
      }
    }
  }

  // Addony - wspolne dla wszystkich metod
  if (cfg.addons) {
    cfg.addons.forEach(function(addon) {
      if (addon.condition && !addon.condition(wordCount)) return;
      if (addon.hideOnHidePrice && LEKTOR_HIDE_PRICE) return;
      // Stala cena (addon.price) lub cena per lektor (LEKTOR_PRICES)
      var addonPrice = addon.price || (LEKTOR_PRICES[addon.field] ? parseInt(LEKTOR_PRICES[addon.field]) : null);
      if (addonPrice) {
        result.addons.push({ field: addon.field, label: addon.label, price: parseInt(addonPrice), tooltip: addon.tooltip || null, hasMelodySelector: addon.hasMelodySelector || false });
      }
    });
  }

  return result;
}

// --- Renderowanie pytan per serviceType ---
function renderQuestions(serviceType, targetEl) {
  var cfg = PRICING_MAP[serviceType];
  if (!cfg) { targetEl.innerHTML = ''; return; }

  var html = '';

  if (cfg.method === 'choice') {
    html += '<div class="mb-4">';
    html += '<label class="block text-gray-900 font-semibold mb-3 text-sm">' + getQuestionLabel(serviceType) + '</label>';
    html += '<div class="space-y-2">';
    // Pre-select first option (e.g. "Up to 1 minute" for Social, "Local ad" for Ad Spot) so price shows immediately
    cfg.options.forEach(function(opt, idx) {
      var price = LEKTOR_PRICES[opt.field];
      var priceLabel = price ? (' - ' + price + ' EUR net') : '';
      var checkedAttr = idx === 0 ? ' checked' : '';
      html += '<label class="flex items-center gap-3 bg-gray-50 rounded-lg p-3 cursor-pointer hover:bg-gray-100 transition-colors border border-transparent has-[:checked]:border-accent/50">' +
        '<input type="radio" name="service-choice" value="' + opt.field + '" class="accent-emerald-600" onchange="onChoiceChange(this)"' + checkedAttr + '>' +
        '<span class="text-gray-600 text-sm">' + opt.label + '<span class="text-accent font-semibold">' + priceLabel + '</span></span>' +
      '</label>';
    });
    html += '</div>';
    if (cfg.note) {
      html += '<p class="text-xs text-gray-500 mt-2">' + cfg.note + '</p>';
    }
    html += '</div>';
  }

  targetEl.innerHTML = html;
}

function getQuestionLabel(serviceType) {
  switch(serviceType) {
    case 'radio': return 'What is the radio ad reach?';
    case 'tv': return 'What is the TV ad reach?';
    case 'social': return 'Recording duration:';
    default: return 'Select option:';
  }
}

// --- Renderowanie wyceny ---
function renderPricing(result, wordCount, targetEl) {
  if (!result) { targetEl.innerHTML = ''; targetEl.classList.add('hidden'); return; }

  var html = '<div class="bg-green-50/50 border border-green-200 rounded-xl p-4 mt-4">';

  if (result.needsCustomQuote) {
    html += '<div class="text-center">' +
      '<p class="text-yellow-400 text-sm font-medium">Custom quote</p>' +
      '<p class="text-gray-500 text-xs mt-1">Contact us for an exact quote.</p>' +
    '</div>';
  } else if (result.basePrice) {
    var totalBase = result.basePrice;

    html += '<div class="flex items-center justify-between mb-2">' +
      '<span class="text-gray-500 text-sm">' + result.label + '</span>' +
      '<span class="text-gray-900 font-bold">' + result.basePrice + ' EUR net</span>' +
    '</div>';

    // Nagranie dwujezyczne - automatycznie doliczane
    if (result.bilingualPrice) {
      totalBase += result.bilingualPrice;
      html += '<div class="flex items-center justify-between mb-2">' +
        '<span class="text-gray-500 text-sm">Bilingual recording</span>' +
        '<span class="text-gray-900 font-bold">+' + result.bilingualPrice + ' EUR net</span>' +
      '</div>';
    }

    // Addony (checkboxy IVR)
    if (result.addons && result.addons.length > 0) {
      html += '<div class="border-t border-gray-200 pt-2 mt-2">';
      html += '<button type="button" onclick="toggleAddonsSection(this)" class="inline-flex items-center gap-1.5 text-left py-1 group">' +
        '<span class="text-xs font-medium text-gray-500 group-hover:text-gray-700 transition-colors">Additional services (' + result.addons.length + ')</span>' +
        '<span class="text-gray-400 group-hover:text-gray-600 transition-colors text-xs flex items-center gap-0.5">' +
          '<span class="addons-toggle-label">expand</span>' +
          '<svg class="addons-toggle-icon w-3.5 h-3.5 transition-transform" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>' +
        '</span>' +
      '</button>';
      html += '<div class="addons-body hidden space-y-2 mt-2">';
      result.addons.forEach(function(addon, idx) {
        var melodyCheckId = addon.hasMelodySelector ? 'melody-addon-check' : '';
        html += '<label class="flex items-center justify-between gap-3 cursor-pointer">' +
          '<span class="flex items-center gap-2">' +
            '<input type="checkbox" class="addon-checkbox accent-emerald-600" data-price="' + addon.price + '" data-label="' + addon.label + '"' +
            (melodyCheckId ? ' id="' + melodyCheckId + '"' : '') +
            ' onchange="recalcTotal();' + (addon.hasMelodySelector ? 'toggleMelodySelector(this)' : '') + '">' +
            '<span class="text-gray-600 text-sm">' + addon.label + '</span>' +
            (addon.tooltip ? '<span class="addon-tooltip-trigger text-gray-500 hover:text-gray-700 cursor-help" data-tooltip-idx="' + idx + '" onclick="toggleAddonTooltip(event, ' + idx + ')">&#10067;</span>' : '') +
          '</span>' +
          '<span class="text-gray-500 text-sm">+' + addon.price + ' EUR net</span>' +
        '</label>';
        if (addon.tooltip) {
          html += '<div id="addon-tooltip-' + idx + '" class="hidden bg-gray-100 rounded-lg p-3 ml-6 text-xs text-gray-500 border border-gray-200">' +
            '<span class="text-gray-500 mr-1">&#9432;</span>' + addon.tooltip +
          '</div>';
        }
        // Selector melodii - kompaktowa lista z przyciskami play
        if (addon.hasMelodySelector && MELODIES.length > 0) {
          html += '<div id="melody-selector" class="hidden ml-6 mt-1 bg-gray-50 rounded-lg border border-gray-200 px-3 py-2">';
          html += '<div class="flex flex-wrap gap-x-4 gap-y-1">';
          MELODIES.forEach(function(m, mi) {
            html += '<div class="inline-flex items-center gap-1.5 py-0.5">' +
              '<label for="melody-' + m.id + '" class="inline-flex items-center gap-1.5 cursor-pointer">' +
                '<input type="radio" name="melody" value="' + m.id + '" id="melody-' + m.id + '" class="accent-emerald-600 w-3 h-3"' + (mi === 0 ? ' checked' : '') + '>' +
                '<span class="text-xs text-gray-700">' + m.name + '</span>' +
              '</label>' +
              '<button type="button" class="melody-play-btn w-5 h-5 rounded-full bg-accent/10 hover:bg-accent/20 inline-flex items-center justify-center transition-colors" data-src="/audio/melodies/' + m.file + '" data-melody="' + m.id + '" onclick="playMelody(this)">' +
                '<svg class="w-2.5 h-2.5 text-accent melody-icon-play" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>' +
                '<svg class="w-2.5 h-2.5 text-accent melody-icon-pause hidden" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>' +
              '</button>' +
            '</div>';
          });
          html += '</div>';
          html += '<audio id="melody-audio" preload="none"></audio>';
          html += '</div>';
        }
      });
      html += '</div>'; // addons-body
      html += '</div>'; // border-t wrapper
    }

    // Suma
    // VAT note for international clients
    html += '<div class="border-t border-green-200 mt-3 pt-3 flex items-center justify-between">' +
      '<span class="text-gray-900 font-bold">Total:</span>' +
      '<div class="text-right"><span id="pricing-total" class="text-2xl font-bold text-green-700">' + totalBase + ' EUR net</span>' +
      '<div id="pricing-brutto" class="text-sm text-gray-500">Net price, VAT may apply</div></div>' +
    '</div>';

    if (result.note) {
      html += '<p class="text-xs text-gray-500 mt-1">' + result.note + '</p>';
    }
  }

  html += '</div>';
  targetEl.innerHTML = html;
  targetEl.classList.remove('hidden');

  // Store base price for recalc (including bilingual)
  targetEl.dataset.basePrice = (result.basePrice || 0) + (result.bilingualPrice || 0);

  // Przełączanie formularzy: pełny (zamówienie) vs prosty (zapytanie o wycenę)
  toggleWizardForms(result.needsCustomQuote);

  // Aktualizuj tekst przycisków zamówienia (Zamów i zapłać / Zamów nagranie)
  if (!result.needsCustomQuote) {
    updateOrderButtonLabels(result.basePrice > 0);
  }
}

function toggleWizardForms(isCustomQuote) {
  var orderForm = document.getElementById('wizard-order-form');
  var inquiryForm = document.getElementById('wizard-inquiry-form');
  if (!orderForm || !inquiryForm) return;
  if (isCustomQuote) {
    orderForm.classList.add('hidden');
    inquiryForm.classList.remove('hidden');
  } else {
    orderForm.classList.remove('hidden');
    inquiryForm.classList.add('hidden');
  }
}

function updateOrderButtonLabels(hasPrice) {
  var label = hasPrice ? 'Order and pay' : 'Order recording';
  var wizBtn = document.getElementById('wiz-submit-btn');
  if (wizBtn) wizBtn.textContent = label;
  var modBtn = document.getElementById('mod-submit-btn');
  if (modBtn) modBtn.textContent = label;
}

function toggleAddonsSection(btn) {
  var body = btn.nextElementSibling;
  if (!body) return;
  var isOpen = !body.classList.contains('hidden');
  body.classList.toggle('hidden', isOpen);
  var label = btn.querySelector('.addons-toggle-label');
  var icon = btn.querySelector('.addons-toggle-icon');
  if (label) label.textContent = isOpen ? 'expand' : 'collapse';
  if (icon) icon.style.transform = isOpen ? '' : 'rotate(180deg)';
}

function toggleAddonTooltip(e, idx) {
  e.preventDefault();
  e.stopPropagation();
  var tip = document.getElementById('addon-tooltip-' + idx);
  if (tip) tip.classList.toggle('hidden');
}

// Melody selector - show/hide panel when checkbox toggled
function toggleMelodySelector(checkbox) {
  var panel = document.getElementById('melody-selector');
  if (!panel) return;
  if (checkbox.checked) {
    panel.classList.remove('hidden');
  } else {
    panel.classList.add('hidden');
    // Stop any playing melody
    var audio = document.getElementById('melody-audio');
    if (audio) { audio.pause(); audio.currentTime = 0; }
    resetMelodyButtons();
  }
}

// Melody audio playback
var currentMelodyBtn = null;
function playMelody(btn) {
  var audio = document.getElementById('melody-audio');
  if (!audio) return;
  var src = btn.getAttribute('data-src');

  // If same button clicked - toggle pause/play
  if (currentMelodyBtn === btn && !audio.paused) {
    audio.pause();
    showPlayIcon(btn);
    return;
  }

  // Stop previous
  if (currentMelodyBtn && currentMelodyBtn !== btn) {
    showPlayIcon(currentMelodyBtn);
  }

  // Play new
  if (audio.getAttribute('src') !== src) {
    audio.src = src;
  }
  audio.play();
  showPauseIcon(btn);
  currentMelodyBtn = btn;

  // Select the corresponding radio
  var melodyId = btn.getAttribute('data-melody');
  var radio = melodyId ? document.getElementById('melody-' + melodyId) : null;
  if (radio) radio.checked = true;
}

function showPlayIcon(btn) {
  var play = btn.querySelector('.melody-icon-play');
  var pause = btn.querySelector('.melody-icon-pause');
  if (play) play.classList.remove('hidden');
  if (pause) pause.classList.add('hidden');
}

function showPauseIcon(btn) {
  var play = btn.querySelector('.melody-icon-play');
  var pause = btn.querySelector('.melody-icon-pause');
  if (play) play.classList.add('hidden');
  if (pause) pause.classList.remove('hidden');
}

function resetMelodyButtons() {
  document.querySelectorAll('.melody-play-btn').forEach(function(btn) {
    showPlayIcon(btn);
  });
  currentMelodyBtn = null;
}

// Auto-reset icons when audio ends
document.addEventListener('ended', function(e) {
  if (e.target && e.target.id === 'melody-audio') {
    resetMelodyButtons();
  }
}, true);

function recalcTotal() {
  // Szukaj basePrice w widocznym kontenerze wyceny
  var containers = ['wizard-pricing', 'modal-pricing'];
  var total = 0;
  for (var i = 0; i < containers.length; i++) {
    var el = document.getElementById(containers[i]);
    if (el && el.dataset.basePrice) { total = parseInt(el.dataset.basePrice) || 0; break; }
  }
  document.querySelectorAll('.addon-checkbox:checked').forEach(function(cb) {
    total += parseInt(cb.dataset.price) || 0;
  });
  var totalEl = document.getElementById('pricing-total');
  if (totalEl) totalEl.textContent = total + ' EUR net';
  // Przelicz brutto (VAT 23%) od pełnej kwoty netto (baza + addony)
  var bruttoEl = document.getElementById('pricing-brutto');
  if (bruttoEl) {
    bruttoEl.textContent = 'Net price, VAT may apply';
  }
}

