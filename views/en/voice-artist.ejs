  if (isCustomQuote) {
    orderForm.classList.add('hidden');
    inquiryForm.classList.remove('hidden');
  } else {
    orderForm.classList.remove('hidden');
    inquiryForm.classList.add('hidden');
  }
}

function updateOrderButtonLabels(hasPrice) {
  var label = hasPrice ? 'Order and pay' : 'Order recording';
  var wizBtn = document.getElementById('wiz-submit-btn');
  if (wizBtn) wizBtn.textContent = label;
  var modBtn = document.getElementById('mod-submit-btn');
  if (modBtn) modBtn.textContent = label;
}

function toggleAddonTooltip(e, idx) {
  e.preventDefault();
  e.stopPropagation();
  var tip = document.getElementById('addon-tooltip-' + idx);
  if (tip) tip.classList.toggle('hidden');
}

// Melody selector — show/hide panel when checkbox toggled
function toggleMelodySelector(checkbox) {
  var panel = document.getElementById('melody-selector');
  if (!panel) return;
  if (checkbox.checked) {
    panel.classList.remove('hidden');
  } else {
    panel.classList.add('hidden');
    // Stop any playing melody
    var audio = document.getElementById('melody-audio');
    if (audio) { audio.pause(); audio.currentTime = 0; }
    resetMelodyButtons();
  }
}

// Melody audio playback
var currentMelodyBtn = null;
function playMelody(btn) {
  var audio = document.getElementById('melody-audio');
  if (!audio) return;
  var src = btn.getAttribute('data-src');

  // If same button clicked — toggle pause/play
  if (currentMelodyBtn === btn && !audio.paused) {
    audio.pause();
    showPlayIcon(btn);
    return;
  }

  // Stop previous
  if (currentMelodyBtn && currentMelodyBtn !== btn) {
    showPlayIcon(currentMelodyBtn);
  }

  // Play new
  if (audio.getAttribute('src') !== src) {
    audio.src = src;
  }
  audio.play();
  showPauseIcon(btn);
  currentMelodyBtn = btn;

  // Select the corresponding radio
  var melodyId = btn.getAttribute('data-melody');
  var radio = melodyId ? document.getElementById('melody-' + melodyId) : null;
  if (radio) radio.checked = true;
}

function showPlayIcon(btn) {
  var play = btn.querySelector('.melody-icon-play');
  var pause = btn.querySelector('.melody-icon-pause');
  if (play) play.classList.remove('hidden');
  if (pause) pause.classList.add('hidden');
}

function showPauseIcon(btn) {
