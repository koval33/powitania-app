<%- include('../partials/head-en') %>

<section class="py-10 md:py-16 bg-stone-100/80">
  <div class="max-w-5xl mx-auto px-4">

    <!-- Breadcrumb -->
    <nav class="text-sm mb-8">
      <a href="/en/" class="text-gray-500 hover:text-gray-900 transition-colors">Home</a>
      <span class="text-gray-400 mx-2">/</span>
      <a href="/en/voice-bank/" class="text-gray-500 hover:text-gray-900 transition-colors">Voice Bank</a>
      <span class="text-gray-400 mx-2">/</span>
      <span class="text-gray-600"><%= lektor.name %></span>
    </nav>

    <!-- Profil: zdjęcie + info -->
    <div class="flex flex-col md:flex-row gap-8 md:gap-12">

      <!-- Lewa kolumna: zdjęcie + tagi -->
      <div class="flex-shrink-0">
        <div class="w-48 h-48 md:w-56 md:h-56 rounded-2xl overflow-hidden border-2 border-gray-200 mx-auto md:mx-0">
          <img src="<%= lektor.photo %>" alt="<%= lektor.name %>" class="w-full h-full object-cover">
        </div>
        <div class="flex flex-wrap gap-2 mt-4 justify-center md:justify-start">
          <% if (lektor.famous) { %>
            <span class="bg-yellow-50 text-yellow-700 text-xs font-semibold px-3 py-1 rounded-full border border-yellow-300">Celebrity</span>
          <% } %>
          <% if (lektor.native) { %>
            <span class="bg-blue-50 text-blue-700 text-xs font-semibold px-3 py-1 rounded-full border border-blue-300">Native speaker</span>
          <% } %>
          <span class="bg-gray-50 text-gray-500 text-xs font-medium px-3 py-1 rounded-full border border-gray-200">
            <%= lektor.gender === 'm' ? 'Male' : 'Female' %>
          </span>
          <span class="bg-gray-50 text-gray-500 text-xs font-medium px-3 py-1 rounded-full border border-gray-200">
            <%= lektor.age %>
          </span>
        </div>
      </div>

      <!-- Prawa kolumna: dane -->
      <div class="flex-1 min-w-0">
        <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-3"><%= lektor.name %></h1>

        <% if (lektor.descriptionEn || lektor.description) { %>
          <p class="text-gray-500 leading-relaxed mb-4"><%= lektor.descriptionEn || lektor.description %></p>
        <% } %>

        <!-- Meta info — kompaktowo -->
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1.5 text-sm text-gray-500 mb-4">
          <span><%= lektor.languages.join(', ') %></span>
          <span class="text-gray-400">·</span>
          <span>Turnaround: <span class="text-gray-900"><%= lektor.turnaround || '24-48h' %></span></span>
          <% if (lektor.applications && lektor.applications.length > 0) { %>
          <span class="text-gray-400">·</span>
          <% lektor.applications.forEach(function(app) { %>
            <span class="text-xs bg-accent/10 text-accent px-2 py-0.5 rounded-full"><%= app %></span>
          <% }); %>
          <% } %>
        </div>

        <!-- PRÓBKI GŁOSOWE — od razu w kolumnie -->
        <%
          var allAudio = [];
          var seenUrls = {};
          var samples = lektor.samples || [];
          if (lektor.audio) {
            allAudio.push({ name: (samples[0] && samples[0].name) || 'Main sample', url: lektor.audio });
            seenUrls[lektor.audio] = true;
            if (samples.length > 0 && samples[0].url) seenUrls[samples[0].url] = true;
          }
          samples.forEach(function(s) {
            if (!s.url) return;
            var isVideo = s.url.includes('youtu') || s.url.includes('vimeo');
            if (!isVideo && !seenUrls[s.url]) {
              allAudio.push(s);
              seenUrls[s.url] = true;
            }
          });
          var videoSamples = (lektor.samples || []).filter(function(s) {
            return s.url && (s.url.includes('youtu') || s.url.includes('vimeo'));
          });
        %>

        <% if (allAudio.length > 0) { %>
        <div class="space-y-2 mb-5">
          <% allAudio.forEach(function(sample, idx) { %>
          <div class="sample-row bg-white shadow-sm rounded-lg border border-gray-200 overflow-hidden">
            <div class="flex items-center gap-3 p-3">
              <button class="sample-play-btn w-10 h-10 flex-shrink-0 bg-accent hover:bg-accent-light rounded-full flex items-center justify-center transition-colors" data-audio="<%= sample.url %>">
                <svg class="play-icon w-4 h-4 text-white ml-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                <svg class="pause-icon w-4 h-4 text-white hidden" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
              </button>
              <div class="flex-1 min-w-0">
                <div class="text-sm text-gray-900 font-medium truncate mb-1"><%= sample.name || ('Sample ' + (idx + 1)) %></div>
                <div class="audio-progress w-full h-1.5 bg-gray-100 rounded-full overflow-hidden cursor-pointer">
                  <div class="audio-bar h-full bg-accent rounded-full transition-all" style="width: 0%"></div>
                </div>
                <div class="flex justify-between mt-0.5">
                  <span class="audio-time text-xs text-gray-500">0:00</span>
                  <span class="audio-duration text-xs text-gray-500">--:--</span>
                </div>
              </div>
              <a href="<%= sample.url %>" download title="Download MP3" class="w-8 h-8 flex-shrink-0 flex items-center justify-center rounded-full text-gray-500 hover:text-gray-900 hover:bg-gray-100 transition-colors">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
              </a>
            </div>
          </div>
          <% }); %>
        </div>
        <% } %>

        <!-- Banner ekspresowy -->
        <% if (typeof isExpress !== 'undefined' && isExpress) { %>
        <div class="bg-yellow-50 border border-yellow-400/30 rounded-xl px-4 py-3 mb-3 flex items-center gap-2 text-sm">
          <svg class="w-4 h-4 text-yellow-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.381z" clip-rule="evenodd"/></svg>
          <span class="text-yellow-800"><strong>Express recording</strong> — rates include priority delivery</span>
        </div>
        <% } %>

        <!-- CTA -->
        <div id="lektor-cta-section" class="flex flex-col gap-3">
          <% if (!lektor.hidePrice) { %>
          <button onclick="showOrderModal()" class="bg-accent hover:bg-accent-light text-white px-6 py-3 rounded-lg font-semibold text-center transition-colors inline-flex items-center justify-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z"/></svg>
            Get a quote for this voice artist
          </button>
          <button onclick="toggleInquiryForm()" class="text-gray-500 hover:text-accent text-sm transition-colors text-center">
            Request a quote
          </button>
          <% } else { %>
          <a href="#zapytanie" class="bg-accent hover:bg-accent-light text-white px-6 py-3 rounded-lg font-semibold text-center transition-colors inline-flex items-center justify-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
            Request a quote
          </a>
          <% } %>
        </div>

        <!-- INLINE FORMULARZ ZAPYTANIA -->
        <div id="inline-inquiry-form" class="mt-4 hidden">
          <div class="bg-stone-50 rounded-xl border border-gray-200 p-5">
            <div id="inquiry-text-preview" class="hidden mb-4">
              <div class="text-xs text-gray-500 mb-1">Your script from the creator:</div>
              <div id="inquiry-text-content" class="text-sm text-gray-600 bg-white rounded-lg p-3 border border-gray-200 line-clamp-3"></div>
            </div>
            <form id="inline-inquiry-submit-form" class="space-y-3">
              <input type="hidden" name="lektorName" value="<%= lektor.name %>">
              <input type="hidden" name="lektorId" value="<%= lektor.id %>">
              <input type="email" name="email" required placeholder="Email *" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-sm text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none">
              <input type="text" name="name" placeholder="Name (optional)" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-sm text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none">
              <textarea name="description" rows="3" placeholder="Describe what you need (optional)" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-sm text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none resize-y"></textarea>
              <button type="submit" class="w-full bg-accent hover:bg-accent-light text-white py-2.5 rounded-lg font-semibold text-sm transition-colors">
                Send Inquiry
              </button>
              <div id="inline-inquiry-msg" class="hidden text-center text-sm"></div>
            </form>
          </div>
        </div>

        <!-- INTELIGENTNY WIZARD WYCENY (widoczny gdy kontekst z kreatora) -->
        <div id="pricing-wizard" class="mt-6 hidden">
          <div class="bg-white shadow-sm rounded-2xl border-2 border-accent/30 p-6">
            <div class="flex items-center justify-between mb-4">
              <div class="flex items-center gap-3">
                <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                <h3 class="text-lg font-bold text-gray-900">Recording Quote</h3>
              </div>
              <button onclick="clearPricingContext()" class="text-gray-500 hover:text-gray-900 transition-colors" title="Close">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
              </button>
            </div>
            <!-- Podgląd tekstu -->
            <div class="bg-gray-50 rounded-lg p-3 mb-4">
              <div class="flex items-center justify-between mb-1">
                <span class="text-xs text-gray-500">Your script:</span>
                <span id="wizard-word-count" class="text-xs text-accent font-medium"></span>
              </div>
              <div id="wizard-text-preview" class="text-gray-600 text-sm leading-relaxed max-h-24 overflow-y-auto"></div>
            </div>
            <!-- Typ nagrania (jeśli nie przyszedł z kreatora) -->
            <div id="wizard-service-type" class="hidden mb-4">
              <label class="block text-gray-900 font-semibold mb-2 text-sm">Recording Type</label>
              <select id="wizard-service-select" onchange="updateWizardPricing()" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-3 text-gray-900 focus:border-accent focus:outline-none">
                <option value="">— select recording type —</option>
                <option value="ivr">Phone Announcements (IVR)</option>
                <option value="radio">Radio Commercial</option>
                <option value="tv">TV Commercial</option>
                <option value="social">Social Media Campaign</option>
                <option value="elearning">E-learning / Training</option>
                <option value="film">Film Narration</option>
                <option value="audiobook">Audiobook</option>
                <option value="podcast">Podcast (intro/outro)</option>
              </select>
            </div>
            <!-- Dynamiczne pytania per serviceType -->
            <div id="wizard-questions"></div>
            <!-- Wycena -->
            <div id="wizard-pricing" class="hidden"></div>
            <!-- CTA + formularz zamówienia — pojawi się dopiero po wycenie -->
            <div id="wizard-cta" class="hidden mt-5">

              <!-- Formularz PEŁNY (zamówienie — widoczny gdy jest cena) -->
              <div id="wizard-order-form" class="border-t border-gray-200 pt-4">
                <h4 class="text-gray-900 font-bold mb-4 flex items-center gap-2">
                  <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/></svg>
                  Dane do zamówienia
                </h4>
                <div class="space-y-3">
                  <div>
                    <label class="block text-gray-900 text-sm font-medium mb-1">Company Name *</label>
                    <input type="text" id="wiz-firmName" required class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none text-sm" placeholder="Company Ltd.">
                  </div>
                  <div class="grid sm:grid-cols-2 gap-3">
                    <div>
                      <label class="block text-gray-900 text-sm font-medium mb-1">Full Name *</label>
                      <input type="text" id="wiz-name" required class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none text-sm" placeholder="John Smith">
                    </div>
                    <div>
                      <label class="block text-gray-900 text-sm font-medium mb-1">Tax ID</label>
                      <input type="text" id="wiz-nip" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none text-sm" placeholder="Tax ID number">
                    </div>
                  </div>
                  <div>
                    <label class="block text-gray-900 text-sm font-medium mb-1">Address *</label>
                    <input type="text" id="wiz-street" required class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none text-sm mb-2" placeholder="123 Main Street">
                    <div class="grid grid-cols-3 gap-2">
                      <input type="text" id="wiz-zipCode" required class="bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none text-sm" placeholder="Zip">
                      <input type="text" id="wiz-city" required class="col-span-2 bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none text-sm" placeholder="City">
                    </div>
                  </div>
                  <div class="grid sm:grid-cols-2 gap-3">
                    <div>
                      <label class="block text-gray-900 text-sm font-medium mb-1">Email *</label>
                      <input type="email" id="wiz-email" required class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none text-sm" placeholder="john@company.com">
                    </div>
                    <div>
                      <label class="block text-gray-900 text-sm font-medium mb-1">Phone</label>
                      <input type="tel" id="wiz-phone" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none text-sm" placeholder="+48 600 000 000">
                    </div>
                  </div>
                  <div>
                    <label class="block text-gray-900 text-sm font-medium mb-1">Notes</label>
                    <textarea id="wiz-notes" rows="2" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none text-sm resize-y" placeholder="Additional information..."></textarea>
                  </div>
                </div>
                <button id="wiz-submit-btn" onclick="submitWizardOrder()" class="bg-accent hover:bg-accent-light text-white px-6 py-3 rounded-lg font-semibold w-full transition-colors mt-4">
                  Order Recording
                </button>
                <div id="wizard-order-msg" class="hidden text-center text-sm mt-2"></div>
                <button onclick="showWizardInquiry()" class="text-gray-500 hover:text-accent text-sm transition-colors text-center w-full mt-2">
                  Ask for details
                </button>
              </div>

              <!-- Formularz PROSTY (kontakt — widoczny przy wycenie indywidualnej) -->
              <div id="wizard-inquiry-form" class="border-t border-gray-200 pt-4 hidden">
                <h4 class="text-gray-900 font-bold mb-4 flex items-center gap-2">
                  <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
                  Request a quote
                </h4>
                <div class="space-y-3">
                  <div>
                    <label class="block text-gray-900 text-sm font-medium mb-1">Email *</label>
                    <input type="email" id="wiz-inq-email" required class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none text-sm" placeholder="john@company.com">
                  </div>
                  <div>
                    <label class="block text-gray-900 text-sm font-medium mb-1">Full Name</label>
                    <input type="text" id="wiz-inq-name" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none text-sm" placeholder="John Smith">
                  </div>
                  <div>
                    <label class="block text-gray-900 text-sm font-medium mb-1">Message</label>
                    <textarea id="wiz-inq-message" rows="3" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none text-sm resize-y" placeholder="Additional information, questions..."></textarea>
                  </div>
                </div>
                <button id="wiz-inq-submit-btn" onclick="submitWizardInquiry()" class="bg-accent hover:bg-accent-light text-white px-6 py-3 rounded-lg font-semibold w-full transition-colors mt-4">
                  Send Inquiry
                </button>
                <div id="wizard-inquiry-msg" class="hidden text-center text-sm mt-2"></div>
              </div>

            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- VIDEO (pełna szerokość, pod profilem) -->
    <%
      var videoSamples = (lektor.samples || []).filter(function(s) {
        return s.url && (s.url.includes('youtu') || s.url.includes('vimeo'));
      });
    %>

    <% if (videoSamples.length > 0) { %>
    <div class="mt-10">
      <h3 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
        <svg class="w-5 h-5 text-red-500" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814z"/><path fill="#fff" d="M9.545 15.568V8.432L15.818 12z"/></svg>
        Video Productions
      </h3>
      <div class="grid sm:grid-cols-2 gap-4">
        <% videoSamples.forEach(function(video) {
          var ytId = '';
          var url = video.url || '';
          if (url.includes('youtu.be/')) {
            ytId = url.split('youtu.be/')[1].split(/[?&#]/)[0];
          } else if (url.includes('youtube.com/watch')) {
            var match = url.match(/[?&]v=([^&#]+)/);
            if (match) ytId = match[1];
          } else if (url.includes('youtube.com/shorts/')) {
            ytId = url.split('shorts/')[1].split(/[?&#]/)[0];
          }
        %>
        <div class="bg-white shadow-sm rounded-xl border border-gray-200 overflow-hidden group">
          <% if (ytId) { %>
          <div style="position:relative;padding-bottom:56.25%;height:0;overflow:hidden" class="cursor-pointer bg-black" data-vid="<%= ytId %>" onclick="loadYT(this)">
            <img src="https://img.youtube.com/vi/<%= ytId %>/mqdefault.jpg" alt="<%= video.name %>" style="position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover">
            <div style="position:absolute;top:0;left:0;width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.4)">
              <div style="width:56px;height:56px;background:#dc2626;border-radius:50%;display:flex;align-items:center;justify-content:center">
                <svg style="width:24px;height:24px;color:#fff;margin-left:3px" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              </div>
            </div>
          </div>
          <% } else { %>
          <div style="position:relative;padding-bottom:56.25%;height:0;overflow:hidden;background:#f9fafb">
            <a href="<%= video.url %>" target="_blank" rel="noopener" style="position:absolute;top:0;left:0;width:100%;height:100%;display:flex;align-items:center;justify-content:center" class="text-accent hover:text-accent-light">
              <svg style="width:48px;height:48px" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/></svg>
            </a>
          </div>
          <% } %>
          <div class="p-3">
