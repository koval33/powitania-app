                '<input type="radio" name="melody" value="' + m.id + '" id="melody-' + m.id + '" class="accent-emerald-600 w-3 h-3"' + (mi === 0 ? ' checked' : '') + '>' +
                '<span class="text-xs text-gray-700">' + m.name + '</span>' +
              '</label>' +
              '<button type="button" class="melody-play-btn w-5 h-5 rounded-full bg-accent/10 hover:bg-accent/20 inline-flex items-center justify-center transition-colors" data-src="/audio/melodies/' + m.file + '" data-melody="' + m.id + '" onclick="playMelody(this)">' +
                '<svg class="w-2.5 h-2.5 text-accent melody-icon-play" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>' +
                '<svg class="w-2.5 h-2.5 text-accent melody-icon-pause hidden" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>' +
              '</button>' +
            '</div>';
          });
          html += '</div>';
          html += '<audio id="melody-audio" preload="none"></audio>';
          html += '</div>';
        }
      });
      html += '</div>';
    }

    // Suma
    // VAT note for international clients
    html += '<div class="border-t border-green-200 mt-3 pt-3 flex items-center justify-between">' +
      '<span class="text-gray-900 font-bold">Total:</span>' +
      '<div class="text-right"><span id="pricing-total" class="text-2xl font-bold text-green-700">' + totalBase + ' EUR net</span>' +
