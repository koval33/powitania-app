    return;
  }

  var ctx = {};
  try { ctx = JSON.parse(sessionStorage.getItem('kreatorContext') || '{}'); } catch(e) {}

  var data = {
    email: email,
    name: document.getElementById('wiz-inq-name').value.trim(),
