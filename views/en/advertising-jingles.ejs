<script>
(function() {
  var currentAudio = null;
  var currentBtn = null;
  function setBtnState(btn, playing) {
    if (!btn) return;
    var play = btn.querySelector('.play-icon');
    var pause = btn.querySelector('.pause-icon');
    if (playing) { if (play) play.classList.add('hidden'); if (pause) pause.classList.remove('hidden'); }
    else { if (play) play.classList.remove('hidden'); if (pause) pause.classList.add('hidden'); }
  }
  window.playSample = function(btn, url) {
    if (currentAudio && currentBtn === btn) {
      if (currentAudio.paused) { currentAudio.play(); setBtnState(btn, true); }
      else { currentAudio.pause(); setBtnState(btn, false); }
      return;
    }
    if (currentAudio) { currentAudio.pause(); setBtnState(currentBtn, false); }
    currentAudio = new Audio(url);
    currentBtn = btn;
    currentAudio.play();
    setBtnState(btn, true);
    currentAudio.onended = function() { setBtnState(btn, false); currentAudio = null; currentBtn = null; };
  };
})();
</script>

