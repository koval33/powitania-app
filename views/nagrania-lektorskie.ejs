    <!-- Lightbox - obsługa zdjęć i filmów (bez browser-native fullscreen) -->
    <div id="lightbox" class="fixed inset-0 z-50 bg-black/80 hidden items-center justify-center p-4" onclick="closeLightbox()">
      <img id="lightbox-img" src="" alt="" class="max-w-full max-h-[90vh] rounded-lg shadow-2xl hidden" onclick="event.stopPropagation()">
      <video id="lightbox-video" class="max-w-full max-h-[90vh] rounded-lg shadow-2xl hidden" controls playsinline controlsList="nodownload nofullscreen" disablePictureInPicture onclick="event.stopPropagation()"></video>
      <button class="absolute top-4 right-4 text-white/80 hover:text-white text-4xl leading-none" onclick="closeLightbox()" aria-label="Zamknij">&times;</button>
    </div>
    <script>
    function openLightbox(el){
      var lb=document.getElementById('lightbox'),img=document.getElementById('lightbox-img'),vid=document.getElementById('lightbox-video');
      img.src=el.src;img.alt=el.alt;
      img.classList.remove('hidden');vid.classList.add('hidden');
      lb.classList.remove('hidden');lb.classList.add('flex');
    }
    function openVideoLightbox(el){
      var lb=document.getElementById('lightbox'),img=document.getElementById('lightbox-img'),vid=document.getElementById('lightbox-video');
      vid.src=el.dataset.video;
      img.classList.add('hidden');vid.classList.remove('hidden');
      lb.classList.remove('hidden');lb.classList.add('flex');
      vid.play().catch(function(){});
    }
    function closeLightbox(){
      var lb=document.getElementById('lightbox'),vid=document.getElementById('lightbox-video');
      vid.pause();vid.removeAttribute('src');vid.load();
      lb.classList.add('hidden');lb.classList.remove('flex');
    }
    document.addEventListener('keydown',function(e){if(e.key==='Escape')closeLightbox()});
    </script>

