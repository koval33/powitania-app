<%- include('partials/head') %>

<section class="py-16 md:py-24">
  <div class="max-w-5xl mx-auto px-4">

    <!-- Hero -->
    <div class="text-center mb-16">
      <h1 class="text-3xl md:text-5xl font-bold text-white mb-6">Nagrania lektorskie</h1>
      <p class="text-gray-400 text-lg max-w-3xl mx-auto leading-relaxed">W związku z rosnącym zapotrzebowaniem na treści — zwłaszcza w Internecie — klienci biznesowi potrzebują stałego dostępu do szybko i&nbsp;sprawnie działającego <strong class="text-white">studia nagrań lektorskich</strong>. Działając na rynku od ponad 24 lat rozumiemy te potrzeby.</p>
    </div>

    <!-- Usługi — karty -->
    <div class="grid md:grid-cols-2 gap-6 mb-16">

      <!-- Zapowiedzi telefoniczne -->
      <a href="/nagrania-lektorskie/zapowiedzi-telefoniczne/" class="group bg-dark-800/60 border border-white/5 rounded-2xl p-8 hover:border-accent/30 transition-all hover:-translate-y-1">
        <div class="w-12 h-12 bg-accent/10 rounded-xl flex items-center justify-center mb-5">
          <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        </div>
        <h3 class="text-xl font-bold text-white mb-3 group-hover:text-accent transition-colors">Zapowiedzi telefoniczne</h3>
        <p class="text-gray-400 leading-relaxed">Profesjonalne nagrania IVR, powitania firmowe i komunikaty na centralę. Buduj profesjonalny wizerunek firmy od pierwszego połączenia.</p>
        <span class="inline-flex items-center mt-4 text-accent text-sm font-semibold group-hover:gap-2 transition-all">
          Dowiedz się więcej
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </span>
      </a>

      <!-- Głos do reklamy -->
      <a href="/nagrania-lektorskie/glos-do-reklamy/" class="group bg-dark-800/60 border border-white/5 rounded-2xl p-8 hover:border-accent/30 transition-all hover:-translate-y-1">
        <div class="w-12 h-12 bg-accent/10 rounded-xl flex items-center justify-center mb-5">
          <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/></svg>
        </div>
        <h3 class="text-xl font-bold text-white mb-3 group-hover:text-accent transition-colors">Głos do reklamy</h3>
        <p class="text-gray-400 leading-relaxed">Spoty radiowe, telewizyjne i internetowe. Zatrudnij rozpoznawalne głosy lektorów i stwórz skuteczną reklamę, która sprzedaje.</p>
        <span class="inline-flex items-center mt-4 text-accent text-sm font-semibold group-hover:gap-2 transition-all">
          Dowiedz się więcej
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </span>
      </a>

      <!-- Lektor do filmów -->
      <a href="/nagrania-lektorskie/profesjonalny-lektor-do-filmow/" class="group bg-dark-800/60 border border-white/5 rounded-2xl p-8 hover:border-accent/30 transition-all hover:-translate-y-1">
        <div class="w-12 h-12 bg-accent/10 rounded-xl flex items-center justify-center mb-5">
          <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
        </div>
        <h3 class="text-xl font-bold text-white mb-3 group-hover:text-accent transition-colors">Profesjonalny lektor do filmów</h3>
        <p class="text-gray-400 leading-relaxed">Narracja do filmów instruktażowych, korporacyjnych, e-learningowych i promocyjnych. Montaż audio-video w pakiecie.</p>
        <span class="inline-flex items-center mt-4 text-accent text-sm font-semibold group-hover:gap-2 transition-all">
          Dowiedz się więcej
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </span>
      </a>

      <!-- Sesje zdalne -->
      <a href="/sesje-zdalne-nagrania-lektorskie-online/" class="group bg-dark-800/60 border border-white/5 rounded-2xl p-8 hover:border-accent/30 transition-all hover:-translate-y-1">
        <div class="w-12 h-12 bg-accent/10 rounded-xl flex items-center justify-center mb-5">
          <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        </div>
        <h3 class="text-xl font-bold text-white mb-3 group-hover:text-accent transition-colors">Sesje zdalne</h3>
        <p class="text-gray-400 leading-relaxed">Weź udział w sesji nagraniowej zdalnie. Kontroluj proces nagrania w czasie rzeczywistym i przekazuj uwagi na bieżąco.</p>
        <span class="inline-flex items-center mt-4 text-accent text-sm font-semibold group-hover:gap-2 transition-all">
          Dowiedz się więcej
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        </span>
      </a>

    </div>

    <!-- Kto tworzy nasze studio -->
    <div class="bg-dark-800/50 rounded-2xl border border-white/5 p-8 md:p-12 mb-16">
      <h2 class="text-2xl md:text-3xl font-bold text-white mb-6">Kto tworzy nasze studio lektorskie?</h2>
      <div class="space-y-4 text-gray-400 leading-relaxed">
        <p><strong class="text-white">Lektorzy</strong> realizujący nagrania lektorskie w naszym studiu cechują się niepowtarzalną i&nbsp;charakterystyczną barwą głosu. Są to osoby obdarzone przez naturę głosem, który przyciąga uwagę i&nbsp;może uatrakcyjnić każdą reklamę bądź film.</p>
        <p>W naszej ofercie posiadamy również usługi lektorskie realizowane przez najbardziej doświadczonych w branży lektorów — w tym <a href="/lektorzy/stanislaw-olejniczak/" class="text-accent hover:text-accent-light">znanego lektora filmowego Stanisława Olejniczaka</a>, który jako jeden z nielicznych w branży potrafi czytać teksty synchronicznie.</p>
        <p>Swoją ofertę urozmaiciliśmy między innymi o <strong class="text-white">komunikaty lektorskie realizowane przez lektorów obcojęzycznych</strong>, co gwarantuje naturalne i oryginalne brzmienie dowolnego nagrania w języku obcym. Ich głosy znajdziecie w naszym <a href="/bank-glosow/" class="text-accent hover:text-accent-light">banku głosów</a>, w kategorii <a href="/bank/natives/" class="text-accent hover:text-accent-light">NATIVES</a>.</p>
      </div>
    </div>

    <!-- Dlaczego my -->
    <div class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold text-white mb-8 text-center">Dlaczego warto wybrać nasze nagrania?</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">

        <div class="text-center">
          <div class="w-14 h-14 mx-auto bg-accent/10 rounded-2xl flex items-center justify-center mb-4">
            <span class="text-2xl font-bold text-accent">230+</span>
          </div>
          <p class="text-white font-semibold mb-1">Lektorów</p>
          <p class="text-gray-500 text-sm">W ponad 30 językach</p>
        </div>

        <div class="text-center">
          <div class="w-14 h-14 mx-auto bg-accent/10 rounded-2xl flex items-center justify-center mb-4">
            <span class="text-2xl font-bold text-accent">24</span>
          </div>
          <p class="text-white font-semibold mb-1">Lata doświadczenia</p>
          <p class="text-gray-500 text-sm">Na rynku od 2001 roku</p>
        </div>

        <div class="text-center">
          <div class="w-14 h-14 mx-auto bg-accent/10 rounded-2xl flex items-center justify-center mb-4">
            <span class="text-2xl font-bold text-accent">48h</span>
          </div>
          <p class="text-white font-semibold mb-1">Realizacja</p>
          <p class="text-gray-500 text-sm">Standardowy czas dostawy</p>
        </div>

        <div class="text-center">
          <div class="w-14 h-14 mx-auto bg-accent/10 rounded-2xl flex items-center justify-center mb-4">
            <span class="text-2xl font-bold text-accent">5.0</span>
          </div>
          <p class="text-white font-semibold mb-1">Ocena klientów</p>
          <p class="text-gray-500 text-sm">Na podstawie 147 opinii</p>
        </div>

      </div>
    </div>

    <!-- CTA -->
    <div class="text-center p-8 md:p-12 bg-gradient-to-br from-accent/10 to-dark-800/50 rounded-2xl border border-accent/20">
      <h2 class="text-2xl font-bold text-white mb-4">Potrzebujesz nagrania lektorskiego?</h2>
      <p class="text-gray-400 mb-6 max-w-xl mx-auto">Przygotuj tekst w naszym kreatorze, wybierz lektora i zamów nagranie. Realizacja w ciągu 2 dni roboczych.</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/#kreator" class="bg-accent hover:bg-accent-light text-white px-8 py-3 rounded-lg font-semibold transition-colors">Przygotuj tekst</a>
        <a href="/bank-glosow/" class="bg-dark-700 hover:bg-dark-600 text-white px-8 py-3 rounded-lg font-semibold transition-colors border border-white/10">Wybierz lektora</a>
        <a href="/nagranie-ekspresowe/" class="bg-dark-700 hover:bg-dark-600 text-yellow-400 px-8 py-3 rounded-lg font-semibold transition-colors border border-yellow-400/20">Nagranie ekspresowe</a>
      </div>
    </div>

  </div>
</section>

