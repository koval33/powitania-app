    <!-- Studio Powitania.pl - od 2001 roku (E-E-A-T) -->
    <div class="mb-16">
      <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4 text-center">Studio Powitania.pl - od&nbsp;2001 roku</h2>
      <div class="grid md:grid-cols-3 gap-4 mb-8">
        <div class="bg-white rounded-xl border border-gray-200 p-5 text-center">
          <div class="text-4xl font-bold text-accent mb-2">25 lat</div>
