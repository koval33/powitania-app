<%
  // Usage: include('partials/inquiry-form', { formId: 'cennik', serviceType: 'general', heading: '...', subtitle: '...' })
  var fId = typeof formId !== 'undefined' ? formId : 'page';
  var sType = typeof serviceType !== 'undefined' ? serviceType : 'general';
  var fHeading = typeof heading !== 'undefined' ? heading : 'Zapytaj o wycenę';
  var fSubtitle = typeof subtitle !== 'undefined' ? subtitle : 'Opisz swój projekt — przygotujemy wycenę i odezwiemy się w ciągu 2 godzin.';
%>
<section class="py-12 border-t border-gray-200" id="zapytanie">
  <div class="max-w-xl mx-auto px-4">
    <h2 class="text-2xl font-bold text-gray-900 mb-2 text-center"><%= fHeading %></h2>
    <p class="text-gray-500 text-center mb-8"><%= fSubtitle %></p>
    <form id="<%= fId %>-inquiry-form" class="space-y-4 inline-inquiry-form" data-service-type="<%= sType %>">
      <div class="grid sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Imię / Firma</label>
          <input type="text" name="name" placeholder="Jan Kowalski" class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">E-mail <span class="text-red-500">*</span></label>
          <input type="email" name="email" required placeholder="jan@firma.pl" class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent">
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Telefon</label>
        <input type="tel" name="phone" placeholder="+48 600 000 000" class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Opis projektu</label>
        <textarea name="description" rows="4" placeholder="Opisz swój projekt — typ nagrania, ilość tekstu, termin realizacji..." class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent resize-none"></textarea>
      </div>
      <button type="submit" class="w-full bg-accent hover:bg-accent-light text-white font-semibold py-3 rounded-lg transition-colors inline-inquiry-submit">
        Wyślij zapytanie
      </button>
      <p class="text-xs text-gray-400 text-center">Odpowiemy w ciągu 1-2 godzin roboczych</p>
    </form>
    <div class="inline-inquiry-success hidden text-center py-8">
      <svg class="w-16 h-16 text-green-500 mx-auto mb-3" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h3 class="text-lg font-bold text-gray-900 mb-1">Zapytanie wysłane!</h3>
      <p class="text-sm text-gray-500">Odezwiemy się najszybciej jak to możliwe.</p>
    </div>
    <div class="inline-inquiry-error hidden mt-3 bg-red-50 border border-red-200 text-red-700 text-sm rounded-lg p-3"></div>
  </div>
</section>

<script>
(function() {
  var form = document.getElementById('<%= fId %>-inquiry-form');
  if (!form) return;
  form.addEventListener('submit', function(e) {
    e.preventDefault();
    var btn = form.querySelector('.inline-inquiry-submit');
    var errorEl = form.closest('div').parentElement.querySelector('.inline-inquiry-error');
    var successEl = form.closest('div').parentElement.querySelector('.inline-inquiry-success');
    if (errorEl) errorEl.classList.add('hidden');
    btn.disabled = true;
    btn.textContent = 'Wysyłanie...';

    var data = {
      email: form.querySelector('[name="email"]').value.trim(),
      name: form.querySelector('[name="name"]').value.trim(),
      phone: form.querySelector('[name="phone"]').value.trim(),
      description: form.querySelector('[name="description"]').value.trim(),
      serviceType: form.dataset.serviceType,
    };

    fetch('/api/contact/inquiry', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data),
    })
    .then(function(res) { return res.json(); })
    .then(function(result) {
      if (result.success || result.ok) {
        form.classList.add('hidden');
        if (successEl) successEl.classList.remove('hidden');
        if (typeof gtag === 'function') {
          gtag('event', 'generate_lead', { event_category: 'inquiry', event_label: data.serviceType });
        }
      } else {
        throw new Error(result.error || 'Wystąpił błąd');
      }
    })
    .catch(function(err) {
      if (errorEl) {
        errorEl.textContent = err.message || 'Nie udało się wysłać. Spróbuj ponownie.';
        errorEl.classList.remove('hidden');
      }
      btn.disabled = false;
      btn.textContent = 'Wyślij zapytanie';
    });
  });
})();
</script>
