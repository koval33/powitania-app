  if (toggle && menu) {
    toggle.addEventListener('click', function() { menu.classList.toggle('hidden'); });
  }

  // Cookie consent managed by CookieYes (script in head-en.ejs)
  // "Cookie Settings" link in footer calls window.revisitCkyConsent (CookieYes API)
  window.showConsentBanner = function() {
    if (typeof window.revisitCkyConsent === 'function') {
      window.revisitCkyConsent();
    }
  };

  // YouTube lazy-load facade (global)
  function loadYT(el) {
    var vid = el.getAttribute('data-vid');
    if (!vid) return;
    el.innerHTML = '<iframe style="position:absolute;top:0;left:0;width:100%;height:100%;border:0" src="https://www.youtube-nocookie.com/embed/' + vid + '?autoplay=1&rel=0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>';
    el.style.cursor = 'default';
    el.onclick = null;
  }
</script>

<% if (currentPath !== '/en/contact/') { %>
<!-- Callback widget: "We'll call you back in 30 minutes" (desktop only, appears after ~30 s of session) -->
<style>
  #cb-widget{display:none;position:fixed;right:24px;bottom:24px;z-index:45;font-family:inherit}
  @media (min-width:768px){#cb-widget.cb-show{display:block}}
  #cb-panel{display:none;position:absolute;right:0;bottom:104px;width:300px;background:#fff;border:1px solid #e5e7eb;border-radius:14px;box-shadow:0 12px 32px rgba(0,0,0,.16);padding:18px}
  #cb-panel.cb-open{display:block}
  #cb-panel h4{margin:0 0 4px;font-size:16px;font-weight:700;color:#111827}
  #cb-panel .cb-sub{margin:0 0 12px;font-size:12.5px;color:#6b7280}
  #cb-panel input[type=tel],#cb-panel input[type=text]{width:100%;box-sizing:border-box;border:1px solid #d1d5db;border-radius:8px;padding:9px 12px;font-size:14px;margin-bottom:8px;color:#111827}
  #cb-panel input:focus{outline:none;border-color:#d85a30}
  #cb-send{width:100%;background:#d85a30;color:#fff;border:none;cursor:pointer;padding:10px;border-radius:8px;font-weight:600;font-size:14px;transition:background .15s}
  #cb-send:hover{background:#e8734a}
  #cb-send:disabled{opacity:.6;cursor:default}
  #cb-close{position:absolute;top:10px;right:12px;background:none;border:none;cursor:pointer;color:#9ca3af;font-size:18px;line-height:1;padding:2px}
  #cb-close:hover{color:#111827}
  #cb-msg{font-size:13px;margin:8px 0 0;display:none}
  #cb-hp{position:absolute;left:-9999px;opacity:0;height:0;width:0}
  #cb-launcher{display:flex;flex-direction:column;align-items:center;gap:8px}
  #cb-fab-wrap{position:relative;line-height:0}
  #cb-fab{width:60px;height:60px;border-radius:50%;background:#d85a30;color:#fff;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;box-shadow:0 6px 18px rgba(0,0,0,.3);transition:background .15s;padding:0}
  #cb-fab:hover{background:#e8734a}
  #cb-fab svg{width:26px;height:26px}
  #cb-min{position:absolute;top:-3px;right:-3px;width:22px;height:22px;border-radius:50%;background:#111827;color:#cbd5e1;border:1.5px solid #fff;cursor:pointer;font-size:13px;line-height:1;display:flex;align-items:center;justify-content:center;padding:0}
  #cb-min:hover{color:#fff}
  #cb-fab-label{background:rgba(17,24,39,.85);color:#fff;font-size:12px;font-weight:600;padding:4px 11px;border-radius:9999px;white-space:nowrap;cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,.18)}
  #cb-widget.cb-mini #cb-fab-label,#cb-widget.cb-mini #cb-min{display:none}
</style>
<div id="cb-widget">
  <div id="cb-panel" role="dialog" aria-label="Request a call">
    <button id="cb-close" type="button" aria-label="Close">&times;</button>
    <h4>Leave your number</h4>
    <p class="cb-sub" id="cb-promise">We'll call you back within 30 minutes.</p>
    <input type="text" id="cb-name" placeholder="Name (optional)" autocomplete="name">
    <input type="tel" id="cb-phone" placeholder="Your phone number" autocomplete="tel" required>
    <input type="text" id="cb-hp" name="website" tabindex="-1" autocomplete="off">
    <button id="cb-send" type="button">Request a call</button>
    <p id="cb-msg"></p>
  </div>
  <div id="cb-launcher">
    <div id="cb-fab-wrap">
      <button id="cb-fab" type="button" aria-haspopup="dialog" aria-label="Request a call">
        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg>
      </button>
      <button id="cb-min" type="button" aria-label="Minimize" title="Minimize">&times;</button>
    </div>
    <span id="cb-fab-label">Request a call</span>
  </div>
</div>
<script>
(function(){
  var SHOW_AFTER_MS = 30000;
  try {
    if (sessionStorage.getItem('cbDone')) return;
    var t0 = parseInt(sessionStorage.getItem('cbT0') || '0', 10);
    if (!t0) { t0 = Date.now(); sessionStorage.setItem('cbT0', String(t0)); }
  } catch(e) { var t0 = Date.now(); }

  var w = document.getElementById('cb-widget');
  var panel = document.getElementById('cb-panel');
  if (!w) return;

  // Promise depends on office hours (Mon-Fri 8-18, Poland time)
  function inWorkHours() {
    try {
      var parts = new Intl.DateTimeFormat('en-US', { timeZone: 'Europe/Warsaw', hour: 'numeric', weekday: 'short', hour12: false }).formatToParts(new Date());
      var h = 0, wd = '';
      parts.forEach(function(p){ if (p.type === 'hour') h = parseInt(p.value, 10); if (p.type === 'weekday') wd = p.value; });
      var weekend = wd === 'Sat' || wd === 'Sun';
      return !weekend && h >= 8 && h < 18;
    } catch(e) { return true; }
  }
  if (!inWorkHours()) {
    document.getElementById('cb-promise').textContent = 'We\'ll call you back on the next business day after 8:00 CET.';
  }

  var delay = Math.max(0, SHOW_AFTER_MS - (Date.now() - t0));
  setTimeout(function(){ w.classList.add('cb-show'); }, delay);

  // Minimized state (circle only, no label) - remembered for the session
  try { if (sessionStorage.getItem('cbMin')) w.classList.add('cb-mini'); } catch(e) {}
  function togglePanel(){
    if (panel.classList.contains('cb-open')) { panel.classList.remove('cb-open'); return; }
    w.classList.remove('cb-mini');
    try { sessionStorage.removeItem('cbMin'); } catch(e) {}
    panel.classList.add('cb-open');
    document.getElementById('cb-phone').focus();
  }
  document.getElementById('cb-fab').addEventListener('click', togglePanel);
  document.getElementById('cb-fab-label').addEventListener('click', togglePanel);
  document.getElementById('cb-min').addEventListener('click', function(e){
    e.stopPropagation();
    w.classList.add('cb-mini');
    panel.classList.remove('cb-open');
    try { sessionStorage.setItem('cbMin', '1'); } catch(e) {}
  });
  document.getElementById('cb-close').addEventListener('click', function(){ panel.classList.remove('cb-open'); });

  document.getElementById('cb-send').addEventListener('click', function(){
    var btn = this;
    var phone = document.getElementById('cb-phone').value.trim();
    var msg = document.getElementById('cb-msg');
    if (!phone) { msg.style.display = 'block'; msg.style.color = '#dc2626'; msg.textContent = 'Please provide your phone number.'; return; }
    btn.disabled = true; btn.textContent = 'Sending...';
    fetch('/api/contact/callback', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        phone: phone,
        name: document.getElementById('cb-name').value.trim(),
        page: location.pathname,
        website: document.getElementById('cb-hp').value,
        lang: 'en'
      })
    })
    .then(function(r){ return r.json(); })
    .then(function(res){
      msg.style.display = 'block';
      if (res.ok) {
        if (window.trackEventEC) trackEventEC('callback_request', { page: location.pathname }, null, phone);
        else if (window.trackEvent) trackEvent('callback_request', { page: location.pathname });
        msg.style.color = '#059669'; msg.textContent = res.message || 'Thank you! We will call you back shortly.';
        btn.textContent = 'Sent ✓';
        try { sessionStorage.setItem('cbDone', '1'); } catch(e) {}
        setTimeout(function(){ w.classList.remove('cb-show'); }, 4000);
      } else {
        msg.style.color = '#dc2626'; msg.textContent = res.error || 'An error occurred. Please call us directly.';
        btn.disabled = false; btn.textContent = 'Request a call';
      }
    })
    .catch(function(){
      msg.style.display = 'block'; msg.style.color = '#dc2626'; msg.textContent = 'Connection error. Call us: +48 605 491 069.';
      btn.disabled = false; btn.textContent = 'Request a call';
    });
  });
})();
</script>
<% } %>

