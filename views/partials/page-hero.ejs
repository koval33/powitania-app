<%# Reusable hero podstron - ciemny full-bleed (menu na obrazie), zdjecie studia B&W,
    dolina pod tekstem (desktop) / mocniejszy scrim (mobile). Locals:
    - breadcrumbs: [{name,url}] (z route; ostatni element = biezaca strona, bez linku)
    - heroH1   : naglowek (dopuszcza HTML, np. &nbsp;)
    - heroSub  : podtytul (dopuszcza HTML; voiceCount mozna wstrzyknac z widoku)
    - heroCta  : 'glosy' (Posluchaj glosow) | 'wycena' (Przeslij tekst do wyceny) | 'none'
    Naglowek transparentnego headera wlacza flaga `pageHeroTransparent: true` w route. %>
<section class="relative overflow-hidden bg-[#2e333d] border-b border-white/10">
  <div class="hero-photo hero-photo-left">
    <img src="/img/studio-bg-1920.bw-backup.webp"
         srcset="/img/studio-bg-960.bw-backup.webp 960w, /img/studio-bg-1920.bw-backup.webp 1920w"
         sizes="100vw"
         alt="Studio nagrań lektorskich Powitania.pl - lektor przy mikrofonie"
         width="1920" height="980" loading="eager"
         class="w-full h-full object-cover" style="object-position: 50% 8%;">
    <div class="hero-fade hero-fade-left"></div>
    <span class="hidden lg:inline-flex absolute bottom-6 left-6 items-center gap-2 bg-gray-900/70 text-white text-[0.7rem] font-bold uppercase tracking-wider px-3 py-1.5 rounded-full">
      <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>REC
    </span>
  </div>

  <div class="relative z-10 min-h-[380px] md:min-h-[420px] flex items-center pt-20 md:pt-24 pb-6">
    <div class="ml-auto w-full lg:w-[44%] lg:mr-[2%] px-6 md:px-10 lg:px-6">
      <% if (typeof breadcrumbs !== 'undefined' && breadcrumbs && breadcrumbs.length) { %>
      <nav class="text-sm text-gray-400 mb-3 flex items-center flex-wrap gap-1.5" aria-label="Okruszki">
        <% breadcrumbs.forEach(function(c, i) { %>
          <% if (i < breadcrumbs.length - 1) { %>
            <a href="<%= c.url %>" class="hover:text-accent-light transition-colors"><%= c.name %></a>
            <span class="text-gray-600">›</span>
          <% } else { %>
            <span class="text-accent-light font-medium"><%= c.name %></span>
          <% } %>
        <% }); %>
      </nav>
      <% } %>
      <h1 class="text-2xl md:text-3xl lg:text-[2rem] font-bold text-white leading-[1.12] mb-2.5"><%- heroH1 %></h1>
      <p class="text-base md:text-lg text-gray-300 leading-relaxed mb-4"><%- heroSub %></p>
      <% if (typeof heroCtaHtml !== 'undefined' && heroCtaHtml) { %>
      <%# Wlasne przyciski CTA (np. jingle: Posluchaj realizacji + Zamow wycene + Zadzwon) %>
      <div class="flex flex-col sm:flex-row sm:flex-wrap gap-3"><%- heroCtaHtml %></div>
      <% } else { %>
      <% var _cta = (typeof heroCta !== 'undefined') ? heroCta : 'wycena'; %>
      <% if (_cta !== 'none') { %>
      <div class="flex flex-col sm:flex-row gap-3">
        <% if (_cta === 'glosy') { %>
          <a href="/bank-glosow/#glosy" class="bg-accent hover:bg-accent-light text-white px-7 py-3 rounded-lg font-semibold text-center transition-colors">Posłuchaj głosów</a>
        <% } else { %>
          <a href="/kontakt/#formularz" class="bg-accent hover:bg-accent-light text-white px-7 py-3 rounded-lg font-semibold text-center transition-colors">Prześlij tekst do wyceny</a>
        <% } %>
        <a href="tel:+48605491069" class="border border-white/30 hover:border-white/60 text-white px-7 py-3 rounded-lg font-semibold text-center transition-colors inline-flex items-center justify-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg>
          Zadzwoń: 605 491 069
        </a>
      </div>
      <% } %>
      <% } %>
    </div>
  </div>
</section>
