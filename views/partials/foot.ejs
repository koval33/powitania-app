    </button>
    <button id="cb-min" type="button" aria-label="Zwiń" title="Zwiń">&times;</button>
  </div>
  <button id="cb-dot" type="button" aria-label="Zamów rozmowę" title="Zamów rozmowę">
    <svg width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg>
  </button>
</div>
<script>
(function(){
  var SHOW_AFTER_MS = 30000;
  try {
    if (sessionStorage.getItem('cbDone')) return;
    var t0 = parseInt(sessionStorage.getItem('cbT0') || '0', 10);
    if (!t0) { t0 = Date.now(); sessionStorage.setItem('cbT0', String(t0)); }
  } catch(e) { var t0 = Date.now(); }

  var w = document.getElementById('cb-widget');
  var panel = document.getElementById('cb-panel');
  if (!w) return;

  // Obietnica zalezna od godzin pracy (pon-pt 8-18, czas PL)
  function inWorkHours() {
    try {
      var parts = new Intl.DateTimeFormat('pl-PL', { timeZone: 'Europe/Warsaw', hour: 'numeric', weekday: 'short', hour12: false }).formatToParts(new Date());
      var h = 0, wd = '';
      parts.forEach(function(p){ if (p.type === 'hour') h = parseInt(p.value, 10); if (p.type === 'weekday') wd = p.value; });
      var weekend = wd.indexOf('sob') === 0 || wd.indexOf('niedz') === 0;
      return !weekend && h >= 8 && h < 18;
    } catch(e) { return true; }
  }
  if (!inWorkHours()) {
    document.getElementById('cb-promise').textContent = 'Oddzwonimy następnego dnia roboczego po 8:00.';
    document.querySelector('#cb-pill span').textContent = 'Zamów rozmowę';
  }

  var delay = Math.max(0, SHOW_AFTER_MS - (Date.now() - t0));
  setTimeout(function(){ w.classList.add('cb-show'); }, delay);

  // Zwiniety stan (kropka) - pamietany przez sesje
  try { if (sessionStorage.getItem('cbMin')) w.classList.add('cb-mini'); } catch(e) {}
  document.getElementById('cb-min').addEventListener('click', function(){
    w.classList.add('cb-mini');
    panel.classList.remove('cb-open');
    try { sessionStorage.setItem('cbMin', '1'); } catch(e) {}
  });
  document.getElementById('cb-dot').addEventListener('click', function(){
    w.classList.remove('cb-mini');
    try { sessionStorage.removeItem('cbMin'); } catch(e) {}
    panel.classList.add('cb-open');
    document.getElementById('cb-phone').focus();
  });

  document.getElementById('cb-pill').addEventListener('click', function(){
    panel.classList.toggle('cb-open');
    if (panel.classList.contains('cb-open')) document.getElementById('cb-phone').focus();
  });
  document.getElementById('cb-close').addEventListener('click', function(){ panel.classList.remove('cb-open'); });

  document.getElementById('cb-send').addEventListener('click', function(){
    var btn = this;
    var phone = document.getElementById('cb-phone').value.trim();
    var msg = document.getElementById('cb-msg');
    if (!phone) { msg.style.display = 'block'; msg.style.color = '#dc2626'; msg.textContent = 'Podaj numer telefonu.'; return; }
    btn.disabled = true; btn.textContent = 'Wysyłanie...';
    fetch('/api/contact/callback', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        phone: phone,
        name: document.getElementById('cb-name').value.trim(),
        page: location.pathname,
        website: document.getElementById('cb-hp').value
      })
    })
    .then(function(r){ return r.json(); })
    .then(function(res){
      msg.style.display = 'block';
      if (res.ok) {
        if (window.trackEvent) trackEvent('callback_request', { page: location.pathname });
        msg.style.color = '#059669'; msg.textContent = res.message || 'Dziękujemy! Wkrótce oddzwonimy.';
        btn.textContent = 'Wysłano ✓';
        try { sessionStorage.setItem('cbDone', '1'); } catch(e) {}
        setTimeout(function(){ w.classList.remove('cb-show'); }, 4000);
      } else {
        msg.style.color = '#dc2626'; msg.textContent = res.error || 'Błąd wysyłania. Zadzwoń do nas bezpośrednio.';
        btn.disabled = false; btn.textContent = 'Zamów rozmowę';
      }
    })
    .catch(function(){
      msg.style.display = 'block'; msg.style.color = '#dc2626'; msg.textContent = 'Błąd połączenia. Zadzwoń: +48 605 491 069.';
      btn.disabled = false; btn.textContent = 'Zamów rozmowę';
    });
  });
})();
</script>
<% } %>

<script src="/js/ga-events.js?v=<%= typeof assetVersion !== 'undefined' ? assetVersion : '' %>" defer></script>
</body>
</html>
