  window.showConsentBanner = function() {
    if (typeof window.revisitCkyConsent === 'function') {
      window.revisitCkyConsent();
    }
  };

  // YouTube lazy-load facade (globalnie)
  function loadYT(el) {
    var vid = el.getAttribute('data-vid');
    if (!vid) return;
    el.innerHTML = '<iframe style="position:absolute;top:0;left:0;width:100%;height:100%;border:0" src="https://www.youtube-nocookie.com/embed/' + vid + '?autoplay=1&rel=0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>';
    el.style.cursor = 'default';
    el.onclick = null;
  }
</script>

