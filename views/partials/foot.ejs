<div id="cb-widget">
  <div id="cb-panel" role="dialog" aria-label="Zamów rozmowę">
    <button id="cb-close" type="button" aria-label="Zamknij">&times;</button>
    <h4>Zostaw numer</h4>
    <p class="cb-sub" id="cb-promise">Oddzwonimy w ciągu 30 minut.</p>
    <input type="text" id="cb-name" placeholder="Imię (opcjonalnie)" autocomplete="name">
    <input type="tel" id="cb-phone" placeholder="Twój numer telefonu" autocomplete="tel" required>
    <input type="text" id="cb-hp" name="website" tabindex="-1" autocomplete="off">
    <button id="cb-send" type="button">Zamów rozmowę</button>
    <p id="cb-msg"></p>
  </div>
  <div id="cb-pill-wrap">
    <button id="cb-pill" type="button" aria-haspopup="dialog">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg>
