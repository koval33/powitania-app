<!-- Cookie Consent Banner (Google Consent Mode v2) -->
<div id="consent-banner" class="fixed bottom-0 left-0 right-0 z-[9999] hidden" role="dialog" aria-label="Zgoda na cookies" aria-modal="false">
  <div class="relative bg-white border-t border-gray-200 shadow-2xl shadow-gray-300/50">
    <div class="max-w-5xl mx-auto px-4 py-5">

      <!-- Widok główny -->
