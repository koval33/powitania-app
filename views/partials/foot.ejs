<script>
(function(){
  var bar = document.getElementById('mobile-cta-bar');
  if (!bar) return;
  var lastY = window.pageYOffset || 0;
  var kreatorVisible = false;
  var hiddenByScroll = false;
  var heroVisible = false;
  var hasHero = false;
  function apply() {
    // Strony z hero: pasek persistent PO hero (ignoruje scroll-down-hide), schowany na hero.
    // Strony bez hero: stara logika scroll-aware (chowa przy scrollu w dol).
    if (kreatorVisible || heroVisible || (!hasHero && hiddenByScroll)) {
      bar.style.transform = 'translateY(110%)';
    } else {
      bar.style.transform = 'translateY(0)';
    }
  }
  // Hide on scroll down, show on scroll up (only after small threshold)
  window.addEventListener('scroll', function() {
    var y = window.pageYOffset || 0;
    var dy = y - lastY;
    if (Math.abs(dy) < 8) return; // ignore tiny jitters
    if (dy > 0 && y > 120) {
      hiddenByScroll = true;
    } else if (dy < 0) {
      hiddenByScroll = false;
    }
    lastY = y;
    updateHero();
    apply();
  }, { passive: true });
  // Hide when kreator is visible on screen
  var kreator = document.getElementById('kreator-root') || document.getElementById('kreator');
  if (kreator && 'IntersectionObserver' in window) {
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        kreatorVisible = e.isIntersecting;
        apply();
      });
    }, { threshold: 0.15 });
    io.observe(kreator);
  }
  // Pasek pojawia sie dopiero PO przewinieciu za hero (hero ma wlasne CTA - nie dublujemy na gorze).
  // Widocznosc hero liczona ze scrolla (getBoundingClientRect) - pewniejsze niz IntersectionObserver.
  var heroEl = document.querySelector('[data-page-hero]') || document.querySelector('section.hero');
  hasHero = !!heroEl;
  function updateHero() {
    if (heroEl) heroVisible = heroEl.getBoundingClientRect().bottom > 0;
  }
  updateHero();
  apply();
  window.addEventListener('resize', function(){ updateHero(); apply(); }, { passive: true });
})();
</script>
<% } %>

