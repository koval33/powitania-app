  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'powitania.pl' %></title>
  <meta name="description" content="<%= typeof description !== 'undefined' ? description : '' %>">
  <% if ((typeof noindex !== 'undefined' && noindex) || (typeof hasNoindexQuery !== 'undefined' && hasNoindexQuery)) { %>
  <meta name="robots" content="noindex, follow">
  <% } %>

  <!-- Canonical -->
  <link rel="canonical" href="https://www.powitania.pl<%= currentPath %>">
  <% if (typeof hreflangPL !== 'undefined' && hreflangPL && typeof hreflangEN !== 'undefined' && hreflangEN) { %>
  <link rel="alternate" hreflang="pl" href="<%= hreflangPL %>">
  <link rel="alternate" hreflang="en" href="<%= hreflangEN %>">
  <link rel="alternate" hreflang="x-default" href="<%= hreflangPL %>">
  <% } %>

  <!-- Favicon -->
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">

  <!-- Open Graph -->
  <meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'powitania.pl' %>">
  <meta property="og:description" content="<%= typeof description !== 'undefined' ? description : '' %>">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://www.powitania.pl<%= currentPath %>">
  <meta property="og:image" content="<%= typeof ogImage !== 'undefined' ? ogImage : 'https://www.powitania.pl/img/og-default.jpg' %>">
  <meta property="og:locale" content="pl_PL">
  <meta property="og:site_name" content="powitania.pl">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= typeof title !== 'undefined' ? title : 'powitania.pl' %>">
  <meta name="twitter:description" content="<%= typeof description !== 'undefined' ? description : '' %>">
  <meta name="twitter:image" content="<%= typeof ogImage !== 'undefined' ? ogImage : 'https://www.powitania.pl/img/og-default.jpg' %>">

  <!-- JSON-LD: Organization + LocalBusiness -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": ["Organization", "LocalBusiness"],
    "@id": "https://www.powitania.pl/#organization",
    "name": "Powitania.pl - OPTIMUM Paweł Kowalski",
    "url": "https://www.powitania.pl",
    "logo": "https://www.powitania.pl/img/logo-powitania.png",
    "image": "https://www.powitania.pl/img/og-default.jpg",
    "description": "Profesjonalne studio nagrań lektorskich. <%= voiceCount %> lektorów, 30+ języków, 25 lat doświadczenia.",
    "telephone": "+48605491069",
    "email": "biuro@powitania.pl",
    "priceRange": "300 PLN - 2200 PLN",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "ul. Fiołkowa 36",
      "addressLocality": "Solec",
      "addressRegion": "mazowieckie",
      "postalCode": "05-532",
      "addressCountry": "PL"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": "52.045040",
      "longitude": "21.111179"
    },
    "openingHoursSpecification": [
      {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
        "opens": "08:00",
        "closes": "18:00"
      }
    ],
    "sameAs": [
      "https://www.facebook.com/powitania",
      "https://www.instagram.com/powitania.pl"
    ],
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "5.0",
      "reviewCount": "<%= typeof reviewCount !== 'undefined' ? reviewCount : 147 %>",
      "bestRating": "5",
      "worstRating": "1"
    },
    <% if (typeof reviewsForSchema !== 'undefined' && Array.isArray(reviewsForSchema) && reviewsForSchema.length > 0) { %>
    "review": [
      <% reviewsForSchema.forEach(function(r, i) { %>
      {
        "@type": "Review",
        "reviewRating": { "@type": "Rating", "ratingValue": "5.0", "bestRating": "5", "worstRating": "1" },
        "author": { "@type": "Person", "name": <%- JSON.stringify(r.author || r.company) %> },
        "reviewBody": <%- JSON.stringify(r.text) %>,
        "datePublished": "<%= new Date(r.date || r.createdAt).toISOString().split('T')[0] %>"
      }<%= i < reviewsForSchema.length - 1 ? ',' : '' %>
      <% }); %>
    ],
    <% } %>
    "foundingDate": "2001",
    "slogan": "Profesjonalne studio lektorskie od 2001 roku",
    "knowsAbout": ["voice-over", "lektor", "nagrania lektorskie", "IVR", "zapowiedzi telefoniczne", "audiobook", "spoty reklamowe", "narracje filmowe", "e-learning", "sesje zdalne"]
  }
  </script>

  <!-- JSON-LD: BreadcrumbList -->
  <% if (typeof breadcrumbs !== 'undefined' && breadcrumbs.length > 0) { %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      <% breadcrumbs.forEach(function(bc, i) { %>
      {
        "@type": "ListItem",
        "position": <%= i + 1 %>,
        "name": "<%= bc.name %>",
        "item": "https://www.powitania.pl<%= bc.url %>"
      }<%= i < breadcrumbs.length - 1 ? ',' : '' %>
      <% }); %>
    ]
  }
  </script>
  <% } %>

  <!-- JSON-LD: WebPage -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://www.powitania.pl<%= currentPath %>#webpage",
    "name": "<%= typeof title !== 'undefined' ? title : 'powitania.pl' %>",
    "description": "<%= typeof description !== 'undefined' ? description : '' %>",
    "url": "https://www.powitania.pl<%= currentPath %>",
    "inLanguage": "pl-PL",
    "isPartOf": { "@id": "https://www.powitania.pl/#website" },
    "about": { "@id": "https://www.powitania.pl/#organization" }
  }
  </script>

  <% if (typeof serviceSchema !== 'undefined') { %>
  <!-- JSON-LD: Service -->
  <script type="application/ld+json">
  <%- JSON.stringify(serviceSchema) %>
  </script>
  <% } %>

  <!-- JSON-LD: WebSite + SearchAction (sitelinks search box w SERP dla brand queries) -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": "https://www.powitania.pl/#website",
    "url": "https://www.powitania.pl",
    "name": "Powitania.pl - Profesjonalne Studio Nagrań Lektorskich",
    "alternateName": "Powitania",
    "inLanguage": "pl-PL",
    "publisher": { "@id": "https://www.powitania.pl/#organization" },
    "potentialAction": {
      "@type": "SearchAction",
      "target": {
        "@type": "EntryPoint",
        "urlTemplate": "https://www.powitania.pl/bank-glosow/?search={search_term_string}"
      },
      "query-input": "required name=search_term_string"
    }
  }
  </script>

  <%/* GTM preconnect removed - GTM is now deferred until after load/interaction */%>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
