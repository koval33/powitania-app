<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'powitania.pl' %></title>
  <meta name="description" content="<%= typeof description !== 'undefined' ? description : '' %>">
  <meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'powitania.pl' %>">
  <meta property="og:description" content="<%= typeof description !== 'undefined' ? description : '' %>">
  <meta property="og:type" content="website">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            dark: { 900: '#0f172a', 800: '#1e293b', 700: '#334155', 600: '#475569' },
            accent: { DEFAULT: '#10b981', light: '#34d399', dark: '#059669' }
          }
        }
      }
    }
  </script>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-white text-slate-700 antialiased">

<% if (!skipHeader) { %>
<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-slate-200 shadow-sm">
  <nav class="w-full max-w-screen-2xl mx-auto px-8 py-5 flex items-center justify-between">
    <a href="/" class="flex flex-col items-start gap-0">
      <img src="/img/logo-powitania.png" alt="powitania.pl" class="h-11 md:h-14">
      <span class="text-[0.6rem] md:text-xs font-bold tracking-[0.2em] uppercase text-slate-500 pl-[2.4rem] md:pl-[3.2rem] -mt-0.5">Twórz treści. Nadaj im głos.</span>
    </a>

    <div class="hidden md:flex items-center gap-7 text-base font-medium">
      <a href="/bank-glosow/" class="hover:text-slate-900 transition-colors <%= currentPath === '/bank-glosow/' ? 'text-slate-900' : 'text-slate-600' %>">Bank głosów</a>
      <a href="/nagrania-lektorskie/" class="hover:text-slate-900 transition-colors <%= currentPath === '/nagrania-lektorskie/' ? 'text-slate-900' : 'text-slate-600' %>">Nagrania lektorskie</a>
      <a href="/sesje-zdalne/" class="hover:text-slate-900 transition-colors <%= currentPath === '/sesje-zdalne/' ? 'text-slate-900' : 'text-slate-600' %>">Sesje zdalne</a>
      <a href="/cennik/" class="hover:text-slate-900 transition-colors <%= currentPath === '/cennik/' ? 'text-slate-900' : 'text-slate-600' %>">Cennik</a>
      <a href="/opinie/" class="hover:text-slate-900 transition-colors <%= currentPath === '/opinie/' ? 'text-slate-900' : 'text-slate-600' %>">Opinie</a>
      <a href="/kontakt/" class="hover:text-slate-900 transition-colors <%= currentPath === '/kontakt/' ? 'text-slate-900' : 'text-slate-600' %>">Kontakt</a>
      <a href="/#kreator" class="bg-accent hover:bg-accent-light text-white px-5 py-2 rounded-lg transition-colors font-semibold">Twórz</a>
    </div>

    <button id="menu-toggle" class="md:hidden p-2 rounded-lg hover:bg-slate-100 text-slate-600">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>
  </nav>

  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 bg-white px-4 pb-4">
    <a href="/bank-glosow/" class="block py-3 text-slate-600 hover:text-slate-900 border-b border-slate-100">Bank głosów</a>
    <a href="/nagrania-lektorskie/" class="block py-3 text-slate-600 hover:text-slate-900 border-b border-slate-100">Nagrania lektorskie</a>
    <a href="/sesje-zdalne/" class="block py-3 text-slate-600 hover:text-slate-900 border-b border-slate-100">Sesje zdalne</a>
    <a href="/cennik/" class="block py-3 text-slate-600 hover:text-slate-900 border-b border-slate-100">Cennik</a>
    <a href="/opinie/" class="block py-3 text-slate-600 hover:text-slate-900 border-b border-slate-100">Opinie</a>
    <a href="/kontakt/" class="block py-3 text-slate-600 hover:text-slate-900 border-b border-slate-100">Kontakt</a>
    <a href="/#kreator" class="block mt-3 bg-accent text-white text-center px-5 py-3 rounded-lg font-semibold">Twórz</a>
  </div>
</header>
<% } %>

<main>
