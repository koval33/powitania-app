<!DOCTYPE html>
<html lang="pl">
<head>
  <% if (gtmId) { %>
  <!-- Google Consent Mode v2 — domyślne ustawienia (MUSI być PRZED GTM) -->
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('consent', 'default', {
      'ad_storage':           'denied',
      'ad_user_data':         'denied',
      'ad_personalization':   'denied',
      'analytics_storage':    'denied',
      'functionality_storage':'granted',
      'security_storage':     'granted',
      'wait_for_update':      500
    });
    (function(){
      var s = localStorage.getItem('cookie-consent-v2');
      if (s) { try { gtag('consent', 'update', JSON.parse(s)); } catch(e){} }
    })();
  </script>
  <!-- Google Tag Manager -->
  <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','<%= gtmId %>');</script>
  <% } %>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'powitania.pl' %></title>
  <meta name="description" content="<%= typeof description !== 'undefined' ? description : '' %>">

  <!-- Canonical -->
  <link rel="canonical" href="https://www.powitania.pl<%= currentPath %>">

  <!-- Favicon -->
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">

  <!-- Open Graph -->
  <meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'powitania.pl' %>">
  <meta property="og:description" content="<%= typeof description !== 'undefined' ? description : '' %>">
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://www.powitania.pl<%= currentPath %>">
  <meta property="og:image" content="<%= typeof ogImage !== 'undefined' ? ogImage : 'https://www.powitania.pl/img/og-default.jpg' %>">
  <meta property="og:locale" content="pl_PL">
  <meta property="og:site_name" content="powitania.pl">

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= typeof title !== 'undefined' ? title : 'powitania.pl' %>">
  <meta name="twitter:description" content="<%= typeof description !== 'undefined' ? description : '' %>">
  <meta name="twitter:image" content="<%= typeof ogImage !== 'undefined' ? ogImage : 'https://www.powitania.pl/img/og-default.jpg' %>">

  <!-- JSON-LD: Organization + LocalBusiness -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": ["Organization", "LocalBusiness"],
    "name": "Powitania.pl — OPTIMUM Paweł Kowalski",
    "url": "https://www.powitania.pl",
    "logo": "https://www.powitania.pl/img/logo-powitania.png",
    "image": "https://www.powitania.pl/img/og-default.jpg",
    "description": "Profesjonalne studio nagrań lektorskich. Ponad 230 lektorów, 30+ języków, 24 lata doświadczenia.",
    "telephone": "+48605491069",
    "email": "biuro@powitania.pl",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "ul. Pozytywistów 4/4",
      "addressLocality": "Lublin",
      "postalCode": "20-639",
      "addressCountry": "PL"
    },
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
      "opens": "08:00",
      "closes": "18:00"
    },
    "sameAs": [
      "https://www.facebook.com/powitania",
      "https://www.instagram.com/powitania.pl"
    ],
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "5",
      "reviewCount": "<%= typeof reviewCount !== 'undefined' ? reviewCount : 147 %>"
    },
    "foundingDate": "2001"
  }
  </script>

  <!-- JSON-LD: BreadcrumbList -->
  <% if (typeof breadcrumbs !== 'undefined' && breadcrumbs.length > 0) { %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      <% breadcrumbs.forEach(function(bc, i) { %>
      {
        "@type": "ListItem",
        "position": <%= i + 1 %>,
        "name": "<%= bc.name %>",
        "item": "https://www.powitania.pl<%= bc.url %>"
      }<%= i < breadcrumbs.length - 1 ? ',' : '' %>
      <% }); %>
    ]
  }
  </script>
  <% } %>

  <!-- JSON-LD: WebPage -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "<%= typeof title !== 'undefined' ? title : 'powitania.pl' %>",
    "description": "<%= typeof description !== 'undefined' ? description : '' %>",
    "url": "https://www.powitania.pl<%= currentPath %>"
  }
  </script>

  <% if (gtmId) { %>
  <link rel="preconnect" href="https://www.googletagmanager.com">
  <link rel="dns-prefetch" href="https://www.googletagmanager.com">
  <% } %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            dark: { 900: '#1a1d23', 800: '#22262e', 700: '#2a2f38', 600: '#343842' },
            accent: { DEFAULT: '#f97316', light: '#fb923c', dark: '#ea580c' }
          }
        }
      }
    }
  </script>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-white text-gray-700 antialiased">

<% if (!skipHeader) { %>
<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-gray-200 shadow-sm">
  <nav class="w-full max-w-screen-2xl mx-auto px-8 py-5 flex items-center justify-between">
    <a href="/" class="flex flex-col items-start gap-0">
      <img src="/img/logo-powitania.png" alt="powitania.pl" class="h-11 md:h-14" style="filter: brightness(0) saturate(0);">
      <span class="text-[0.6rem] md:text-xs font-bold tracking-[0.2em] uppercase text-gray-500 pl-[2.4rem] md:pl-[3.2rem] -mt-0.5">Twórz treści. Nadaj im głos.</span>
    </a>

    <div class="hidden md:flex items-center gap-7 text-base font-medium">
      <a href="/bank-glosow/" class="hover:text-gray-900 transition-colors <%= currentPath === '/bank-glosow/' ? 'text-gray-900 font-semibold' : 'text-gray-600' %>">Bank głosów</a>
      <a href="/nagrania-lektorskie/" class="hover:text-gray-900 transition-colors <%= currentPath === '/nagrania-lektorskie/' ? 'text-gray-900 font-semibold' : 'text-gray-600' %>">Nagrania lektorskie</a>
      <a href="/sesje-zdalne-nagrania-lektorskie-online/" class="hover:text-gray-900 transition-colors <%= currentPath === '/sesje-zdalne-nagrania-lektorskie-online/' ? 'text-gray-900 font-semibold' : 'text-gray-600' %>">Sesje zdalne</a>
      <a href="/cennik/" class="hover:text-gray-900 transition-colors <%= currentPath === '/cennik/' ? 'text-gray-900 font-semibold' : 'text-gray-600' %>">Cennik</a>
      <a href="/opinie/" class="hover:text-gray-900 transition-colors <%= currentPath === '/opinie/' ? 'text-gray-900 font-semibold' : 'text-gray-600' %>">Opinie</a>
      <a href="/kontakt/" class="hover:text-gray-900 transition-colors <%= currentPath === '/kontakt/' ? 'text-gray-900 font-semibold' : 'text-gray-600' %>">Kontakt</a>
      <a href="/#kreator" class="bg-accent hover:bg-accent-light text-white px-5 py-2 rounded-lg transition-colors font-semibold">Twórz</a>
    </div>

    <button id="menu-toggle" class="md:hidden p-2 rounded-lg hover:bg-gray-100 text-gray-500">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
    </button>
  </nav>

  <div id="mobile-menu" class="hidden md:hidden border-t border-gray-100 bg-white px-4 pb-4">
    <a href="/bank-glosow/" class="block py-3 text-gray-600 hover:text-gray-900 border-b border-gray-100">Bank głosów</a>
    <a href="/nagrania-lektorskie/" class="block py-3 text-gray-600 hover:text-gray-900 border-b border-gray-100">Nagrania lektorskie</a>
    <a href="/sesje-zdalne-nagrania-lektorskie-online/" class="block py-3 text-gray-600 hover:text-gray-900 border-b border-gray-100">Sesje zdalne</a>
    <a href="/cennik/" class="block py-3 text-gray-600 hover:text-gray-900 border-b border-gray-100">Cennik</a>
    <a href="/opinie/" class="block py-3 text-gray-600 hover:text-gray-900 border-b border-gray-100">Opinie</a>
    <a href="/kontakt/" class="block py-3 text-gray-600 hover:text-gray-900 border-b border-gray-100">Kontakt</a>
    <a href="/#kreator" class="block mt-3 bg-accent text-white text-center px-5 py-3 rounded-lg font-semibold">Twórz</a>
  </div>
</header>
<% } %>

<main>
