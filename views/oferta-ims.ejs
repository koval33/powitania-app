<%- include('partials/head') %>

<section class="py-12 md:py-16">
  <div class="max-w-6xl mx-auto px-4">

    <div class="mb-8">
      <p class="text-xs font-semibold uppercase tracking-widest text-accent mb-2">Oferta poufna</p>
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-3">Oferta lektorska dla <%= ims ? ims.client : 'IMS' %></h1>
      <p class="text-gray-600 max-w-3xl leading-relaxed">Dedykowane stawki lektorów obcojęzycznych do spotów reklamowych. Dla każdego lektora podajemy dwie stawki: <strong>reklama w stacji radiowej o zasięgu krajowym</strong> oraz <strong>reklama w galerii handlowej</strong> (sklepy sieciowe i centra handlowe).</p>
    </div>

    <% if (!ims) { %>
      <p class="text-gray-600">Brak danych oferty.</p>
    <% } else { %>
    <%
      function imsWave(key){
        var s=String(key), h=0; for (var i=0;i<s.length;i++) h=((h<<5)-h+s.charCodeAt(i))|0;
        var seed=Math.abs(h), bars=80, midY=18, top=[], bot=[];
        for (var b=0;b<bars;b++){ var x=Math.sin(seed*9999+b*1.37)*10000; x=x-Math.floor(x);
          var hg=4+Math.round(x*26), px=(b*100/(bars-1)).toFixed(2);
          top.push(px+','+(midY-hg/2).toFixed(2)); bot.push(px+','+(midY+hg/2).toFixed(2)); }
        return 'M '+top[0]+' L '+top.join(' L ')+' L '+bot.reverse().join(' L ')+' Z';
      }
    %>

    <div class="grid sm:grid-cols-2 gap-4 mb-10">
      <div class="bg-stone-100/70 border border-gray-200 rounded-xl p-4">
        <p class="text-sm text-gray-700"><strong class="text-gray-900">Licencja.</strong> <%= ims.licenseNote %></p>
      </div>
      <div class="bg-stone-100/70 border border-gray-200 rounded-xl p-4">
        <p class="text-sm text-gray-700"><strong class="text-gray-900">Przedłużenie.</strong> <%= ims.renewalNote %></p>
      </div>
    </div>

    <div class="mb-8 flex flex-wrap items-center gap-3">
      <label for="imsLangFilter" class="text-sm font-medium text-gray-700">Filtr języka:</label>
      <select id="imsLangFilter" class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-accent">
        <option value="">Wszystkie języki</option>
        <% ims.languages.forEach(function(group){ %><option value="<%= group.lang %>"><%= group.lang %></option><% }); %>
      </select>
    </div>

    <% ims.languages.forEach(function(group){ %>
    <div class="ims-lang mb-10" data-lang="<%= group.lang %>">
      <h2 class="text-lg md:text-xl font-bold text-gray-900 mb-2"><%= group.lang %></h2>
      <div class="hidden md:grid grid-cols-12 gap-3 px-3 pb-1 text-[10px] uppercase tracking-wider text-gray-400">
        <div class="col-span-3">Lektor</div>
        <div class="col-span-2">Radio - krajowe</div>
        <div class="col-span-2">Galeria handlowa</div>
        <div class="col-span-5">Demo mp3</div>
      </div>
      <div class="border border-gray-200 rounded-xl overflow-hidden bg-white">
        <% group.lektorzy.forEach(function(v, vi){ %>
        <div class="grid grid-cols-1 md:grid-cols-12 gap-1 md:gap-3 md:items-center px-3 py-2 text-sm <%= vi ? 'border-t border-gray-100' : '' %>">
          <div class="md:col-span-3 min-w-0">
            <span class="font-semibold text-gray-900"><%= v.name %></span>
          </div>
          <div class="md:col-span-2"><span class="md:hidden text-[10px] uppercase tracking-wider text-gray-400 mr-1">Radio:</span><span class="font-semibold text-gray-900"><%= markupPrice(v.radio, 'radio') %></span></div>
          <div class="md:col-span-2"><span class="md:hidden text-[10px] uppercase tracking-wider text-gray-400 mr-1">Galeria:</span><span class="font-semibold text-gray-900"><%= markupPrice(v.gallery, 'gallery') %></span></div>
          <div class="md:col-span-5 flex gap-3 items-center">
            <% (Array.isArray(v.demos) ? v.demos : []).filter(Boolean).forEach(function(src){ %>
            <div class="bp-player flex-1 min-w-0">
              <div class="player-box flex items-center gap-2 cursor-pointer">
                <button type="button" class="play-btn w-6 h-6 flex-shrink-0 rounded-full border-2 border-gray-900 bg-white flex items-center justify-center transition-colors" data-audio="<%= src %>" title="Odtwórz">
                  <svg class="play-icon w-3 h-3 text-gray-900 ml-px" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                  <svg class="pause-icon w-3 h-3 text-gray-900 hidden" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
                </button>
                <button type="button" class="stop-btn w-6 h-6 flex-shrink-0 rounded-full border-2 border-accent bg-white hover:bg-accent/5 flex items-center justify-center transition-colors" title="Zatrzymaj">
                  <svg class="w-2.5 h-2.5 text-accent" fill="currentColor" viewBox="0 0 24 24"><rect x="6" y="6" width="12" height="12"/></svg>
                </button>
                <div class="audio-time-wrap text-[10px] text-gray-600 font-mono tabular-nums whitespace-nowrap flex-shrink-0">
                  <span class="audio-time">00:00</span><span class="audio-duration text-gray-400 ml-1">--:--</span>
                </div>
                <div class="audio-progress relative flex-1 min-w-0 h-7 cursor-pointer">
                  <svg class="absolute inset-0 w-full h-full text-gray-300" viewBox="0 0 100 36" preserveAspectRatio="none" aria-hidden="true"><path d="<%= imsWave(src) %>" fill="currentColor"/></svg>
                  <div class="audio-bar absolute top-0 h-full pointer-events-none" style="left:0%;width:1px;background-color:rgba(107,114,128,0.8);transform:translateX(-0.5px);transition:left 100ms linear"></div>
                </div>
              </div>
            </div>
            <% }); %>
          </div>
        </div>
        <% }); %>
      </div>
    </div>
    <% }); %>

    <p class="text-xs text-gray-400 mt-12 border-t border-gray-200 pt-6">Materiał poufny, przygotowany wyłącznie dla Klienta <%= ims.client %>. Strona nieindeksowana (noindex) i niedostępna z nawigacji serwisu.</p>

    <script>(function(){var s=document.getElementById('imsLangFilter');if(!s)return;var gs=document.querySelectorAll('.ims-lang');s.addEventListener('change',function(){var v=s.value;gs.forEach(function(g){g.style.display=(!v||g.getAttribute('data-lang')===v)?'':'none';});});})();</script>
    <script>
    (function(){
      var boxes=document.querySelectorAll('.bp-player .player-box'); if(!boxes.length) return;
      var shared=null,curBtn=null;
      function fmt(s){var m=Math.floor(s/60),x=Math.floor(s%60);return (m<10?'0':'')+m+':'+(x<10?'0':'')+x;}
      function reset(){if(!curBtn)return;curBtn.querySelector('.play-icon').classList.remove('hidden');curBtn.querySelector('.pause-icon').classList.add('hidden');var r=curBtn.closest('.player-box');if(r){r.querySelector('.audio-bar').style.left='0%';r.querySelector('.audio-time').textContent='00:00';}}
      function audioEl(){if(shared){shared.pause();shared.remove();}shared=document.createElement('audio');shared.preload='auto';shared.style.display='none';document.body.appendChild(shared);
        shared.addEventListener('timeupdate',function(){if(!curBtn)return;var r=curBtn.closest('.player-box');if(!r||!shared.duration)return;r.querySelector('.audio-bar').style.left=((shared.currentTime/shared.duration)*100)+'%';r.querySelector('.audio-time').textContent=fmt(shared.currentTime);});
        shared.addEventListener('loadedmetadata',function(){if(!curBtn)return;var r=curBtn.closest('.player-box');if(r)r.querySelector('.audio-duration').textContent=fmt(shared.duration);});
        shared.addEventListener('ended',function(){reset();curBtn=null;});return shared;}
      boxes.forEach(function(box){
        var btn=box.querySelector('.play-btn');
        btn.addEventListener('click',function(e){e.stopPropagation();var src=btn.dataset.audio;if(!src)return;var pi=btn.querySelector('.play-icon'),pa=btn.querySelector('.pause-icon');
          if(curBtn===btn&&shared){if(shared.paused){shared.play();pi.classList.add('hidden');pa.classList.remove('hidden');}else{shared.pause();pi.classList.remove('hidden');pa.classList.add('hidden');}return;}
          if(shared&&!shared.paused)shared.pause();reset();curBtn=btn;var a=audioEl();a.src=src;a.load();a.play().then(function(){pi.classList.add('hidden');pa.classList.remove('hidden');}).catch(function(){pi.classList.remove('hidden');pa.classList.add('hidden');});pi.classList.add('hidden');pa.classList.remove('hidden');});
        var sb=box.querySelector('.stop-btn');if(sb)sb.addEventListener('click',function(e){e.stopPropagation();if(!shared||curBtn!==btn)return;shared.pause();shared.currentTime=0;reset();curBtn=null;});
        box.addEventListener('click',function(e){e.stopPropagation();var prog=e.target.closest('.audio-progress');if(prog){if(shared&&curBtn===btn&&shared.duration){var rc=prog.getBoundingClientRect();shared.currentTime=((e.clientX-rc.left)/rc.width)*shared.duration;}return;}if(!e.target.closest('.play-btn')&&!e.target.closest('.stop-btn'))btn.click();});
      });
    })();
    </script>

    <% } %>
  </div>
</section>

<%- include('partials/foot') %>
