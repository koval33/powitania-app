<%- include('partials/head') %>

<section class="py-12 md:py-16">
  <div class="max-w-6xl mx-auto px-4">

    <div class="mb-8">
      <p class="text-xs font-semibold uppercase tracking-widest text-accent mb-2">Oferta poufna</p>
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-3">Oferta lektorska dla <%= ims ? ims.client : 'IMS' %></h1>
      <p class="text-gray-600 max-w-3xl leading-relaxed">Dedykowane stawki lektorów obcojęzycznych do spotów reklamowych. Dla każdego lektora podajemy dwie stawki: <strong>reklama w stacji radiowej o zasięgu krajowym</strong> oraz <strong>reklama w galerii handlowej</strong> (sklepy sieciowe i centra handlowe).</p>
    </div>

    <% if (!ims) { %>
      <p class="text-gray-600">Brak danych oferty.</p>
    <% } else { %>

    <div class="grid sm:grid-cols-2 gap-4 mb-10">
      <div class="bg-stone-100/70 border border-gray-200 rounded-xl p-4">
        <p class="text-sm text-gray-700"><strong class="text-gray-900">Licencja.</strong> <%= ims.licenseNote %></p>
      </div>
      <div class="bg-stone-100/70 border border-gray-200 rounded-xl p-4">
        <p class="text-sm text-gray-700"><strong class="text-gray-900">Przedłużenie.</strong> <%= ims.renewalNote %></p>
      </div>
    </div>

    <% ims.languages.forEach(function(group){ %>
    <div class="mb-10">
      <h2 class="text-xl md:text-2xl font-bold text-gray-900 mb-4 pb-2 border-b border-gray-200"><%= group.lang %></h2>
      <div class="space-y-4">
        <% group.lektorzy.forEach(function(v){ %>
        <div class="bg-white border border-gray-200 rounded-xl p-5 shadow-sm">
          <div class="grid md:grid-cols-12 gap-4 md:gap-6 items-start">

            <div class="md:col-span-3">
              <p class="font-bold text-gray-900"><%= v.name %></p>
              <% if (v.note) { %><p class="text-xs text-gray-500 mt-1 leading-relaxed"><%= v.note %></p><% } %>
            </div>

            <div class="md:col-span-3">
              <p class="text-[11px] uppercase tracking-wider text-gray-400 mb-1">Radio - zasięg krajowy</p>
              <p class="text-lg font-semibold text-gray-900"><%= v.radio %></p>
            </div>

            <div class="md:col-span-3">
              <p class="text-[11px] uppercase tracking-wider text-gray-400 mb-1">Galeria handlowa</p>
              <p class="text-lg font-semibold text-gray-900"><%= v.gallery %></p>
            </div>

            <div class="md:col-span-3">
              <p class="text-[11px] uppercase tracking-wider text-gray-400 mb-2">Demo mp3</p>
              <div class="space-y-2">
                <% var demos = Array.isArray(v.demos) ? v.demos : []; %>
                <% for (var i = 0; i < 2; i++) { %>
                  <% if (demos[i]) { %>
                    <audio controls preload="none" class="w-full" style="height:38px"><source src="<%= demos[i] %>" type="audio/mpeg"></audio>
                  <% } else { %>
                    <div class="text-xs text-gray-400 border border-dashed border-gray-300 rounded-lg px-3 py-2">Demo <%= i + 1 %> - miejsce na plik mp3</div>
                  <% } %>
                <% } %>
              </div>
            </div>

          </div>
        </div>
        <% }); %>
      </div>
    </div>
    <% }); %>

    <p class="text-xs text-gray-400 mt-12 border-t border-gray-200 pt-6">Materiał poufny, przygotowany wyłącznie dla Klienta IMS. Strona nieindeksowana (noindex) i niedostępna z nawigacji serwisu.</p>

    <% } %>
  </div>
</section>

<%- include('partials/foot') %>
