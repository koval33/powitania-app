<%- include('partials/head') %>

<section class="py-16 md:py-24">
  <div class="max-w-4xl mx-auto px-4">

    <h1 class="text-3xl md:text-4xl font-bold text-white mb-4 text-center">Aktualności</h1>
    <p class="text-gray-400 text-center mb-12">Nowości ze studia, nowi lektorzy, porady i artykuły branżowe</p>

    <!-- Lista postów -->
    <div class="space-y-6">
      <% posts.forEach(function(post) { %>
      <a href="/aktualnosci-pl/<%= post.slug %>/" class="block group bg-dark-800/60 border border-white/5 rounded-xl p-6 hover:border-accent/30 transition-all">
        <div class="flex items-start justify-between gap-4">
          <div class="flex-1 min-w-0">
            <h2 class="text-lg font-bold text-white group-hover:text-accent transition-colors mb-2"><%= post.title %></h2>
            <p class="text-gray-500 text-sm leading-relaxed"><%= post.excerpt %></p>
          </div>
          <div class="flex-shrink-0 text-right">
            <time class="text-xs text-gray-600" datetime="<%= post.date %>">
              <%= new Date(post.date).toLocaleDateString('pl-PL', { day: 'numeric', month: 'long', year: 'numeric' }) %>
            </time>
          </div>
        </div>
      </a>
      <% }); %>
    </div>

    <!-- Paginacja -->
    <% if (totalPages > 1) { %>
    <div class="flex items-center justify-center gap-2 mt-12">
      <% if (currentPage > 1) { %>
        <a href="/aktualnosci-pl/<%= currentPage === 2 ? '' : 'strona/' + (currentPage - 1) + '/' %>" class="px-4 py-2 bg-dark-700 hover:bg-dark-600 text-gray-400 rounded-lg border border-white/10 text-sm transition-colors">← Nowsze</a>
      <% } %>

      <% for (var p = 1; p <= totalPages; p++) { %>
        <% if (p === currentPage) { %>
          <span class="px-3 py-2 bg-accent text-white rounded-lg text-sm font-semibold"><%= p %></span>
        <% } else { %>
          <a href="/aktualnosci-pl/<%= p === 1 ? '' : 'strona/' + p + '/' %>" class="px-3 py-2 bg-dark-700 hover:bg-dark-600 text-gray-400 rounded-lg border border-white/10 text-sm transition-colors"><%= p %></a>
        <% } %>
      <% } %>

      <% if (currentPage < totalPages) { %>
        <a href="/aktualnosci-pl/strona/<%= currentPage + 1 %>/" class="px-4 py-2 bg-dark-700 hover:bg-dark-600 text-gray-400 rounded-lg border border-white/10 text-sm transition-colors">Starsze →</a>
      <% } %>
    </div>
    <% } %>

  </div>
</section>

<%- include('partials/foot') %>
