<%- include('partials/head') %>

<section class="py-16 md:py-24">
  <div class="max-w-4xl mx-auto px-4">

    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4 text-center">Aktualności</h1>
    <p class="text-gray-500 text-center mb-12">Nowości ze studia, nowi lektorzy, porady i artykuły branżowe</p>

    <!-- Lista postów -->
    <div class="space-y-6">
      <% posts.forEach(function(post) { %>
      <a href="/aktualnosci-pl/<%= post.slug %>/" class="block group bg-white shadow-sm border border-gray-200 rounded-xl p-6 hover:border-accent/30 transition-all">
        <div class="flex items-start gap-4">
          <% if (post.image) { %>
          <img src="<%= post.image %>" alt="<%= post.title %>" class="w-20 h-20 rounded-full object-cover border border-gray-200 flex-shrink-0" loading="lazy">
          <% } %>
          <div class="flex-1 min-w-0">
            <div class="flex items-start justify-between gap-4">
              <h2 class="text-lg font-bold text-gray-900 group-hover:text-accent transition-colors mb-2"><%= post.title %></h2>
              <time class="text-xs text-gray-600 flex-shrink-0" datetime="<%= post.date %>">
                <%= new Date(post.date).toLocaleDateString('pl-PL', { day: 'numeric', month: 'long', year: 'numeric' }) %>
              </time>
            </div>
            <p class="text-gray-500 text-sm leading-relaxed"><%= post.excerpt %></p>
          </div>
        </div>
      </a>
      <% }); %>
    </div>

    <!-- Paginacja -->
    <% if (totalPages > 1) { %>
    <div class="flex items-center justify-center gap-2 mt-12">
      <% if (currentPage > 1) { %>
        <a href="/aktualnosci-pl/<%= currentPage === 2 ? '' : 'strona/' + (currentPage - 1) + '/' %>" class="px-4 py-2 bg-white hover:bg-gray-100 text-gray-500 rounded-lg border border-gray-200 text-sm transition-colors">← Nowsze</a>
      <% } %>

      <% for (var p = 1; p <= totalPages; p++) { %>
        <% if (p === currentPage) { %>
          <span class="px-3 py-2 bg-accent text-white rounded-lg text-sm font-semibold"><%= p %></span>
        <% } else { %>
          <a href="/aktualnosci-pl/<%= p === 1 ? '' : 'strona/' + p + '/' %>" class="px-3 py-2 bg-white hover:bg-gray-100 text-gray-500 rounded-lg border border-gray-200 text-sm transition-colors"><%= p %></a>
        <% } %>
      <% } %>

      <% if (currentPage < totalPages) { %>
        <a href="/aktualnosci-pl/strona/<%= currentPage + 1 %>/" class="px-4 py-2 bg-white hover:bg-gray-100 text-gray-500 rounded-lg border border-gray-200 text-sm transition-colors">Starsze →</a>
      <% } %>
    </div>
    <% } %>

  </div>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": "https://www.powitania.pl/aktualnosci-pl/#blog",
  "name": "Aktualności Powitania.pl",
  "description": "Blog branżowy o nagraniach lektorskich, voice-over, dubbingu, IVR i produkcji audio. Aktualności ze studia, nowi lektorzy, case studies klientów.",
  "url": "https://www.powitania.pl/aktualnosci-pl/",
  "inLanguage": "pl-PL",
  "isPartOf": { "@id": "https://www.powitania.pl/#website" },
  "publisher": { "@id": "https://www.powitania.pl/#organization" },
  "blogPost": [
    <% posts.forEach(function(p, i) { %>
    {
      "@type": "BlogPosting",
      "headline": <%- JSON.stringify(p.title) %>,
      "description": <%- JSON.stringify(p.excerpt) %>,
      "datePublished": "<%= p.date %>",
      "dateModified": "<%= p.date %>",
      "inLanguage": "pl-PL",
      "url": "https://www.powitania.pl/aktualnosci-pl/<%= p.slug %>/",
      "mainEntityOfPage": { "@type": "WebPage", "@id": "https://www.powitania.pl/aktualnosci-pl/<%= p.slug %>/" },
      "image": "https://www.powitania.pl<%= p.image || '/img/og-powitania-dark-v2.jpg' %>",
      "author": { "@type": "Organization", "name": "Powitania.pl - OPTIMUM Paweł Kowalski" },
      "publisher": { "@id": "https://www.powitania.pl/#organization" }
    }<%= i < posts.length - 1 ? ',' : '' %>
    <% }); %>
  ]
}
</script>

<%- include('partials/foot') %>
