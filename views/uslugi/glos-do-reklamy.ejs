          </tr>
          <tr>
            <td class="px-4 py-3 text-gray-900">Reklama social media</td>
            <td class="px-4 py-3 text-gray-600">od 750 zł</td>
            <td class="px-4 py-3 text-gray-600">12 miesięcy</td>
          </tr>
          <tr>
            <td class="px-4 py-3 text-gray-900">Billboard sponsorski</td>
            <td class="px-4 py-3 text-gray-600">od 1200 zł</td>
            <td class="px-4 py-3 text-gray-600">12 miesięcy</td>
          </tr>
          <tr>
            <td class="px-4 py-3 text-gray-900">Spot do sieci handlowej / sklepów</td>
            <td class="px-4 py-3 text-gray-600">od 850 zł</td>
            <td class="px-4 py-3 text-gray-600">12 miesięcy</td>
          </tr>
        </tbody>
