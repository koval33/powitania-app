              <p class="font-bold text-gray-900 group-hover:text-accent transition-colors"><%= v.name %></p>
              <p class="text-xs text-gray-500">Lektor reklamowy</p>
            </div>
          </div>
          <p class="text-sm text-gray-600 leading-relaxed"><%= item.desc %></p>
        </a>
      <% } }); %>
    </div>
  </div>
</section>

