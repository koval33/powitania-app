<%- include('../partials/head') %>

<!-- Hero -->
<section class="py-10 md:py-14 bg-gradient-to-br from-stone-100 via-white to-stone-100 border-b border-gray-200">
  <div class="max-w-4xl mx-auto px-4 text-center">
    <h1 class="text-2xl md:text-4xl font-bold text-gray-900 mb-4 leading-tight">Głos do reklamy</h1>
    <p class="text-lg text-gray-500 max-w-2xl mx-auto leading-relaxed">
      Zatrudnij najbardziej rozpoznawalnych lektorów i stwórz spot reklamowy, który przyciągnie uwagę słuchaczy. Profesjonalny lektor do reklamy i rozpoznawalny głos to lepsza jakość spotu.
    </p>
  </div>
</section>

<!-- Najczęściej wybierani lektorzy do reklamy (PL flagowi) -->
<section class="py-16 border-b border-gray-200">
  <div class="max-w-5xl mx-auto px-4">
    <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4 text-center">Najczęściej wybierani lektorzy do reklamy</h2>
    <p class="text-gray-600 text-center max-w-3xl mx-auto leading-relaxed mb-10">W naszym <a href="/bank-glosow/" class="text-accent hover:underline">banku głosów</a> znajdziesz lektorów najbardziej rozpoznawalnych w polskiej reklamie - głosy znane z setek spotów telewizyjnych, radiowych i kinowych. Ich autorytet i charakterystyczna barwa budują zaufanie odbiorcy od pierwszych sekund spotu. To wybór dla marek, które chcą natychmiastowego skojarzenia z jakością i prestiżem.</p>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% var flagPL = [
        {id: 'andrzej-ferenc', desc: 'Głęboki, rozpoznawalny męski głos, kojarzony z setkami reklam telewizyjnych i radiowych.', sampleUrl: '/audio/samples/Ferenc_1.mp3', sampleLabel: 'Demo lektorskie'},
        {id: 'jacek-brzostynski', desc: 'Charyzmatyczny, autorytatywny głos męski, doskonały do spotów premium i kampanii korporacyjnych.', sampleUrl: '/audio/samples/Jacek-Brzosty%C5%84ski_spot-Nest-Bank.mp3', sampleLabel: 'Spot reklamowy - Nest Bank'},
        {id: 'lukasz-nowicki', desc: 'Wszechstronny głos męski, rozpoznawalny z mediów. Dobrze sprawdza się zarówno w spotach reklamowych, jak i narracji.', sampleUrl: '/audio/samples/Lukasz_Nowicki.mp3', sampleLabel: 'Próbka głosowa'},
        {id: 'przemyslaw-skowron', desc: 'Głęboki, dynamiczny głos męski. Częsty wybór do reklam motoryzacyjnych i kampanii z mocnym przekazem emocjonalnym.', sampleUrl: '/audio/samples/Skowron_1.mp3', sampleLabel: 'Nagranie lektorskie'},
        {id: 'stanislaw-olejniczak', desc: 'Legendarny głos polskiej telewizji i kina, ikoniczny dla wielu pokoleń odbiorców.', sampleUrl: '/audio/samples/StanislawOlejniczak_21.mp3', sampleLabel: 'Nagranie lektorskie'},
        {id: 'janusz', desc: 'Doświadczony lektor reklamowy, sprawdzony w setkach spotów radiowych i telewizyjnych.', sampleUrl: '/audio/samples/Janusz_demo2.mp3', sampleLabel: 'Radiowy spot reklamowy'}
      ]; %>
      <% flagPL.forEach(function(item) { var v = voices.find(function(x) { return x.id === item.id; }); if (v) { %>
        <div class="bg-white shadow-sm border border-gray-200 rounded-xl p-5 hover:border-accent/40 transition-all">
          <div class="flex items-center gap-4 mb-3">
            <a href="/lektorzy/<%= v.id %>/" class="group flex items-center gap-4 flex-1 min-w-0">
              <img src="<%= v.photo %>" alt="<%= v.name %>" class="w-16 h-16 rounded-full object-cover border-2 border-gray-200 flex-shrink-0" loading="lazy">
              <div class="min-w-0">
                <p class="font-bold text-gray-900 group-hover:text-accent transition-colors truncate"><%= v.name %></p>
                <p class="text-xs text-gray-500">Lektor reklamowy</p>
              </div>
            </a>
            <% if (item.sampleUrl) { %>
            <button type="button" onclick="playSample(this, '<%= item.sampleUrl %>')" title="Posłuchaj próbki" aria-label="Posłuchaj próbki - <%= v.name %>" class="play-btn w-9 h-9 flex-shrink-0 rounded-full border-2 border-gray-900 bg-white hover:bg-gray-50 flex items-center justify-center transition-colors">
              <svg class="play-icon w-4 h-4 text-gray-900 ml-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              <svg class="pause-icon w-4 h-4 text-gray-900 hidden" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
            </button>
            <% } %>
          </div>
          <p class="text-sm text-gray-600 leading-relaxed"><%= item.desc %></p>
        </div>
      <% } }); %>
    </div>
  </div>
</section>

<!-- Lektorzy do reklam obcojęzycznych (native) -->
<section class="py-16 bg-stone-100/60 border-b border-gray-200">
  <div class="max-w-5xl mx-auto px-4">
    <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4 text-center">Lektorzy do reklam obcojęzycznych</h2>
    <p class="text-gray-600 text-center max-w-3xl mx-auto leading-relaxed mb-10">Realizujemy spoty reklamowe również w językach obcych - z udziałem lektorów native. To rozwiązanie dla marek międzynarodowych, kampanii eksportowych i sieci handlowych z wielojęzycznym przekazem. Stawki dla lektorów native są zwykle ok. 2× wyższe niż dla polskich lektorów.</p>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% var flagNative = [
        {id: 'bill', desc: 'Angielski (USA / brytyjski) - profesjonalny native speaker do spotów eksportowych.', sampleUrl: '/audio/samples/BillRatner_CommercialVO.mp3', sampleLabel: 'Commercial voiceover'},
        {id: 'roy-2', desc: 'Angielski - charakterystyczny męski głos. Profil zawiera realizacje wideo z kampanii reklamowych.', sampleUrl: '/audio/samples/Roy_2_commercials.mp3', sampleLabel: 'Commercials demo'},
        {id: 'jon', desc: 'Angielski - uniwersalny głos męski, dobry do spotów korporacyjnych i e-learningu.', sampleUrl: '/audio/samples/Jon-Carter-TV-Promo-Demo.mp3', sampleLabel: 'TV promo demo'},
        {id: 'konstancja', desc: 'Lektor native - barwa głosu i język do uzgodnienia, sprawdź profil.', sampleUrl: '/audio/samples/spot_Konstancja.mp3', sampleLabel: 'Spot reklamowy'},
        {id: 'julien', desc: 'Francuski - lektor native dla rynku frankofońskiego.', sampleUrl: '/audio/samples/Julien_demo1.mp3', sampleLabel: 'Próbka demo'},
        {id: 'carla', desc: 'Lektor native - kobiecy głos do spotów wielojęzycznych, sprawdź profil.', sampleUrl: '/audio/samples/Carla_commercial.mp3', sampleLabel: 'Commercial voiceover'}
      ]; %>
      <% flagNative.forEach(function(item) { var v = voices.find(function(x) { return x.id === item.id; }); if (v) { %>
        <div class="bg-white shadow-sm border border-gray-200 rounded-xl p-5 hover:border-accent/40 transition-all">
          <div class="flex items-center gap-4 mb-3">
            <a href="/lektorzy/<%= v.id %>/" class="group flex items-center gap-4 flex-1 min-w-0">
              <img src="<%= v.photo %>" alt="<%= v.name %>" class="w-16 h-16 rounded-full object-cover border-2 border-gray-200 flex-shrink-0" loading="lazy">
              <div class="min-w-0">
                <p class="font-bold text-gray-900 group-hover:text-accent transition-colors truncate"><%= v.name %></p>
                <p class="text-xs text-gray-500">Lektor native</p>
              </div>
            </a>
            <% if (item.sampleUrl) { %>
            <button type="button" onclick="playSample(this, '<%= item.sampleUrl %>')" title="Posłuchaj próbki" aria-label="Posłuchaj próbki - <%= v.name %>" class="play-btn w-9 h-9 flex-shrink-0 rounded-full border-2 border-gray-900 bg-white hover:bg-gray-50 flex items-center justify-center transition-colors">
              <svg class="play-icon w-4 h-4 text-gray-900 ml-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              <svg class="pause-icon w-4 h-4 text-gray-900 hidden" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
            </button>
            <% } %>
          </div>
          <p class="text-sm text-gray-600 leading-relaxed"><%= item.desc %></p>
        </div>
      <% } }); %>
    </div>

    <div class="text-center mt-8">
      <a href="/bank-glosow/?native=1" class="text-accent hover:text-accent-light font-medium text-sm">Zobacz wszystkich lektorów native &rarr;</a>
    </div>
  </div>
</section>

<!-- Features -->
<section class="py-16">
  <div class="max-w-5xl mx-auto px-4">
    <div class="grid md:grid-cols-2 gap-12">
      <div>
        <h2 class="text-2xl font-bold text-gray-900 mb-6">Co oferujemy?</h2>
        <div class="space-y-4">
          <div class="flex gap-3">
            <div class="w-8 h-8 bg-green-100 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
              <svg class="w-4 h-4 text-green-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900">Spoty radiowe</h3>
              <p class="text-sm text-gray-500">Lokalne i ogólnokrajowe spoty radiowe w wykonaniu doświadczonych lektorów reklamowych.</p>
              <p class="text-sm text-gray-500 mt-2 leading-relaxed">Realizujemy głosy do kampanii radiowych - od lokalnych stacji po ogólnopolskie sieci radiowe. Reklama radiowa wymaga lektora z naturalną dykcją i charakterystycznym głosem reklamowym, który przebije się przez tło dźwiękowe. Każdy spot reklamowy dostarczamy w wersji 15s, 30s i 60s.</p>
            </div>
          </div>
          <div class="flex gap-3">
            <div class="w-8 h-8 bg-green-100 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
              <svg class="w-4 h-4 text-green-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900">Spoty telewizyjne</h3>
              <p class="text-sm text-gray-500">Profesjonalni lektorzy do reklam telewizyjnych - od lokalnych stacji po ogólnopolski zasięg.</p>
              <p class="text-sm text-gray-500 mt-2 leading-relaxed">Głosy do kampanii telewizyjnych - TV ogólnopolska, regionalna i kablowa. Reklama telewizyjna to inny rejestr niż radiowa: tu liczy się synchronizacja z obrazem i emocja głosu. Realizujemy profesjonalne spoty reklamowe od strony lektorsko-dźwiękowej - nagranie, post-produkcję i mastering w jakości emisyjnej dla TVN, Polsat, TVP i kanałów branżowych.</p>
            </div>
          </div>
          <div class="flex gap-3">
            <div class="w-8 h-8 bg-green-100 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
              <svg class="w-4 h-4 text-green-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900">Reklama w social media</h3>
              <p class="text-sm text-gray-500 leading-relaxed">Reklama internetowa i social media to obecnie największy segment - głosy do kampanii internetowych dla YouTube ads, Meta, TikTok, LinkedIn oraz Spotify ads. Głosy do kampanii marketingowych w digital wymagają zwięzłości i hook&apos;a w pierwszych 3 sekundach. Dostarczamy w formatach kompatybilnych z każdą platformą reklamową.</p>
            </div>
          </div>
          <div class="flex gap-3">
            <div class="w-8 h-8 bg-green-100 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
              <svg class="w-4 h-4 text-green-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900">Billboardy sponsorskie i sieci handlowe</h3>
              <p class="text-sm text-gray-500 leading-relaxed">Głosy do kampanii promocyjnych - billboardy radiowe (5-10 sekund, format wskazania sponsorskiego), billboardy telewizyjne, oraz spoty wewnętrzne dla sieci handlowych. Krótka forma wymaga doświadczonego lektora - każde słowo ma znaczenie.</p>
            </div>
          </div>
        </div>
      </div>
      <div>
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Dlaczego my?</h2>
        <p class="text-sm text-gray-600 leading-relaxed mb-6">Specjalizujemy się w produkcji nagrań lektorskich do reklam - od castingu, przez nagranie, po mastering broadcast-ready. Dla agencji reklamowych, domów produkcyjnych i klientów bezpośrednich dostarczamy profesjonalny głos lektora w jakości produkcyjnej. Każdy głos lektorski w naszym banku ma dostępne próbki audio do odsłuchania, a wybór można skonsultować z naszym zespołem przed castingiem. Scenariusz reklamy dostarcza klient - w razie potrzeby pomożemy go zweryfikować pod kątem timingu (mieści się w 30s? czy w 60s?) i naturalności wypowiedzi lektorskiej.</p>
        <div class="space-y-4">
          <div class="flex gap-3">
            <div class="w-8 h-8 bg-green-100 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
              <svg class="w-4 h-4 text-green-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900">Pomożemy dobrać głos</h3>
              <p class="text-sm text-gray-500">Doradzamy, który lektor najlepiej pasuje do specyfiki Twojej reklamy - branży, grupy docelowej i charakteru produktu.</p>
              <p class="text-sm text-gray-500 mt-2 leading-relaxed">Pomagamy w wyborze lektora dopasowanego do brand voice marki. Nasz bank głosów lektorskich zawiera <%= voiceCount %> lektorów z audio próbkami - możesz wybrać sam lub poprosić nasz zespół o casting tekstu próbnego. Wybór lektora zajmuje 24-48h, w zależności od skali projektu.</p>
            </div>
          </div>
          <div class="flex gap-3">
            <div class="w-8 h-8 bg-green-100 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
              <svg class="w-4 h-4 text-green-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900">Weryfikacja scenariusza</h3>
              <p class="text-sm text-gray-500">Czytamy tekst zanim wejdziemy do studia. Jeśli zauważymy błędy językowe lub problematyczne miejsca - zaproponujemy korektę przed nagraniem.</p>
            </div>
          </div>
          <div class="flex gap-3">
            <div class="w-8 h-8 bg-green-100 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
              <svg class="w-4 h-4 text-green-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900">Montaż i mastering w cenie</h3>
              <p class="text-sm text-gray-500">Nie doliczamy za obróbkę plików - normalizacja głośności, czyszczenie i mastering są wliczone w stawkę nagrania.</p>
            </div>
          </div>
          <div class="flex gap-3">
            <div class="w-8 h-8 bg-green-100 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
              <svg class="w-4 h-4 text-green-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900">Minimum 3 wersje nagrania</h3>
              <p class="text-sm text-gray-500">Dostarczamy co najmniej trzy wersje różniące się interpretacją - Ty wybierasz tę najlepszą.</p>
            </div>
          </div>
          <div class="flex gap-3">
            <div class="w-8 h-8 bg-green-100 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
              <svg class="w-4 h-4 text-green-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            </div>
            <div>
              <h3 class="font-semibold text-gray-900">Montaż audio-video</h3>
              <p class="text-sm text-gray-500">Za niewielką opłatą podłożymy ścieżkę głosową pod Twój materiał wideo - dostajesz gotowy spot do emisji.</p>
            </div>
          </div>
        </div>
        <div class="mt-6 flex flex-col sm:flex-row gap-3">
          <a href="/kreator/?start=spots" class="bg-accent hover:bg-accent-light text-white px-6 py-3 rounded-lg font-semibold text-center transition-colors">Przygotuj tekst spotu</a>
          <a href="/cennik-nagran-lektorskich/" class="border border-gray-200 hover:border-gray-400 text-gray-700 px-6 py-3 rounded-lg font-semibold text-center transition-colors">Zobacz cennik</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Cennik -->
