<!-- Lektorzy reklamowi - carousel istniejący -->
<section class="py-16" style="background-color:#efe8df">
  <div class="max-w-5xl mx-auto px-4">
    <h2 class="text-2xl font-bold text-gray-900 mb-8 text-center">Lektorzy reklamowi</h2>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-6">
      <% var recIds = ['jacek-brzostynski', 'maciej-jablonski', 'malgorzata', 'anita']; %>
      <% recIds.forEach(function(pid) { %>
        <% var v = voices.find(function(x) { return x.id === pid; }); %>
        <% if (v) { %>
        <a href="/lektorzy/<%= v.id %>/" class="text-center group">
          <img src="<%= v.photo %>" alt="<%= v.name %>" class="w-24 h-24 rounded-full mx-auto object-cover border-2 border-gray-200 group-hover:border-accent transition-all mb-2" loading="lazy">
          <div class="text-gray-900 font-semibold text-sm group-hover:text-accent transition-colors"><%= v.name %></div>
        </a>
        <% } %>
      <% }); %>
    </div>
    <div class="text-center mt-8">
      <a href="/bank-glosow/" class="text-accent hover:text-accent-light font-medium text-sm">Zobacz wszystkich lektorów &rarr;</a>
    </div>
  </div>
</section>

<!-- Najczęściej wybierani lektorzy do reklamy (PL flagowi) -->
<section class="py-16 border-t border-gray-200">
  <div class="max-w-5xl mx-auto px-4">
    <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4 text-center">Najczęściej wybierani lektorzy do reklamy</h2>
    <p class="text-gray-600 text-center max-w-3xl mx-auto leading-relaxed mb-10">W naszym <a href="/bank-glosow/" class="text-accent hover:underline">banku głosów</a> dostępni są lektorzy z najwyższej grupy cenowej - głosy rozpoznawalne z reklam telewizyjnych, radiowych i kinowych. Ich autorytet i charakterystyczna barwa budują zaufanie odbiorcy od pierwszych sekund spotu. To wybór dla marek, które chcą natychmiastowego skojarzenia z jakością i prestiżem.</p>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% var flagPL = [
        {id: 'andrzej-ferenc', desc: 'Głęboki, rozpoznawalny męski głos, kojarzony z setkami reklam telewizyjnych i radiowych.'},
        {id: 'jacek-brzostynski', desc: 'Charyzmatyczny, autorytatywny głos męski, doskonały do spotów premium i kampanii korporacyjnych.'},
        {id: 'lukasz-nowicki', desc: 'Wszechstronny głos męski, rozpoznawalny z mediów. Dobrze sprawdza się zarówno w spotach reklamowych, jak i narracji.'},
        {id: 'przemyslaw-skowron', desc: 'Głęboki, dynamiczny głos męski. Częsty wybór do reklam motoryzacyjnych i kampanii z mocnym przekazem emocjonalnym.'},
        {id: 'stanislaw-olejniczak', desc: 'Legendarny głos polskiej telewizji i kina, ikoniczny dla wielu pokoleń odbiorców.'}
