<%- include('../partials/head') %>

<%# Hero podstrony - partial page-hero (menu na obrazie). Flaga pageHeroTransparent w route. %>
<%- include('../partials/page-hero', {
  heroH1: 'Produkcja jingli reklamowych',
  heroSub: 'Tworzymy jingle i&nbsp;śpiewane spoty reklamowe na&nbsp;zamówienie - do&nbsp;radia, telewizji i&nbsp;social media, na&nbsp;czołówki podcastów i&nbsp;oprawę firmowych wydarzeń. Profesjonalna produkcja audio pod&nbsp;Twój brief: kontrola kreatywna, selekcja wariantów, obróbka i&nbsp;mastering oraz jasne prawa do&nbsp;emisji. Gotowe pliki w&nbsp;krótkim czasie.',
  heroCtaHtml: `
    <a href="/kontakt/#formularz" class="bg-accent hover:bg-accent-light text-white px-7 py-3 rounded-lg font-semibold text-center transition-colors">Zamów bezpłatną wycenę</a>
    <a href="tel:+48605491069" class="border border-white/30 hover:border-white/60 text-white px-7 py-3 rounded-lg font-semibold text-center transition-colors inline-flex items-center justify-center gap-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg>
      Zadzwoń: 605 491 069
    </a>
  `
}) %>

<!-- Posłuchaj realizacji -->
<section id="realizacje" class="py-16 border-b border-gray-200 scroll-mt-24">
  <div class="max-w-5xl mx-auto px-4">
    <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4 text-center">Posłuchaj naszych realizacji</h2>
    <p class="text-gray-600 text-center max-w-3xl mx-auto leading-relaxed mb-10">Każdy jingiel tworzymy pod konkretny brief - od pomysłu na melodię i hasło po gotowy, dopasowany utwór.<br class="hidden md:inline"> Poniżej realne wdrożenia dla klientów oraz koncepty demo z różnych branż i zastosowań.<br class="hidden md:inline"> Większość pokazujemy w dwóch wariantach, bo na etapie tworzenia proponujemy kilka kierunków do wyboru.</p>

    <% var jingles = [
      {name:'Niepoważny Podcast Golfowy', cat:'Czołówka i przebitka do podcastu', f:'podcast-golfowy', real:true},
      {name:'Ruphert and Rico', cat:'Zapowiedź przed występem', f:'rupert-rico', img:'rupert_rico.webp', real:true, single:true},
      {name:'Sobienie Królewskie', cat:'Udźwiękowienie reklamy pola golfowego', f:'sobienie-promo', real:true},
      {name:'Auto Nova', cat:'Motoryzacja - salon samochodowy', f:'auto-nova', img:'auto_nova_2.jpg'},
      {name:'BlueWay Travel', cat:'Turystyka - biuro podróży', f:'blueway-travel', img:'blue_way_travel_2.jpg'},
      {name:'Click Market', cat:'E-commerce - sklep internetowy', f:'click-market', img:'click_market_2.jpg'},
      {name:'Dom Fix', cat:'Dom i remonty - usługi', f:'dom-fix'},
      {name:'Złoty Piec', cat:'Gastronomia - pizzeria', f:'zloty-piec'},
      {name:'Mocc Mleko', cat:'Spożywczy - FMCG / nabiał', f:'mocc-mleko'}
    ]; %>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% jingles.forEach(function(j) { %>
        <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden hover:border-accent/40 transition-all">
          <div class="relative">
            <img src="/img/spoty/<%= j.img ? j.img : (j.f + '.webp') %>" alt="<%= j.name %> - <%= j.cat %>" loading="lazy" width="800" height="534" class="w-full aspect-[3/2] object-cover">
            <span class="absolute top-3 right-3 text-[0.65rem] uppercase tracking-wide font-semibold text-white <%= j.real ? 'bg-accent' : 'bg-black/55' %> px-2 py-0.5 rounded backdrop-blur-sm"><%= j.real ? 'Realizacja klienta' : 'Demo' %></span>
          </div>
          <div class="p-5">
            <h3 class="font-bold text-gray-900 leading-snug mb-0.5"><%= j.name %></h3>
            <p class="text-xs text-gray-500 mb-4"><%= j.cat %></p>
          <div class="flex flex-wrap gap-2">
            <button type="button" onclick="playSample(this, '/audio/spoty/<%= j.f %>-1.mp3')" aria-label="Posłuchaj - <%= j.name %><%= j.single ? '' : ', wersja 1' %>" class="play-btn inline-flex items-center gap-1.5 rounded-full border-2 border-gray-900 bg-white hover:bg-gray-50 text-gray-900 text-sm font-medium px-3 py-1.5 transition-colors">
              <svg class="play-icon w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              <svg class="pause-icon w-3.5 h-3.5 hidden" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
              <span><%= j.single ? 'Posłuchaj' : 'Wersja 1' %></span>
            </button>
            <% if (!j.single) { %>
            <button type="button" onclick="playSample(this, '/audio/spoty/<%= j.f %>-2.mp3')" aria-label="Posłuchaj - <%= j.name %>, wersja 2" class="play-btn inline-flex items-center gap-1.5 rounded-full border-2 border-gray-900 bg-white hover:bg-gray-50 text-gray-900 text-sm font-medium px-3 py-1.5 transition-colors">
              <svg class="play-icon w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              <svg class="pause-icon w-3.5 h-3.5 hidden" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
              <span>Wersja 2</span>
            </button>
            <% } %>
          </div>
          </div>
        </div>
      <% }); %>
    </div>

    <p class="text-center text-sm text-gray-500 mt-8 max-w-2xl mx-auto">Oznaczone „Realizacja klienta" to faktyczne wdrożenia - czołówka „Niepoważnego Podcastu Golfowego", udźwiękowienie reklamy pola golfowego Sobienie Królewskie oraz zapowiedź „Ruphert and Rico". Pozostałe to koncepty demo (marki przykładowe) pokazujące zakres możliwości. Pełne portfolio dla konkretnych marek udostępniamy po podpisaniu NDA.</p>
  </div>
</section>

<!-- Co produkujemy -->
<section class="py-16 bg-stone-100/60 border-b border-gray-200">
  <div class="max-w-5xl mx-auto px-4">
    <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4 text-center">Co produkujemy</h2>
    <p class="text-gray-600 text-center max-w-3xl mx-auto leading-relaxed mb-10">Pełna produkcja muzyczna do reklamy i komunikacji marki - od krótkiego, wpadającego w ucho jingla po rozbudowany, śpiewany spot reklamowy.</p>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
        <h3 class="font-bold text-gray-900 mb-2">Jingle reklamowe</h3>
        <p class="text-sm text-gray-600 leading-relaxed">Krótka, chwytliwa melodia z nazwą marki lub hasłem - od kilkusekundowego sygnału po pełny jingiel radiowy. Buduje rozpoznawalność i zostaje w głowie odbiorcy na długo po emisji.</p>
      </div>
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
        <h3 class="font-bold text-gray-900 mb-2">Śpiewane spoty reklamowe</h3>
        <p class="text-sm text-gray-600 leading-relaxed">Pełny spot z warstwą wokalną - melodia, tekst reklamowy i wokal w jednym. Sprawdza się tam, gdzie zwykła narracja lektorska nie wystarcza, a marka chce wyróżnić się emocją i rytmem.</p>
      </div>
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
        <h3 class="font-bold text-gray-900 mb-2">Czołówki i przebitki do podcastów</h3>
        <p class="text-sm text-gray-600 leading-relaxed">Intro, outro i krótkie przebitki (stingi) spinające odcinki podcastu. Spójna oprawa dźwiękowa, która profesjonalizuje audycję i buduje rozpoznawalność programu od pierwszych sekund.</p>
      </div>
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
        <h3 class="font-bold text-gray-900 mb-2">Oprawa muzyczna eventów</h3>
        <p class="text-sm text-gray-600 leading-relaxed">Muzyka i piosenki na eventy firmowe, gale, targi i wyjazdy integracyjne - od hymnu firmowego, przez podkład pod prezentację, po utwór okolicznościowy z personalizowanym tekstem.</p>
      </div>
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
        <h3 class="font-bold text-gray-900 mb-2">Audio branding i sound logo</h3>
        <p class="text-sm text-gray-600 leading-relaxed">Dźwiękowa tożsamość marki - sygnał dźwiękowy (sound logo) i spójny system audio, który rozpoznasz w spocie, na infolinii i w aplikacji. Konsekwentne brzmienie marki we wszystkich kanałach.</p>
      </div>
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
        <h3 class="font-bold text-gray-900 mb-2">Muzyka i piosenki na zamówienie</h3>
        <p class="text-sm text-gray-600 leading-relaxed">Tworzone pod konkretny brief - utwory okolicznościowe, podkłady pod film korporacyjny, piosenki na jubileusz firmy. Pod Twój cel i markę, nie ze stockowej biblioteki.</p>
      </div>
    </div>
  </div>
</section>

<!-- Gdzie się sprawdzą -->
<section class="py-16 border-b border-gray-200">
  <div class="max-w-5xl mx-auto px-4">
    <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4 text-center">Gdzie sprawdza się jingiel i spot śpiewany</h2>
    <p class="text-gray-600 text-center max-w-3xl mx-auto leading-relaxed mb-10">Produkcja muzyczna działa wszędzie tam, gdzie liczy się emocja, rozpoznawalność i to, by przekaz został zapamiętany.</p>

    <div class="grid md:grid-cols-2 gap-x-14">
      <div class="py-5 border-t border-gray-200">
        <h3 class="text-lg font-semibold text-gray-900 mb-1.5">Reklama radiowa</h3>
        <p class="text-sm text-gray-600 leading-relaxed">Jingiel radiowy to klasyka, która wciąż działa. W radiu liczy się dźwięk - chwytliwa melodia przebija się przez tło i buduje skojarzenie z marką już po kilku emisjach. Dostarczamy wersje 15s, 30s i 60s.</p>
      </div>
      <div class="py-5 border-t border-gray-200">
        <h3 class="text-lg font-semibold text-gray-900 mb-1.5">Spoty telewizyjne</h3>
        <p class="text-sm text-gray-600 leading-relaxed">Warstwa muzyczna i wokalna pod spot TV - od podkładu budującego emocję po pełny śpiewany refren synchronizowany z obrazem. Mastering w jakości emisyjnej dla stacji ogólnopolskich i regionalnych.</p>
      </div>
      <div class="py-5 border-t border-gray-200">
        <h3 class="text-lg font-semibold text-gray-900 mb-1.5">Social media i digital</h3>
        <p class="text-sm text-gray-600 leading-relaxed">Krótkie, rytmiczne formy pod YouTube, Meta, TikTok i Spotify ads. Dźwięk z hookiem w pierwszych sekundach zatrzymuje scroll i zwiększa zapamiętywalność reklamy w kanałach, gdzie konkurencja o uwagę jest największa.</p>
      </div>
      <div class="py-5 border-t border-gray-200">
        <h3 class="text-lg font-semibold text-gray-900 mb-1.5">Podcasty</h3>
        <p class="text-sm text-gray-600 leading-relaxed">Czołówka, outro i przebitki, które nadają audycji profesjonalny charakter. Spójna oprawa dźwiękowa buduje markę podcastu i sprawia, że słuchacz rozpoznaje program po pierwszych nutach.</p>
      </div>
      <div class="py-5 border-t border-gray-200">
        <h3 class="text-lg font-semibold text-gray-900 mb-1.5">Eventy firmowe, gale i targi</h3>
        <p class="text-sm text-gray-600 leading-relaxed">Hymn firmowy, intro otwierające galę, podkład pod prezentację na targach czy utwór na wyjazd integracyjny. Muzyka, która buduje atmosferę wydarzenia i zostaje z uczestnikami na dłużej.</p>
      </div>
      <div class="py-5 border-t border-gray-200">
        <h3 class="text-lg font-semibold text-gray-900 mb-1.5">Audio branding marki</h3>
        <p class="text-sm text-gray-600 leading-relaxed">Sound logo i system dźwiękowy spójny we wszystkich punktach styku - reklama, infolinia, aplikacja, ekspozycja w punkcie sprzedaży. Dźwięk staje się rozpoznawalnym elementem tożsamości marki.</p>
      </div>
    </div>
  </div>
</section>

<!-- Jak powstaje jingiel -->
<section class="py-16 bg-stone-100/60 border-b border-gray-200">
  <div class="max-w-4xl mx-auto px-4">
    <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4 text-center">Jak powstaje jingiel</h2>
    <p class="text-gray-600 text-center max-w-3xl mx-auto leading-relaxed mb-10">Łączymy generatywną sztuczną inteligencję z naszą selekcją i obróbką dźwięku - dzięki temu gotowy, dopasowany utwór dostajesz szybciej i taniej niż w klasycznej produkcji. Na kluczowych etapach pokazujemy warianty do wyboru, żebyś miał wpływ na efekt końcowy.</p>

    <ol class="space-y-5">
      <li class="flex gap-4">
        <span class="flex-shrink-0 w-10 md:w-12 text-3xl md:text-4xl font-bold text-gray-900 leading-none tabular-nums">01</span>
        <div>
          <h3 class="font-semibold text-gray-900">Brief i koncepcja</h3>
          <p class="text-sm text-gray-600 leading-relaxed">Poznajemy markę, cel kampanii, grupę docelową i kanał emisji. Ustalamy charakter muzyki, długość i to, czy jingiel ma być śpiewany, czy instrumentalny.</p>
        </div>
      </li>
      <li class="flex gap-4">
        <span class="flex-shrink-0 w-10 md:w-12 text-3xl md:text-4xl font-bold text-gray-900 leading-none tabular-nums">02</span>
        <div>
          <h3 class="font-semibold text-gray-900">Tekst i kreacja</h3>
          <p class="text-sm text-gray-600 leading-relaxed">Piszemy tekst reklamowy pod melodię (lub adaptujemy Twój), proponujemy hasło i hook. Tekst musi być chwytliwy i mieścić się w rytmie - to inny warsztat niż copy do spotu lektorskiego.</p>
        </div>
      </li>
      <li class="flex gap-4">
        <span class="flex-shrink-0 w-10 md:w-12 text-3xl md:text-4xl font-bold text-gray-900 leading-none tabular-nums">03</span>
        <div>
          <h3 class="font-semibold text-gray-900">Generowanie wariantów</h3>
          <p class="text-sm text-gray-600 leading-relaxed">Z pomocą AI przygotowujemy kilka kierunków do wyboru - inny nastrój, tempo, brzmienie czy charakter głosu. Wybierasz ten, który najlepiej pasuje do marki.</p>
        </div>
      </li>
      <li class="flex gap-4">
        <span class="flex-shrink-0 w-10 md:w-12 text-3xl md:text-4xl font-bold text-gray-900 leading-none tabular-nums">04</span>
        <div>
          <h3 class="font-semibold text-gray-900">Wokal i brzmienie</h3>
          <p class="text-sm text-gray-600 leading-relaxed">Dobieramy charakter i barwę głosu oraz instrumentarium pod Twój brief. Warstwa wokalna i muzyczna powstaje cyfrowo, a my dopracowujemy detale i spójność z marką.</p>
        </div>
      </li>
      <li class="flex gap-4">
        <span class="flex-shrink-0 w-10 md:w-12 text-3xl md:text-4xl font-bold text-gray-900 leading-none tabular-nums">05</span>
        <div>
          <h3 class="font-semibold text-gray-900">Obróbka i mastering</h3>
          <p class="text-sm text-gray-600 leading-relaxed">Czyścimy, balansujemy i masterujemy wybrany utwór do poziomu emisyjnego. Efekt brzmi tak samo dobrze w radiu, w telewizji i w telefonie.</p>
        </div>
      </li>
      <li class="flex gap-4">
        <span class="flex-shrink-0 w-10 md:w-12 text-3xl md:text-4xl font-bold text-gray-900 leading-none tabular-nums">06</span>
        <div>
          <h3 class="font-semibold text-gray-900">Wersje i dostawa</h3>
          <p class="text-sm text-gray-600 leading-relaxed">Dostarczamy komplet wersji - różne długości (15s / 30s / 60s), wariant instrumentalny do podkładu i pliki w wymaganych formatach (WAV, MP3). Wszystko z jasno ustalonymi zasadami wykorzystania.</p>
        </div>
      </li>
    </ol>
  </div>
</section>

<!-- Dlaczego my -->
<section class="py-16 border-b border-gray-200">
  <div class="max-w-4xl mx-auto px-4">
    <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4 text-center">Dlaczego my</h2>
    <p class="text-gray-600 text-center max-w-3xl mx-auto leading-relaxed mb-10">Działamy od 2001 roku i znamy się na produkcji dźwięku - to doświadczenie wnosimy też do jingli. Jingle to nasza nowa usługa: tworzymy je z wykorzystaniem sztucznej inteligencji, którą uzupełniamy własną selekcją i obróbką, żeby szybko dostarczyć gotowy, dopasowany utwór.</p>

    <div class="grid sm:grid-cols-2 gap-6">
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
        <h3 class="font-semibold text-gray-900 mb-1">Od briefu po gotowy plik</h3>
        <p class="text-sm text-gray-600 leading-relaxed">Całość prowadzimy u siebie - koncept, tekst, generowanie wariantów, obróbka i mastering. Jeden zespół odpowiada za efekt, bez podzlecania na zewnątrz.</p>
      </div>
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
        <h3 class="font-semibold text-gray-900 mb-1">Tworzone pod Twój brief</h3>
        <p class="text-sm text-gray-600 leading-relaxed">Nie wysyłamy gotowca ze stockowej biblioteki - utwór powstaje pod Twoją markę i cel kampanii, w kilku wariantach do wyboru.</p>
      </div>
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
        <h3 class="font-semibold text-gray-900 mb-1">Jasne zasady wykorzystania</h3>
        <p class="text-sm text-gray-600 leading-relaxed">Ustalamy na piśmie, gdzie i jak długo możesz emitować utwór (radio, TV, internet, wewnętrznie). Masz szczególne wymagania co do zakresu - powiedz na etapie briefu, dopasujemy ofertę.</p>
      </div>
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
        <h3 class="font-semibold text-gray-900 mb-1">Szybko i bez kosztów sesji</h3>
        <p class="text-sm text-gray-600 leading-relaxed">Nie czekasz na zespół muzyków ani studyjną sesję - gotowy jingiel dostajesz w krótkim czasie. A jeśli potrzebujesz żywego głosu, lektora u nas zawsze nagrywa człowiek: zobacz <a href="/nagrania-lektorskie/glos-do-reklamy/" class="text-accent hover:underline">głos do reklamy</a>.</p>
      </div>
    </div>
  </div>
</section>

<!-- Prawa i licencje -->
<section class="py-16 border-b border-gray-200">
  <div class="max-w-4xl mx-auto px-4">
    <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4 text-center">Prawa i licencje do emisji</h2>
    <p class="text-gray-600 text-center max-w-3xl mx-auto leading-relaxed mb-10">Zanim zaczniemy, ustalamy na piśmie zakres wykorzystania gotowego utworu - żeby po odbiorze nie było żadnych niejasności, gdzie i jak długo możesz go emitować.</p>
    <div class="grid sm:grid-cols-3 gap-6">
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
        <h3 class="font-semibold text-gray-900 mb-1">Pola eksploatacji i czas</h3>
        <p class="text-sm text-gray-600 leading-relaxed">W wycenie określamy kanały (radio, TV, internet, social media, użytek wewnętrzny) i okres wykorzystania. Dokładnie wiesz, gdzie i jak długo możesz emitować utwór.</p>
      </div>
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
        <h3 class="font-semibold text-gray-900 mb-1">Tworzone na Twoje zlecenie</h3>
        <p class="text-sm text-gray-600 leading-relaxed">To nie gotowiec ze stockowej biblioteki dostępny dla wszystkich - utwór powstaje pod Twój brief i markę. Na życzenie ustalimy wyłączność, żeby nie trafił do nikogo innego.</p>
      </div>
      <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
        <h3 class="font-semibold text-gray-900 mb-1">Te same zasady przy produkcji z AI</h3>
        <p class="text-sm text-gray-600 leading-relaxed">Muzykę tworzymy z wykorzystaniem AI uzupełnionej naszą obróbką, ale zakres wykorzystania ustalamy tak samo jasno i na piśmie jak przy klasycznej produkcji.</p>
      </div>
    </div>
    <p class="text-gray-600 text-center max-w-3xl mx-auto leading-relaxed mt-8">Masz szczególne wymagania - wyłączność w branży, dłuższy okres emisji albo konkretne rynki? Powiedz na etapie briefu, a dopasujemy warunki w wycenie.</p>
  </div>
</section>

