<script>
// Audio player for IVR samples
(function() {
  var currentBtn = null;
  var audioEl = null;

  function getAudio() {
    if (audioEl) audioEl.remove();
    audioEl = document.createElement('audio');
    audioEl.preload = 'auto';
    audioEl.style.display = 'none';
    document.body.appendChild(audioEl);
    audioEl.addEventListener('timeupdate', function() {
      if (!currentBtn) return;
      var row = currentBtn.closest('.ivr-sample-row');
      if (!row || !audioEl.duration) return;
      row.querySelector('.ivr-audio-bar').style.width = (audioEl.currentTime / audioEl.duration * 100) + '%';
    });
    audioEl.addEventListener('ended', function() {
      if (currentBtn) {
        currentBtn.querySelector('.play-icon').classList.remove('hidden');
        currentBtn.querySelector('.pause-icon').classList.add('hidden');
        var row = currentBtn.closest('.ivr-sample-row');
        if (row) row.querySelector('.ivr-audio-bar').style.width = '0%';
      }
      currentBtn = null;
    });
    return audioEl;
  }

  document.querySelectorAll('.ivr-play-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var src = this.dataset.audio;
      if (!src) return;
      var existing = audioEl;

      if (currentBtn === this && existing && !existing.paused) {
        existing.pause();
        this.querySelector('.play-icon').classList.remove('hidden');
        this.querySelector('.pause-icon').classList.add('hidden');
        return;
      }
      if (currentBtn === this && existing && existing.paused) {
        existing.play();
        this.querySelector('.play-icon').classList.add('hidden');
        this.querySelector('.pause-icon').classList.remove('hidden');
        return;
      }

      if (currentBtn && currentBtn !== this) {
        if (existing) existing.pause();
        currentBtn.querySelector('.play-icon').classList.remove('hidden');
        currentBtn.querySelector('.pause-icon').classList.add('hidden');
        var oldRow = currentBtn.closest('.ivr-sample-row');
        if (oldRow) oldRow.querySelector('.ivr-audio-bar').style.width = '0%';
      }

      currentBtn = this;
      var audio = getAudio();
      audio.src = src;
      audio.play();
      this.querySelector('.play-icon').classList.add('hidden');
      this.querySelector('.pause-icon').classList.remove('hidden');
    });
  });

  document.querySelectorAll('.ivr-audio-progress').forEach(function(bar) {
    bar.addEventListener('click', function(e) {
      if (!audioEl || !audioEl.duration) return;
      var rect = this.getBoundingClientRect();
      audioEl.currentTime = ((e.clientX - rect.left) / rect.width) * audioEl.duration;
    });
  });
})();
</script>

