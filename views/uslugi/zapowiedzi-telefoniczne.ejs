<script>
// Audio player for IVR samples
(function() {
  var currentBtn = null;
  var audioEl = null;

  function getAudio() {
    if (audioEl) audioEl.remove();
    audioEl = document.createElement('audio');
    audioEl.preload = 'auto';
    audioEl.style.display = 'none';
    document.body.appendChild(audioEl);
    audioEl.addEventListener('timeupdate', function() {
      if (!currentBtn) return;
      var row = currentBtn.closest('.ivr-sample-row');
      if (!row || !audioEl.duration) return;
      row.querySelector('.ivr-audio-bar').style.width = (audioEl.currentTime / audioEl.duration * 100) + '%';
    });
    audioEl.addEventListener('ended', function() {
      if (currentBtn) {
        currentBtn.querySelector('.play-icon').classList.remove('hidden');
        currentBtn.querySelector('.pause-icon').classList.add('hidden');
        var row = currentBtn.closest('.ivr-sample-row');
        if (row) row.querySelector('.ivr-audio-bar').style.width = '0%';
      }
      currentBtn = null;
    });
    return audioEl;
  }

  document.querySelectorAll('.ivr-play-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var src = this.dataset.audio;
      if (!src) return;
      var existing = audioEl;

      if (currentBtn === this && existing && !existing.paused) {
        existing.pause();
        this.querySelector('.play-icon').classList.remove('hidden');
        this.querySelector('.pause-icon').classList.add('hidden');
        return;
      }
      if (currentBtn === this && existing && existing.paused) {
        existing.play();
        this.querySelector('.play-icon').classList.add('hidden');
        this.querySelector('.pause-icon').classList.remove('hidden');
        return;
      }

      if (currentBtn && currentBtn !== this) {
        if (existing) existing.pause();
        currentBtn.querySelector('.play-icon').classList.remove('hidden');
        currentBtn.querySelector('.pause-icon').classList.add('hidden');
        var oldRow = currentBtn.closest('.ivr-sample-row');
        if (oldRow) oldRow.querySelector('.ivr-audio-bar').style.width = '0%';
      }

      currentBtn = this;
      var audio = getAudio();
      audio.src = src;
      audio.play();
      this.querySelector('.play-icon').classList.add('hidden');
      this.querySelector('.pause-icon').classList.remove('hidden');
    });
  });

  document.querySelectorAll('.ivr-audio-progress').forEach(function(bar) {
    bar.addEventListener('click', function(e) {
      if (!audioEl || !audioEl.duration) return;
      var rect = this.getBoundingClientRect();
      audioEl.currentTime = ((e.clientX - rect.left) / rect.width) * audioEl.duration;
    });
  });
})();

// IVR inquiry form
document.getElementById('ivr-inquiry-form').addEventListener('submit', function(e) {
  e.preventDefault();
  var btn = document.getElementById('ivr-submit-btn');
  var errorEl = document.getElementById('ivr-form-error');
  errorEl.classList.add('hidden');
  btn.disabled = true;
  btn.textContent = 'Wysyłanie...';

  var data = {
    email: document.getElementById('ivr-email').value.trim(),
    name: document.getElementById('ivr-name').value.trim(),
    phone: document.getElementById('ivr-phone').value.trim(),
    description: document.getElementById('ivr-description').value.trim(),
    serviceType: 'ivr',
  };

  fetch('/api/contact/inquiry', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(data),
  })
  .then(function(res) { return res.json(); })
  .then(function(result) {
    if (result.success || result.ok) {
      document.getElementById('ivr-inquiry-form').classList.add('hidden');
      document.getElementById('ivr-form-success').classList.remove('hidden');
      if (typeof gtag === 'function') {
        gtag('event', 'generate_lead', { event_category: 'inquiry', event_label: 'ivr' });
      }
    } else {
      throw new Error(result.error || 'Wystąpił błąd');
    }
  })
  .catch(function(err) {
    errorEl.textContent = err.message || 'Nie udało się wysłać. Spróbuj ponownie.';
    errorEl.classList.remove('hidden');
    btn.disabled = false;
    btn.textContent = 'Wyślij zapytanie';
  });
});
</script>

