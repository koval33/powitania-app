<!-- Custom audio player init - jeden shared <audio> dla wszystkich .play-btn -->
<script>
(function() {
  function formatTime(s) {
    if (!isFinite(s)) return '--:--';
    var m = Math.floor(s / 60);
    var sec = Math.floor(s % 60);
    return m + ':' + (sec < 10 ? '0' : '') + sec;
  }
  var currentBtn = null;
  function resetCurrentBtn() {
    if (!currentBtn) return;
    currentBtn.querySelector('.play-icon').classList.remove('hidden');
    currentBtn.querySelector('.pause-icon').classList.add('hidden');
    var box = currentBtn.closest('.player-box');
    if (box) {
      box.querySelector('.audio-bar').style.width = '0%';
      box.querySelector('.audio-time').textContent = '0:00';
    }
  }
  function getAudioEl() {
    var el = document.getElementById('shared-audio-el');
    if (el) el.remove();
    el = document.createElement('audio');
    el.id = 'shared-audio-el';
    el.preload = 'auto';
    el.style.display = 'none';
    document.body.appendChild(el);
    el.addEventListener('timeupdate', function() {
      if (!currentBtn) return;
      var box = currentBtn.closest('.player-box');
      if (!box) return;
      var pct = (el.currentTime / el.duration) * 100;
      box.querySelector('.audio-bar').style.width = pct + '%';
      box.querySelector('.audio-time').textContent = formatTime(el.currentTime);
    });
    el.addEventListener('loadedmetadata', function() {
      if (!currentBtn) return;
      var box = currentBtn.closest('.player-box');
      if (box) box.querySelector('.audio-duration').textContent = formatTime(el.duration);
    });
    el.addEventListener('ended', function() { resetCurrentBtn(); currentBtn = null; });
    return el;
  }
  document.querySelectorAll('.play-btn').forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.stopPropagation();
      var src = this.dataset.audio;
      if (!src) return;
      var playIcon = this.querySelector('.play-icon');
      var pauseIcon = this.querySelector('.pause-icon');
      var existing = document.getElementById('shared-audio-el');
      if (currentBtn === this && existing) {
        if (existing.paused) {
          existing.play();
          playIcon.classList.add('hidden');
          pauseIcon.classList.remove('hidden');
        } else {
          existing.pause();
          playIcon.classList.remove('hidden');
          pauseIcon.classList.add('hidden');
        }
        return;
      }
      if (existing && !existing.paused) existing.pause();
      resetCurrentBtn();
      currentBtn = this;
      var audio = getAudioEl();
      audio.src = src;
      audio.load();
      audio.play().catch(function() {
        playIcon.classList.remove('hidden');
        pauseIcon.classList.add('hidden');
      });
      playIcon.classList.add('hidden');
      pauseIcon.classList.remove('hidden');
    });
  });
})();
</script>

