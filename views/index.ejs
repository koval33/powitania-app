<%- include('partials/head') %>

<!-- HERO - Claude Design package, obraz wypelnia container (mobile cover+top, desktop tez cover+top) -->
<section class="hero relative overflow-hidden min-h-[600px] md:min-h-0">

  <%# Mobile: object-cover wypelnia container (absolute, sekcja ma min-h-[600px]) %>
  <img src="/img/studio-bg-960.bw-backup.webp"
       alt="Studio nagrań Powitania.pl - lektor przy mikrofonie"
       class="md:hidden absolute inset-0 w-full h-full object-cover object-top"
       width="960" height="490"
       loading="eager"
       fetchpriority="high">
  <%# Desktop: obraz W NORMALNYM FLOW - definiuje wysokość sekcji (naturalna proporcja, bez zoomu, bez pustego pasa) %>
  <img src="/img/studio-bg-1920.bw-backup.webp"
       alt=""
       class="hidden md:block w-full h-auto max-w-none"
       width="1920" height="980"
       loading="eager"
       fetchpriority="high">

  <%# Overlay - dokladnie ten sam co na hero podstron (klasa .hero-fade): srodek jasny,
      ciemniej tylko gora (menu), prawa "dolina" i lewy-dolny rog. Mniej ponuro niz jednolity scrim. %>
  <div class="hero-fade hero-fade-home absolute inset-0"></div>

  <%# Content - nałożony absolutnie na obraz, pt-[140px/160px] (header + oddech) %>
  <div class="relative md:absolute md:inset-0 z-10 w-full max-w-7xl mx-auto px-4 md:px-6 lg:px-8 pt-28 md:pt-[160px] pb-8">

    <%# Tytuły w jednym bloku tła %>
    <div class="flex justify-center mb-6 md:mb-14">
      <div class="inline-block bg-black/35 rounded-md px-6 md:px-10 py-6 md:py-8 text-center">
        <h1 class="text-white font-extralight text-3xl sm:text-4xl md:text-5xl lg:text-[56px] tracking-tight leading-[1.1]" style="font-family: 'Dosis', sans-serif;">
          Studio i&nbsp;usługi lektorskie
        </h1>
        <p class="mt-3 md:mt-4 text-white/95 font-extralight text-2xl sm:text-3xl md:text-[32px] tracking-wide leading-snug" style="font-family: 'Dosis', sans-serif;">
          Przeszukaj nasz bank głosów
        </p>
      </div>
    </div>

    <%# Widget: znajdź lektora (selecty + button w jednym rzędzie na md+) %>
    <form action="/bank-glosow/" method="get" class="max-w-3xl mx-auto bg-black/35 border border-white/45 rounded-md p-5 md:p-7">
      <h2 class="text-white text-center text-lg md:text-xl font-normal mb-5 md:mb-6 leading-snug tracking-wide" style="font-family: 'Dosis', sans-serif;">
        Znajdź lektora w&nbsp;dwóch prostych krokach lub zadzwoń do nas <a href="tel:+48605491069" class="font-semibold hover:underline whitespace-nowrap">605&nbsp;491&nbsp;069</a>!
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-[1fr_1fr_auto] gap-3 md:gap-4 items-end">
        <label class="block">
          <span class="block text-white text-xs font-medium mb-1.5">Płeć lektora</span>
          <select name="gender" class="field-select w-full bg-white text-gray-900 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-accent/60">
            <option value="all">Wszyscy</option>
            <option value="m">Mężczyzna</option>
            <option value="f">Kobieta</option>
          </select>
        </label>

        <label class="block">
          <span class="block text-white text-xs font-medium mb-1.5">Język</span>
          <select name="lang" class="field-select w-full bg-white text-gray-900 rounded-md px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-accent/60">
            <option value="all">Wszystkie języki</option>
            <%
              // Lista języków dynamicznie z voices.json (sortowanie: polski first, reszta alfabetycznie)
              var allLangs = new Set();
              (voices || []).forEach(function(v) { (v.languages || []).forEach(function(l) { allLangs.add(l); }); });
              var langs = Array.from(allLangs).sort(function(a, b) {
                if (a === 'polski') return -1;
                if (b === 'polski') return 1;
                return a.localeCompare(b, 'pl');
              });
            %>
            <% langs.forEach(function(lang) { %>
              <option value="<%= lang %>"<% if (lang === 'polski') { %> selected<% } %>><%= lang %></option>
            <% }); %>
          </select>
        </label>

        <button type="submit" class="w-full md:w-auto bg-accent hover:bg-accent-light transition-colors duration-200 text-white uppercase tracking-wider font-semibold text-xs md:text-sm px-5 md:px-6 py-2.5 rounded-md focus:outline-none focus:ring-2 focus:ring-white/70 focus:ring-offset-2 focus:ring-offset-transparent whitespace-nowrap">
          Znajdź lektora
        </button>
      </div>
    </form>

  </div>
</section>

<!-- ATOMIC FACTS - dla LLM/GEO -->
<section class="py-12 border-t border-gray-200">
  <div class="max-w-5xl mx-auto px-4 text-center">
    <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4" style="font-family: 'Dosis', sans-serif;">
      Studio lektorskie powitania.pl - od 2001 roku
    </h2>
    <p class="text-base md:text-lg text-gray-700 leading-relaxed">
      <strong>Powitania.pl</strong> to profesjonalne studio lektorskie założone w&nbsp;2001&nbsp;roku w&nbsp;Lublinie. Należymy do&nbsp;najdłużej działających polskich firm świadczących usługi lektorskie. Nasz bank głosów liczy <strong><%= voiceCount %>&nbsp;lektorów w&nbsp;30+&nbsp;językach</strong>.
    </p>
    <p class="text-base md:text-lg text-gray-700 leading-relaxed mt-4">
      Zrealizowaliśmy ponad <strong>11&nbsp;000 nagrań</strong> - m.in. dla Hyundai, Orange, Play, Asseco, Allegro, DHL, TVN, Volvo, MSWiA, MEN. Ocena <strong>5/5</strong> (<%= reviewCount %>&nbsp;opinii), realizacja <strong>24-48h</strong>, ceny <strong>od&nbsp;300&nbsp;zł</strong>.
    </p>
  </div>
</section>

