<!-- Audio player for popular lectors + Reviews carousel -->
<script>
var popularAudio = null;
var popularBtn = null;

function playPopular(btn, src) {
  if (popularBtn && popularBtn !== btn) {
    popularBtn.querySelector('.play-icon').classList.remove('hidden');
    popularBtn.querySelector('.pause-icon').classList.add('hidden');
  }
  if (popularAudio && popularAudio.src.includes(src) && !popularAudio.paused) {
    popularAudio.pause();
    btn.querySelector('.play-icon').classList.remove('hidden');
    btn.querySelector('.pause-icon').classList.add('hidden');
    return;
  }
  if (!popularAudio) popularAudio = new Audio();
  popularAudio.src = src;
  popularAudio.play();
  popularBtn = btn;
  btn.querySelector('.play-icon').classList.add('hidden');
  btn.querySelector('.pause-icon').classList.remove('hidden');
  popularAudio.onended = function() {
    btn.querySelector('.play-icon').classList.remove('hidden');
    btn.querySelector('.pause-icon').classList.add('hidden');
  };
}

// Reviews carousel
var currentSlide = 0;
var totalSlides = 3;

function slideReviews(dir) {
  currentSlide = (currentSlide + dir + totalSlides) % totalSlides;
  updateSlider();
}

function goToSlide(n) {
  currentSlide = n;
  updateSlider();
}

function updateSlider() {
  var slider = document.getElementById('reviews-slider');
  if (slider) slider.style.transform = 'translateX(-' + (currentSlide * 100) + '%)';
  var dots = document.querySelectorAll('.review-dot');
  dots.forEach(function(dot, i) {
    dot.className = 'review-dot w-2.5 h-2.5 rounded-full transition-colors ' + (i === currentSlide ? 'bg-accent' : 'bg-gray-600');
  });
}

// Auto-play carousel
setInterval(function() { slideReviews(1); }, 8000);

// YouTube lazy-load facade
function loadYT(el) {
  var vid = el.getAttribute('data-vid');
  el.innerHTML = '<iframe class="w-full h-full" src="https://www.youtube.com/embed/' + vid + '?autoplay=1" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>';
  el.style.cursor = 'default';
  el.onclick = null;
}

// Homepage contact form
(function() {
  var form = document.getElementById('homepage-contact-form');
  if (!form) return;
  var msg = document.getElementById('hc-msg');
  var btn = document.getElementById('hc-submit');

  form.addEventListener('submit', function(e) {
    e.preventDefault();
    btn.disabled = true;
    btn.textContent = 'Wysyłanie...';
    msg.className = 'hidden';

    var data = {
      name: document.getElementById('hc-name').value.trim(),
      email: document.getElementById('hc-email').value.trim(),
      message: document.getElementById('hc-message').value.trim(),
      source: 'homepage'
    };

    fetch('/api/contact', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    })
    .then(function(r) { return r.json(); })
    .then(function(res) {
      if (res.ok) {
        msg.className = 'text-center text-sm py-3 rounded-lg bg-accent/10 border border-accent/30 text-accent';
        msg.textContent = 'Dziękujemy! Odpowiemy najszybciej jak to możliwe.';
        form.reset();
      } else {
        msg.className = 'text-center text-sm py-3 rounded-lg bg-red-500/10 border border-red-500/30 text-red-400';
        msg.textContent = res.error || 'Wystąpił błąd. Spróbuj ponownie.';
      }
    })
    .catch(function() {
      msg.className = 'text-center text-sm py-3 rounded-lg bg-red-500/10 border border-red-500/30 text-red-400';
      msg.textContent = 'Wystąpił błąd połączenia. Spróbuj ponownie.';
    })
    .finally(function() {
      btn.disabled = false;
      btn.textContent = 'Wyślij wiadomość';
    });
  });
})();

// Newsletter form (UI - shows confirmation, actual endpoint TBD)
(function() {
  var form = document.getElementById('newsletter-form');
  if (!form) return;
  var msg = document.getElementById('nl-msg');

  form.addEventListener('submit', function(e) {
    e.preventDefault();
    var email = document.getElementById('nl-email').value.trim();
    if (!email) return;
    msg.className = 'text-center text-sm py-2 mt-2 rounded-lg bg-accent/10 border border-accent/30 text-accent';
    msg.textContent = 'Dziękujemy za zapisanie się! Potwierdzenie wyślemy na ' + email;
    form.reset();
  });
})();
</script>

