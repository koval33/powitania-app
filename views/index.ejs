<%- include('partials/head') %>

<!-- HERO + KREATOR -->
<section class="relative overflow-hidden hero-dotgrid">

  <div class="relative max-w-4xl mx-auto px-4 pt-10 pb-4 md:pt-14 md:pb-6 text-center">
    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-3 leading-tight" style="font-family: 'Poppins', sans-serif;">
      Profesjonalne kreacje lektorskie
    </h1>
    <p class="text-lg text-gray-600 max-w-2xl mx-auto">
      Przygotuj tekst, wybierz lektora, zamów nagranie. Ponad 234 profesjonalnych głosów w 30+ językach.
    </p>
  </div>

  <!-- KREATOR wewnątrz sekcji z kropkami -->
  <div id="kreator" class="relative pb-10 pt-2 scroll-mt-[8rem]">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center mb-5">
        <h2 class="text-2xl font-bold text-gray-900" style="font-family: 'Poppins', sans-serif;">Kreator Treści Lektorskich</h2>
      </div>
      <%- include('partials/kreator') %>
    </div>
  </div>
</section>

<!-- ATOMIC FACTS — dla LLM/GEO -->
<section class="py-12 bg-white">
  <div class="max-w-4xl mx-auto px-4 text-center">
    <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-4" style="font-family: 'Poppins', sans-serif;">
      Studio lektorskie powitania.pl — od 2001 roku
    </h2>
    <p class="text-base md:text-lg text-gray-700 leading-relaxed">
      <strong>Powitania.pl</strong> to profesjonalne studio lektorskie założone w 2001 roku w Lublinie. Należymy do najdłużej działających polskich studiów nagrań lektorskich. Nasz bank głosów liczy <strong>234 lektorów w 30+ językach</strong>. Zrealizowaliśmy ponad <strong>11&nbsp;000 nagrań</strong> dla <strong>2&nbsp;800+ klientów</strong> — m.in. Hyundai, Orange, Play, Asseco, Allegro, DHL, TVN, Volvo, MSWiA, MEN. Ocena <strong>5/5</strong> (149 opinii). Realizacja <strong>24-48h</strong>, ceny <strong>od 300 zł</strong>.
    </p>
  </div>
</section>

<!-- JAK TO DZIAŁA -->
<section class="py-16" style="background-color:#efe8df">
  <div class="max-w-6xl mx-auto px-4">
    <h2 class="text-3xl font-bold text-center text-gray-900 mb-12">Jak to działa?</h2>
    <div class="grid md:grid-cols-3 gap-10">
      <!-- Step 1: Przygotuj tekst -->
      <div class="text-center group">
        <div class="w-full mb-5 aspect-[3/2] rounded-xl overflow-hidden shadow-sm">
          <img src="/img/sections/przygotuj-tekst.webp" alt="Przygotuj tekst — edytor tekstów" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" fetchpriority="high" width="670" height="449">
        </div>
        <h3 class="font-bold text-lg mb-2 text-gray-900">Przygotuj tekst</h3>
        <p class="text-gray-500 text-sm">Skorzystaj z kreatora lub wklej własny tekst do optymalizacji.</p>
      </div>
      <!-- Step 2: Wybierz lektora -->
      <div class="text-center group">
        <div class="w-full mb-5 aspect-[3/2] rounded-xl overflow-hidden shadow-sm">
          <img src="/img/sections/wybierz-lektora.webp" alt="Wybierz lektora — studio nagraniowe" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" width="670" height="445">
        </div>
        <h3 class="font-bold text-lg mb-2 text-gray-900">Wybierz lektora</h3>
        <p class="text-gray-500 text-sm">Przesłuchaj próbki i wybierz głos idealny dla Twojego projektu.</p>
      </div>
      <!-- Step 3: Zamów nagranie -->
      <div class="text-center group">
        <div class="w-full mb-5 aspect-[3/2] rounded-xl overflow-hidden shadow-sm">
          <img src="/img/sections/zamow-nagranie.webp" alt="Zamów nagranie — zamówienie online" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" width="670" height="353">
        </div>
        <h3 class="font-bold text-lg mb-2 text-gray-900">Zamów nagranie</h3>
        <p class="text-gray-500 text-sm">Profesjonalne nagranie gotowe w 24-48 godzin.</p>
      </div>
    </div>
  </div>
</section>

<!-- AKTUALNOŚCI -->
<% if (typeof posts !== 'undefined' && posts.length > 0) { %>
<section class="py-16">
  <div class="max-w-6xl mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">Aktualności</h2>
      <p class="text-gray-500">Nowości ze studia nagrań lektorskich, porady i artykuły branżowe</p>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      <% posts.forEach(function(post) { %>
      <a href="/aktualnosci-pl/<%= post.slug %>/" class="group bg-white rounded-xl border border-gray-200 hover:border-accent overflow-hidden shadow-sm hover:shadow-md transition-all duration-300">
        <div class="p-6">
          <div class="text-xs text-gray-500 mb-3"><%= post.date %></div>
          <h3 class="font-semibold mb-2 text-gray-900 group-hover:text-accent transition-colors line-clamp-2"><%= post.title %></h3>
          <p class="text-gray-500 text-sm leading-relaxed line-clamp-3"><%= post.excerpt %></p>
          <span class="inline-flex items-center gap-1 text-accent text-sm font-medium mt-4">
            Czytaj więcej
            <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          </span>
        </div>
      </a>
      <% }); %>
    </div>

    <div class="text-center mt-10">
      <a href="/aktualnosci-pl/" class="text-accent hover:text-accent-light font-medium text-sm">Wszystkie aktualności &rarr;</a>
    </div>
  </div>
</section>
<% } %>

