<!-- Audio player for popular lectors + Reviews carousel -->
<script>
var popularAudio = null;
var popularBtn = null;

function playPopular(btn, src) {
  if (popularBtn && popularBtn !== btn) {
    popularBtn.querySelector('.play-icon').classList.remove('hidden');
    popularBtn.querySelector('.pause-icon').classList.add('hidden');
  }
  if (popularAudio && popularAudio.src.includes(src) && !popularAudio.paused) {
    popularAudio.pause();
    btn.querySelector('.play-icon').classList.remove('hidden');
    btn.querySelector('.pause-icon').classList.add('hidden');
    return;
  }
  if (!popularAudio) popularAudio = new Audio();
  popularAudio.src = src;
  popularAudio.play();
  popularBtn = btn;
  btn.querySelector('.play-icon').classList.add('hidden');
  btn.querySelector('.pause-icon').classList.remove('hidden');
  popularAudio.onended = function() {
    btn.querySelector('.play-icon').classList.remove('hidden');
    btn.querySelector('.pause-icon').classList.add('hidden');
  };
}

// Reviews carousel
var currentSlide = 0;
var totalSlides = 3;

function slideReviews(dir) {
  currentSlide = (currentSlide + dir + totalSlides) % totalSlides;
  updateSlider();
}

function goToSlide(n) {
  currentSlide = n;
  updateSlider();
}

function updateSlider() {
  var slider = document.getElementById('reviews-slider');
  if (slider) slider.style.transform = 'translateX(-' + (currentSlide * 100) + '%)';
  var dots = document.querySelectorAll('.review-dot');
  dots.forEach(function(dot, i) {
    var inner = dot.querySelector('span');
    if (inner) inner.className = 'w-2.5 h-2.5 rounded-full transition-colors ' + (i === currentSlide ? 'bg-accent' : 'bg-gray-600');
  });
}

// Auto-play carousel
setInterval(function() { slideReviews(1); }, 8000);

// Dynamiczna karuzela YouTube - sprawdza dostępność filmów, buduje slajdy
(function() {
  var allVideos = [
    { id: 'SS9ebAxTiF8', title: 'Film korporacyjny - Marcopol', narrator: 'Lektor Bill', slug: 'bill' },
    { id: 'jBbX2XOt4hA', title: 'Historia narodzin Dzbanka - Ceramika Artystyczna', narrator: 'Lektor Andrzej Ferenc', slug: 'andrzej-ferenc' },
    { id: 'nQsRy6AKyj0', title: 'Reklama TV - Biedronka', narrator: 'Lektorka Lea', slug: 'lea' },
    { id: '9lWm6XAbaDg', title: 'Narracja do filmu instruktażowego', narrator: 'Lektor Patryk', slug: 'patryk' },
    { id: 'cfZ27giVqh8', title: 'Wiktor zachęca do monitoringu stron', narrator: 'Lektor Wiktor', slug: 'wiktor' },
    { id: '6gnEr5UzW2Q', title: 'Narracja do projektu \u201eZiemianie atakują\u201d', narrator: 'Lektor David', slug: 'david' },
    { id: 'XQV-8dbWgII', title: 'Prezentacja firmy z branży przemysłowej', narrator: 'Lektorka Beata', slug: 'beata' },
    { id: 'YLdaojG1tQw', title: 'Narracja do filmu serwisu Askberry', narrator: 'Lektor Michał', slug: 'michal' },
    { id: 'ejCfU8Ucx6A', title: 'Reklama Bosch', narrator: 'Lektor Humberto', slug: 'humberto' }
  ];

  var track = document.getElementById('yt-track');
  var prevBtn = document.getElementById('yt-prev');
  var nextBtn = document.getElementById('yt-next');
  var dotsWrap = document.getElementById('yt-dots');
  if (!track) return;

  var PER_SLIDE = 3;
  var currentSlide = 0;
  var totalSlides = 0;

  function makeCard(v) {
    return '<div class="bg-white rounded-xl overflow-hidden border border-gray-200 hover:border-gray-300 shadow-sm hover:shadow-md transition-all">' +
      '<div class="aspect-video bg-gray-100 relative cursor-pointer yt-facade" data-vid="' + v.id + '" onclick="loadYT(this)">' +
        '<img src="https://img.youtube.com/vi/' + v.id + '/hqdefault.jpg" alt="' + v.title + '" class="w-full h-full object-cover" loading="lazy">' +
        '<div class="absolute inset-0 flex items-center justify-center bg-black/40 hover:bg-black/30 transition-colors">' +
          '<svg class="w-14 h-14 text-white/90" viewBox="0 0 68 48"><path d="M66.52 7.74c-.78-2.93-2.49-5.41-5.42-6.19C55.79.13 34 0 34 0S12.21.13 6.9 1.55C3.97 2.33 2.27 4.81 1.48 7.74.06 13.05 0 24 0 24s.06 10.95 1.48 16.26c.78 2.93 2.49 5.41 5.42 6.19C12.21 47.87 34 48 34 48s21.79-.13 27.1-1.55c2.93-.78 4.64-3.26 5.42-6.19C67.94 34.95 68 24 68 24s-.06-10.95-1.48-16.26z" fill="red"/><path d="M45 24L27 14v20" fill="white"/></svg>' +
        '</div>' +
      '</div>' +
      '<div class="p-4">' +
        '<h3 class="text-gray-900 font-semibold text-sm">' + v.title + '</h3>' +
        (v.slug ? '<a href="/lektorzy/' + v.slug + '/" class="text-xs text-accent-dark hover:text-accent mt-1 inline-block">' + v.narrator + '</a>' : '<p class="text-xs text-gray-600 mt-1">' + v.narrator + '</p>') +
      '</div></div>';
  }

  function buildCarousel(videos) {
    if (!videos.length) {
      document.getElementById('yt-section').style.display = 'none';
      return;
    }
    track.innerHTML = '';
    totalSlides = Math.ceil(videos.length / PER_SLIDE);
    for (var s = 0; s < totalSlides; s++) {
      var slideDiv = document.createElement('div');
      slideDiv.className = 'w-full flex-shrink-0 grid md:grid-cols-3 gap-6 px-1';
      var chunk = videos.slice(s * PER_SLIDE, (s + 1) * PER_SLIDE);
      chunk.forEach(function(v) { slideDiv.innerHTML += makeCard(v); });
      track.appendChild(slideDiv);
    }
    // Dots
    dotsWrap.innerHTML = '';
    if (totalSlides > 1) {
      for (var d = 0; d < totalSlides; d++) {
        var dot = document.createElement('button');
        dot.type = 'button';
        dot.setAttribute('data-slide', d);
        dot.setAttribute('aria-label', 'Przejdź do grupy filmów ' + (d + 1));
        dot.className = 'w-6 h-6 flex items-center justify-center';
        var dotInner = document.createElement('span');
        dotInner.className = 'w-2.5 h-2.5 rounded-full transition-colors ' + (d === 0 ? 'bg-accent' : 'bg-gray-600');
        dot.appendChild(dotInner);
        dot.addEventListener('click', function() { goToSlide(parseInt(this.getAttribute('data-slide'), 10)); });
        dotsWrap.appendChild(dot);
      }
      prevBtn.classList.remove('hidden'); prevBtn.classList.add('flex');
      nextBtn.classList.remove('hidden'); nextBtn.classList.add('flex');
    }
    currentSlide = 0;
  }

  function goToSlide(n) {
    currentSlide = ((n % totalSlides) + totalSlides) % totalSlides;
    track.style.transform = 'translateX(-' + (currentSlide * 100) + '%)';
    var dots = dotsWrap.querySelectorAll('button');
    dots.forEach(function(d, i) {
      var inner = d.querySelector('span');
      if (inner) inner.className = 'w-2.5 h-2.5 rounded-full transition-colors ' + (i === currentSlide ? 'bg-accent' : 'bg-gray-600');
    });
  }

  prevBtn.addEventListener('click', function() { goToSlide(currentSlide - 1); });
  nextBtn.addEventListener('click', function() { goToSlide(currentSlide + 1); });

  // Sprawdź dostępność filmów via server-side proxy, potem zbuduj karuzelę
  var ids = allVideos.map(function(v) { return v.id; }).join(',');
  fetch('/api/yt-check?ids=' + ids)
    .then(function(r) { return r.json(); })
    .then(function(data) {
      var active = allVideos.filter(function(v) { return data.results[v.id] !== false; });
      buildCarousel(active);
    })
    .catch(function() {
      // W razie błędu - pokaż wszystkie
      buildCarousel(allVideos);
    });
})();

// Homepage contact form
(function() {
  var form = document.getElementById('homepage-contact-form');
  if (!form) return;
  var msg = document.getElementById('hc-msg');
  var btn = document.getElementById('hc-submit');

  form.addEventListener('submit', function(e) {
    e.preventDefault();
    btn.disabled = true;
    btn.textContent = 'Wysyłanie...';
    msg.className = 'hidden';

    var data = {
      name: document.getElementById('hc-name').value.trim(),
      email: document.getElementById('hc-email').value.trim(),
      message: document.getElementById('hc-message').value.trim(),
      source: 'homepage'
    };

    fetch('/api/contact', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    })
    .then(function(r) { return r.json(); })
    .then(function(res) {
      if (res.ok) {
        if (window.trackEvent) trackEvent('form_submit_contact', { source: 'homepage' });
        msg.className = 'text-center text-sm py-3 rounded-lg bg-accent/10 border border-accent/30 text-accent';
        msg.textContent = 'Dziękujemy! Odpowiemy najszybciej jak to możliwe.';
        form.reset();
      } else {
        msg.className = 'text-center text-sm py-3 rounded-lg bg-red-500/10 border border-red-500/30 text-red-400';
        msg.textContent = res.error || 'Wystąpił błąd. Spróbuj ponownie.';
      }
    })
    .catch(function() {
      msg.className = 'text-center text-sm py-3 rounded-lg bg-red-500/10 border border-red-500/30 text-red-400';
      msg.textContent = 'Wystąpił błąd połączenia. Spróbuj ponownie.';
    })
    .finally(function() {
      btn.disabled = false;
      btn.textContent = 'Wyślij wiadomość';
    });
  });
})();
</script>

