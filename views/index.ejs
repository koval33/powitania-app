<%- include('partials/head') %>

<!-- HERO + KREATOR — dot grid pod całą pierwszą sekcją -->
<section class="relative overflow-hidden hero-dotgrid">
  <div class="absolute inset-0 dot-grid-bg"></div>

  <div class="relative max-w-4xl mx-auto px-4 pt-10 pb-4 md:pt-14 md:pb-6 text-center">
    <h1 class="text-3xl md:text-4xl font-bold text-white mb-3 leading-tight" style="font-family: 'Poppins', sans-serif;">
      Profesjonalne nagrania lektorskie
    </h1>
    <p class="text-lg text-gray-300 max-w-2xl mx-auto">
      Przygotuj tekst, wybierz lektora, zamów nagranie. Ponad 230 profesjonalnych głosów w 30+ językach.
    </p>
  </div>

  <!-- KREATOR wewnątrz sekcji z kropkami -->
  <div id="kreator" class="relative pb-10 pt-2 scroll-mt-[8rem]">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center mb-5">
        <h2 class="text-2xl font-bold text-white" style="font-family: 'Poppins', sans-serif;">Kreator Tekstów</h2>
      </div>
      <%- include('partials/kreator') %>
    </div>
  </div>
</section>

<!-- JAK TO DZIAŁA -->
<section class="py-16 bg-gradient-to-b from-slate-900 to-slate-800/50">
  <div class="max-w-5xl mx-auto px-4">
    <h2 class="text-3xl font-bold text-center text-white mb-12">Jak to działa?</h2>
    <div class="grid md:grid-cols-3 gap-8">
      <!-- Step 1: Przygotuj tekst -->
      <div class="text-center group">
        <div class="w-full max-w-xs mx-auto mb-5 aspect-[3/2] rounded-xl overflow-hidden">
          <img src="/img/sections/przygotuj-tekst.webp" alt="Przygotuj tekst — edytor tekstów" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy">
        </div>
        <h3 class="font-bold text-lg mb-2 text-white">Przygotuj tekst</h3>
        <p class="text-gray-400 text-sm">Skorzystaj z kreatora lub wklej własny tekst do optymalizacji.</p>
      </div>
      <!-- Step 2: Wybierz lektora -->
      <div class="text-center group">
        <div class="w-full max-w-xs mx-auto mb-5 aspect-[3/2] rounded-xl overflow-hidden">
          <img src="/img/sections/wybierz-lektora.webp" alt="Wybierz lektora — studio nagraniowe" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy">
        </div>
        <h3 class="font-bold text-lg mb-2 text-white">Wybierz lektora</h3>
        <p class="text-gray-400 text-sm">Przesłuchaj próbki i wybierz głos idealny dla Twojego projektu.</p>
      </div>
      <!-- Step 3: Zamów nagranie -->
      <div class="text-center group">
        <div class="w-full max-w-xs mx-auto mb-5 aspect-[3/2] rounded-xl overflow-hidden">
          <img src="/img/sections/zamow-nagranie.webp" alt="Zamów nagranie — zamówienie online" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy">
        </div>
        <h3 class="font-bold text-lg mb-2 text-white">Zamów nagranie</h3>
        <p class="text-gray-400 text-sm">Profesjonalne nagranie gotowe w 24-48 godzin.</p>
      </div>
    </div>
  </div>
</section>

<!-- AKTUALNOŚCI -->
<% if (typeof posts !== 'undefined' && posts.length > 0) { %>
<section class="py-16">
  <div class="max-w-6xl mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Aktualności</h2>
      <p class="text-gray-400">Nowości ze studia nagrań lektorskich, porady i artykuły branżowe</p>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      <% posts.forEach(function(post) { %>
      <a href="/aktualnosci-pl/<%= post.slug %>/" class="group bg-gradient-to-b from-slate-800 to-slate-900 rounded-xl border border-white/10 hover:border-accent/30 overflow-hidden shadow-lg shadow-black/20 hover:shadow-xl hover:shadow-black/30 transition-all duration-300">
        <div class="p-6">
          <div class="text-xs text-gray-600 mb-3"><%= post.date %></div>
          <h3 class="text-white font-semibold mb-2 group-hover:text-accent transition-colors line-clamp-2"><%= post.title %></h3>
          <p class="text-gray-500 text-sm leading-relaxed line-clamp-3"><%= post.excerpt %></p>
          <span class="inline-flex items-center gap-1 text-accent text-sm font-medium mt-4">
            Czytaj więcej
            <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          </span>
        </div>
      </a>
      <% }); %>
    </div>

    <div class="text-center mt-10">
      <a href="/aktualnosci-pl/" class="inline-flex items-center gap-2 bg-dark-700 hover:bg-dark-600 text-white px-6 py-3 rounded-lg font-semibold text-sm transition-colors border border-white/10">
        Wszystkie aktualności
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
      </a>
    </div>
  </div>
</section>
<% } %>

<!-- NASZE USŁUGI -->
