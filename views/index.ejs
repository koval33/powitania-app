        </div>
        <button type="submit" id="hc-submit" class="w-full bg-accent hover:bg-accent-light text-white font-semibold py-3 rounded-lg transition-colors">Wyślij wiadomość</button>
        <div id="hc-msg" class="hidden text-center text-sm py-3 rounded-lg"></div>
      </form>
    </div>
  </div>
</section>

