<!-- POPULARNI LEKTORZY -->
<section class="py-20 bg-gradient-to-b from-slate-900 to-slate-800/50">
  <div class="max-w-6xl mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Popularni lektorzy</h2>
      <p class="text-gray-400">Odsłuchaj próbki i znajdź głos idealny dla Twojego projektu</p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-6">
      <% var popularIds = ['jacek-brzostynski', 'malgorzata', 'janusz', 'anita', 'maciej-jablonski']; %>
      <% var allVoices = typeof voices !== 'undefined' ? voices : []; %>
      <% popularIds.forEach(function(pid) { %>
        <% var v = allVoices.find(function(x) { return x.id === pid; }); %>
        <% if (v) { %>
        <div class="text-center group">
          <div class="relative mb-3">
            <img
              src="<%= v.photo %>"
              alt="<%= v.name %>"
              class="w-28 h-28 md:w-32 md:h-32 rounded-full mx-auto object-cover border-2 border-white/10 group-hover:border-accent/50 transition-all"
              loading="lazy"
            >
            <% if (v.audio) { %>
            <button
              onclick="playPopular(this, '<%= v.audio %>')"
              class="absolute bottom-0 right-1/2 translate-x-1/2 translate-y-1/3 w-10 h-10 bg-accent hover:bg-accent-light text-white rounded-full flex items-center justify-center shadow-lg transition-all hover:scale-110"
              title="Odsłuchaj próbkę"
            >
              <svg class="w-4 h-4 ml-0.5 play-icon" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              <svg class="w-4 h-4 pause-icon hidden" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
            </button>
            <% } %>
          </div>
          <a href="/lektorzy/<%= v.id %>/" class="text-white font-semibold text-sm hover:text-accent transition-colors"><%= v.name %></a>
          <div class="text-xs text-gray-500 mt-0.5"><%= v.gender === 'm' ? 'Lektor' : 'Lektorka' %></div>
        </div>
        <% } %>
      <% }); %>
    </div>

    <div class="text-center mt-10">
      <a href="/bank-glosow/" class="inline-flex items-center gap-2 bg-accent/10 hover:bg-accent/20 text-accent px-6 py-3 rounded-lg font-semibold text-sm transition-colors border border-accent/20">
        Zobacz wszystkich lektorów (230+)
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
      </a>
    </div>
  </div>
</section>

<!-- STATYSTYKI -->
