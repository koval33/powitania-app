<%- include('../partials/head') %>
<%- include('_nav') %>

<section class="py-12 md:py-16">
  <div class="max-w-md mx-auto px-4 text-center">
    <h1 class="text-2xl font-bold text-gray-900 mb-4">Logowanie</h1>
    <p class="text-gray-600 mb-8 leading-relaxed">Za chwilę przeniesiemy Cię do panelu. Jeśli nic się nie dzieje, kliknij przycisk.</p>
    <form id="panel-verify" method="post" action="/panel/login/verify/">
      <input type="hidden" name="token" value="<%= token %>">
      <input type="hidden" name="next" value="<%= next %>">
      <button type="submit" class="inline-block bg-accent hover:bg-accent-light text-white px-6 py-3 rounded-lg font-semibold transition-colors">Wejdź do panelu</button>
    </form>
  </div>
</section>

<script>
  // Link z maila jest jednorazowy; zuzywa go dopiero ten POST, nie samo
  // otwarcie strony (skanery poczty odwiedzaja linki GET-em).
  document.getElementById('panel-verify').submit();
</script>
<%- include('../partials/foot') %>
