<%- include('../partials/head') %>
<%- include('_nav') %>

<section class="py-8 md:py-16">
  <div class="max-w-5xl mx-auto px-4">
    <a href="/panel/" class="text-sm text-gray-500 hover:text-accent">&larr; Wszystkie zamówienia</a>
    <h1 class="text-2xl md:text-3xl font-bold text-gray-900 mt-3 mb-2">Nowe zamówienie</h1>
    <p class="text-gray-600 mb-8 leading-relaxed">Kwoty liczą się na bieżąco z cennika z umowy ramowej<% if (cennik && cennik.wersja) { %> (wersja <%= cennik.wersja %>)<% } %>. Wysłane zamówienie trafia do akceptacji Optimum, a Ty potwierdzasz gotowy dokument w panelu.</p>

    <form id="panel-nowe" class="space-y-6" novalidate>
      <div class="bg-white border border-gray-200 rounded-xl p-4 md:p-6">
        <h2 class="text-lg font-bold text-gray-900 mb-4">Projekt</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label for="klient_koncowy" class="block text-sm font-semibold text-gray-700 mb-1">Klient końcowy</label>
            <input type="text" id="klient_koncowy" name="klient_koncowy" required maxlength="200" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-3 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none" placeholder="marka, dla której powstaje nagranie">
          </div>
          <div>
            <label for="projekt" class="block text-sm font-semibold text-gray-700 mb-1">Nazwa projektu lub kampanii</label>
            <input type="text" id="projekt" name="projekt" required maxlength="200" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-3 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none" placeholder="np. kampania wiosenna 2027">
          </div>
          <div>
            <label for="termin_realizacji" class="block text-sm font-semibold text-gray-700 mb-1">Termin dostarczenia nagrań</label>
            <input type="date" id="termin_realizacji" name="termin_realizacji" required class="w-full bg-white border border-gray-300 rounded-lg px-4 py-3 text-gray-900 focus:border-accent focus:outline-none">
          </div>
          <div>
            <label for="termin_sesji" class="block text-sm font-semibold text-gray-700 mb-1">Termin sesji nagraniowej <span class="text-gray-500 font-normal">(opcjonalnie)</span></label>
            <input type="datetime-local" id="termin_sesji" name="termin_sesji" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-3 text-gray-900 focus:border-accent focus:outline-none">
          </div>
          <div>
            <label for="data_emisji" class="block text-sm font-semibold text-gray-700 mb-1">Planowana pierwsza emisja <span class="text-gray-500 font-normal">(opcjonalnie)</span></label>
            <input type="date" id="data_emisji" name="data_emisji" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-3 text-gray-900 focus:border-accent focus:outline-none">
          </div>
          <div>
            <label for="tryb_realizacji" class="block text-sm font-semibold text-gray-700 mb-1">Tryb realizacji</label>
            <select id="tryb_realizacji" name="tryb_realizacji" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-3 text-gray-900 focus:border-accent focus:outline-none">
              <option value="standard">standardowy</option>
              <option value="ekspres">ekspres, ten sam dzień (+50% stawek)</option>
              <option value="weekend">weekend lub dzień wolny (+50% stawek)</option>
            </select>
          </div>
        </div>
        <label class="flex items-center gap-3 text-sm text-gray-700 mt-4 cursor-pointer">
          <input type="checkbox" name="sesja_zdalna" class="h-4 w-4 accent-accent">
          <span>Sesja zdalna z udziałem Zamawiającego (<span data-kwota="sesja_zdalna">150 zł</span> netto)</span>
        </label>
      </div>

      <div>
        <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
          <h2 class="text-lg font-bold text-gray-900">Pozycje</h2>
          <div class="flex flex-wrap gap-2">
            <button type="button" data-dodaj="spot" class="inline-block bg-accent hover:bg-accent-light text-white px-4 py-2 rounded-lg font-semibold text-sm transition-colors">+ Spot reklamowy</button>
            <button type="button" data-dodaj="dogrywka" class="inline-block border border-gray-300 hover:border-accent text-gray-900 px-4 py-2 rounded-lg font-semibold text-sm transition-colors">+ Dogrywka do wcześniejszego Zamówienia</button>
          </div>
        </div>
        <div id="pozycje" class="space-y-4"></div>
        <p id="pozycje-puste" class="bg-white border border-gray-200 border-dashed rounded-xl p-6 text-gray-600 text-sm leading-relaxed">Zacznij od spotu reklamowego. Wersje pochodne (skrót, inne zakończenie) i dogrywki dodasz przyciskiem przy konkretnym spocie.</p>
      </div>

      <div class="bg-white border border-gray-200 rounded-xl p-4 md:p-6">
        <label for="uwagi_klienta" class="block text-sm font-semibold text-gray-700 mb-1">Uwagi do zamówienia <span class="text-gray-500 font-normal">(opcjonalnie)</span></label>
        <textarea id="uwagi_klienta" name="uwagi_klienta" rows="3" maxlength="2000" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-3 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none" placeholder="np. referencje brzmienia, pliki, osoby do kontaktu przy sesji"></textarea>
      </div>

      <div class="bg-gray-50 border border-gray-200 rounded-xl p-4 md:p-6">
        <h2 class="text-lg font-bold text-gray-900 mb-3">Podsumowanie</h2>
        <div id="podsumowanie" class="text-sm space-y-1 text-gray-700">
          <p class="text-gray-500">Dodaj pozycje, żeby zobaczyć wycenę.</p>
        </div>
        <div id="blokady" class="hidden bg-amber-50 border border-amber-200 text-amber-900 rounded-lg px-4 py-3 text-sm mt-4 leading-relaxed"></div>
        <div id="blad" class="hidden bg-red-50 border border-red-200 text-red-700 rounded-lg px-4 py-3 text-sm mt-4 leading-relaxed"></div>
        <div class="flex flex-wrap gap-3 mt-6">
          <button type="submit" data-wyslij="1" class="inline-block bg-accent hover:bg-accent-light text-white px-6 py-3 rounded-lg font-semibold transition-colors">Wyślij do akceptacji</button>
          <button type="submit" data-wyslij="0" class="inline-block border border-gray-300 hover:border-accent text-gray-900 px-6 py-3 rounded-lg font-semibold transition-colors">Zapisz jako szkic</button>
        </div>
        <p class="text-xs text-gray-500 mt-4 leading-relaxed">Kwoty netto w PLN według cennika z umowy ramowej; licencja wyłączna na 12 miesięcy w Polsce na wskazanym polu eksploatacji. Ostateczną kwotę potwierdza Optimum w dokumencie Zamówienia.</p>
      </div>
    </form>
  </div>
</section>

<template id="szablon-pozycji">
  <div class="pozycja bg-white border border-gray-200 rounded-xl p-4 md:p-6" data-typ="" data-rodzic="">
    <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
      <h3 class="font-semibold text-gray-900"><span class="poz-nr"></span>. <span class="poz-typ"></span></h3>
      <div class="flex items-center gap-3">
        <span class="poz-kwota font-semibold text-gray-900"></span>
        <button type="button" class="poz-usun text-sm text-gray-500 hover:text-red-700 underline">usuń</button>
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="pole-kwota-bazowa hidden">
        <label class="block text-sm font-semibold text-gray-700 mb-1">Stawka tamtej wersji (netto)</label>
        <input type="number" name="kwota_bazowa" min="1" step="1" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-3 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none" placeholder="z poprzedniego Zamówienia">
      </div>
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Lektor</label>
        <select name="lektor_id" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-3 text-gray-900 focus:border-accent focus:outline-none"></select>
      </div>
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Pole eksploatacji</label>
        <select name="pole" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-3 text-gray-900 focus:border-accent focus:outline-none"></select>
      </div>
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Długość</label>
        <select name="dlugosc" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-3 text-gray-900 focus:border-accent focus:outline-none"></select>
      </div>
      <div class="pole-opis-wersji hidden md:col-span-3">
        <label class="block text-sm font-semibold text-gray-700 mb-1">Czym różni się ta wersja</label>
        <input type="text" name="opis_wersji" maxlength="200" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-3 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none" placeholder="np. skrót do 15 s, inne zakończenie z nową ofertą">
      </div>
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Udźwiękowienie</label>
        <select name="udzwiekowienie" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-3 text-gray-900 focus:border-accent focus:outline-none">
          <option value="brak">bez udźwiękowienia</option>
          <option value="powierzona">muzyka powierzona lub stock</option>
          <option value="kreatywne">kreatywne</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Okres licencji</label>
        <select name="okres" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-3 text-gray-900 focus:border-accent focus:outline-none">
          <option value="12">12 miesięcy</option>
          <option value="24">24 miesiące (+50% stawki)</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Licencja</label>
        <select name="licencja" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-3 text-gray-900 focus:border-accent focus:outline-none">
          <option value="wylaczna">wyłączna</option>
          <option value="niewylaczna">niewyłączna</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-semibold text-gray-700 mb-1">Terytorium</label>
        <input type="text" name="terytorium" value="Polska" maxlength="80" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-3 text-gray-900 focus:border-accent focus:outline-none">
      </div>
      <div class="md:col-span-3">
        <label class="block text-sm font-semibold text-gray-700 mb-1">Tekst do nagrania <span class="text-gray-500 font-normal">(opcjonalnie, ale z nim Optimum od razu widzi, czy to wersja pochodna, czy nowy spot)</span></label>
        <textarea name="tekst" rows="3" maxlength="4000" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-3 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none" placeholder="wklej tekst spotu albo tej wersji; jeśli tekst jest w załączniku, napisz to w uwagach"></textarea>
      </div>
      <div class="md:col-span-2">
        <label class="block text-sm font-semibold text-gray-700 mb-1">Uwagi do pozycji <span class="text-gray-500 font-normal">(opcjonalnie)</span></label>
        <input type="text" name="uwagi" maxlength="300" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-3 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none" placeholder="np. tekst w załączniku, ton energiczny">
      </div>
    </div>
    <div class="poz-komunikaty text-sm text-amber-800 mt-3 leading-relaxed"></div>
    <p class="poz-zrodlo text-xs text-gray-500 mt-2"></p>
    <div class="podrzedne space-y-3 mt-4 ml-4 border-l-2 border-accent/20 pl-4 hidden"></div>
    <div class="poz-akcje hidden flex flex-wrap gap-2 mt-4 pt-4 border-t border-gray-100">
      <button type="button" data-dodaj-do="wersja_pochodna" class="inline-block border border-gray-300 hover:border-accent text-gray-900 px-3 py-1.5 rounded-lg font-semibold text-xs transition-colors">+ Wersja pochodna tego spotu</button>
      <button type="button" data-dodaj-do="dogrywka" class="inline-block border border-gray-300 hover:border-accent text-gray-900 px-3 py-1.5 rounded-lg font-semibold text-xs transition-colors">+ Dogrywka do tego spotu</button>
    </div>
  </div>
</template>

<script id="panel-konfiguracja" type="application/json"><%- JSON.stringify(konfiguracja).replace(/</g, '\\u003c') %></script>
<script src="/js/panel-pricing.js?v=<%= assetVersion %>"></script>
<script src="/js/panel-nowe.js?v=<%= assetVersion %>"></script>
<%- include('../partials/foot') %>
