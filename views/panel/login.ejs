<%- include('../partials/head') %>
<%- include('_nav') %>

<section class="py-12 md:py-16">
  <div class="max-w-md mx-auto px-4">
    <h1 class="text-2xl md:text-3xl font-bold text-gray-900 mb-2">Logowanie do panelu zamówień</h1>
    <p class="text-gray-600 mb-8 leading-relaxed">Podaj firmowy adres e-mail. Wyślemy na niego jednorazowy link do logowania, ważny 15 minut. Bez hasła.</p>

    <% if (blad) { %>
    <div class="bg-red-50 border border-red-200 text-red-700 rounded-lg px-4 py-3 text-sm mb-6"><%= blad %></div>
    <% } %>

    <form method="post" action="/panel/login/" class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm space-y-4">
      <input type="hidden" name="next" value="<%= next %>">
      <div>
        <label for="email" class="block text-sm font-semibold text-gray-700 mb-1">Adres e-mail</label>
        <input type="email" id="email" name="email" required autocomplete="email" autofocus
               class="w-full bg-white border border-gray-300 rounded-lg px-4 py-3 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none"
               placeholder="imie.nazwisko@firma.pl">
      </div>
      <% if (turnstileSiteKey) { %>
      <div class="cf-turnstile" data-sitekey="<%= turnstileSiteKey %>" data-response-field-name="turnstileToken" data-size="flexible"></div>
      <% } %>
      <button type="submit" class="w-full bg-accent hover:bg-accent-light text-white font-semibold py-3 rounded-lg transition-colors">Wyślij link do logowania</button>
    </form>

    <p class="text-sm text-gray-500 mt-6 leading-relaxed">Panel jest dostępny dla klientów z podpisaną umową ramową. Nie masz dostępu, a powinieneś? Napisz na <a href="mailto:biuro@powitania.pl" class="text-accent hover:underline">biuro@powitania.pl</a>.</p>
  </div>
</section>

<% if (turnstileSiteKey) { %>
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<% } %>
<%- include('../partials/foot') %>
