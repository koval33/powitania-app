<!-- MODAL: Szybkie zapytanie -->
<div id="quick-inquiry-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
  <!-- Overlay -->
  <div class="absolute inset-0 bg-black/50" onclick="closeInquiryModal()"></div>
  <!-- Content -->
  <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-lg p-6 z-10">
    <div class="flex items-start justify-between mb-1">
      <h3 class="text-xl font-bold text-gray-900">Zapytaj o lektora</h3>
      <button type="button" onclick="closeInquiryModal()" class="flex-shrink-0 ml-4 w-8 h-8 flex items-center justify-center rounded-full bg-gray-100 hover:bg-gray-200 text-gray-500 hover:text-gray-700 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <p class="text-sm text-gray-500 mb-5">Lektor: <span id="qi-lektor-display" class="font-medium text-gray-700"></span></p>
    <form id="qi-form" class="space-y-4">
      <input type="hidden" id="qi-lektor-name" name="lektorName" value="">
      <div>
        <label for="qi-email" class="block text-sm font-medium text-gray-700 mb-1">E-mail <span class="text-red-500">*</span></label>
        <input type="email" id="qi-email" name="email" required placeholder="jan@firma.pl" class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent">
      </div>
      <div>
        <label for="qi-name" class="block text-sm font-medium text-gray-700 mb-1">Imię / Firma</label>
        <input type="text" id="qi-name" name="name" placeholder="Jan Kowalski" class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent">
      </div>
      <div>
        <label for="qi-phone" class="block text-sm font-medium text-gray-700 mb-1">Telefon</label>
        <input type="tel" id="qi-phone" name="phone" placeholder="+48 600 000 000" class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent">
      </div>
      <div>
        <label for="qi-message" class="block text-sm font-medium text-gray-700 mb-1">Wiadomość</label>
        <textarea id="qi-message" name="description" rows="3" placeholder="W czym możemy pomóc? Opisz projekt, a przygotujemy wycenę." class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:border-accent focus:ring-1 focus:ring-accent resize-none"></textarea>
      </div>
      <button type="submit" id="qi-submit-btn" class="w-full bg-accent hover:bg-accent-light text-white font-semibold py-3 rounded-lg transition-colors">
        Wyślij zapytanie
      </button>
      <p class="text-xs text-gray-400 text-center">Odpowiemy w ciągu 1-2 godzin roboczych</p>
    </form>
    <!-- Sukces -->
    <div id="qi-success" class="hidden text-center py-6">
      <svg class="w-16 h-16 text-green-500 mx-auto mb-3" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <h4 class="text-lg font-bold text-gray-900 mb-1">Zapytanie wysłane!</h4>
      <p class="text-sm text-gray-500">Odezwiemy się najszybciej jak to możliwe.</p>
      <button type="button" onclick="closeInquiryModal()" class="mt-4 text-accent hover:text-accent-light text-sm font-medium">Zamknij</button>
    </div>
    <!-- Błąd -->
    <div id="qi-error" class="hidden mt-3 bg-red-50 border border-red-200 text-red-700 text-sm rounded-lg p-3"></div>
  </div>
</div>

<script>
// --- Inquiry modal ---
function openInquiryModal(lektorName) {
  document.getElementById('qi-lektor-name').value = lektorName;
  document.getElementById('qi-lektor-display').textContent = lektorName;
  document.getElementById('qi-form').classList.remove('hidden');
  document.getElementById('qi-success').classList.add('hidden');
  document.getElementById('qi-error').classList.add('hidden');
  document.getElementById('qi-submit-btn').disabled = false;
  document.getElementById('qi-submit-btn').textContent = 'Wyślij zapytanie';
  document.getElementById('quick-inquiry-modal').classList.remove('hidden');
  document.body.style.overflow = 'hidden';
  setTimeout(function() { document.getElementById('qi-email').focus(); }, 100);
}

function closeInquiryModal() {
  document.getElementById('quick-inquiry-modal').classList.add('hidden');
  document.body.style.overflow = '';
}

// Close on Escape
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') closeInquiryModal();
});

document.getElementById('qi-form').addEventListener('submit', function(e) {
  e.preventDefault();
  var btn = document.getElementById('qi-submit-btn');
  var errorEl = document.getElementById('qi-error');
  errorEl.classList.add('hidden');
  btn.disabled = true;
  btn.textContent = 'Wysyłanie...';

  var data = {
    email: document.getElementById('qi-email').value.trim(),
    name: document.getElementById('qi-name').value.trim(),
    phone: document.getElementById('qi-phone').value.trim(),
    description: document.getElementById('qi-message').value.trim(),
    lektorName: document.getElementById('qi-lektor-name').value,
    serviceType: 'voiceover',
  };

  fetch('/api/contact/inquiry', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(data),
  })
  .then(function(res) { return res.json(); })
  .then(function(result) {
    if (result.ok || result.success) {
      document.getElementById('qi-form').classList.add('hidden');
      document.getElementById('qi-success').classList.remove('hidden');
      // Track conversion
      if (window.trackEventEC) trackEventEC('form_submit_inquiry_bank', { lektor: data.lektorName }, data.email, data.phone);
      else if (window.trackEvent) trackEvent('form_submit_inquiry_bank', { lektor: data.lektorName });
    } else {
      throw new Error(result.error || 'Wystąpił błąd');
    }
  })
  .catch(function(err) {
    errorEl.textContent = err.message || 'Nie udało się wysłać. Spróbuj ponownie.';
    errorEl.classList.remove('hidden');
    btn.disabled = false;
    btn.textContent = 'Wyślij zapytanie';
  });
});
</script>

