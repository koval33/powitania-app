  #filters-bar .bank-filter-select { padding: 0 1.5rem 0 0.5rem; }
  #filters-bar .flex.flex-wrap { gap: 0.375rem; }
  /* Jezyk: select bez wymuszonej szerokosci alokuje miejsce na najdluzsza opcje
     (np. "portugalski") = duzy luz. Ustalamy wask, jawna szerokosc. */
