  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* Mobile only: kompaktowe pille w sticky filter bar - cel: zmiescic gender + Jezyk + Wiecej w jednej linii.
   Sidebar (#filters-sidebar) jest md:flex, wiec ponizsze reguly go nie dotykaja. */
@media (max-width: 767px) {
