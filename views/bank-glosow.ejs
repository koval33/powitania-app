    <!-- Licznik -->
    <%/* Mobile: ukryte (oszczedza wiersz; feedback ilosci jest nizej w "Pokazano X z Y"). #voice-count zostaje w DOM - JS dalej updateuje. */%>
    <p id="voice-count-line" class="hidden md:block text-sm text-gray-500 mb-4">Znaleziono: <span id="voice-count" class="text-gray-900 font-semibold"><%= voices.length %></span> lektorów</p>

    <style>
      /* Desktop: grid 3-col 2-row [photo | content (player on top, meta below) | CTA] */
      /* Photo flush z karta (bez paddingu/border-radius), pozostale strefy maja swoj padding */
      .vc-inner {
        display: grid !important;
        grid-template-columns: 140px 1fr 150px !important;
        grid-template-rows: auto auto !important;
        column-gap: 20px !important;
        row-gap: 6px !important;
        padding: 0 16px 0 0 !important;
        align-items: stretch !important;
      }
      .vc-photo {
        grid-column: 1; grid-row: 1 / -1;
        width: 140px !important;
        height: auto !important;
        align-self: stretch !important;
        border-radius: 0 !important;
        position: relative !important;
      }
      /* img pozycjonowany absolutnie - wypelnia kafel, NIE narzuca wlasnej (intrinsic) wysokosci.
         Dzieki temu wysokosc karty wyznacza tresc, a nie proporcje zdjecia (portret vs kwadrat). */
      .vc-photo img { position: absolute !important; inset: 0 !important; width: 100% !important; height: 100% !important; display: block !important; object-fit: cover !important; }

      /* Waveform (SoundCloud-style): slupki szare = nieodtworzone, akcent = odtworzone.
         --wave-accent steruje kolorem zagranej czesci (zmiana w 1 miejscu, np. na pomaranczowy). */
      .audio-progress { --wave-accent: #199dff; }
      .wave-svg { overflow: visible; }
      .wave-top-base { fill: #c2c8d2; }
      .wave-bot-base { fill: #c2c8d2; opacity: 0.42; }
      .wave-played { transition: clip-path 100ms linear; }
      .wave-top-played { fill: var(--wave-accent); }
      .wave-bot-played { fill: var(--wave-accent); opacity: 0.42; }
      .player-box:hover .wave-top-base { fill: #b4bbc7; }
      .vc-player-wrap { display: contents; }
      .vc-player-row { grid-column: 2; grid-row: 1; display: flex; align-items: center; gap: 10px; min-width: 0; padding-top: 16px; }
      .vc-info { grid-column: 2; grid-row: 2; min-width: 0; align-self: end; padding-bottom: 16px; }
      .vc-cta { grid-column: 3; grid-row: 1 / -1; align-self: center; padding: 16px 0; }
      /* Elementy mobile-only - ukryte domyślnie (desktop pokazuje vc-badge-inline w vc-info) */
      .vc-badge-mobile { display: none; }
      /* Mobile: 3-strefowy uklad - (1) zdjecie+info, (2) player full-width, (3) CTA+wiecej */
      @media (max-width: 767px) {
        .vc-inner {
          display: grid !important;
          grid-template-columns: 72px 1fr !important;
          column-gap: 12px !important;
          row-gap: 8px !important;
          align-items: start !important;
          padding: 10px !important;
          gap: unset;
        }
        /* STREFA 1 - zdjecie 72px w lewej kolumnie */
        .vc-photo {
          grid-column: 1; grid-row: 1;
          width: 72px !important; height: 72px !important;
          flex-shrink: 0;
        }
        /* STREFA 1 - info: imie+badge w rzedzie 1, meta pod spodem */
        .vc-info {
          grid-column: 2; grid-row: 1;
          display: grid !important;
          grid-template-columns: minmax(0, 1fr) auto;
          column-gap: 8px;
          row-gap: 2px;
          align-content: center;
          align-self: center;
          flex: initial !important;
          width: auto !important;
          min-width: 0;
        }
        .vc-info > h3 { grid-column: 1; grid-row: 1; min-width: 0; }
        /* Badge inline obok imienia (zamiast pod meta) */
        .vc-info > .vc-badge-inline {
          grid-column: 2; grid-row: 1;
          margin: 0 !important;
          align-self: center;
          display: block !important;
        }
        /* Meta (wiek/jezyk/termin/cena) - pelna szerokosc info, bez gornego marginesu */
        .vc-info > div:not(.vc-badge-inline) {
          grid-column: 1 / -1;
          margin-top: 0 !important;
        }
        /* Osobny .vc-badge-mobile niepotrzebny - badge jest obok imienia */
        .vc-badge-mobile { display: none !important; }

        /* STREFA 2 - player full-width */
        .vc-player-wrap { display: contents !important; }
        .player-box {
          grid-column: 1 / -1; grid-row: 2;
          flex: initial !important;
          padding: 10px 12px !important;
        }
        /* Wiekszy Play button - tap-target 40x40 */
        .player-box .play-btn { width: 44px !important; height: 44px !important; }

        /* STREFA 3 - akcje: dwa CTA side-by-side, pełna szerokość */
        .vc-cta {
          width: auto !important;
          grid-column: 1 / -1; grid-row: 3;
          flex-direction: row !important;
          gap: 8px !important;
          align-self: center;
        }
        .vc-cta > a, .vc-cta > button { flex: 1; min-height: 44px; }
        /* Premium (tylko "Zapytaj" - jedyne dziecko): nie rozciagaj na full width,
           ma byc tej samej szerokosci co jeden z dwoch przyciskow zwyklych lektorow (polowa - polowa gapa) */
        .vc-cta > :only-child { flex: 0 0 calc(50% - 4px) !important; }

        /* Mobile - zaokraglone zdjecie (avatar-style w male karcie) */
        .vc-photo { border-radius: 0.5rem !important; }

        /* Mobile - ukryj licznik czasu zeby fala miala wiecej miejsca */
        .player-box .audio-time-wrap { display: none !important; }
      }
    </style>
    <!-- Siatka lektorów -->
    <div id="voices-grid" class="grid grid-cols-1 gap-3">
      <% voices.forEach(function(v, idx) { %>
      <div class="voice-card bg-white rounded-xl border border-gray-200 overflow-hidden hover:border-accent/30 shadow-sm hover:shadow-md transition-shadow<%= idx >= 20 ? ' hidden' : '' %>"
           data-id="<%= v.id %>"
           data-url="<%= v.profileUrl %>"
           data-gender="<%= v.gender %>"
           data-age="<%= v.age %>"
           data-languages="<%= v.languages.join(',') %>"
           data-famous="<%= v.famous %>"
           data-native="<%= v.native %>"
           data-price="<%= v.priceGroup || '' %>"
           data-hideprice="<%= v.hidePrice ? 'true' : 'false' %>"
           data-name="<%= v.name.toLowerCase() %>">

        <div class="vc-inner flex items-center gap-4 px-5 py-4">

          <!-- Zdjęcie (link do profilu) - flush z karta, bez border-radius (karta ma overflow-hidden) -->
          <a href="<%= v.profileUrl %>" class="vc-photo flex-shrink-0 w-20 h-20 overflow-hidden bg-gray-100 block hover:opacity-90 transition-opacity">
            <% if (v.photo) { %>
              <img src="<%= v.photo %>" alt="<%= v.name %>" class="w-full h-full object-cover" loading="lazy">
            <% } else { %>
              <div class="w-full h-full flex items-center justify-center text-gray-400">
                <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
              </div>
            <% } %>
          </a>

          <!-- Imię + meta (link do profilu) - row 2 grid, pod player -->
          <a href="<%= v.profileUrl %>" class="vc-info min-w-0 block hover:text-accent transition-colors">
            <div class="flex items-baseline gap-2.5 flex-wrap">
              <h3 class="font-light text-gray-900 tracking-tight leading-tight text-2xl"><%= v.name %></h3>
              <% if (v.age) { %><span class="text-sm text-gray-500"><%= v.age %></span><% } %>
            </div>
            <div class="mt-1.5 flex items-center justify-between gap-3 flex-wrap">
              <div class="text-sm text-gray-500">
                Nagrywa w&nbsp;językach: <span class="text-accent font-medium uppercase tracking-wide"><%= v.languages.slice(0,3).join(', ') %></span>
              </div>
              <div class="text-sm text-accent font-medium flex items-center gap-2 whitespace-nowrap">
                <% if (!v.hidePrice && v.prices && v.prices.ivr_100) { %>
                  <span>od <%= v.prices.ivr_100 %>&nbsp;PLN</span>
                  <% if (v.turnaround) { %>
                    <span class="text-gray-300">|</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 7v5l3 2"/></svg>
                    <span><%= v.turnaround %></span>
                  <% } %>
                <% } %>
              </div>
            </div>
          </a>


          <!-- Player + przyciski - na desktop: display:contents (niewidoczny wrapper), na mobile: wiersz -->
          <%
            var sampleToPlay = (v.samples && v.samples.length > 0)
              ? v.samples.filter(function(s) { return s.url && !s.url.includes('youtu'); })[0]
              : null;
            if (!sampleToPlay) sampleToPlay = { name: 'Próbka', url: '' };
          %>
          <div class="vc-player-wrap">
            <div class="player-box vc-player-row cursor-pointer">
              <%# Play - czarne outline 24x24 (mniejszy ok 25%) z umiarkowanym trojkatem (12px, viewBox standardowy) %>
              <button class="play-btn w-6 h-6 flex-shrink-0 rounded-full border-2 border-gray-900 bg-white flex items-center justify-center transition-colors" data-audio="<%= sampleToPlay.url %>" title="Odtwórz">
                <svg class="play-icon w-3.5 h-3.5 text-gray-900 ml-px" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                <svg class="pause-icon w-3.5 h-3.5 text-gray-900 hidden" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
              </button>
              <%# Stop - bialy 24x24 z accent obreczy + accent kwadratem 12px %>
              <button type="button" class="stop-btn w-6 h-6 flex-shrink-0 rounded-full border-2 border-accent bg-white hover:bg-accent/5 flex items-center justify-center transition-colors" title="Zatrzymaj">
                <svg class="w-3 h-3 text-accent" fill="currentColor" viewBox="0 0 24 24"><rect x="6" y="6" width="12" height="12"/></svg>
              </button>
              <%# Time display - 00:00 / 00:33 (ukryte na mobile - daje wiecej miejsca na fale) %>
              <div class="audio-time-wrap text-xs text-gray-600 font-mono tabular-nums whitespace-nowrap flex-shrink-0">
                <span class="audio-time">00:00</span>
                <span class="audio-duration text-gray-400 ml-1">--:--</span>
              </div>
              <%# Waveform SoundCloud-style. WYDAJNOSC: sciezki <path d> NIE sa renderowane
                  server-side (przy 236 kartach to bylo ~4 MB HTML). Emitujemy tylko seed
                  (data-wave-seed); slupki rysuje JS (buildWave) gdy karta wejdzie w ekran
                  (IntersectionObserver). Algorytm 1:1 z dawnym server-side. viewBox width = 150 (_waveBars). %>
              <%
                var _hashStr = function(s){var h=0;for(var i=0;i<s.length;i++)h=((h<<5)-h+s.charCodeAt(i))|0;return Math.abs(h);};
                var _seed = _hashStr(v.id || v.name);
              %>
              <div class="audio-progress relative flex-1 min-w-0 h-9 cursor-pointer" data-wave-seed="<%= _seed %>">
                <svg class="wave-svg absolute inset-0 w-full h-full" viewBox="0 0 150 36" preserveAspectRatio="none" aria-hidden="true">
                  <path class="wave-top-base"/>
                  <path class="wave-bot-base"/>
                  <g class="wave-played" style="clip-path: inset(0 100% 0 0);">
                    <path class="wave-top-played"/>
                    <path class="wave-bot-played"/>
                  </g>
                </svg>
              </div>
              <%# Download MP3 - stara ikonka (strzalka w dol, gray) %>
              <a href="<%= sampleToPlay.url %>" download onclick="event.stopPropagation()" title="Pobierz próbkę MP3" class="w-7 h-7 flex-shrink-0 flex items-center justify-center rounded-full text-gray-400 hover:text-gray-700 hover:bg-gray-200 transition-colors">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
              </a>
            </div>

            <!-- Akcje: premium (hidePrice) → tylko Zapytaj prowadzący do formularza na profilu; pozostali → Wyceń (primary) + Zapytaj (secondary, modal) -->
            <div class="vc-cta flex-shrink-0 flex flex-col gap-2 items-stretch justify-center">
              <% if (v.hidePrice) { %>
                <a href="<%= v.profileUrl %>#zapytanie" onclick="event.stopPropagation()" class="cta-inquiry inline-flex items-center justify-center bg-accent hover:bg-accent-light text-white text-sm font-medium px-4 py-2.5 rounded-lg transition-colors whitespace-nowrap">
                  Zapytaj
                </a>
              <% } else { %>
                <a href="<%= v.profileUrl %>#wycena" onclick="event.stopPropagation()" class="cta-pricing inline-flex items-center justify-center bg-accent hover:bg-accent-light text-white text-sm font-medium px-4 py-2.5 rounded-lg transition-colors whitespace-nowrap">
                  Wyceń nagranie
                </a>
                <button type="button" class="cta-inquiry inline-flex items-center justify-center bg-white hover:bg-gray-50 text-gray-700 text-sm font-medium px-4 py-2.5 rounded-lg border border-gray-300 hover:border-gray-400 transition-colors whitespace-nowrap" onclick="event.stopPropagation(); openInquiryModal('<%= v.name.replace(/'/g, "\\'") %>')" data-lektor="<%= v.name %>">
                  Zapytaj
                </button>
              <% } %>
            </div>
          </div>

        </div>
      </div>
      <% }); %>
    </div>

    <!-- Załaduj więcej -->
    <div id="load-more-wrap" class="text-center mt-10">
      <button id="load-more-btn" class="bg-white hover:bg-gray-100 border border-gray-300 text-gray-700 px-8 py-3 rounded-lg font-medium transition-colors">
        Załaduj więcej lektorów
      </button>
      <p id="load-more-info" class="text-sm text-gray-500 mt-3">Pokazano <span id="shown-count">20</span> z <span id="total-filtered">0</span></p>
    </div>

    <!-- Pusty stan -->
    <div id="no-results" class="hidden text-center py-16">
      <svg class="w-16 h-16 text-gray-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/></svg>
      <p class="text-gray-500 text-lg">Nie znaleziono lektorów spełniających kryteria</p>
      <button onclick="resetFilters()" class="mt-4 text-accent hover:text-accent-light text-sm font-medium">Wyczyść filtry</button>
    </div>

  </div><!-- /.right content -->

</div><!-- /.main layout -->
<script>
  (function() {
    var header = document.querySelector('header');
    var sidebar = document.getElementById('filters-sidebar');
    if (!sidebar) return;
    // Karta filtr+kontakt bywa wyzsza niz viewport. Chcemy: przewija sie z
    // lista lektorow, a gdy jej DOL (zacheta kontaktowa) dojdzie ~24px od dolu
    // ekranu - zamarza. position:sticky + dynamiczny top:
    //  - karta miesci sie w viewport -> top = headerH+12 (pin pod headerem)
    //  - karta wyzsza niz viewport   -> top ujemny = vh - cardH - 24
    //    (pin tak, ze dol/zacheta zostaje ~24px nad dolem ekranu)
    function setSidebarTop() {
      if (!window.matchMedia('(min-width: 768px)').matches) { sidebar.style.top = ''; return; }
      var headerH = header ? header.offsetHeight : 0;
      var topFits = headerH + 12;
      var topTall = window.innerHeight - sidebar.offsetHeight - 24;
      sidebar.style.top = Math.min(topFits, topTall) + 'px';
    }
    setSidebarTop();
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setSidebarTop);
    }
    window.addEventListener('load', setSidebarTop);
    window.addEventListener('resize', setSidebarTop);
  })();
</script>

