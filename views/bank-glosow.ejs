    {
      "@type": "Question",
      "name": "Co jeśli żaden głos w banku nie pasuje do mojego projektu?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Internetowy bank głosów Powitania.pl pokazuje <%= voiceCount %> lektorów aktualnie aktywnych. Jeśli żaden nie pasuje - napisz do nas z opisem projektu, postaramy się znaleźć rozwiązanie (np. specyficzne dialekty, dziecięce głosy, niszowe języki). Otwarci jesteśmy na nietypowe zlecenia."
      }
    }
  ]
}
</script>

