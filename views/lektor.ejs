                '<span class="text-xs text-gray-700">' + m.name + '</span>' +
              '</label>' +
              '<button type="button" class="melody-play-btn w-5 h-5 rounded-full bg-accent/10 hover:bg-accent/20 inline-flex items-center justify-center transition-colors" data-src="/audio/melodies/' + m.file + '" data-melody="' + m.id + '" onclick="playMelody(this)">' +
                '<svg class="w-2.5 h-2.5 text-accent melody-icon-play" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>' +
                '<svg class="w-2.5 h-2.5 text-accent melody-icon-pause hidden" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>' +
              '</button>' +
            '</div>';
          });
          html += '</div>';
          html += '<audio id="melody-audio" preload="none"></audio>';
          html += '</div>';
        }
      });
      html += '</div>'; // addons-body
      html += '</div>'; // border-t wrapper
    }

    // Suma
    var brutto = Math.round(totalBase * 1.23 * 100) / 100;
    html += '<div class="border-t border-green-200 mt-3 pt-3 flex items-center justify-between">' +
      '<span class="text-gray-900 font-bold">Łącznie:</span>' +
      '<div class="text-right"><span id="pricing-total" class="text-2xl font-bold text-green-700">' + totalBase + ' zł netto</span>' +
      '<div id="pricing-brutto" class="text-sm text-gray-500">' + brutto.toFixed(2) + ' zł brutto (z VAT 23%)</div></div>' +
    '</div>';

    if (result.note) {
      html += '<p class="text-xs text-gray-500 mt-1">' + result.note + '</p>';
    }
  }

  html += '</div>';
  targetEl.innerHTML = html;
  var wasHidden = targetEl.classList.contains('hidden');
  targetEl.classList.remove('hidden');
  // Po pierwszym odkryciu ceny - delikatnie przewin ja w pole widzenia.
  // Clarity audit: cena wyliczala sie pod foldem (zwlaszcza mobile), user nie widzial efektu wklejenia tekstu.
  if (wasHidden) {
    try { targetEl.scrollIntoView({ behavior: 'smooth', block: 'center' }); } catch (e) {}
  }

  // Store base price for recalc (including bilingual)
  targetEl.dataset.basePrice = (result.basePrice || 0) + (result.bilingualPrice || 0);

  // Przełączanie formularzy: custom quote -> zapytanie; inaczej -> bramka decyzji (Zamawiam / Waham się)
  if (result.needsCustomQuote) { toggleWizardForms(true); }
  else { revealWizardStep(); }

  // Aktualizuj tekst przycisków zamówienia (Zamów i zapłać / Zamów nagranie)
  if (!result.needsCustomQuote) {
    updateOrderButtonLabels(result.basePrice > 0);
  }
}

// Pamiec wyboru z bramki decyzji (null | 'order' | 'inquiry')
var wizardChoiceMade = false;

// Po wyliczeniu ceny (gdy NIE jest custom quote): pokaz bramke lub utrzymaj wybrana sciezke.
// Wolane z renderPricing przy kazdym przeliczeniu, wiec nie moze cofac wyboru usera.
function revealWizardStep() {
  var choice = document.getElementById('wizard-choice');
  var order = document.getElementById('wizard-order-form');
  var inquiry = document.getElementById('wizard-inquiry-form');
  if (wizardChoiceMade === 'order') {
    if (choice) choice.classList.add('hidden');
    if (inquiry) inquiry.classList.add('hidden');
    if (order) order.classList.remove('hidden');
  } else if (wizardChoiceMade === 'inquiry') {
    if (choice) choice.classList.add('hidden');
    if (order) order.classList.add('hidden');
    if (inquiry) inquiry.classList.remove('hidden');
  } else {
    if (order) order.classList.add('hidden');
    if (inquiry) inquiry.classList.add('hidden');
    if (choice) choice.classList.remove('hidden');
  }
}

