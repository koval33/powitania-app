var _personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://www.powitania.pl/lektorzy/" + lektor.id + "/#person",
  "name": lektor.name,
  "jobTitle": "Lektor",
  "description": lektor.description || lektor.seoDescription || "",
  "image": "https://www.powitania.pl" + lektor.photo,
  "url": "https://www.powitania.pl/lektorzy/" + lektor.id + "/",
  "knowsLanguage": (lektor.languages || []).map(function(l) { return _langMap[l] || l; }),
  "knowsAbout": (lektor.applications || []).slice(),
  "worksFor": {
    "@type": "Organization",
    "name": "Powitania.pl",
    "url": "https://www.powitania.pl"
  },
  "memberOf": {
    "@type": "Organization",
    "name": "Powitania.pl bank głosów",
    "url": "https://www.powitania.pl/bank-glosow/"
  }
};

// Wzbogać dla famous lektorów z bazą biografii
if (KNOWN_BIOS[lektor.id]) {
  var _bio = KNOWN_BIOS[lektor.id];
  if (_bio.alma) {
    _personSchema.alumniOf = { "@type": "EducationalOrganization", "name": _bio.alma };
  }
  if (_bio.knownFor && _bio.knownFor.length) {
    _personSchema.knowsAbout = _personSchema.knowsAbout.concat(_bio.knownFor);
  }
}
var _serviceSchemaLektor = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Voice Over Recording",
  "name": "Nagranie lektorskie - " + lektor.name,
  "provider": {
    "@type": "Organization",
    "name": "Powitania.pl - OPTIMUM Paweł Kowalski",
    "url": "https://www.powitania.pl"
  },
  "areaServed": "PL",
  "url": "https://www.powitania.pl/lektorzy/" + lektor.id + "/"
};

// --- Product schema - ceny per usługa dla rich results w Google SERP ---
// Uwaga: aggregateRating celowo pominięte, bo opinie są globalne (o studiu),
// nie o konkretnym lektorze. Doklejanie tej samej oceny do każdego z lektorskich
// produktów Google może uznać za spam.
var _prices = lektor.prices || {};
var _offers = [];
var _lektorUrl = "https://www.powitania.pl/lektorzy/" + lektor.id + "/";
function _addOffer(field, name) {
  var v = _prices[field];
  if (v && v !== 'wycena' && !isNaN(parseInt(v))) {
    _offers.push({
      "@type": "Offer",
      "name": name,
      "price": String(parseInt(v)),
      "priceCurrency": "PLN",
      "availability": "https://schema.org/InStock",
      "url": _lektorUrl + "#wycena",
      "seller": { "@type": "Organization", "name": "Powitania.pl" }
    });
  }
}
if (!lektor.hidePrice) {
  _addOffer('ivr_100',            'Zapowiedź telefoniczna IVR - do 100 słów');
  _addOffer('ivr_200',            'Zapowiedź telefoniczna IVR - do 200 słów');
  _addOffer('spot_radio_local',   'Spot reklamowy radio - lokalny');
  _addOffer('spot_radio_national','Spot reklamowy radio - krajowy');
  _addOffer('spot_tv_local',      'Spot reklamowy TV - lokalny');
  _addOffer('spot_tv_national',   'Spot reklamowy TV - krajowy');
  _addOffer('spot_social_1min',   'Nagranie social media - do 1 minuty');
  _addOffer('spot_social_2min',   'Nagranie social media - do 2 minut');
  _addOffer('narration_1page',    'Narracja / film - 1 strona A4');
  _addOffer('narration_2pages',   'Narracja / film - 2 strony A4');
  _addOffer('narration_3pages',   'Narracja / film - 3 strony A4');
}
var _productSchema = null;
if (_offers.length > 0) {
  var _prs = _offers.map(function(o) { return parseInt(o.price); });
  var _desc = (lektor.description || lektor.seoDescription || ('Profesjonalne nagrania lektorskie w wykonaniu ' + lektor.name + '. Zapowiedzi IVR, spoty reklamowe, narracje filmowe, social media.')).replace(/\s+/g, ' ').trim();
  if (_desc.length > 500) _desc = _desc.substring(0, 497) + '...';
  _productSchema = {
    "@context": "https://schema.org",
    "@type": "Product",
    "productID": "lektor-" + lektor.id,
    "name": "Nagranie lektorskie - " + lektor.name,
    "description": _desc,
    "image": "https://www.powitania.pl" + lektor.photo,
    "brand": { "@type": "Brand", "name": "Powitania.pl" },
    "category": "Voice-over services",
    "url": _lektorUrl,
    "offers": {
      "@type": "AggregateOffer",
      "priceCurrency": "PLN",
      "lowPrice": String(Math.min.apply(null, _prs)),
      "highPrice": String(Math.max.apply(null, _prs)),
      "offerCount": _offers.length,
      "offers": _offers
    }
  };
}
var _faqItems = [];
var _faqDisplayName = lektor.name.replace(/\s+\d+$/, '').trim();
var _faqTurnaroundSchema = lektor.turnaround || (lektor.hidePrice ? '4 dni robocze' : null);
if (_faqTurnaroundSchema) {
  _faqItems.push({ "@type": "Question", "name": "Jak szybko " + _faqDisplayName + " zrealizuje nagranie?", "acceptedAnswer": { "@type": "Answer", "text": "Standardowy czas realizacji to " + _faqTurnaroundSchema + ". Krótkie formy reklamowe (do 30 sekund) często gotowe tego samego dnia. Dłuższe projekty - wycena indywidualna z terminem do ustalenia." } });
}
if (!lektor.hidePrice) {
  _faqItems.push({ "@type": "Question", "name": "Jak zamówić nagranie lektorskie?", "acceptedAnswer": { "@type": "Answer", "text": "Możesz w prosty sposób dokonać wyceny i zamówić nagranie w powyższym formularzu. Jeśli masz jakieś wątpliwości, zadzwoń do nas: 605 491 069 lub napisz na biuro@powitania.pl." } });
  _faqItems.push({ "@type": "Question", "name": "Czy dostępna jest bezpłatna próbka nagrania?", "acceptedAnswer": { "@type": "Answer", "text": "Na życzenie Klienta przesyłamy bezpłatną dedykowaną próbkę nagrania. Na profilu dostępne są też gotowe próbki audio do odsłuchania." } });
}
if (lektor.languages && lektor.languages.length > 0) {
  _faqItems.push({ "@type": "Question", "name": "W jakich językach nagrywa " + _faqDisplayName + "?", "acceptedAnswer": { "@type": "Answer", "text": _faqDisplayName + " nagrywa w języku " + lektor.languages.join(', ') + ". Język natywny: " + (lektor.native ? lektor.nativeLanguage : 'polski') + "." } });
}
if (lektor.applications && lektor.applications.length > 0) {
  _faqItems.push({ "@type": "Question", "name": "W czym specjalizuje się " + _faqDisplayName + "?", "acceptedAnswer": { "@type": "Answer", "text": _faqDisplayName + " specjalizuje się w: " + lektor.applications.join(', ') + ". Szczegóły i próbki audio powyżej." } });
}
var _faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": _faqItems };
%>
<script type="application/ld+json"><%- JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": "https://www.powitania.pl/lektorzy/" + lektor.id + "/#profilepage",
  "url": "https://www.powitania.pl/lektorzy/" + lektor.id + "/",
  "name": "Profil lektora " + lektor.name,
  "isPartOf": { "@id": "https://www.powitania.pl/#website" },
  "about": { "@id": "https://www.powitania.pl/#organization" },
  "mainEntity": { "@id": "https://www.powitania.pl/lektorzy/" + lektor.id + "/#person" }
}) %></script>
<script type="application/ld+json"><%- JSON.stringify(_personSchema) %></script>
<script type="application/ld+json"><%- JSON.stringify(_serviceSchemaLektor) %></script>
<% if (_productSchema) { %>
<script type="application/ld+json"><%- JSON.stringify(_productSchema) %></script>
<% } %>
<script type="application/ld+json"><%- JSON.stringify(_faqSchema) %></script>
<% if (allAudio && allAudio.length > 0) { allAudio.forEach(function(s) { %>
<script type="application/ld+json"><%- JSON.stringify({ "@context": "https://schema.org", "@type": "AudioObject", "name": s.name || ("Próbka głosowa - " + lektor.name), "contentUrl": (s.url && s.url.startsWith('http') ? s.url : 'https://www.powitania.pl' + s.url), "encodingFormat": "audio/mpeg", "description": "Próbka głosowa lektora " + lektor.name }) %></script>
<% }); } %>
