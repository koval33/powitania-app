  ctaEl.classList.remove('hidden');

  var ctx = { text: text, serviceType: serviceType, lektorName: LEKTOR_NAME, lektorId: LEKTOR_ID, timestamp: Date.now() };
  try { sessionStorage.setItem('kreatorContext', JSON.stringify(ctx)); } catch(e) {}
