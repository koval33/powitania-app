// Melody selector - show/hide panel when checkbox toggled
function toggleMelodySelector(checkbox) {
  var panel = document.getElementById('melody-selector');
  if (!panel) return;
  if (checkbox.checked) {
    panel.classList.remove('hidden');
  } else {
    panel.classList.add('hidden');
    // Stop any playing melody
    var audio = document.getElementById('melody-audio');
    if (audio) { audio.pause(); audio.currentTime = 0; }
    resetMelodyButtons();
  }
}

// Melody audio playback
var currentMelodyBtn = null;
function playMelody(btn) {
  var audio = document.getElementById('melody-audio');
  if (!audio) return;
  var src = btn.getAttribute('data-src');

  // If same button clicked - toggle pause/play
  if (currentMelodyBtn === btn && !audio.paused) {
    audio.pause();
    showPlayIcon(btn);
    return;
  }

  // Stop previous
  if (currentMelodyBtn && currentMelodyBtn !== btn) {
    showPlayIcon(currentMelodyBtn);
  }

  // Play new
  if (audio.getAttribute('src') !== src) {
    audio.src = src;
  }
  audio.play();
  showPauseIcon(btn);
  currentMelodyBtn = btn;

  // Select the corresponding radio
  var melodyId = btn.getAttribute('data-melody');
  var radio = melodyId ? document.getElementById('melody-' + melodyId) : null;
  if (radio) radio.checked = true;
}

function showPlayIcon(btn) {
  var play = btn.querySelector('.melody-icon-play');
  var pause = btn.querySelector('.melody-icon-pause');
  if (play) play.classList.remove('hidden');
  if (pause) pause.classList.add('hidden');
}

function showPauseIcon(btn) {
  var play = btn.querySelector('.melody-icon-play');
  var pause = btn.querySelector('.melody-icon-pause');
  if (play) play.classList.add('hidden');
  if (pause) pause.classList.remove('hidden');
}

function resetMelodyButtons() {
  document.querySelectorAll('.melody-play-btn').forEach(function(btn) {
    showPlayIcon(btn);
  });
  currentMelodyBtn = null;
}

// Auto-reset icons when audio ends
document.addEventListener('ended', function(e) {
  if (e.target && e.target.id === 'melody-audio') {
    resetMelodyButtons();
  }
}, true);

function recalcTotal() {
  // Szukaj basePrice w widocznym kontenerze wyceny
  var containers = ['wizard-pricing', 'modal-pricing'];
  var total = 0;
  for (var i = 0; i < containers.length; i++) {
    var el = document.getElementById(containers[i]);
    if (el && el.dataset.basePrice) { total = parseInt(el.dataset.basePrice) || 0; break; }
  }
  document.querySelectorAll('.addon-checkbox:checked').forEach(function(cb) {
    total += parseInt(cb.dataset.price) || 0;
  });
  var totalEl = document.getElementById('pricing-total');
  if (totalEl) totalEl.textContent = total + ' zł netto';
  // Przelicz brutto (VAT 23%) od pełnej kwoty netto (baza + addony)
  var bruttoEl = document.getElementById('pricing-brutto');
  if (bruttoEl) {
    var brutto = Math.round(total * 1.23 * 100) / 100;
    bruttoEl.textContent = brutto.toFixed(2) + ' zł brutto (z VAT 23%)';
  }
}

