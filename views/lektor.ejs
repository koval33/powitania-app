function toggleWizardForms(isCustomQuote, source) {
  var orderForm = document.getElementById('wizard-order-form');
  var inquiryForm = document.getElementById('wizard-inquiry-form');
  var choice = document.getElementById('wizard-choice');
  if (!orderForm || !inquiryForm) return;
  if (choice) choice.classList.add('hidden');
  if (isCustomQuote) {
    wizardChoiceMade = 'inquiry';
    // Zapamietaj zrodlo (auto z kreatora / 'Zapytaj o szczegoly' / 'Waham sie')
    // odczytane potem w submitWizardInquiry przy trackEvent.
    inquiryForm.dataset.source = source || 'wycena_indywidualna';
    orderForm.classList.add('hidden');
