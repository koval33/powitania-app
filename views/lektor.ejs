function submitModalInquiry() {
  var email = document.getElementById('mod-inq-email').value.trim();
  var msgEl = document.getElementById('modal-inquiry-msg');
  if (!email) {
    msgEl.classList.remove('hidden');
    msgEl.className = 'text-center text-sm mt-2 text-red-500';
    msgEl.textContent = 'Podaj adres email.';
    return;
  }

  var data = {
    email: email,
    name: document.getElementById('mod-inq-name').value.trim(),
    lektorName: LEKTOR_NAME,
    lektorId: LEKTOR_ID,
    serviceType: document.getElementById('modal-service-select').value,
    generatedText: document.getElementById('modal-text-input').value.trim(),
    description: document.getElementById('mod-inq-message').value.trim()
  };

  var btn = document.getElementById('mod-inq-submit-btn');
  btn.disabled = true;
  btn.textContent = 'Wysyłanie...';

  fetch('/api/contact/inquiry', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(data)
  })
  .then(function(r) { return r.json(); })
  .then(function(res) {
    msgEl.classList.remove('hidden');
    if (res.ok) {
      if (window.trackEvent) trackEvent('form_submit_inquiry', { lektor: LEKTOR_ID, source: 'modal' });
      if (typeof gtag === 'function') gtag('event', 'generate_lead', { event_category: 'inquiry', event_label: LEKTOR_NAME });
      msgEl.className = 'text-center text-sm mt-2 text-emerald-500';
      msgEl.textContent = res.message || 'Dziękujemy! Odpowiemy z wyceną w ciągu 2 godzin.';
      btn.disabled = false;
      btn.textContent = 'Wyślij zapytanie';
      msgEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } else {
      msgEl.className = 'text-center text-sm mt-2 text-red-500';
      msgEl.textContent = res.error || 'Wystąpił błąd. Spróbuj ponownie.';
      btn.disabled = false;
      btn.textContent = 'Wyślij zapytanie';
    }
  })
  .catch(function() {
    msgEl.classList.remove('hidden');
    msgEl.className = 'text-center text-sm mt-2 text-red-500';
    msgEl.textContent = 'Błąd połączenia. Sprawdź internet.';
    btn.disabled = false;
    btn.textContent = 'Wyślij zapytanie';
  });
}

