          <button type="button" class="svc-btn relative border-2 border-gray-200 rounded-xl px-4 py-4 text-left transition-all hover:border-accent hover:bg-accent/5 hover:-translate-y-0.5 hover:shadow-md" data-select="modal-service-select" data-value="social" onclick="pickService(this)">
            <span class="block text-sm font-semibold text-gray-800 leading-tight">Social Media</span>
            <span class="block text-xs text-gray-400 mt-1">online / digital</span>
