function submitOrderRequest(data, msgElId) {
  var msgEl = document.getElementById(msgElId);
  if (msgEl) { msgEl.classList.add('hidden'); }

  // Sprawdź czy mamy numeryczną cenę (> 0) - jeśli tak, kieruj na płatność P24
  var numericPrice = parseFloat(String(data.totalPrice || '0').replace(/[^0-9.,]/g, '').replace(',', '.'));
  var hasPrice = numericPrice > 0;

  var endpoint = hasPrice ? '/api/payment/register' : '/api/contact/order';
  var eventName = hasPrice ? 'form_submit_payment' : 'form_submit_order';

  fetch(endpoint, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(data)
  })
  .then(function(r) { return r.json(); })
  .then(function(res) {
    if (res.ok && res.redirectUrl) {
      if (msgEl) {
        msgEl.classList.remove('hidden');
        msgEl.className = 'text-center text-sm mt-2 text-accent';
        msgEl.textContent = 'Przekierowuję na stronę płatności...';
      }
      try { sessionStorage.removeItem('kreatorContext'); } catch(e) {}

      // Fix race condition: nawigacja dopiero po wykonaniu tagów GTM (eventCallback).
      // Bez tego window.location.href anuluje pending GA4 beacony przed wysłaniem.
      var navigated = false;
      var navigateOnce = function() {
        if (navigated) return;
        navigated = true;
        window.location.href = res.redirectUrl;
      };

      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: eventName,
        lektor: '<%= lektor.id %>',
        value: numericPrice,
        eventCallback: navigateOnce,
        eventTimeout: 2000
      });

      // Fallback: gdy GTM niedostępny / eventCallback się nie wykona — nawigacja po 2.5s.
      setTimeout(navigateOnce, 2500);
      return;
    }
    if (msgEl) {
      msgEl.classList.remove('hidden');
      if (res.ok) {
        // Event dopiero po potwierdzeniu serwera
        if (window.trackEvent) trackEvent(eventName, { lektor: '<%= lektor.id %>', value: numericPrice });
        msgEl.className = 'text-center text-sm mt-2 text-emerald-500';
        msgEl.textContent = res.message || 'Zamowienie wyslane. Odpowiemy w ciagu 2 godzin.';
        try { sessionStorage.removeItem('kreatorContext'); } catch(e) {}
      } else {
        msgEl.className = 'text-center text-sm mt-2 text-red-400';
        msgEl.textContent = res.error || 'Blad wysylania.';
      }
    }
  })
  .catch(function() {
    if (msgEl) {
      msgEl.className = 'text-center text-sm mt-2 text-red-400';
      msgEl.textContent = 'Blad polaczenia. Sprobuj ponownie.';
      msgEl.classList.remove('hidden');
    }
  });
}

