<%- include('partials/head') %>

<style>
.order-fields-3col {
  display: grid;
  grid-template-columns: 1fr;
  gap: 0.75rem;
}
@media (min-width: 640px) {
  .order-fields-3col { grid-template-columns: 1fr 1fr 1fr; }
}
/* Kafelki wyboru typu nagrania: lekka wypuklosc (convex) jako sygnal clickability,
   zamiast pomaranczowej strzalki (sugerowala proces "w prawo"). Inset highlight u gory
   + delikatny drop shadow = efekt uniesienia; hover (shadow-md + translate) poglebia. */
.svc-btn {
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.7), 0 1px 2px rgba(0,0,0,0.06), 0 2px 5px rgba(0,0,0,0.05);
}
</style>

<section class="py-10 md:py-16 bg-stone-100/80">
  <div class="max-w-5xl mx-auto px-4">

    <!-- Breadcrumb -->
    <nav class="text-sm mb-8">
      <a href="/" class="text-gray-500 hover:text-gray-900 transition-colors">Strona główna</a>
      <span class="text-gray-400 mx-2">/</span>
      <a href="/bank-glosow/" class="text-gray-500 hover:text-gray-900 transition-colors">Bank głosów</a>
      <span class="text-gray-400 mx-2">/</span>
      <span class="text-gray-600"><%= lektor.name %></span>
    </nav>

    <!-- Profil: zdjęcie + info -->
    <div class="flex flex-col md:flex-row gap-8 md:gap-12">

      <!-- Lewa kolumna: zdjęcie + tagi -->
      <div class="flex-shrink-0">
        <div class="w-48 h-48 md:w-56 md:h-56 rounded-2xl overflow-hidden border-2 border-gray-200 mx-auto md:mx-0">
          <img src="<%= lektor.photo %>" alt="<%= lektor.name %>" class="w-full h-full object-cover">
        </div>
        <div class="flex flex-wrap gap-2 mt-4 justify-center md:justify-start">
          <% if (lektor.famous) { %>
            <a href="/bank-glosow/?famous=1" class="bg-yellow-50 text-yellow-700 hover:bg-yellow-100 hover:text-yellow-800 text-xs font-semibold px-3 py-1 rounded-full border border-yellow-300 transition-colors" title="Zobacz wszystkich lektorów z grupy Znani i Lubiani">Znani i lubiani</a>
          <% } %>
          <% if (lektor.native) { %>
            <a href="/bank-glosow/?native=1" class="bg-blue-50 text-blue-700 hover:bg-blue-100 hover:text-blue-800 text-xs font-semibold px-3 py-1 rounded-full border border-blue-300 transition-colors" title="Zobacz wszystkich Native speakerów">Native speaker</a>
          <% } %>
          <span class="bg-gray-50 text-gray-500 text-xs font-medium px-3 py-1 rounded-full border border-gray-200">
            <%= lektor.gender === 'm' ? 'Mężczyzna' : 'Kobieta' %>
          </span>
          <span class="bg-gray-50 text-gray-500 text-xs font-medium px-3 py-1 rounded-full border border-gray-200">
            <%= lektor.age %>
          </span>
        </div>

        <% if (!lektor.hidePrice && lektor.prices) { %>
        <div class="mt-5 space-y-1.5 text-xs text-gray-500">
          <% if (lektor.prices.ivr_100) { %>
          <div class="flex justify-between"><span>Zapowiedź tel.</span><span class="font-semibold text-gray-800">od <%= lektor.prices.ivr_100 %> zł</span></div>
          <% } %>
          <% if (lektor.prices.spot_social_1min) { %>
          <div class="flex justify-between"><span>Social Media</span><span class="font-semibold text-gray-800">od <%= lektor.prices.spot_social_1min %> zł</span></div>
          <% } %>
          <% if (lektor.prices.spot_radio_local) { %>
          <div class="flex justify-between"><span>Spot reklamowy</span><span class="font-semibold text-gray-800">od <%= lektor.prices.spot_radio_local %> zł</span></div>
          <% } %>
          <% if (lektor.prices.narration_1page) { %>
          <div class="flex justify-between"><span>Narracja / film</span><span class="font-semibold text-gray-800">od <%= lektor.prices.narration_1page %> zł</span></div>
          <% } %>
        </div>
        <% } %>

        <!-- Kontakt: duzy, wyrazny blok pod zdjeciem i cennikiem (zawsze widoczny) -->
        <div class="mt-6 rounded-xl border border-gray-200 bg-gray-50 p-4 text-center md:text-left">
          <p class="text-gray-900 font-bold leading-snug mb-3">Nie wiesz od czego zacząć?<br>Zadzwoń / napisz.</p>
          <a href="tel:+48605491069" class="flex items-center justify-center md:justify-start gap-2.5 text-gray-800 hover:text-accent text-lg font-semibold transition-colors mb-2.5">
            <svg class="w-5 h-5 text-accent flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/></svg>
            605 491 069
          </a>
          <a href="mailto:biuro@powitania.pl" class="flex items-center justify-center md:justify-start gap-2.5 text-gray-800 hover:text-accent font-semibold transition-colors">
            <svg class="w-5 h-5 text-accent flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
            <span class="break-all">biuro@powitania.pl</span>
          </a>
        </div>
      </div>

      <!-- Prawa kolumna: dane -->
      <div class="flex-1 min-w-0">
        <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-3"><%= lektor.name %></h1>

        <% if (lektor.description) { %>
          <p class="text-gray-500 leading-relaxed mb-4"><%= lektor.description %></p>
        <% } %>
        <% if (lektor.studioNote) { %>
          <p class="text-sm text-gray-400 italic mb-4"><%= lektor.studioNote %></p>
        <% } %>

        <!-- Meta info - kompaktowo -->
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1.5 text-sm text-gray-500 mb-4">
          <span><%= lektor.languages.join(', ') %></span>
          <span class="text-gray-400">·</span>
          <span>Realizacja: <span class="text-gray-900"><%= lektor.turnaround || '24-48h' %></span></span>
          <% if (lektor.applications && lektor.applications.length > 0) { %>
          <span class="text-gray-400">·</span>
          <% lektor.applications.forEach(function(app) { %>
            <span class="text-xs bg-accent/10 text-accent px-2 py-0.5 rounded-full"><%= app %></span>
          <% }); %>
          <% } %>
        </div>

        <!-- PRÓBKI GŁOSOWE - kolejność z panelu admin (po reorderze ↑↓). -->
        <%
          var allAudio = [];
          var videoSamples = [];
          (lektor.samples || []).forEach(function(s) {
            if (!s.url) return;
            var isVideo = s.url.includes('youtu') || s.url.includes('vimeo');
            if (isVideo) videoSamples.push(s);
            else allAudio.push(s);
          });
        %>

        <% if (allAudio.length > 0) { %>
        <div class="space-y-2 mb-5">
          <% allAudio.forEach(function(sample, idx) { %>
          <div class="sample-row bg-white shadow-sm rounded-lg border border-gray-200 overflow-hidden">
            <div class="flex items-center gap-3 p-3">
              <button class="sample-play-btn w-9 h-9 flex-shrink-0 rounded-full border-2 border-gray-900 bg-white hover:bg-gray-50 flex items-center justify-center transition-colors" data-audio="<%= sample.url %>">
                <svg class="play-icon w-4 h-4 text-gray-900 ml-0.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                <svg class="pause-icon w-4 h-4 text-gray-900 hidden" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
              </button>
              <div class="flex-1 min-w-0">
                <div class="text-sm text-gray-900 font-medium truncate mb-1"><%= sample.name || ('Próbka ' + (idx + 1)) %></div>
                <div class="audio-progress w-full h-1.5 bg-gray-100 rounded-full overflow-hidden cursor-pointer">
                  <div class="audio-bar h-full bg-accent rounded-full transition-all" style="width: 0%"></div>
                </div>
                <div class="flex justify-between mt-0.5">
                  <span class="audio-time text-xs text-gray-500">0:00</span>
                  <span class="audio-duration text-xs text-gray-500">--:--</span>
                </div>
              </div>
              <a href="<%= sample.url %>" download title="Pobierz MP3" class="w-8 h-8 flex-shrink-0 flex items-center justify-center rounded-full text-gray-500 hover:text-gray-900 hover:bg-gray-100 transition-colors">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/></svg>
              </a>
            </div>
          </div>
          <% }); %>
        </div>
        <% } %>

        <!-- Banner ekspresowy -->
        <% if (typeof isExpress !== 'undefined' && isExpress) { %>
        <div class="bg-yellow-50 border border-yellow-400/30 rounded-xl px-4 py-3 mb-3 flex items-center gap-2 text-sm">
          <svg class="w-4 h-4 text-yellow-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.381z" clip-rule="evenodd"/></svg>
          <span class="text-yellow-800"><strong>Nagranie ekspresowe</strong> - stawki uwzględniają priorytetową realizację</span>
        </div>
        <% } %>

        <!-- CTA (tylko dla hidePrice - kieruje do formularza zapytania) -->
        <% if (lektor.hidePrice) { %>
        <div id="lektor-cta-section" class="flex flex-col gap-3">
          <a href="#zapytanie" class="bg-accent hover:bg-accent-light text-white px-6 py-3 rounded-lg font-semibold text-center transition-colors inline-flex items-center justify-center gap-2">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
            Zapytaj o wycenę
          </a>
        </div>
        <% } %>

        <!-- INTELIGENTNY WIZARD WYCENY (widoczny gdy kontekst z kreatora) -->
        <div id="pricing-wizard" class="mt-6 hidden">
          <div class="bg-white shadow-sm rounded-2xl border-2 border-accent/30 p-6">
            <div class="flex items-center justify-between mb-4">
              <div class="flex items-center gap-2.5 flex-wrap">
                <svg class="w-6 h-6 text-accent flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                <h3 class="text-lg font-bold text-gray-900">Wycena nagrania</h3>
                <span id="wizard-subtitle" class="text-sm text-gray-500 hidden"></span>
              </div>
              <button onclick="clearPricingContext()" class="text-gray-500 hover:text-gray-900 transition-colors" title="Zamknij">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
              </button>
            </div>
            <!-- Podgląd tekstu -->
            <div class="bg-gray-50 rounded-lg p-3 mb-4">
              <div class="flex items-center justify-between mb-1">
                <span class="text-xs text-gray-500">Twój tekst:</span>
                <span id="wizard-word-count" class="text-xs text-accent font-medium"></span>
              </div>
              <div id="wizard-text-preview" class="text-gray-600 text-sm leading-relaxed max-h-24 overflow-y-auto"></div>
            </div>
            <!-- Typ nagrania (jeśli nie przyszedł z kreatora) -->
            <div id="wizard-service-type" class="hidden mb-4">
              <label class="block text-gray-900 font-semibold mb-2 text-sm">Typ nagrania</label>
              <select id="wizard-service-select" class="hidden" onchange="updateWizardPricing()">
                <option value="">- wybierz typ nagrania -</option>
                <option value="ivr">Zapowiedź telefoniczna</option>
                <option value="social">Social Media</option>
                <option value="spot">Spot reklamowy</option>
                <option value="film">Narracja</option>
              </select>
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                <button type="button" class="svc-btn relative border-2 border-gray-200 rounded-xl px-4 py-4 text-left transition-all hover:border-accent hover:bg-accent/5 hover:-translate-y-0.5 hover:shadow-md" data-select="wizard-service-select" data-value="ivr" onclick="pickService(this)">
                  <span class="block text-sm font-semibold text-gray-800 leading-tight">Zapowiedź tel.</span>
                  <span class="block text-xs text-gray-400 mt-1">IVR / centrala</span>
                </button>
                <button type="button" class="svc-btn relative border-2 border-gray-200 rounded-xl px-4 py-4 text-left transition-all hover:border-accent hover:bg-accent/5 hover:-translate-y-0.5 hover:shadow-md" data-select="wizard-service-select" data-value="social" onclick="pickService(this)">
                  <span class="block text-sm font-semibold text-gray-800 leading-tight">Social Media</span>
                  <span class="block text-xs text-gray-400 mt-1">online / digital</span>
                </button>
                <button type="button" class="svc-btn relative border-2 border-gray-200 rounded-xl px-4 py-4 text-left transition-all hover:border-accent hover:bg-accent/5 hover:-translate-y-0.5 hover:shadow-md" data-select="wizard-service-select" data-value="spot" onclick="pickService(this)">
                  <span class="block text-sm font-semibold text-gray-800 leading-tight">Spot reklamowy</span>
                  <span class="block text-xs text-gray-400 mt-1">radio / TV</span>
                </button>
                <button type="button" class="svc-btn relative border-2 border-gray-200 rounded-xl px-4 py-4 text-left transition-all hover:border-accent hover:bg-accent/5 hover:-translate-y-0.5 hover:shadow-md" data-select="wizard-service-select" data-value="film" onclick="pickService(this)">
                  <span class="block text-sm font-semibold text-gray-800 leading-tight">Narracja</span>
                  <span class="block text-xs text-gray-400 mt-1">film / e-learning</span>
                </button>
              </div>
            </div>
            <!-- Dynamiczne pytania per serviceType -->
            <div id="wizard-questions"></div>
            <!-- Wycena -->
            <div id="wizard-pricing" class="hidden"></div>
            <!-- CTA + formularz zamówienia - pojawi się dopiero po wycenie -->
            <div id="wizard-cta" class="hidden mt-5">

              <!-- Bramka decyzji: Zamawiam vs Waham się (pojawia się po wyliczeniu ceny) -->
              <div id="wizard-choice" class="hidden border-t border-gray-200 pt-4">
                <p class="text-gray-900 font-medium text-center mb-3">Jak chcesz kontynuować?</p>
                <div class="grid grid-cols-2 gap-3">
                  <button type="button" onclick="chooseWizardOrder()" class="bg-accent hover:bg-accent-light text-white px-4 py-3 rounded-lg font-semibold transition-colors">Zamawiam</button>
                  <button type="button" onclick="chooseWizardInquiry()" class="bg-white hover:bg-gray-50 text-gray-700 border border-gray-300 hover:border-gray-400 px-4 py-3 rounded-lg font-semibold transition-colors">Waham się</button>
                </div>
              </div>

              <!-- Formularz PEŁNY (zamówienie - widoczny gdy jest cena) -->
              <div id="wizard-order-form" class="border-t border-gray-200 pt-4">
                <h4 class="text-gray-900 font-bold mb-4 flex items-center gap-2">
                  <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/></svg>
                  Dane do zamówienia
                </h4>
                <div class="space-y-3">
                  <div class="grid sm:grid-cols-2 gap-3">
                    <div>
                      <label class="block text-gray-900 text-sm font-medium mb-1">Nazwa firmy *</label>
                      <input type="text" id="wiz-firmName" required class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none text-sm" placeholder="Firma Sp. z o.o.">
                    </div>
                    <div>
                      <label class="block text-gray-900 text-sm font-medium mb-1">NIP</label>
                      <input type="text" id="wiz-nip" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none text-sm" placeholder="123-456-78-90">
                    </div>
                  </div>
                  <div class="order-fields-3col">
                    <div>
                      <label class="block text-gray-900 text-sm font-medium mb-1">Imię i nazwisko *</label>
                      <input type="text" id="wiz-name" required class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none text-sm" placeholder="Jan Kowalski">
                    </div>
                    <div>
                      <label class="block text-gray-900 text-sm font-medium mb-1">Email *</label>
                      <input type="email" id="wiz-email" required class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none text-sm" placeholder="jan@firma.pl">
                    </div>
                    <div>
                      <label class="block text-gray-900 text-sm font-medium mb-1">Telefon</label>
                      <input type="tel" id="wiz-phone" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none text-sm" placeholder="+48 600 000 000">
                    </div>
                  </div>
                </div>
                <button id="wiz-submit-btn" onclick="submitWizardOrder()" class="bg-accent hover:bg-accent-light text-white px-6 py-3 rounded-lg font-semibold w-full transition-colors mt-4">
                  Zamów nagranie
                </button>
                <div id="wizard-order-msg" class="hidden text-center text-sm mt-2"></div>
                <p class="text-center text-sm text-gray-500 mt-3">Masz pytania? <button type="button" onclick="toggleWizardForms(true, 'zapytaj_o_szczegoly')" class="text-accent hover:text-accent-light font-medium">Zapytaj o szczegóły</button> lub zadzwoń: <a href="tel:+48605491069" class="text-accent hover:text-accent-light font-medium">605 491 069</a></p>
              </div>

              <!-- Formularz ZAPYTANIA (widoczny gdy klik "Zapytaj o szczegóły") -->
              <div id="wizard-inquiry-form" class="hidden border-t border-gray-200 pt-4" data-source="wycena_indywidualna">
                <h4 class="text-gray-900 font-bold mb-3 flex items-center gap-2">
                  <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
                  Zapytaj o szczegóły
                </h4>
                <div class="space-y-3">
                  <div class="grid sm:grid-cols-2 gap-3">
                    <div>
                      <label class="block text-gray-900 text-sm font-medium mb-1">Email *</label>
                      <input type="email" id="wiz-inq-email" required class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none text-sm" placeholder="jan@firma.pl">
                    </div>
                    <div>
                      <label class="block text-gray-900 text-sm font-medium mb-1">Imię i nazwisko</label>
                      <input type="text" id="wiz-inq-name" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none text-sm" placeholder="Jan Kowalski">
                    </div>
                  </div>
                  <div>
                    <label class="block text-gray-900 text-sm font-medium mb-1">Wiadomość</label>
                    <textarea id="wiz-inq-message" rows="3" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none text-sm resize-y" placeholder="Opisz swój projekt..."></textarea>
                  </div>
                </div>
                <button id="wiz-inq-submit-btn" type="button" onclick="submitWizardInquiry()" class="bg-accent hover:bg-accent-light text-white px-6 py-3 rounded-lg font-semibold w-full transition-colors mt-4">Wyślij zapytanie</button>
                <div id="wizard-inquiry-msg" class="hidden text-center text-sm mt-2"></div>
