              <div class="border-t border-gray-200 pt-4">
                <p class="text-gray-900 font-medium text-center mb-3">Jak chcesz kontynuować?</p>
                <div class="grid grid-cols-2 gap-3">
                  <button type="button" onclick="chooseModalOrder()" class="bg-accent hover:bg-accent-light text-white px-4 py-3 rounded-lg font-semibold transition-colors">Zamawiam</button>
                  <button type="button" onclick="chooseModalInquiry()" class="bg-white hover:bg-gray-50 text-gray-700 border border-gray-300 hover:border-gray-400 px-4 py-3 rounded-lg font-semibold transition-colors">Waham się</button>
