            <!-- Formularz zamówienia po wycenie -->
            <div id="modal-order-cta" class="hidden mt-4">
              <div class="border-t border-gray-200 pt-4">
                <h4 class="text-gray-900 font-bold mb-4 flex items-center gap-2">
                  <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/></svg>
                  Dane do zamówienia
                </h4>
                <div class="space-y-3">
                  <div class="grid sm:grid-cols-2 gap-3">
                    <div>
                      <label class="block text-gray-900 text-sm font-medium mb-1">Nazwa firmy *</label>
                      <input type="text" id="mod-firmName" required class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none text-sm" placeholder="Firma Sp. z o.o.">
                    </div>
                    <div>
                      <label class="block text-gray-900 text-sm font-medium mb-1">NIP</label>
                      <input type="text" id="mod-nip" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none text-sm" placeholder="123-456-78-90">
                    </div>
                  </div>
                  <div class="order-fields-3col">
                    <div>
                      <label class="block text-gray-900 text-sm font-medium mb-1">Imię i nazwisko *</label>
                      <input type="text" id="mod-name" required class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none text-sm" placeholder="Jan Kowalski">
                    </div>
                    <div>
                      <label class="block text-gray-900 text-sm font-medium mb-1">Email *</label>
                      <input type="email" id="mod-email" required class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none text-sm" placeholder="jan@firma.pl">
                    </div>
                    <div>
                      <label class="block text-gray-900 text-sm font-medium mb-1">Telefon</label>
                      <input type="tel" id="mod-phone" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none text-sm" placeholder="+48 600 000 000">
                    </div>
                  </div>
                </div>
                <button id="mod-submit-btn" onclick="submitModalOrder()" class="bg-accent hover:bg-accent-light text-white px-6 py-3 rounded-lg font-semibold w-full transition-colors mt-4">
                  Zamów nagranie
                </button>
                <div id="modal-order-msg" class="hidden text-center text-sm mt-2"></div>
                <p class="text-center text-sm text-gray-500 mt-3">Masz pytania? <button type="button" onclick="showModalInquiry()" class="text-accent hover:text-accent-light font-medium">Zapytaj o szczegóły</button> lub zadzwoń: <a href="tel:+48605491069" class="text-accent hover:text-accent-light font-medium">605 491 069</a></p>
              </div>
            </div>

            <!-- Formularz ZAPYTANIA w modalu -->
            <div id="modal-inquiry-form" class="hidden mt-4">
              <div class="border-t border-gray-200 pt-4">
                <h4 class="text-gray-900 font-bold mb-3 flex items-center gap-2">
                  <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
                  Zapytaj o szczegóły
                </h4>
                <div class="space-y-3">
                  <div class="grid sm:grid-cols-2 gap-3">
                    <div>
                      <label class="block text-gray-900 text-sm font-medium mb-1">Email *</label>
                      <input type="email" id="mod-inq-email" required class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none text-sm" placeholder="jan@firma.pl">
                    </div>
                    <div>
                      <label class="block text-gray-900 text-sm font-medium mb-1">Imię i nazwisko</label>
                      <input type="text" id="mod-inq-name" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none text-sm" placeholder="Jan Kowalski">
                    </div>
                  </div>
                  <div>
                    <label class="block text-gray-900 text-sm font-medium mb-1">Wiadomość</label>
                    <textarea id="mod-inq-message" rows="3" class="w-full bg-white border border-gray-300 rounded-lg px-4 py-2.5 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none text-sm resize-y" placeholder="Opisz swój projekt..."></textarea>
                  </div>
                </div>
                <button id="mod-inq-submit-btn" type="button" onclick="submitModalInquiry()" class="bg-accent hover:bg-accent-light text-white px-6 py-3 rounded-lg font-semibold w-full transition-colors mt-4">Wyślij zapytanie</button>
                <div id="modal-inquiry-msg" class="hidden text-center text-sm mt-2"></div>
                <p class="text-center text-sm text-gray-500 mt-3"><button type="button" onclick="showModalOrder()" class="text-accent hover:text-accent-light font-medium">← Wróć do zamówienia</button></p>
              </div>
            </div>

          </div>
        </div><!-- /#wycena -->
      </div>
        </div>
        <% } %>

      </div>
    </div>

    <!-- VIDEO (pełna szerokość, pod profilem) -->
    <%
      var videoSamples = (lektor.samples || []).filter(function(s) {
        return s.url && (s.url.includes('youtu') || s.url.includes('vimeo'));
      });
    %>

    <% if (videoSamples.length > 0) { %>
    <div class="mt-10">
      <h3 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
        <svg class="w-5 h-5 text-red-500" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814z"/><path fill="#fff" d="M9.545 15.568V8.432L15.818 12z"/></svg>
        Realizacje wideo
      </h3>
      <div class="grid sm:grid-cols-2 gap-4">
        <% videoSamples.forEach(function(video) {
          var ytId = '';
          var url = video.url || '';
          if (url.includes('youtu.be/')) {
            ytId = url.split('youtu.be/')[1].split(/[?&#]/)[0];
          } else if (url.includes('youtube.com/watch')) {
            var match = url.match(/[?&]v=([^&#]+)/);
            if (match) ytId = match[1];
          } else if (url.includes('youtube.com/shorts/')) {
            ytId = url.split('shorts/')[1].split(/[?&#]/)[0];
          }
        %>
        <div class="bg-white shadow-sm rounded-xl border border-gray-200 overflow-hidden group">
          <% if (ytId) { %>
          <div style="position:relative;padding-bottom:56.25%;height:0;overflow:hidden" class="cursor-pointer bg-black" data-vid="<%= ytId %>" onclick="loadYT(this)">
            <img src="https://img.youtube.com/vi/<%= ytId %>/mqdefault.jpg" alt="<%= video.name %>" style="position:absolute;top:0;left:0;width:100%;height:100%;object-fit:cover">
            <div style="position:absolute;top:0;left:0;width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.4)">
              <div style="width:56px;height:56px;background:#dc2626;border-radius:50%;display:flex;align-items:center;justify-content:center">
                <svg style="width:24px;height:24px;color:#fff;margin-left:3px" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              </div>
            </div>
          </div>
          <% } else { %>
          <div style="position:relative;padding-bottom:56.25%;height:0;overflow:hidden;background:#f9fafb">
            <a href="<%= video.url %>" target="_blank" rel="noopener" style="position:absolute;top:0;left:0;width:100%;height:100%;display:flex;align-items:center;justify-content:center" class="text-accent hover:text-accent-light">
              <svg style="width:48px;height:48px" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25"/></svg>
            </a>
          </div>
          <% } %>
          <div class="p-3">
            <div class="text-sm text-gray-900 font-medium"><%= video.name %></div>
          </div>
        </div>
        <% }); %>
      </div>
    </div>
    <% } %>

    <!-- FORMULARZ ZAPYTANIA (dla lektorów z hidePrice) -->
    <% if (lektor.hidePrice) { %>
    <div class="mt-12 scroll-mt-[8rem]" id="zapytanie">
      <div class="max-w-2xl mx-auto bg-white shadow-sm rounded-2xl border border-gray-200 p-8">
        <div class="flex items-center gap-4 mb-6">
          <% if (lektor.photo) { %>
            <img src="<%= lektor.photo %>" alt="<%= lektor.name %>" class="w-14 h-14 rounded-full object-cover border-2 border-gray-200 flex-shrink-0">
          <% } %>
          <div class="min-w-0">
            <div class="text-xs text-gray-500 uppercase tracking-wider font-medium mb-0.5">Zapytanie o realizację</div>
            <h2 class="text-xl md:text-2xl font-bold text-gray-900 truncate"><%= lektor.name %></h2>
          </div>
        </div>
        <p class="text-gray-600 leading-relaxed mb-8">
          Udział artysty w projekcie jest potwierdzany indywidualnie. Proszę o przesłanie możliwie jak najszerszej informacji na temat projektu (typ nagrania, pole jego eksploatacji, czas na jaki ma zostać udzielona licencja) a my wrócimy z informacją na temat zainteresowania artysty i kosztów.
        </p>
        <hr class="border-gray-200 mb-8">

        <form id="inquiry-form" enctype="multipart/form-data">
          <input type="hidden" name="lektorName" value="<%= lektor.name %>">
          <input type="hidden" name="lektorId" value="<%= lektor.id %>">

          <div class="mb-6">
            <label class="block text-gray-900 font-semibold mb-2">Opis projektu</label>
            <textarea name="description" rows="5" required
              class="w-full bg-white border border-gray-300 rounded-xl px-4 py-3 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none resize-y transition-colors"
              placeholder="Informacje o projekcie: typ nagrania, pole jego eksploatacji, czas na jaki ma zostać udzielona licencja..."></textarea>
          </div>

          <div class="mb-6">
            <label class="block text-gray-900 font-semibold mb-2">Email:</label>
            <input type="email" name="email" required
              class="w-full bg-white border border-gray-300 rounded-xl px-4 py-3 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none transition-colors"
              placeholder="twoj@email.pl">
          </div>

          <div class="mb-6">
            <label class="block text-gray-500 text-sm mb-2">Załącznik <span class="text-gray-400">(opcjonalnie)</span></label>
            <label class="flex items-center gap-3 cursor-pointer border border-dashed border-gray-300 rounded-xl px-4 py-3 hover:border-gray-400 hover:bg-gray-50 transition-colors">
              <svg class="w-5 h-5 text-gray-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"/></svg>
              <span class="text-gray-400 text-sm truncate file-label">Dołącz plik (PDF, DOC, MP3, WAV, ZIP)</span>
              <input type="file" name="attachment" class="hidden" accept=".pdf,.doc,.docx,.txt,.rtf,.odt,.mp3,.wav,.zip" onchange="updateFileLabel(this)">
            </label>
          </div>

          <div class="flex justify-end">
            <button type="submit" id="inquiry-submit"
              class="bg-accent hover:bg-accent-light text-white px-8 py-3 rounded-lg font-bold text-sm uppercase tracking-wider transition-colors">
              Wyślij zapytanie
            </button>
          </div>

          <div id="inquiry-msg" class="mt-4 text-center hidden"></div>
        </form>
      </div>
    </div>
    <% } %>

    <!-- FAQ -->
    <div class="mt-16">
      <h2 class="text-2xl font-bold text-gray-900 mb-6">Najczęściej zadawane pytania</h2>
      <div class="space-y-3 max-w-3xl">

        <% var displayName = lektor.name.replace(/\s+\d+$/, '').trim(); %>
        <% var _faqTurnaround = lektor.turnaround || (lektor.hidePrice ? '4 dni robocze' : null); %>
        <% if (_faqTurnaround) { %>
        <details class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
          <summary class="flex items-center justify-between px-6 py-4 cursor-pointer font-semibold text-gray-900 select-none" style="list-style:none">
            <span>Jak szybko <%= displayName %> zrealizuje nagranie?</span>
            <svg class="w-5 h-5 flex-shrink-0 ml-3 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/></svg>
          </summary>
          <div class="px-6 pb-5 text-gray-600 leading-relaxed">Standardowy czas realizacji to <strong><%= _faqTurnaround %></strong>. Krótkie formy reklamowe (do 30 sekund) często gotowe tego samego dnia. Dłuższe projekty - wycena indywidualna z terminem do ustalenia.</div>
        </details>
        <% } %>

        <% if (!lektor.hidePrice) { %>
        <details class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
          <summary class="flex items-center justify-between px-6 py-4 cursor-pointer font-semibold text-gray-900 select-none" style="list-style:none">
            <span>Jak zamówić nagranie lektorskie?</span>
            <svg class="w-5 h-5 flex-shrink-0 ml-3 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/></svg>
          </summary>
          <div class="px-6 pb-5 text-gray-600 leading-relaxed">Możesz w prosty sposób dokonać wyceny i zamówić nagranie w powyższym formularzu. Jeśli masz jakieś wątpliwości, zadzwoń do nas: <a href="tel:+48605491069" class="text-accent hover:underline">605 491 069</a> lub napisz na <a href="mailto:biuro@powitania.pl" class="text-accent hover:underline">biuro@powitania.pl</a>.</div>
        </details>

        <details class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
          <summary class="flex items-center justify-between px-6 py-4 cursor-pointer font-semibold text-gray-900 select-none" style="list-style:none">
            <span>Czy dostępna jest bezpłatna próbka nagrania?</span>
            <svg class="w-5 h-5 flex-shrink-0 ml-3 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/></svg>
          </summary>
          <div class="px-6 pb-5 text-gray-600 leading-relaxed">Na życzenie Klienta przesyłamy bezpłatną dedykowaną próbkę nagrania. Na profilu dostępne są też gotowe próbki audio do odsłuchania.</div>
        </details>
        <% } %>

        <% if (lektor.languages && lektor.languages.length > 0) { %>
        <details class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
          <summary class="flex items-center justify-between px-6 py-4 cursor-pointer font-semibold text-gray-900 select-none" style="list-style:none">
            <span>W jakich językach nagrywa <%= displayName %>?</span>
            <svg class="w-5 h-5 flex-shrink-0 ml-3 text-gray-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/></svg>
          </summary>
          <div class="px-6 pb-5 text-gray-600 leading-relaxed"><strong><%= displayName %></strong> nagrywa w języku <strong><%= lektor.languages.join(', ') %></strong>. Język natywny: <strong><%= lektor.native ? lektor.nativeLanguage : 'polski' %></strong>.</div>
        </details>
        <% } %>

        <% if (lektor.applications && lektor.applications.length > 0) { %>
