<script>
// --- Re-scroll do #wycena po pełnym załadowaniu (handluje async layout shift z audio metadata) ---
(function() {
  if (window.location.hash !== '#wycena') return;
  function rescroll() {
    var el = document.getElementById('wycena');
    if (!el) return;
    var header = document.querySelector('header');
    var headerH = header ? header.offsetHeight : 96;
    var top = el.getBoundingClientRect().top + window.pageYOffset - headerH - 24;
    window.scrollTo({ top: top, behavior: 'smooth' });
  }
  // Po pełnym załadowaniu (audio metadata, fonty, obrazy)
  window.addEventListener('load', function() { setTimeout(rescroll, 100); });
})();

// --- Custom audio player ---
var currentBtn = null;
var currentAudioSrc = '';

function resetCurrentBtn() {
  if (!currentBtn) return;
  currentBtn.querySelector('.play-icon').classList.remove('hidden');
  currentBtn.querySelector('.pause-icon').classList.add('hidden');
  var oldRow = currentBtn.closest('.sample-row');
  if (oldRow) {
    oldRow.querySelector('.audio-bar').style.width = '0%';
    oldRow.querySelector('.audio-time').textContent = '0:00';
  }
}

function getAudioEl() {
  // Zawsze tworzymy nowy element - najprostsza metoda unikania problemów z ponownym użyciem
  var el = document.getElementById('shared-audio-el');
  if (el) el.remove();
  el = document.createElement('audio');
  el.id = 'shared-audio-el';
  el.preload = 'auto';
  el.style.display = 'none';
  document.body.appendChild(el);

  el.addEventListener('timeupdate', function() {
    if (!currentBtn) return;
    var row = currentBtn.closest('.sample-row');
    if (!row) return;
    var pct = (el.currentTime / el.duration) * 100;
    row.querySelector('.audio-bar').style.width = pct + '%';
    row.querySelector('.audio-time').textContent = formatTime(el.currentTime);
  });

  el.addEventListener('loadedmetadata', function() {
    if (!currentBtn) return;
    var row = currentBtn.closest('.sample-row');
    if (row) row.querySelector('.audio-duration').textContent = formatTime(el.duration);
  });

  el.addEventListener('ended', function() {
    resetCurrentBtn();
    currentBtn = null;
  });

  return el;
}

function initSamplePlayer(btn) {
  btn.addEventListener('click', function(e) {
    e.stopPropagation();
    var src = this.dataset.audio;
    if (!src) return;
    var playIcon = this.querySelector('.play-icon');
    var pauseIcon = this.querySelector('.pause-icon');

    var existing = document.getElementById('shared-audio-el');

    // Klik na ten sam przycisk - pauza/wznowienie
    if (currentBtn === this && existing) {
      if (existing.paused) {
        existing.play();
        playIcon.classList.add('hidden');
        pauseIcon.classList.remove('hidden');
      } else {
        existing.pause();
        playIcon.classList.remove('hidden');
        pauseIcon.classList.add('hidden');
      }
      return;
    }

    // Inny przycisk - resetuj poprzedni, stwórz nowy element audio
    if (existing && !existing.paused) existing.pause();
    resetCurrentBtn();
    currentBtn = this;

    var audio = getAudioEl();
    audio.src = src;
    audio.load();
    audio.play().then(function() {
      playIcon.classList.add('hidden');
      pauseIcon.classList.remove('hidden');
    }).catch(function(err) {
      console.error('[audio] play error:', err);
      playIcon.classList.remove('hidden');
      pauseIcon.classList.add('hidden');
    });
    // Pokaż stan ładowania od razu
    playIcon.classList.add('hidden');
    pauseIcon.classList.remove('hidden');
  });
}

// Init all sample players + progress bar seek (raz na wiersz)
document.querySelectorAll('.sample-play-btn').forEach(function(btn) {
  initSamplePlayer(btn);
  var row = btn.closest('.sample-row');
  if (row) {
    row.querySelector('.audio-progress').addEventListener('click', function(e) {
      var audio = document.getElementById('shared-audio-el');
      if (audio && currentBtn === btn && audio.duration) {
        var rect = this.getBoundingClientRect();
        var pct = (e.clientX - rect.left) / rect.width;
        audio.currentTime = pct * audio.duration;
      }
    });
  }
});

function formatTime(s) {
  var m = Math.floor(s / 60);
  var sec = Math.floor(s % 60);
  return m + ':' + (sec < 10 ? '0' : '') + sec;
}


// File upload label
function updateFileLabel(input) {
  var label = input.closest('label').querySelector('.file-label');
  if (input.files.length > 0) {
    label.textContent = input.files[0].name;
    label.classList.remove('text-gray-400');
    label.classList.add('text-gray-900');
  } else {
    label.textContent = 'Dołącz plik (PDF, DOC, MP3, WAV, ZIP)';
    label.classList.add('text-gray-400');
    label.classList.remove('text-gray-900');
  }
}

// Inquiry form submit
(function() {
  var form = document.getElementById('inquiry-form');
  if (!form) return;

  form.addEventListener('submit', function(e) {
    e.preventDefault();
    var btn = document.getElementById('inquiry-submit');
    var msg = document.getElementById('inquiry-msg');
    var origText = btn.textContent;

    btn.disabled = true;
    btn.textContent = 'Wysyłanie...';
    msg.className = 'mt-4 text-center hidden';

    var formData = new FormData(form);

    fetch('/api/contact/inquiry-premium', {
      method: 'POST',
      body: formData
    })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data.ok) {
        if (window.trackEventEC) trackEventEC('form_submit_inquiry_premium', { lektor: '<%= lektor.id %>' }, formData.get('email'), formData.get('phone'));
        else if (window.trackEvent) trackEvent('form_submit_inquiry_premium', { lektor: '<%= lektor.id %>' });
        msg.textContent = data.message || 'Dziękujemy! Odpowiemy najszybciej jak to możliwe.';
        msg.className = 'mt-4 text-center text-accent font-medium';
        form.reset();
        var fileLabel = form.querySelector('.file-label');
        if (fileLabel) { fileLabel.textContent = 'Brak zaznaczonych plików'; fileLabel.className = 'text-gray-500 text-sm truncate file-label'; }
      } else {
        msg.textContent = data.error || 'Wystąpił błąd. Spróbuj ponownie.';
        msg.className = 'mt-4 text-center text-red-400 font-medium';
      }
    })
    .catch(function() {
      msg.textContent = 'Błąd połączenia. Spróbuj ponownie.';
      msg.className = 'mt-4 text-center text-red-400 font-medium';
    })
    .finally(function() {
      btn.disabled = false;
      btn.textContent = origText;
    });
  });
})();

// --- Lektor context data ---
var LEKTOR_NAME = '<%= lektor.name.replace(/'/g, "\\'") %>';
var LEKTOR_ID = '<%= lektor.id %>';
var LEKTOR_PRICES = <%- JSON.stringify(lektor.prices || {}) %>;
var LEKTOR_HIDE_PRICE = <%= lektor.hidePrice ? 'true' : 'false' %>;
var IS_EXPRESS = <%= typeof isExpress !== 'undefined' && isExpress ? 'true' : 'false' %>;
var MELODIES = <%- JSON.stringify(typeof melodies !== 'undefined' ? melodies : []) %>;

// Tryb ekspresowy: ceny +50% zaokrąglone do 10 zł
if (IS_EXPRESS) {
  for (var key in LEKTOR_PRICES) {
    if (typeof LEKTOR_PRICES[key] === 'number') {
