<%- include('partials/head') %>

<section class="py-16 md:py-24">
  <div class="max-w-4xl mx-auto px-4">
    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4 text-center">Opinie naszych Klientów</h1>
    <p class="text-gray-500 text-center mb-6 max-w-2xl mx-auto">Zebraliśmy ponad <strong class="text-gray-900"><%= reviews.length %> opinii</strong> od Klientów z całej Polski. Oto, co o nas mówią.</p>

    <div class="text-center mb-6">
      <a href="#dodaj-opinie" class="inline-flex items-center gap-2 bg-accent hover:bg-accent-light text-white px-6 py-2.5 rounded-lg font-semibold text-sm transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
        Dodaj opinię
      </a>
    </div>

    <!-- Średnia ocena -->
    <div class="flex items-center justify-center gap-2 mb-12">
      <div class="flex text-yellow-400">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
      </div>
      <span class="text-gray-900 font-semibold">5.0</span>
      <span class="text-gray-500 text-sm">(<%= reviews.length %> opinii)</span>
    </div>

    <!-- Lista opinii -->
    <div class="space-y-4" id="reviews-list">
      <% reviews.forEach(function(r, i) { %>
      <div class="review-card bg-white shadow-sm border border-gray-200 rounded-xl p-6 <%= i >= 12 ? 'hidden' : '' %>" data-index="<%= i %>">
        <div class="flex items-start justify-between mb-3">
          <div>
            <p class="text-gray-900 font-semibold"><%= r.company %></p>
            <% if (r.author) { %>
              <p class="text-gray-500 text-sm"><%= r.author %></p>
            <% } %>
            <% if (r.date || r.createdAt) { %>
              <p class="text-gray-600 text-xs mt-1"><%= new Date(r.date || r.createdAt).toLocaleDateString('pl-PL', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
            <% } %>
          </div>
          <div class="flex text-yellow-400 flex-shrink-0 ml-4">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          </div>
        </div>
        <p class="text-gray-600 leading-relaxed"><%= r.text %></p>
        <% if (r.link) { %>
          <a href="<%= r.link %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-accent hover:text-accent-light text-sm mt-3 transition-colors">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m9.86-3.02a4.5 4.5 0 00-1.242-7.244l-4.5-4.5a4.5 4.5 0 00-6.364 6.364L4.343 8.04"/></svg>
            Zobacz realizację
          </a>
        <% } %>
      </div>
      <% }); %>
    </div>

    <% if (reviews.length > 12) { %>
    <div class="text-center mt-8" id="load-more-wrap">
      <button id="load-more-btn" class="bg-white hover:bg-gray-100 text-gray-700 px-8 py-3 rounded-lg font-semibold transition-colors border border-gray-300">
        Pokaż więcej opinii (<span id="remaining-count"><%= reviews.length - 12 %></span>)
      </button>
    </div>
    <% } %>

    <!-- Formularz dodawania opinii -->
    <div class="mt-16 bg-stone-100/80 rounded-2xl border border-gray-200 p-8" id="dodaj-opinie">
      <h2 class="text-2xl font-bold text-gray-900 mb-2 text-center">Dodaj swoją opinię</h2>
      <p class="text-gray-500 text-center mb-8">Współpracowałeś z nami? Podziel się swoim doświadczeniem.</p>

      <form id="review-form" class="max-w-lg mx-auto space-y-5">
        <div>
          <label for="review-company" class="block text-sm text-gray-600 mb-1.5">Nazwa firmy <span class="text-red-400">*</span></label>
          <input type="text" id="review-company" name="company" required
            class="w-full bg-white border border-gray-300 rounded-lg px-4 py-3 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none transition-colors"
            placeholder="np. Twoja Firma Sp. z o.o.">
        </div>
        <div>
          <label for="review-author" class="block text-sm text-gray-600 mb-1.5">Imię i nazwisko</label>
          <input type="text" id="review-author" name="author"
            class="w-full bg-white border border-gray-300 rounded-lg px-4 py-3 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none transition-colors"
            placeholder="np. Jan Kowalski">
        </div>
        <div>
          <label for="review-text" class="block text-sm text-gray-600 mb-1.5">Treść opinii <span class="text-red-400">*</span></label>
          <textarea id="review-text" name="text" required rows="4"
            class="w-full bg-white border border-gray-300 rounded-lg px-4 py-3 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none transition-colors resize-none"
            placeholder="Opisz swoje doświadczenie ze współpracy z nami..."></textarea>
        </div>
        <div>
          <label for="review-link" class="block text-sm text-gray-600 mb-1.5">Link do realizacji <span class="text-gray-400 font-normal">(opcjonalnie)</span></label>
          <input type="url" id="review-link" name="link"
            class="w-full bg-white border border-gray-300 rounded-lg px-4 py-3 text-gray-900 placeholder-gray-400 focus:border-accent focus:outline-none transition-colors"
            placeholder="np. https://twojafirma.pl/nagranie">
          <p class="text-xs text-gray-400 mt-1">Link do strony, na której wykorzystano nagranie - Twoja opinia będzie bardziej wiarygodna.</p>
        </div>
        <button type="submit" id="review-submit"
          class="w-full bg-accent hover:bg-accent-light text-white font-semibold py-3 rounded-lg transition-colors">
          Wyślij opinię
        </button>
        <div id="review-msg" class="hidden text-center text-sm py-3 rounded-lg"></div>
      </form>
    </div>

  </div>
</section>

<!-- Review Schema.org - wskazuje przez @id na globalną Organization z head.ejs -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "https://www.powitania.pl/#organization",
  "name": "Powitania.pl - OPTIMUM Paweł Kowalski",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "5.0",
    "bestRating": "5",
    "worstRating": "1",
    "reviewCount": "<%= reviews.length %>"
  },
  "review": [
    <% reviews.slice(0, 10).forEach(function(r, i) { %>
    {
      "@type": "Review",
      "name": <%- JSON.stringify("Opinia firmy " + r.company + " o usługach Powitania.pl") %>,
      "author": { "@type": "Organization", "name": <%- JSON.stringify(r.company) %> },
      "itemReviewed": { "@id": "https://www.powitania.pl/#organization" },
      "reviewRating": { "@type": "Rating", "ratingValue": "5.0", "bestRating": "5", "worstRating": "1" },
      "reviewBody": <%- JSON.stringify(r.text) %>,
      "datePublished": "<%= r.date %>"
    }<%= i < Math.min(reviews.length, 10) - 1 ? ',' : '' %>
    <% }); %>
  ]
}
</script>

<script>
// Load more reviews
(function() {
  var btn = document.getElementById('load-more-btn');
  if (!btn) return;

  var shown = 12;
  var cards = document.querySelectorAll('.review-card');
  var total = cards.length;
  var remaining = document.getElementById('remaining-count');
  var wrap = document.getElementById('load-more-wrap');

  btn.addEventListener('click', function() {
    var next = Math.min(shown + 12, total);
    for (var i = shown; i < next; i++) {
      cards[i].classList.remove('hidden');
    }
    shown = next;
    var left = total - shown;
    if (left > 0) {
      remaining.textContent = left;
    } else {
      wrap.style.display = 'none';
    }
  });
})();

// Submit review form
(function() {
  var form = document.getElementById('review-form');
  var msg = document.getElementById('review-msg');
  var submitBtn = document.getElementById('review-submit');

  form.addEventListener('submit', function(e) {
    e.preventDefault();
    submitBtn.disabled = true;
    submitBtn.textContent = 'Wysyłanie...';
    msg.className = 'hidden';

    var data = {
      company: document.getElementById('review-company').value.trim(),
      author: document.getElementById('review-author').value.trim(),
      text: document.getElementById('review-text').value.trim(),
      link: document.getElementById('review-link').value.trim()
    };

    fetch('/api/reviews/add', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    })
    .then(function(r) { return r.json(); })
    .then(function(res) {
      if (res.ok) {
        if (window.trackEvent) trackEvent('form_submit_review');
        msg.className = 'text-center text-sm py-3 rounded-lg bg-accent/10 border border-accent/30 text-accent';
        msg.textContent = res.message;
        form.reset();
      } else {
        msg.className = 'text-center text-sm py-3 rounded-lg bg-red-500/10 border border-red-500/30 text-red-400';
        msg.textContent = res.error || 'Wystąpił błąd. Spróbuj ponownie.';
      }
    })
    .catch(function() {
      msg.className = 'text-center text-sm py-3 rounded-lg bg-red-500/10 border border-red-500/30 text-red-400';
      msg.textContent = 'Wystąpił błąd połączenia. Spróbuj ponownie.';
    })
    .finally(function() {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Wyślij opinię';
    });
  });
})();
</script>

<%- include('partials/foot') %>
