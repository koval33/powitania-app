<%- include('partials/head') %>

<section class="py-16 md:py-24">
  <div class="max-w-4xl mx-auto px-4">
    <h1 class="text-3xl md:text-4xl font-bold text-white mb-4 text-center">Opinie naszych klientów</h1>
    <p class="text-gray-400 text-center mb-4 max-w-2xl mx-auto">Zaufało nam ponad <strong class="text-white"><%= reviews.length %> firm i instytucji</strong> z całej Polski. Oto, co o nas mówią.</p>

    <!-- Średnia ocena -->
    <div class="flex items-center justify-center gap-2 mb-12">
      <div class="flex text-yellow-400">
